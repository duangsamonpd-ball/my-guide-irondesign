---
/**
 * ── Why this component declares no `figma-size` band ──────────────────────
 *
 * No node found. The form-field reference says so outright, and on 2026-08-28
 * a published-component search returned nothing, the file has no page of its
 * own for it, and neither catch-all page (`Other element`, `Test`) holds one.
 * That is what was checked — not every frame on every canvas.
 */
interface Props {
  label?: string;
  linkText?: string;
  sizeLimitText?: string;
  name?: string;
  accept?: string;
  error?: boolean;
  errorMessage?: string;
  disabled?: boolean;
  fileName?: string;
  fileSize?: string;
  class?: string;
}

const {
  label = 'Drag & drop your file',
  linkText = 'Select file from computer',
  sizeLimitText = 'Size up to 100 MB',
  name,
  accept,
  error = false,
  errorMessage,
  disabled = false,
  fileName,
  fileSize,
  class: className,
} = Astro.props;

const hasFile = !!fileName;

import { icons as sharedIcons } from '../icons';

// circle-check and triangle-exclamation are shared with Notice — see ../icons.
const icons = {
  upload: sharedIcons.cloudArrowUp,
  check: sharedIcons.circleCheck,
  warning: sharedIcons.triangleExclamation,
} as const;

const iconKey = hasFile ? 'check' : error ? 'warning' : 'upload';
---

<label class:list={['dropzone', { error, 'has-file': hasFile, 'is-disabled': disabled }, className]}>
  <input type="file" name={name} accept={accept} disabled={disabled} class="dropzone-input" />
  <div class="dropzone-left">
    <span class="dropzone-icon"><svg viewBox={icons[iconKey].viewBox} fill="currentColor" aria-hidden="true"><path d={icons[iconKey].path} /></svg></span>
    <div class="dropzone-text">
      {hasFile ? (
        <div class="title">{fileName}</div>
      ) : (
        <div class="title">{error ? (errorMessage || 'Upload failed') : label}</div>
      )}
      {/* The link's trailing arrow is an icon, not a "→". Measured against this
          system's own --font-sans: Montserrat has no arrow glyph, so the
          character drops to the next family in the stack and its box goes
          16.00px to 14.78px. Third component to hit it, after FormCard and
          Select. aria-hidden because the <label> wraps the file input, so
          every word in here lands in that input's accessible name. */}
      {hasFile && fileSize ? (
        <span class="size-label">{fileSize}</span>
      ) : (
        <span class="link">{linkText}<svg class="link-arrow" viewBox={sharedIcons.arrowRight.viewBox} fill="currentColor" aria-hidden="true"><path d={sharedIcons.arrowRight.path} /></svg></span>
      )}
    </div>
  </div>
  {!hasFile && sizeLimitText && <span class="dropzone-size">{sizeLimitText}</span>}
  {hasFile && <button type="button" class="dz-remove">Remove</button>}
</label>

<style>
  .dropzone {
    border: var(--border-width-1-5) dashed var(--color-border-strong); border-radius: var(--rounded-lg);
    background: var(--color-bg-base); padding: var(--spacing-xl);
    display: flex; align-items: center; justify-content: space-between; gap: var(--spacing-md);
    cursor: pointer; position: relative;
    transition: border-color var(--duration-fast), background var(--duration-fast);
  }
  .dropzone-input { position: absolute; inset: 0; opacity: 0; cursor: pointer; }
  .dropzone-left { display: flex; align-items: center; gap: var(--spacing-md); min-width: 0; }
  .dropzone-icon {
    width: 40px; height: 40px; border-radius: var(--rounded-lg); flex-shrink: 0;
    background: color-mix(in srgb, var(--color-secondary) 6%, transparent); border: var(--border-width-1) solid color-mix(in srgb, var(--color-secondary) 10%, transparent);
    color: var(--color-secondary); display: flex; align-items: center; justify-content: center;
  }
  .dropzone-icon svg { width: 18px; height: 18px; }
  .dropzone-text { min-width: 0; }
  .dropzone-text .title { font-size: var(--font-size-body); color: var(--color-text-body); margin-bottom: var(--spacing-micro); }
  /* A FILENAME truncates; a label wraps. `.dropzone-text` above is `min-width: 0`
     so it shrinks past its own content, and `quote-request.pdf` — an unremarkable
     name — needed 146px in a box that was 95px at 1280. It was breaking mid-word
     across two lines, which no gate could see: it never overflowed, so the sweep
     was green, and it is exactly the "not overflowing is not fitting" case.
     Scoped to `.has-file` because the same element holds the call-to-action
     label and the error message in the other states, and those SHOULD wrap. */
  .dropzone.has-file .dropzone-text .title { white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  /* The arrow is a 16px box around the glyph, matching the em box the character
     used to occupy at --font-size-base. */
  .dropzone-text .link { display: inline-flex; align-items: center; gap: var(--spacing-micro); font-size: var(--font-size-body); font-weight: var(--fw-btn-lg); color: var(--color-secondary); }
  .link-arrow { width: 16px; height: 16px; flex-shrink: 0; }
  .dropzone-text .size-label { font-size: var(--font-size-caption); color: var(--color-text-support); }
  .dropzone-size { font-size: var(--font-size-body); color: var(--color-text-support); white-space: nowrap; flex-shrink: 0; }
  .dropzone:hover, .dropzone.is-dragover { border-color: var(--color-secondary); background: var(--color-bg-card-alt); }
  .dropzone.is-dragover .dropzone-icon { background: color-mix(in srgb, var(--color-secondary) 12%, transparent); }
  .dropzone.error { border-color: var(--color-danger); }
  .dropzone.error .dropzone-icon { background: color-mix(in srgb, var(--color-danger) 6%, transparent); border-color: color-mix(in srgb, var(--color-danger) 10%, transparent); color: var(--color-danger); }
  .dropzone.is-disabled { opacity: .5; cursor: not-allowed; }
  .dropzone.is-disabled .dropzone-input { cursor: not-allowed; }
  .dropzone.has-file { border-style: solid; border-color: var(--color-border); cursor: default; }
  .dropzone.has-file .dropzone-icon { background: color-mix(in srgb, var(--color-success-strong) 8%, transparent); border-color: color-mix(in srgb, var(--color-success-strong) 14%, transparent); color: var(--color-success-strong); }
  .dz-remove {
    font-size: var(--font-size-btn-sm); font-weight: var(--fw-btn-lg); color: var(--color-text-support);
    background: none; border: none; cursor: pointer; padding: var(--spacing-micro) var(--spacing-xs); position: relative; z-index: 1;
  }
  .dz-remove:hover { color: var(--color-danger); }

  /* The row cannot hold its own contents on a narrow screen. `.dropzone-size`
     is nowrap and does not shrink, the icon is fixed at 40, and what gives is
     `.dropzone-text` — `min-width: 0`, so it keeps shrinking past the link
     inside it. `.link` is an inline-flex row of text plus a 16px icon and will
     not go below 85.8px, so below 330 it simply leaves its parent: 8.7px out at
     320, 28.7px at 300, with nothing clipping it.

     The breakpoint is 437.98, not 329.98, and the difference is the whole
     lesson. Stopping the overflow only needs 330 — but a screenshot at 360
     showed the fix was not a fix: no overflow, and the label broken across
     three lines with the arrow stranded to the right of them. NOT OVERFLOWING
     IS NOT THE SAME AS FITTING. Swept 4px at a time for the width where the
     title and the link each sit on one line, which is 438. */
  @media (max-width: 437.98px) {
    .dropzone { flex-direction: column; align-items: flex-start; gap: var(--spacing-sm); }
    .dropzone-size { align-self: flex-start; }
  }
</style>

<script>
  function initDropzones(root: ParentNode = document) {
    root.querySelectorAll<HTMLElement>('.dropzone:not([data-dz-init])').forEach((dz) => {
      dz.dataset.dzInit = '1';
      const input = dz.querySelector<HTMLInputElement>('.dropzone-input');
      const removeBtn = dz.querySelector<HTMLButtonElement>('.dz-remove');

      ['dragenter', 'dragover'].forEach((evt) =>
        dz.addEventListener(evt, (e) => {
          e.preventDefault();
          if (!dz.classList.contains('is-disabled')) dz.classList.add('is-dragover');
        })
      );
      ['dragleave', 'drop'].forEach((evt) =>
        dz.addEventListener(evt, (e) => {
          e.preventDefault();
          dz.classList.remove('is-dragover');
        })
      );
      dz.addEventListener('drop', (e: DragEvent) => {
        const file = e.dataTransfer?.files?.[0];
        if (file && input) {
          const dt = new DataTransfer();
          dt.items.add(file);
          input.files = dt.files;
          input.dispatchEvent(new Event('change', { bubbles: true }));
        }
      });

      removeBtn?.addEventListener('click', (e) => {
        e.preventDefault();
        e.stopPropagation();
        dz.dispatchEvent(new CustomEvent('file-remove', { bubbles: true }));
      });
    });
  }

  document.addEventListener('DOMContentLoaded', () => initDropzones());
  document.addEventListener('astro:page-load', () => initDropzones());
</script>
