---
// quote / key / check are shared with the other card components — see ../icons.
import { icons } from '../icons';

interface Props {
  icon: 'quote' | 'key' | 'check';
  headingPrefix?: string;
  headingBold: string;
  headingSuffix?: string;
  inputPlaceholder: string;
  inputName?: string;
  /**
   * The field's real label. The card's design has no room for a visible one, so
   * it is rendered visually hidden rather than left out — a placeholder is not a
   * label: it is not announced by every screen reader, and it disappears the
   * moment the user types, taking the only description of the field with it.
   * Defaults to the placeholder text.
   */
  inputLabel?: string;
  hint?: string;
  submitLabel: string;
  submitIcon?: 'quote' | 'key' | 'check';
  footerNotes: string[];
  /**
   * Heading level for the card's headline. It was a `<p>`, so the card
   * contributed nothing to the page outline. Default 3.
   */
  headingLevel?: 2 | 3 | 4 | 5;
  /** Where the form posts. Omitted means the current URL. */
  action?: string;
  method?: 'get' | 'post';
  class?: string;
}

const {
  icon,
  headingPrefix = 'Get your free',
  headingBold,
  headingSuffix = 'instantly.',
  inputPlaceholder,
  inputName,
  inputLabel,
  hint,
  submitLabel,
  submitIcon,
  footerNotes,
  headingLevel = 3,
  action,
  method,
  class: className,
} = Astro.props;

const Heading = `h${headingLevel}` as 'h2' | 'h3' | 'h4' | 'h5';
/* base-16, 8 digits — the shape build-demos.mjs normalises. See FormCard. */
const uid = `tc-${Math.random().toString(16).slice(2, 10)}`;
const inputId = `${uid}-email`;
const hintId = hint ? `${uid}-hint` : undefined;
---

<form class:list={['bg-bg-base border border-border rounded-2xl py-[40px] px-[32px] flex flex-col items-center gap-[20px] max-w-[420px] text-center', className]} action={action} method={method} aria-labelledby={`${uid}-title`}>
  <span class="size-[64px] rounded-full flex items-center justify-center text-secondary bg-[color-mix(in_srgb,var(--color-secondary)_10%,transparent)]"><svg class="size-[28px]" viewBox={icons[icon].viewBox} fill="currentColor" aria-hidden="true"><path d={icons[icon].path} /></svg></span>
  {/* The spaces are `{' '}` expressions, not literal text. Under a dynamic <Tag>
      Astro drops a whitespace-only text node that sits between an expression and
      an element, so `{headingPrefix} <b>` rendered as "Get your free30-day Trial
      Key". An expression that evaluates to a space survives. */}
  {/* `font-normal` is DELIBERATE and does not take `font-title-lg` — do not
      "fix" it to match the role. The heading is regular weight so the <b> can
      carry the emphasis, and `--fw-title-lg` is 700, the same as the <b>. Both
      were snapped to the role on 2026-08-13 and measured: heading 400 → 700
      with the <b> already at 700, so the contrast the markup exists for
      disappeared entirely. Reverted on Ball's call, weight only. The leading
      DID move and stays moved — `leading-[1.4]` on an 18px size is 25.2px
      against the role's 28. */}
  <Heading class="font-sans text-title-lg text-text-body leading-title-lg font-normal m-0" id={`${uid}-title`}>{headingPrefix}{' '}<b class="text-text-heading font-bold">{headingBold}</b>{' '}{headingSuffix}</Heading>
  <div class="w-full flex flex-col gap-xs">
    <label class="sr-only" for={inputId}>{inputLabel ?? inputPlaceholder}</label>
    <input
      class="w-full h-[var(--size-input)] border-[length:var(--border-width-1-5)] border-border rounded-md px-[16px] font-sans text-body leading-body text-text-body bg-bg-base outline-none text-center transition-[border-color,box-shadow] duration-[var(--duration-fast)] placeholder:text-text-placeholder hover:border-border-strong focus:border-border-focus focus:shadow-focus-blue"
      id={inputId}
      type="email"
      name={inputName}
      placeholder={inputPlaceholder}
      autocomplete="email"
      aria-describedby={hintId}
      required
    />
    {hint && <span class="text-caption leading-caption text-text-support" id={hintId}>{hint}</span>}
  </div>
  <button type="submit" class="w-full h-[var(--size-btn-lg)] border-0 rounded-full bg-primary text-primary-on font-sans text-btn-lg font-btn-lg leading-btn-lg cursor-pointer inline-flex items-center justify-center gap-[8px] transition-[background-color] duration-[var(--duration-fast)] hover:bg-primary-hover">{submitLabel} {submitIcon && <svg class="size-[14px]" viewBox={icons[submitIcon].viewBox} fill="currentColor" aria-hidden="true"><path d={icons[submitIcon].path} /></svg>}</button>
  {footerNotes.length > 0 && (
    <ul class="flex items-center justify-center gap-[12px] text-caption-sm font-caption-sm leading-caption-sm text-text-support flex-wrap m-0 list-none p-0">
      {footerNotes.map((note, i) => (
        <li class="flex items-center gap-[12px]">
          {i > 0 && <span class="w-[3px] h-[3px] rounded-full bg-border-strong shrink-0" aria-hidden="true"></span>}
          <span>{note}</span>
        </li>
      ))}
    </ul>
  )}
</form>

