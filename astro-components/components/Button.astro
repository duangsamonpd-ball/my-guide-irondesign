---
interface Props {
  variant?: 'primary' | 'secondary' | 'tertiary' | 'outline' | 'ondark' | 'ghost';
  size?: 'lg' | 'md' | 'sm';
  disabled?: boolean;
  type?: 'button' | 'submit' | 'reset';
  href?: string;
  class?: string;
}

const {
  variant = 'primary',
  size = 'md',
  disabled = false,
  type = 'button',
  href,
  class: className,
} = Astro.props;

const Tag = href ? 'a' : 'button';
---

<Tag
  class:list={['btn', `btn--${size}`, `btn--${variant}`, className]}
  href={href}
  type={href ? undefined : type}
  disabled={href ? undefined : disabled}
  aria-disabled={href && disabled ? 'true' : undefined}
>
  <slot />
</Tag>

<style>
  .btn {
    cursor: pointer; display: inline-flex; align-items: center; justify-content: center;
    font-family: 'Montserrat', sans-serif; border: var(--border-width-2) solid transparent; outline: none;
    border-radius: var(--rounded-cta); white-space: nowrap; text-decoration: none;
    transition: background var(--duration-fast), color var(--duration-fast), border-color var(--duration-fast), box-shadow var(--duration-fast);
  }
  /* sizes — padding and gap are per-size in Figma, so neither belongs on .btn */
  .btn--lg { height: var(--size-btn-lg); padding: 0 var(--spacing-2xl); gap: var(--spacing-sm); font-size: var(--font-size-btn-lg); font-weight: var(--fw-btn-lg); letter-spacing: 0; }
  .btn--md { height: var(--size-btn-md); padding: 0 var(--spacing-xl); gap: var(--spacing-xs); font-size: var(--font-size-btn); font-weight: var(--fw-btn); letter-spacing: 0; }
  .btn--sm { height: var(--size-btn-sm); padding: 0 var(--spacing-md); gap: var(--spacing-micro); font-size: var(--font-size-btn-sm); font-weight: var(--fw-btn); letter-spacing: 0.4px; }
  /* variants — solid */
  .btn--primary   { background: var(--color-primary); color: var(--color-primary-on); }
  .btn--primary:hover   { background: var(--color-primary-hover); }
  .btn--secondary { background: var(--color-secondary); color: var(--color-primary-on); }
  .btn--secondary:hover { background: var(--color-secondary-hover); }
  .btn--tertiary  { background: var(--color-button-tertiary); color: var(--color-primary-on); }
  .btn--tertiary:hover  { background: var(--color-primary); }   /* black → pink */
  /* variants — outline / ghost (blue text → pink on hover) */
  .btn--outline   { background: var(--color-bg-base); color: var(--color-on-tertiary); border-color: var(--color-border); }
  .btn--outline:hover   { background: var(--color-button-outline-hover); border-color: var(--color-border-strong); color: var(--color-on-tertiary-hover); }
  /* ondark sits on a dark surface: white label, translucent white border.
     It read as blue-on-dark before, which only scraped AA on the slate-800
     surface the docs demo uses and had no headroom on anything lighter.
     White is what Figma specifies, and it more than triples the contrast. */
  .btn--ondark    { background: var(--ondark-tint); color: var(--color-primary-on); border-color: var(--ondark-border); backdrop-filter: blur(var(--blur-xs)); }
  .btn--ondark:hover    { color: var(--color-on-tertiary-hover); border-color: var(--ondark-border-hover); }
  .btn--ghost     { background: transparent; color: var(--color-on-tertiary); }
  .btn--ghost:hover     { background: var(--ghost-hover); color: var(--color-on-tertiary-hover); }
  /* focus rings */
  .btn--primary:focus-visible   { box-shadow: var(--shadow-focus-magenta); }
  .btn--secondary:focus-visible { box-shadow: var(--focus-ring-blue); }
  .btn--tertiary:focus-visible  { box-shadow: var(--focus-ring-white); }
  .btn--outline:focus-visible   { box-shadow: var(--focus-ring-blue); }
  /* The border override this used to carry was compensating for a wrong default;
     the default border is now already transparent/white/30. Figma draws no ring
     on ondark focus — the ring is kept deliberately, for a visible focus state. */
  .btn--ondark:focus-visible    { box-shadow: var(--focus-ring-blue); }
  .btn--ghost:focus-visible     { border-color: var(--color-border-focused); }
  .btn[disabled], .btn[aria-disabled="true"] { opacity: .5; cursor: not-allowed; pointer-events: none; }
</style>
