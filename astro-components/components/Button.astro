---
interface Props {
  variant?: 'primary' | 'secondary' | 'tertiary' | 'outline' | 'ondark' | 'ghost';
  size?: 'lg' | 'md' | 'sm';
  /**
   * Let a long label wrap instead of leaving the box. Off by default: a button
   * is normally short and one line reads better. Turn it on where the label is
   * long and the container is narrow — the Footer band is the case that found
   * this, where "Get Full 10 products Suite" needs 309.5px against 248px of
   * room at a 320 viewport and was being cut, silently, by an ancestor's
   * `overflow: hidden`.
   *
   * This has to be a prop rather than a class passed in. `whitespace-nowrap`
   * below and a `whitespace-normal` on the call site are both one class deep,
   * so the winner is decided by their order in the compiled stylesheet, not by
   * the order they are written — and Tailwind emits `normal` at 1111 and
   * `nowrap` at 1114, so the override loses. `[white-space:normal]` lands in
   * the same place and loses identically.
   */
  wrap?: boolean;
  disabled?: boolean;
  type?: 'button' | 'submit' | 'reset';
  href?: string;
  class?: string;
}

const {
  variant = 'primary',
  size = 'md',
  wrap = false,
  disabled = false,
  type = 'button',
  href,
  class: className,
} = Astro.props;

/**
 * Sizes: padding and gap are per-size in Figma, so neither belongs on the base.
 * `--size-btn-*` and `--fw-btn*` are real tokens but neither `size` nor `fw` is a
 * Tailwind namespace, so they can only be reached as arbitrary values — the
 * weight through arbitrary-property syntax, because `font-[…]` is ambiguous
 * between family and weight.
 */
const SIZE = {
  lg: 'px-2xl gap-sm text-btn-lg font-btn-lg leading-btn-lg tracking-[0]',
  md: 'px-xl gap-xs text-btn font-btn leading-btn tracking-[0]',
  sm: 'px-md gap-micro text-btn-sm font-btn leading-btn-sm tracking-[0.4px]',
} as const;

/**
 * Height is separate from the rest of the size because `wrap` has to change it.
 * A fixed height with a label allowed to wrap trades a horizontal clip for a
 * vertical one, which is worse — it is the same `overflow: hidden` doing the
 * cutting either way. Wrapping keeps the same number as a FLOOR and lets the
 * pill grow past it, so a two-line label still measures 56px at `lg` (the two
 * lines are 39px, well inside it) and nothing moves until a third line needs
 * room that a fixed height would simply have eaten.
 */
const HEIGHT = {
  lg: 'h-[var(--size-btn-lg)]',
  md: 'h-[var(--size-btn-md)]',
  sm: 'h-[var(--size-btn-sm)]',
} as const;

const WRAP_HEIGHT = {
  lg: 'min-h-[var(--size-btn-lg)] py-sm',
  md: 'min-h-[var(--size-btn-md)] py-xs',
  sm: 'min-h-[var(--size-btn-sm)] py-micro',
} as const;

/**
 * Every variant is fill + label + border + hover + focus ring, written out per
 * variant. The <style> version could derive nothing here either — each row was
 * already its own rule — so this is the same table with the same six entries.
 *
 * Fills come from the `button/*` token family, which is what Figma binds on this
 * set — `button/primary`, `button/secondary`, `button/tertiary`, `button/outline`
 * and their hovers. The repo had imported all six and the table only used three,
 * reaching for --color-primary and --color-secondary for the rest, so the same
 * table disagreed with itself. Every one is an alias of the brand colour today,
 * so nothing moves; what it buys is that a button fill can change without
 * dragging the brand — and --color-secondary alone is worn by Checkbox, Radio,
 * Select, Tooltip, FormCard, TrialKeyCard and FileUpload. Ball's ruling
 * 2026-08-10, the same split-by-role call as Badge's solid `info` that day.
 *
 * `outline` moved onto `button/outline` too, on Ball's ruling 2026-08-11, and it
 * is the one row here that changes anything: --color-bg-base and
 * --color-button-outline are both #FFFFFF in light but `.dark` remaps them to
 * #391C39 and #260F27, so the outline button is repainted in dark mode only.
 * That is the intended reading rather than a side effect — the dark violet ramp
 * is an elevation scale (/800 card, /900 page, /950 recessed), and
 * `--color-button-dark-outline` was already defined as /950 WITH its own hover
 * at /900 and used by nobody. On the page colour that hover could not have read
 * at all, since the button would have started at the page colour. It also lifts
 * the label from 4.62:1 to 5.48:1, which matters more once the dark border is
 * corrected to Figma's own value and stops carrying the affordance alone.
 *
 * ondark sits on a dark surface: white label, translucent white border. It read
 * as blue-on-dark before, which only scraped AA on the slate-800 surface the
 * docs demo uses and had no headroom on anything lighter. White is what Figma
 * specifies, and it more than triples the contrast.
 */
const VARIANT = {
  primary:
    'bg-button-primary text-primary-on border-transparent hover:bg-button-primary-hover focus-visible:shadow-focus-magenta',
  secondary:
    'bg-button-secondary text-primary-on border-transparent hover:bg-button-secondary-hover focus-visible:shadow-[var(--focus-ring-blue)]',
  /* black → pink */
  tertiary:
    'bg-button-tertiary text-primary-on border-transparent hover:bg-button-primary focus-visible:shadow-[var(--focus-ring-white)]',
  outline:
    'bg-button-outline text-on-tertiary border-border hover:bg-button-outline-hover hover:border-border-strong ' +
    'hover:text-on-tertiary-hover focus-visible:shadow-[var(--focus-ring-blue)]',
  /* The border override this used to carry was compensating for a wrong default;
     the default border is transparent already. Figma draws no ring on ondark
     focus — the ring is kept deliberately, for a visible focus state. */
  ondark:
    'bg-[var(--ondark-tint)] text-primary-on border-[var(--ondark-border)] backdrop-blur-xs ' +
    'hover:text-on-tertiary-hover hover:border-[var(--ondark-border-hover)] ' +
    'focus-visible:shadow-[var(--focus-ring-blue)]',
  ghost:
    'bg-transparent text-on-tertiary border-transparent hover:bg-[var(--ghost-hover)] hover:text-on-tertiary-hover ' +
    'focus-visible:border-border-focused',
} as const;

const BASE =
  'cursor-pointer inline-flex items-center justify-center font-sans no-underline ' +
  'border-[length:var(--border-width-2)] border-solid outline-none rounded-cta ' +
  'transition-[background-color,color,border-color,box-shadow] duration-[var(--duration-fast)] ' +
  /* `[disabled]` and `[aria-disabled="true"]` were one rule; as variants they
     are two, because a class list has no way to say "or". */
  'disabled:opacity-50 disabled:cursor-not-allowed disabled:pointer-events-none ' +
  'aria-disabled:opacity-50 aria-disabled:cursor-not-allowed aria-disabled:pointer-events-none';

const Tag = href ? 'a' : 'button';
---

<Tag
  class:list={[
    BASE,
    wrap ? 'whitespace-normal text-center' : 'whitespace-nowrap',
    wrap ? WRAP_HEIGHT[size] : HEIGHT[size],
    SIZE[size],
    VARIANT[variant],
    className,
  ]}
  href={href}
  type={href ? undefined : type}
  disabled={href ? undefined : disabled}
  aria-disabled={href && disabled ? 'true' : undefined}
>
  <slot />
</Tag>

