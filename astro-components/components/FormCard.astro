---
/**
 * ── Its design reference is 2787:10701 (Ball, 2026-11-02) ─────────────────
 *
 * There is still no FormCard component in Figma. The one form card drawn in the
 * file is suite-upgrade's "Activate your Iron Suite Upgrade" (2787:10701,
 * 440 x 385), and Ball ruled that FormCard follows it. It differed in seven places.
 * Two were asked for (an optional icon; a shadow instead of the border). Five
 * were not, and without them no page could swap to this card without leaving
 * its frame:
 *   - width 440, was 540;
 *   - subtitle 14 MEDIUM on a 21px line, 8 under the title, was caption 14/20
 *     regular 4 under. No type role carries 21, so it is written here;
 *   - 16 between fields, was 20;
 *   - the submit is the DS Button, primary md: 48 tall, 14/600, no arrow. It was
 *     hand-drawn here at 56, 16/700, with a → of its own, so it followed Button
 *     only by luck.
 * Padding 32 and the 24 between the three blocks already matched.
 *
 * ── Why it declares no `figma-size` band ──────────────────────────────────
 *
 * The frame is a PAGE's card, not a component node: its height is whatever its
 * fields make it, and the fields inside are covered (Input, Select and Textarea
 * each declare their 96/72/150).
 */
// quote / key / check are shared with the other card components — see ../icons.
import { icons } from '../icons';
import Button from './Button.astro';

interface Props {
  /** The icon in the tinted square beside the title. Leave it off for a title on its own, as 2787:10701 draws it. */
  icon?: 'quote' | 'key' | 'check';
  /**
   * `bordered` is a 1px border for a card on the page's own surface; `elevated` drops the border for the `shadow/modal` shadow, for a card that floats over a hero or an image.
   * @figma 2787:10701 is `elevated` — no stroke, `shadow/modal`
   */
  variant?: 'bordered' | 'elevated';
  /** The card's heading; it also names the form for assistive tech. */
  title: string;
  /** A short line under the title. */
  subtitle?: string;
  /** The text on the full-width submit button. */
  submitLabel: string;
  /** Small print under the button, such as "No obligation to proceed". */
  noteLeft?: string;
  /** A second note beside the first, with a dot between them when both are set. */
  noteRight?: string;
  /**
   * Heading level for the card title. It used to be a hard-coded `h3`, which
   * broke the page outline wherever the card did not happen to sit under an h2.
   * Default stays 3 so nothing that already uses this card moves.
   */
  headingLevel?: 2 | 3 | 4 | 5;
  /** Where the form posts. Omitted means the current URL, which is what a form with no action does. */
  action?: string;
  /** How the form sends — omitted means the browser's default, `get`. */
  method?: 'get' | 'post';
  /** The form's id, for a script that finds it or a button outside it (`form="…"`). */
  id?: string;
  /** Extra classes on the `<form>`, after the component's own. */
  class?: string;
}

const {
  icon,
  variant = 'bordered',
  title,
  subtitle,
  submitLabel,
  noteLeft,
  noteRight,
  headingLevel = 3,
  action,
  method,
  id,
  class: className,
} = Astro.props;

const Heading = `h${headingLevel}` as 'h2' | 'h3' | 'h4' | 'h5';
/* The form takes its accessible name from its own title, so a screen reader's
   forms list says "Request a quote" rather than "form".
   base-16, 8 digits: that is the shape build-demos.mjs normalises to a stable
   `fc-demo-1`. A base-36 id would carry letters past `f`, slip past the
   normaliser and make check:render fail on a different id every run. */
const titleId = `fc-${Math.random().toString(16).slice(2, 10)}`;
---

<form
  class:list={[
    'bg-bg-base rounded-2xl p-[32px] flex flex-col gap-[24px] max-w-[440px]',
    variant === 'elevated' ? 'shadow-[var(--shadow-modal)]' : 'border border-border',
    className,
  ]}
  id={id}
  action={action}
  method={method}
  aria-labelledby={titleId}
>
  <div class="flex items-center gap-[16px]">
    {icon && (
      <span
        class="size-[64px] shrink-0 rounded-lg flex items-center justify-center text-secondary
               bg-[color-mix(in_srgb,var(--color-secondary)_6%,transparent)]
               border border-[color-mix(in_srgb,var(--color-secondary)_10%,transparent)]"
      >
        <svg class="size-[26px]" viewBox={icons[icon].viewBox} fill="currentColor" aria-hidden="true"><path d={icons[icon].path} /></svg>
      </span>
    )}
    <div class="flex flex-1 flex-col gap-[8px]">
      <Heading class="font-sans text-h4 font-h4 leading-h4 tracking-h4 text-text-heading m-0" id={titleId}>{title}</Heading>
      {subtitle && <p class="font-sans text-sm font-medium leading-[21px] text-text-support m-0">{subtitle}</p>}
    </div>
  </div>
  <div class="flex flex-col gap-[16px]">
    <slot />
  </div>
  <div class="flex flex-col gap-[12px]">
    <Button type="submit" variant="primary" size="md" class="w-full">{submitLabel}</Button>
    {(noteLeft || noteRight) && (
      <ul class="flex items-center justify-center gap-[12px] text-caption-sm font-caption-sm leading-caption-sm tracking-caption-sm text-text-support list-none m-0 p-0">
        {noteLeft && <li class="flex items-center gap-[12px]"><span>{noteLeft}</span></li>}
        {noteRight && (
          <li class="flex items-center gap-[12px]">
            {noteLeft && <span class="w-[3px] h-[3px] rounded-full bg-border-strong shrink-0" aria-hidden="true"></span>}
            <span>{noteRight}</span>
          </li>
        )}
      </ul>
    )}
  </div>
</form>
