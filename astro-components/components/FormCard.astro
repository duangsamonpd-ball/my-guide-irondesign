---
// quote / key / check are shared with the other card components — see ../icons.
import { icons } from '../icons';

interface Props {
  icon: 'quote' | 'key' | 'check';
  title: string;
  subtitle?: string;
  submitLabel: string;
  noteLeft?: string;
  noteRight?: string;
  /**
   * Heading level for the card title. It used to be a hard-coded `h3`, which
   * broke the page outline wherever the card did not happen to sit under an h2.
   * Default stays 3 so nothing that already uses this card moves.
   */
  headingLevel?: 2 | 3 | 4 | 5;
  /** Where the form posts. Omitted means the current URL, which is what a form with no action does. */
  action?: string;
  method?: 'get' | 'post';
  class?: string;
}

const {
  icon,
  title,
  subtitle,
  submitLabel,
  noteLeft,
  noteRight,
  headingLevel = 3,
  action,
  method,
  class: className,
} = Astro.props;

const Heading = `h${headingLevel}` as 'h2' | 'h3' | 'h4' | 'h5';
/* The form takes its accessible name from its own title, so a screen reader's
   forms list says "Request a quote" rather than "form".
   base-16, 8 digits: that is the shape build-demos.mjs normalises to a stable
   `fc-demo-1`. A base-36 id would carry letters past `f`, slip past the
   normaliser and make check:render fail on a different id every run. */
const titleId = `fc-${Math.random().toString(16).slice(2, 10)}`;
---

<form
  class:list={[
    'bg-bg-base border border-border rounded-2xl p-[32px] flex flex-col gap-[24px] max-w-[540px]',
    className,
  ]}
  action={action}
  method={method}
  aria-labelledby={titleId}
>
  <div class="flex items-center gap-[16px]">
    <span
      class="size-[64px] shrink-0 rounded-lg flex items-center justify-center text-secondary
             bg-[color-mix(in_srgb,var(--color-secondary)_6%,transparent)]
             border border-[color-mix(in_srgb,var(--color-secondary)_10%,transparent)]"
    >
      <svg class="size-[26px]" viewBox={icons[icon].viewBox} fill="currentColor" aria-hidden="true"><path d={icons[icon].path} /></svg>
    </span>
    <div>
      <Heading class="font-sans text-h4 font-h4 leading-h4 text-text-heading m-0" id={titleId}>{title}</Heading>
      {subtitle && <p class="font-sans text-caption leading-caption text-text-support mt-[4px] mb-0 mx-0">{subtitle}</p>}
    </div>
  </div>
  {/*
    `.fc-fields :global(.field) { max-width: none }` reached into slotted markup
    to unpin the 340px cap Input and Textarea set on themselves. A class list
    cannot reach into a slot, and after the conversion there is no `.field`
    class left to aim at either — so the same override is written as an
    arbitrary variant on the direct children, which is what that selector meant.
  */}
  <div class="flex flex-col gap-[20px] [&>*]:max-w-none">
    <slot />
  </div>
  <div class="flex flex-col gap-[12px]">
    <button
      type="submit"
      class="group w-full h-[var(--size-btn-lg)] border-0 rounded-full bg-primary text-primary-on
             font-sans text-btn-lg font-btn-lg leading-btn-lg cursor-pointer inline-flex items-center justify-center gap-[8px]
             transition-[background-color] duration-[var(--duration-fast)] hover:bg-primary-hover"
    >
      {submitLabel}
      {/* An icon, not a "→". This is the component the trap was FOUND on: the
          character has no Montserrat glyph, so it falls through --font-sans and
          its box goes 16.00px to 14.78px. Fixed everywhere else first; this was
          the last one still carrying it. 16px is the em box the character had
          at --font-size-btn-lg, so the button's width does not move. */}
      <svg class="size-[16px] shrink-0 transition-transform duration-[var(--duration-base)] group-hover:translate-x-[3px]" viewBox={icons.arrowRight.viewBox} fill="currentColor" aria-hidden="true"><path d={icons.arrowRight.path} /></svg>
    </button>
    {(noteLeft || noteRight) && (
      <ul class="flex items-center justify-center gap-[12px] text-caption-sm font-caption-sm leading-caption-sm text-text-support list-none m-0 p-0">
        {noteLeft && <li class="flex items-center gap-[12px]"><span>{noteLeft}</span></li>}
        {noteRight && (
          <li class="flex items-center gap-[12px]">
            {noteLeft && <span class="w-[3px] h-[3px] rounded-full bg-border-strong shrink-0" aria-hidden="true"></span>}
            <span>{noteRight}</span>
          </li>
        )}
      </ul>
    )}
  </div>
</form>

