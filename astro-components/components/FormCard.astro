---
// quote / key / check are shared with the other card components — see ../icons.
import { icons } from '../icons';

interface Props {
  icon: 'quote' | 'key' | 'check';
  title: string;
  subtitle?: string;
  submitLabel: string;
  noteLeft?: string;
  noteRight?: string;
  /**
   * Heading level for the card title. It used to be a hard-coded `h3`, which
   * broke the page outline wherever the card did not happen to sit under an h2.
   * Default stays 3 so nothing that already uses this card moves.
   */
  headingLevel?: 2 | 3 | 4 | 5;
  /** Where the form posts. Omitted means the current URL, which is what a form with no action does. */
  action?: string;
  method?: 'get' | 'post';
  class?: string;
}

const {
  icon,
  title,
  subtitle,
  submitLabel,
  noteLeft,
  noteRight,
  headingLevel = 3,
  action,
  method,
  class: className,
} = Astro.props;

const Heading = `h${headingLevel}` as 'h2' | 'h3' | 'h4' | 'h5';
/* The form takes its accessible name from its own title, so a screen reader's
   forms list says "Request a quote" rather than "form".
   base-16, 8 digits: that is the shape build-demos.mjs normalises to a stable
   `fc-demo-1`. A base-36 id would carry letters past `f`, slip past the
   normaliser and make check:render fail on a different id every run. */
const titleId = `fc-${Math.random().toString(16).slice(2, 10)}`;
---

<form class:list={['form-card', className]} action={action} method={method} aria-labelledby={titleId}>
  <div class="fc-title">
    <span class="fc-icon"><svg viewBox={icons[icon].viewBox} fill="currentColor" aria-hidden="true"><path d={icons[icon].path} /></svg></span>
    <div class="fc-heading">
      <Heading class="fc-h" id={titleId}>{title}</Heading>
      {subtitle && <p>{subtitle}</p>}
    </div>
  </div>
  <div class="fc-fields">
    <slot />
  </div>
  <div class="fc-last">
    <button type="submit" class="fc-submit">{submitLabel} <span class="arr">→</span></button>
    {(noteLeft || noteRight) && (
      <ul class="fc-notes">
        {noteLeft && <li><span>{noteLeft}</span></li>}
        {noteRight && (
          <li>
            {noteLeft && <span class="fc-sep" aria-hidden="true"></span>}
            <span>{noteRight}</span>
          </li>
        )}
      </ul>
    )}
  </div>
</form>

<style>
  .form-card {
    background: var(--color-bg-base); border: var(--border-width-1) solid var(--color-border); border-radius: var(--rounded-2xl);
    padding: 32px; display: flex; flex-direction: column; gap: 24px; max-width: 540px;
  }
  .fc-title { display: flex; align-items: center; gap: 16px; }
  .fc-icon {
    width: 64px; height: 64px; flex-shrink: 0; border-radius: var(--rounded-lg);
    background: color-mix(in srgb, var(--color-secondary) 6%, transparent); border: var(--border-width-1) solid color-mix(in srgb, var(--color-secondary) 10%, transparent);
    display: flex; align-items: center; justify-content: center; color: var(--color-secondary);
  }
  .fc-icon svg { width: 26px; height: 26px; }
  /* Selected by class, not by `h3` — the level is a prop now, so the tag is not
     knowable from the stylesheet. */
  .fc-heading .fc-h { font-family: 'Montserrat', sans-serif; font-size: var(--font-size-h4); font-weight: 700; color: var(--color-text-heading); margin: 0; }
  .fc-heading p { font-family: 'Montserrat', sans-serif; font-size: var(--font-size-caption); color: var(--color-text-support); margin: 4px 0 0; }
  .fc-fields { display: flex; flex-direction: column; gap: 20px; }
  .fc-fields :global(.field) { max-width: none; }
  .fc-last { display: flex; flex-direction: column; gap: 12px; }
  .fc-submit {
    width: 100%; height: var(--size-btn-lg); border: none; border-radius: var(--rounded-cta);
    background: var(--color-primary); color: var(--color-primary-on); font-family: 'Montserrat', sans-serif;
    font-size: var(--font-size-btn-lg); font-weight: var(--fw-btn-lg); cursor: pointer;
    display: inline-flex; align-items: center; justify-content: center; gap: 8px;
    transition: background var(--duration-fast);
  }
  .fc-submit:hover { background: var(--color-primary-hover); }
  .fc-submit .arr { transition: transform var(--duration-base); }
  .fc-submit:hover .arr { transform: translateX(3px); }
  /* A list, with the separator inside the item it precedes — see TrialKeyCard. */
  .fc-notes { display: flex; align-items: center; justify-content: center; gap: 12px; font-size: var(--font-size-caption-sm); color: var(--color-text-support); list-style: none; margin: 0; padding: 0; }
  .fc-notes li { display: flex; align-items: center; gap: 12px; }
  .fc-sep { width: 3px; height: 3px; border-radius: 50%; background: var(--color-border-strong); flex-shrink: 0; }
</style>
