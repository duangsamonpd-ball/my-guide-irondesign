---
/**
 * Badge — from Figma node `779:3486`, styled by Tailwind utilities rather than a
 * scoped <style>. It was the first component converted, and this header said
 * "POC, branch `poc/badge-tailwind` only, not for merge" until 2026-08-10 —
 * three months after `ba85523` landed the conversion on main. It is the shipped
 * Badge: `check:parity` counts it among the utility-styled components, and the
 * package exports it. The notes at the bottom are what the conversion cost, kept
 * because they are still true, not because this is still a trial.
 *
 * `intent` matches Figma outright — the Figma property was `status` until Ball
 * renamed it.
 */

interface Props {
  intent?: 'success' | 'warning' | 'danger' | 'info' | 'important' | 'neutral';
  /**
   * Figma `779:3486` ships `variant=subtle|solid`; this took a `solid` boolean
   * until 2026-08-11. Eight components in this library express their variant
   * axis as an enum named `variant` and Badge was the only one spelling one as
   * a boolean — the same reasoning that turned `small` into `size` below.
   */
  variant?: 'subtle' | 'solid';
  /** Figma `779:3486` ships `size=sm|md`; this took a `small` boolean until 2026-08-06. */
  size?: 'sm' | 'md';
  pill?: boolean;
  dot?: boolean;
  class?: string;
}

const {
  intent = 'neutral',
  variant = 'subtle',
  size = 'md',
  pill = false,
  dot = false,
  class: className,
} = Astro.props;

/**
 * Every intent/variant pair has to exist as a LITERAL string here.
 * Tailwind scans source as plain text — it never evaluates it — so the
 * `.badge--${intent}` pattern the CSS version used has no equivalent:
 * `bg-${intent}-subtle` is scanned as that exact text and no rule is emitted.
 * Six intents x two fills = twelve strings that must be written out and kept in
 * step by hand. The CSS version needed one rule per intent and derived the rest.
 */
const SUBTLE = {
  success: 'bg-success-subtle text-success-strong',
  warning: 'bg-warning-subtle text-warning-strong',
  danger: 'bg-danger-subtle text-danger-strong',
  info: 'bg-info-subtle text-info-strong',
  important: 'bg-important-subtle text-important-strong',
  neutral: 'bg-neutral-subtle text-neutral-strong',
} as const;

/**
 * Solid label colour is per INTENT, not per theme — `.dark` remaps only the
 * -subtle/-strong pairs, so a solid badge is identical in both modes and one
 * label colour cannot serve all six. success/warning/info have light fills and
 * take `text/on-light`; white on them is 2.17 / 1.99 / 3.25 and fails AA.
 * danger/important/neutral have dark fills and take `text/on-dark`.
 *
 * These used to be badge-specific tokens (`badge-solid` / `-inverse`). They are
 * not badge-specific at all — the same choice applies to any fixed-lightness
 * surface — so they are the system-wide on-dark/on-light pair now, and
 * check:contrast still derives all twelve pairings from this map.
 *
 * `info` fills with --color-info, not --color-secondary. Both are
 * --iron-blue-500 and neither is remapped by `.dark`, so this moves no pixel in
 * either mode — but Figma binds `status/info` here, and a badge's fill is a
 * status, not the brand's secondary. Ball's ruling 2026-08-10, the same
 * split-by-role call he made for Tooltip's link the same day.
 */
const SOLID = {
  success: 'bg-success text-text-on-light-heading',
  warning: 'bg-warning text-text-on-light-heading',
  danger: 'bg-danger text-text-on-dark-heading',
  info: 'bg-info text-text-on-light-heading',
  important: 'bg-important text-text-on-dark-heading',
  neutral: 'bg-neutral text-text-on-dark-heading',
} as const;

const base = 'inline-flex items-center gap-micro font-sans font-bold whitespace-nowrap px-xs py-micro';

/* --fw-badge and --line-height-badge have NO semantic counterpart in @theme:
   build-theme.mjs maps --font-size-* → --text-* and --letter-spacing-* →
   --tracking-*, but a weight or a line-height only survives as a SCALE step.
   So `font-bold` and `leading-4` are the raw scale, and the fact that they are
   the badge's values is no longer expressed anywhere. */
const type = size === 'sm'
  ? 'text-badge-sm leading-3 tracking-badge-sm'
  : 'text-badge leading-4 tracking-badge';

/* Figma node 776-899 uses --rounded-sm on every badge, not a pill; `pill` opts
   back into the old default. */
const shape = pill ? 'rounded-full' : 'rounded-sm';

/* The dot is 6px / 4px. This theme defines only NAMED --spacing-* (micro, xs,
   sm…) and no `--spacing` base — but Tailwind's own default theme still supplies
   `--spacing: 0.25rem`, so the numeric scale survives and size-1.5 is exactly
   6px. Verified in the compiled output, not assumed. */
const dotSize = size === 'sm' ? 'size-1' : 'size-1.5';
---

<span class:list={[base, type, shape, variant === 'solid' ? SOLID[intent] : SUBTLE[intent], className]}>
  {dot && <span class:list={['rounded-full bg-current', dotSize]}></span>}
  <slot />
</span>

{/*
  WHAT THE CONVERSION COST

  It works, and dark mode still works — `bg-success-subtle` compiles to
  `background-color: var(--color-success-subtle)`, and `.dark` in tokens.css
  still remaps that variable, so re-theming survives the rewrite untouched.

  What it costs is in the four notes above:
   · twelve literal strings replace six derived rules
   · font-weight and line-height lose their semantic names
   · the component now only renders correctly if the CONSUMER runs Tailwind with
     a content glob that reaches into node_modules. Today they import one
     stylesheet and are done.

  Those three are the reason the other seven components still carry a scoped
  <style>: the trade is real, and it was taken deliberately for the eleven that
  are converted rather than assumed to be free.
*/}
