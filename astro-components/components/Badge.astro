---
interface Props {
  intent?: 'success' | 'warning' | 'danger' | 'info' | 'important' | 'neutral';
  solid?: boolean;
  small?: boolean;
  pill?: boolean;
  dot?: boolean;
  class?: string;
}

const {
  intent = 'neutral',
  solid = false,
  small = false,
  pill = false,
  dot = false,
  class: className,
} = Astro.props;
---

<span class:list={['badge', `badge--${intent}`, { solid, sm: small, pill }, className]}>
  {dot && <span class="bdot"></span>}
  <slot />
</span>

<style>
  /*
    Subtle fill = --color-{intent}-subtle, text = --color-{intent}-strong; solid uses the
    base --color-{intent}. Every value is a semantic token (from the Figma color_ui
    export), so for the SUBTLE variant dark mode is automatic: inside a `.dark` ancestor
    those tokens swap to the Dark Purple values (see the .dark block in tokens.css) and the
    badge re-themes with no per-component dark rule — verified against Figma node 776-899
    ("Badge"). The SOLID variant is the exception: .dark does not remap the status base
    colours, so its fill — and therefore its label colour — is identical in both modes.
    Default shape is --rounded-sm (Figma node 776-899 uses this on every badge, not a
    pill) — the old default was --rounded-full; `pill` now opts back into that shape.
  */
  .badge {
    display: inline-flex; align-items: center; gap: var(--spacing-micro);
    font-family: 'Montserrat', sans-serif; font-size: var(--font-size-badge); font-weight: var(--fw-badge);
    line-height: var(--line-height-badge); padding: var(--spacing-micro) var(--spacing-xs); border-radius: var(--rounded-sm); white-space: nowrap; letter-spacing: var(--letter-spacing-badge);
  }
  .badge .bdot { width: 6px; height: 6px; border-radius: var(--rounded-full); background: currentColor; }

  .badge--success   { background: var(--color-success-subtle); color: var(--color-success-strong); }
  .badge--warning   { background: var(--color-warning-subtle); color: var(--color-warning-strong); }
  .badge--danger    { background: var(--color-danger-subtle);  color: var(--color-danger-strong); }
  .badge--info      { background: var(--color-info-subtle);    color: var(--color-info-strong); }
  .badge--important { background: var(--color-important-subtle); color: var(--color-important-strong); }
  .badge--neutral   { background: var(--color-neutral-subtle);   color: var(--color-neutral-strong); }

  /*
    Solid label colour is chosen per INTENT, not per theme. The solid fills are the
    status base colours, and .dark remaps only the -subtle/-strong pairs — so a solid
    badge is the same colour in both modes and one label colour cannot serve all six.
    success / warning / info have light fills and take the inverse (neutral/900) label;
    white on them is 2.17 / 1.99 / 3.25 and fails AA at 12px/700.
  */
  .badge.solid { color: var(--color-text-on-color-badge-solid); }
  .badge.solid.badge--success   { background: var(--color-success);   color: var(--color-text-on-color-badge-solid-inverse); }
  .badge.solid.badge--warning   { background: var(--color-warning);   color: var(--color-text-on-color-badge-solid-inverse); }
  .badge.solid.badge--danger    { background: var(--color-danger); }
  .badge.solid.badge--info      { background: var(--color-secondary); color: var(--color-text-on-color-badge-solid-inverse); }
  .badge.solid.badge--important { background: var(--color-important); }
  .badge.solid.badge--neutral   { background: var(--color-neutral); }

  .badge.sm {
    font-size: var(--font-size-badge-sm); line-height: var(--line-height-badge-sm);
    padding: var(--spacing-micro) var(--spacing-xs);
  }
  .badge.sm .bdot { width: 4px; height: 4px; }
  .badge.pill { border-radius: var(--rounded-full); }
</style>
