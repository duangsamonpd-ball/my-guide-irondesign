---
import { fieldShell, fieldLabel, fieldRequiredMark, fieldControl, fieldBorder, fieldHint, fieldError, fieldId } from '../field';

interface Props {
  label?: string;
  id?: string;
  name?: string;
  placeholder?: string;
  value?: string;
  rows?: number;
  hint?: string;
  error?: boolean;
  errorMessage?: string;
  disabled?: boolean;
  required?: boolean;
  class?: string;
}

const {
  label,
  id,
  name,
  placeholder,
  value,
  rows = 3,
  hint,
  error = false,
  errorMessage,
  disabled = false,
  required = false,
  class: className,
} = Astro.props;

const textareaId = fieldId(id, name, 'textarea');
---

<div class:list={[fieldShell, className]}>
  {label && (
    <label class={fieldLabel} for={textareaId}>
      {label}{required && <span class={fieldRequiredMark}> *</span>}
    </label>
  )}
  {/* The box and the resize affordance are the whole of what makes this a
      Textarea rather than an Input; everything else it wears is shared. */}
  <textarea
    id={textareaId}
    name={name}
    rows={rows}
    class:list={['min-h-[86px] p-sm resize-y disabled:resize-none', fieldControl, fieldBorder(error)]}
    placeholder={placeholder}
    disabled={disabled}
    required={required}
  >{value}</textarea>
  {error && errorMessage ? (
    <span class={fieldError}>{errorMessage}</span>
  ) : hint ? (
    <span class={fieldHint}>{hint}</span>
  ) : null}
</div>
