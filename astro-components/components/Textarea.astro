---
/**
 * ── The band this component declares, and what draws it ───────────────────
 *
 * All six states of `914:2485` are 280x150, and this is the component where
 * that number had the least to stand on: Textarea has no reconciliation of its
 * own — its values came from Input's ruling — and its control is a DESIGNED
 * 98px over a `min-height: 86`, which `rows` cannot produce. A designed height
 * that no gate holds is a number waiting to be tidied into `rows={3}` by
 * someone reading the markup and not the canvas. 20 + 8 + 98 + 8 + 16 = 150.
 *
 * @figma-size field
 *   node   914:2486
 *   frame  Textarea component
 *   page   component-textarea.html
 *   region preview
 *   select div.max-w-\[340px\]
 *   at     1440
 *   height 150
 *   why    20 + 8 + the designed 98 + 8 + 16; the 98 cannot come from rows
 */
import { fieldShell, fieldLabel, fieldRequiredMark, fieldControl, fieldBorder, fieldHint, fieldError, fieldId } from '../field';

interface Props {
  label?: string;
  id?: string;
  name?: string;
  placeholder?: string;
  value?: string;
  /** Height in text rows. **Omit it** and the box is Figma's own 98px — a
   *  designed number, not three lines of 28 plus padding, which is what `rows`
   *  would give. Passing `rows` hands the height back to the browser. */
  rows?: number;
  hint?: string;
  error?: boolean;
  errorMessage?: string;
  disabled?: boolean;
  required?: boolean;
  class?: string;
}

const {
  label,
  id,
  name,
  placeholder,
  value,
  rows,
  hint,
  error = false,
  errorMessage,
  disabled = false,
  required = false,
  class: className,
} = Astro.props;

const textareaId = fieldId(id, name, 'textarea');

/* Figma fixes the box at 98px (`914:2488` and every sibling state) over a
   `min-height` of 86. `rows` cannot express 98: three rows of `leading/7` plus
   the 8px padding and the border is 102. So the design's height is the default
   and `rows` is the opt-out — set it and the browser sizes the box instead.
   Ball's ruling 2026-08-11. */
const sizing = rows === undefined ? 'h-[98px]' : '';
---

<div class:list={[fieldShell, className]}>
  {label && (
    <label class={fieldLabel} for={textareaId}>
      {label}{required && <span class={fieldRequiredMark}> *</span>}
    </label>
  )}
  {/* The box and the resize affordance are the whole of what makes this a
      Textarea rather than an Input; everything else it wears is shared.

      Padding is NOT uniform. Figma's own node — `914:2485`, this component's
      first, after it had taken Select's numbers and then Input's by ruling —
      binds `spacing-sm` across and `spacing-xs` down on every state (`914:2488`
      and siblings). `p-sm` had it 12 all round, so top and bottom carried 4px
      too much. */}
  <textarea
    id={textareaId}
    name={name}
    rows={rows}
    class:list={['min-h-[86px] px-sm py-xs resize-y disabled:resize-none', sizing, fieldControl, fieldBorder(error)]}
    placeholder={placeholder}
    disabled={disabled}
    required={required}
  >{value}</textarea>
  {error && errorMessage ? (
    <span class={fieldError}>{errorMessage}</span>
  ) : hint ? (
    <span class={fieldHint}>{hint}</span>
  ) : null}
</div>
