---
import { fieldShell, fieldLabel, fieldRequiredMark, fieldControl, fieldBorder, fieldHint, fieldError, fieldId } from '../field';

interface Props {
  label?: string;
  id?: string;
  name?: string;
  type?: string;
  placeholder?: string;
  value?: string;
  hint?: string;
  error?: boolean;
  errorMessage?: string;
  disabled?: boolean;
  required?: boolean;
  class?: string;
}

const {
  label,
  id,
  name,
  type = 'text',
  placeholder,
  value,
  hint,
  error = false,
  errorMessage,
  disabled = false,
  required = false,
  class: className,
} = Astro.props;

const inputId = fieldId(id, name, 'input');
---

<div class:list={[fieldShell, className]}>
  {label && (
    <label class={fieldLabel} for={inputId}>
      {label}{required && <span class={fieldRequiredMark}> *</span>}
    </label>
  )}
  <div class="relative flex items-center">
    <input
      id={inputId}
      name={name}
      type={type}
      {/* The 44px row and its inline padding are the whole of what makes this an
          Input rather than a Textarea; everything else it wears is shared. */}
      class:list={['h-[var(--size-input)] px-sm', fieldControl, fieldBorder(error)]}
      placeholder={placeholder}
      value={value}
      disabled={disabled}
      required={required}
    />
  </div>
  {error && errorMessage ? (
    <span class={fieldError}>{errorMessage}</span>
  ) : hint ? (
    <span class={fieldHint}>{hint}</span>
  ) : null}
</div>
