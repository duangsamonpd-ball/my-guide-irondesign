---
/**
 * ── The band this component declares, and what draws it ───────────────────
 *
 * `912:1819` draws all six states at 280x96, and the 96 is the WHOLE field —
 * label 20 + `gap-xs` 8 + the 44 control + 8 + a 16 hint. That sum is the claim
 * worth holding: the control's 44 is `--size-input`, a token `check:theme`
 * already keeps, but the two gaps and the hint's line are spent here and by
 * `Select` and `Textarea` too. All three agree on every value in that row as of
 * `b7f80ad`, and two of the three fixes that got them there were the set
 * disagreeing with ITSELF — which is what a shared shell is for and what
 * nothing was measuring.
 *
 * `preview` and not `states`: the node's 96 includes a label and the states
 * demo renders none, so those five would be a correct 76 against the wrong
 * question.
 *
 * @figma-size field
 *   node   912:1819
 *   frame  Input component
 *   page   component-input.html
 *   region preview
 *   select div.max-w-\[340px\]
 *   at     1440
 *   height 96
 *   why    20 + 8 + the --size-input 44 + 8 + a 16 hint, label and all
 */
import { fieldShell, fieldLabel, fieldRequiredMark, fieldControl, fieldBorder, fieldHint, fieldError, fieldId } from '../field';

interface Props {
  label?: string;
  id?: string;
  name?: string;
  // Named from the spec rather than copied into a hand-written union: this was
  // `string` until 2026-08-12, which `astro check` rejects at `type={type}`
  // because the attribute is `HTMLInputTypeAttribute`. A literal union here
  // would be a second list of the HTML input types for this repo to keep
  // current, which is the kind of restated fact nothing checks.
  /** Any input type the HTML spec defines. */
  type?: astroHTML.JSX.HTMLInputTypeAttribute;
  placeholder?: string;
  value?: string;
  hint?: string;
  error?: boolean;
  errorMessage?: string;
  disabled?: boolean;
  required?: boolean;
  class?: string;
}

const {
  label,
  id,
  name,
  type = 'text',
  placeholder,
  value,
  hint,
  error = false,
  errorMessage,
  disabled = false,
  required = false,
  class: className,
} = Astro.props;

const inputId = fieldId(id, name, 'input');
---

<div class:list={[fieldShell, className]}>
  {label && (
    <label class={fieldLabel} for={inputId}>
      {label}{required && <span class={fieldRequiredMark}> *</span>}
    </label>
  )}
  {/* The 44px row and its inline padding on the <input> below are the whole of
      what makes this an Input rather than a Textarea; everything else it wears
      is shared. This sat between two attributes until 2026-08-12, where Astro's
      compiler dropped it silently — nothing rendered wrong, but the TS parse
      died on it, so every line after it in this file went unchecked. A JSX
      comment is only a comment in CHILD position. */}
  <div class="relative flex items-center">
    <input
      id={inputId}
      name={name}
      type={type}
      class:list={['h-[var(--size-input)] px-sm', fieldControl, fieldBorder(error)]}
      placeholder={placeholder}
      value={value}
      disabled={disabled}
      required={required}
    />
  </div>
  {error && errorMessage ? (
    <span class={fieldError}>{errorMessage}</span>
  ) : hint ? (
    <span class={fieldHint}>{hint}</span>
  ) : null}
</div>
