---
interface Props {
  label?: string;
  id?: string;
  name?: string;
  type?: string;
  placeholder?: string;
  value?: string;
  hint?: string;
  error?: boolean;
  errorMessage?: string;
  disabled?: boolean;
  required?: boolean;
  class?: string;
}

const {
  label,
  id,
  name,
  type = 'text',
  placeholder,
  value,
  hint,
  error = false,
  errorMessage,
  disabled = false,
  required = false,
  class: className,
} = Astro.props;

const inputId = id ?? name ?? `input-${Math.random().toString(36).slice(2, 9)}`;
---

<div class:list={['flex flex-col gap-xs w-full max-w-[340px]', className]}>
  {label && (
    <label class="text-label font-medium text-text-body leading-5" for={inputId}>
      {label}{required && <span class="text-danger"> *</span>}
    </label>
  )}
  <div class="relative flex items-center">
    <input
      id={inputId}
      name={name}
      type={type}
      class:list={[
        'w-full h-[var(--size-input)] rounded-md px-sm font-sans text-body text-text-body',
        'bg-bg-base border outline-none',
        'transition-[border-color,box-shadow] duration-[var(--duration-fast)]',
        'placeholder:text-text-placeholder',
        'disabled:bg-bg-disabled disabled:text-text-disabled disabled:cursor-not-allowed',
        /* Same two branches as Textarea, and for the same reason: `.input.error`
           and `.input:hover` had equal specificity with error later in the file,
           so an errored field never took the hover border and its focus ring was
           the danger-coloured one. Writing both out says that outright. */
        error
          ? 'border-danger focus:border-danger focus:shadow-focus-magenta'
          : 'border-border hover:border-border-strong focus:border-secondary focus:shadow-focus-blue',
      ]}
      placeholder={placeholder}
      value={value}
      disabled={disabled}
      required={required}
    />
  </div>
  {error && errorMessage ? (
    <span class="text-caption-sm font-medium leading-4 tracking-caption-sm text-danger">{errorMessage}</span>
  ) : hint ? (
    <span class="text-caption-sm font-medium leading-4 tracking-caption-sm text-text-support">{hint}</span>
  ) : null}
</div>
