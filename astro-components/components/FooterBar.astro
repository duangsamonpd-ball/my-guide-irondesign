---
/**
 * FooterBar — the site footer bar from Figma's "Footer 2026" section
 * (node 263:1386; the lg component set is `footer-lg`, 877:2953).
 *
 * NOT the same component as Footer.astro. Footer.astro is `.footer-top`, the
 * violet IRONSUITE cross-sell band that sits ABOVE this; FooterBar is the black
 * bar underneath it — menu, review badges, brand, socials, partner logos and
 * legal line. They stack, they do not replace each other.
 *
 * Three bands, and the fills are the opposite way round to what the token names
 * suggest: the menu row and the brand row are both `surface/footer-alt`
 * (--color-bg-footer-alt, neutral/950) and only the bottom legal row is
 * `surface/footer` (--color-bg-footer, neutral/900).
 *
 * This is the first consumer either of those tokens has ever had — they were
 * imported with the colour ramp and sat unread until now.
 *
 * Deviations from the Figma node, all deliberate:
 *  · Figma sets three text nodes in Gotham (the review ratings, "Join Iron
 *    Slack", "Every Iron Suite Donates") inside a Montserrat system, with no
 *    variable bound. They are Montserrat here.
 *  · "Join Iron Slack" paints a raw colour from a Figma *style* named Light
 *    Gray rather than a variable; it uses --color-text-on-color-body here, the
 *    same as every other secondary line in the bar.
 *  · The brand lockup's gap is bound to `spacing-xl` in Figma but resolves to
 *    6px, which is off our scale entirely (4 → 8). The lockup is one SVG here,
 *    so the question does not arise in code — but it is still wrong in Figma.
 *  · Both star rows are white at 30% — they are the *empty* state, which is why
 *    they read as grey. G2 sets the opacity on each of the five stars and
 *    Capterra sets it on the group; same result, two different ways of saying
 *    it. Neither needs help from CSS, and adding any would double it.
 *  · The two lg variants disagree about the Slack row: Default places a 16px
 *    icon in a 20px row with the label at leading 20, Free tools version a 24px
 *    icon in a 24px row at leading 18. **Ball ruled for Default (2026-08-02)**,
 *    so 16px is correct in both regions here and the Free tools variant is the
 *    one to correct in Figma.
 *  · The Free tools panel's four icons — three headings plus the close button —
 *    are *text* nodes in `Font Awesome 7 Pro: Solid` (U+F021, U+F044, U+F0AD,
 *    U+F00D), not vectors, so nothing can be exported. All four code points are
 *    in the Free tier and Free Solid 7.3.1 matches the nine icons already in
 *    ../icons byte for byte, so they are inlined the same way — no Pro licence,
 *    no new dependency. Checked 2026-08-03.
 *  · Every pair of menu items is separated by a divider except Free Tools and
 *    Webinars, whose divider is hidden in both variants and carries stale
 *    coordinates. **Ball ruled to draw it (2026-08-02)** — the hidden node is a
 *    leftover, not a decision, and Figma is the side that needs the fix.
 *
 * Assets are real files, like Logo.astro — a partner logo is artwork, no token
 * can stand in for it. `basePath` points at wherever docs/assets/ was copied to.
 *
 * Every exported SVG here was cleaned before being committed. Figma's export
 * carries the node's whole ancestor chain — the section frame, its fill, even
 * the dashed selection outline — plus a canvas-sized backdrop rect, and it
 * bakes in any opacity set on a parent group. Left alone that renders as a grey
 * box behind each logo, and any opacity CSS then applies a second time. Only
 * the innermost artwork group is kept.
 */
import Logo from './Logo.astro';
import { icons } from '../icons';

interface Link {
  label: string;
  href?: string;
  /** Renders a caret after the label — the Free Tools item is the only one. */
  caret?: boolean;
}

interface Review {
  /** Alt text and the label the rating is read as, e.g. "G2". */
  name: string;
  /** Artwork filename inside basePath, e.g. "logo-g2.svg". */
  logo: string;
  /** Star artwork filename inside basePath — the resting row, white at 30%. */
  stars: string;
  /**
   * The filled row shown while the card is hovered — Figma binds those stars to
   * `brand/accent-1`, which is `--color-accent-1` here (iron-orange/500). The
   * value lives in the exported artwork, not in this component's CSS.
   * A second file rather than a CSS filter: the 30% is baked into the resting
   * artwork as `opacity="0.3"` on white paths, and nothing CSS can do to an
   * `<img>` reaches inside it to raise the alpha, let alone recolour it.
   */
  starsHover: string;
  /** e.g. "4.9" — rendered large; `outOf` follows it small. */
  score: string;
  outOf?: string;
}

interface Social {
  name: string;
  icon: string;
  href?: string;
}

interface Partner {
  name: string;
  logo: string;
  /** Rendered width in px; height is fixed at 28 to match the row. */
  width: number;
}

/**
 * One heading in the Free tools panel. `columns` is a list of columns, each a
 * list of links — Figma lays PDF Converters out as five columns of two rather
 * than one wrapping list, and column breaks are an editorial choice, not
 * something a layout algorithm should guess at.
 */
interface ToolGroup {
  title: string;
  /**
   * Glyph shown before the title. Named, not free-form — same approach as
   * FormCard/TrialKeyCard. Figma sets these as *text* in `Font Awesome 7 Pro:
   * Solid`, so they cannot be exported as vectors; all three code points are in
   * the Free tier, which is where the path data in ../icons comes from.
   * Optional: a group without one still lays out, the title just sits alone.
   */
  icon?: 'arrowsRotate' | 'penToSquare' | 'wrench';
  columns: Link[][];
}

interface Props {
  menu?: Link[];
  /** Figma's `Property 1=Free tools version` — shows the Free Tools item, which
   *  exists in the Default variant too but is hidden there. */
  freeTools?: boolean;
  freeToolsLabel?: string;
  freeToolsHref?: string;
  /** Figma's `Property 1=Free tool open` — the panel the Free Tools item opens. */
  toolGroups?: ToolGroup[];
  /** Render the panel already open. Off by default; the trigger owns it after that. */
  toolsOpen?: boolean;
  closeToolsLabel?: string;
  reviews?: Review[];
  address?: string;
  socials?: Social[];
  slackLabel?: string;
  slackHref?: string;
  partners?: Partner[];
  copyright?: string;
  legal?: Link[];
  donateLabel?: string;
  donateImg?: string;
  basePath?: string;
  class?: string;
}

const {
  menu = [
    { label: 'About Us' },
    { label: 'News' },
    { label: 'Customers' },
    { label: 'Careers' },
    { label: 'Academy' },
    { label: 'Webinars' },
    { label: 'Customer HUB Login' },
    { label: 'Contact Us' },
  ],
  reviews = [
    { name: 'G2', logo: 'logo-g2.svg', stars: 'stars-g2.svg', starsHover: 'stars-g2-hover.svg', score: '4.9', outOf: '/ 5' },
    { name: 'Capterra', logo: 'logo-capterra.svg', stars: 'stars-capterra.svg', starsHover: 'stars-capterra-hover.svg', score: '5', outOf: '/ 5' },
  ],
  address = '205 N. Michigan Ave. Chicago, IL 60611 USA +1 (312) 252-3088',
  socials = [
    { name: 'GitHub', icon: 'icon-github.svg' },
    { name: 'YouTube', icon: 'icon-youtube.svg' },
    { name: 'X', icon: 'icon-x.svg' },
    { name: 'Facebook', icon: 'icon-facebook.svg' },
    { name: 'LinkedIn', icon: 'icon-linkedin.svg' },
  ],
  freeTools = false,
  freeToolsLabel = 'Free tools',
  freeToolsHref,
  /* Column breaks copied from Figma node 880:1078, which splits PDF Converters
     into 5 columns, PDF Editors into 2 and Others into 1. */
  toolGroups = [
    {
      title: 'PDF Converters',
      icon: 'arrowsRotate',
      columns: [
        [{ label: 'PDF to JPG' }, { label: 'URL to PDF' }],
        [{ label: 'HTML to PDF' }, { label: 'PDF to PNG' }],
        [{ label: 'Tiff to PDF' }, { label: 'SVG to PDF' }],
        [{ label: 'JPG to PDF' }, { label: 'Docx to PDF' }],
        [{ label: 'Text to PDF' }],
      ],
    },
    {
      title: 'PDF Editors',
      icon: 'penToSquare',
      columns: [
        [{ label: 'Password Protect PDF' }, { label: 'Flatten PDF Form' }],
        [{ label: 'Merge PDF' }, { label: 'Compress PDF' }],
      ],
    },
    { title: 'Others', icon: 'wrench', columns: [[{ label: 'JSON to C#' }]] },
  ],
  toolsOpen = false,
  closeToolsLabel = 'Close free tools',
  slackLabel = 'Join Iron Slack',
  slackHref,
  partners = [
    { name: 'PDF Association Member', logo: 'logo-pdf-association-member.svg', width: 46 },
    { name: 'Microsoft Partner', logo: 'logo-microsoft.svg', width: 92 },
    { name: 'AWS Partner Network', logo: 'logo-aws.svg', width: 86 },
  ],
  copyright = 'Copyright © Iron Software 2013-2026',
  legal = [{ label: 'Terms' }, { label: 'Privacy' }, { label: 'Cookie' }],
  donateLabel = 'Every Iron Suite Donates',
  donateImg = '1% logo - Horizontal.png',
  basePath = 'assets',
  class: className,
} = Astro.props;

/* Asset names are encoded, not interpolated raw. `1% logo - Horizontal.png`
   contains a percent sign, and `% l` is an invalid escape sequence — the browser
   fails the whole URL and renders a broken image. */
const asset = (file: string) => `${basePath}/${encodeURIComponent(file)}`;

/* Figma keeps the Free Tools item in every variant and only toggles its
   visibility, so it belongs in the same list rather than in its own slot. It
   sits between Academy and Webinars; if Webinars is not in the menu it goes
   last, which is the only sensible answer for a caller with a custom list. */
/* The Free Tools item becomes a real disclosure button when there is a panel to
   disclose, and stays a plain link when there is not — so `freeTools` alone is
   still the flat "Free tools version" of the design. The id follows the
   `prefix-8hex` shape build-demos.mjs normalises, so the generated docs markup
   does not churn on every build. */
const hasPanel = freeTools && toolGroups.length > 0;
const panelId = `fbtools-${Math.random().toString(16).slice(2, 10)}`;

const items: Link[] = [...menu];
if (freeTools) {
  const at = items.findIndex((i) => i.label === 'Webinars');
  items.splice(at === -1 ? items.length : at, 0, {
    label: freeToolsLabel,
    href: freeToolsHref,
    caret: true,
  });
}
---

<footer class:list={['fb', { 'fb-tools-open': hasPanel && toolsOpen }, className]}>
  <nav class="fb-menu-bar" aria-label="Footer">
    <ul class="fb-menu">
      {items.map((item, i) => (
        <li>
          {i > 0 && <span class="fb-div" aria-hidden="true"></span>}
          {item.caret && hasPanel ? (
            <button type="button" class="fb-menu-link fb-tools-trigger" aria-expanded={toolsOpen ? 'true' : 'false'} aria-controls={panelId}>
              {item.label}
              <svg class="fb-caret" viewBox={icons.chevronDown.viewBox} fill="currentColor" aria-hidden="true"><path d={icons.chevronDown.path} /></svg>
            </button>
          ) : (
            <a class="fb-menu-link" href={item.href ?? '#'}>
              {item.label}
              {item.caret && (
                <svg class="fb-caret" viewBox={icons.chevronDown.viewBox} fill="currentColor" aria-hidden="true"><path d={icons.chevronDown.path} /></svg>
              )}
            </a>
          )}
        </li>
      ))}
    </ul>
  </nav>

  {hasPanel && (
    <div class="fb-tools" id={panelId} inert={!toolsOpen}>
      <div class="fb-tools-clip">
        <div class="fb-tools-panel">
          <img class="fb-tools-bg" src={asset('footerbar-freetools-bg.png')} alt="" aria-hidden="true" />
          <div class="fb-tools-inner">
            {toolGroups.map((group, gi) => (
              <div class="fb-tools-group" style={`--i:${gi}`}>
                <p class="fb-tools-title">
                  {group.icon && (
                    <svg class="fb-tools-title-icon" viewBox={icons[group.icon].viewBox} fill="currentColor" aria-hidden="true"><path d={icons[group.icon].path} /></svg>
                  )}
                  {group.title}
                </p>
                <div class="fb-tools-cols">
                  {group.columns.map((col) => (
                    <div class="fb-tools-col">
                      {col.map((link) => (
                        <a class="fb-tools-link" href={link.href ?? '#'}>{link.label}</a>
                      ))}
                    </div>
                  ))}
                </div>
              </div>
            ))}
            <button type="button" class="fb-tools-close" style={`--i:${toolGroups.length}`} aria-label={closeToolsLabel}>
              <svg viewBox={icons.xmark.viewBox} fill="currentColor" aria-hidden="true"><path d={icons.xmark.path} /></svg>
            </button>
          </div>
        </div>
      </div>
    </div>
  )}

  <div class="fb-mid">
    <div class="fb-mid-inner">
      <div class="fb-reviews">
        {reviews.map((r) => (
          <div class="fb-review">
            <img class="fb-review-logo" src={asset(r.logo)} alt={r.name} width="32" height="32" />
            <div class="fb-review-rating">
              <img class="fb-stars" src={asset(r.stars)} alt="" width="68" height="12" />
              <img class="fb-stars-hover" src={asset(r.starsHover)} alt="" width="68" height="12" />
              <p class="fb-score">{r.score}{r.outOf && <span class="fb-outof"> {r.outOf}</span>}</p>
            </div>
          </div>
        ))}
      </div>

      <div class="fb-brand">
        {/* Both lockups are rendered and swapped on hover, the same way TopNav
            does it. At rest Figma's Main logo is the all-white `mono` at 60%;
            hovering reveals `ondark`, which carries the colour mark and the pink
            SOFTWARE. Swapping the file rather than filtering the mono one is
            what makes the mark come back in its real brand colours. */}
        <span class="fb-logo">
          <span class="fb-logo-mono"><Logo kind="wordmark" brand="iron" variant="mono" height={24} basePath={basePath} label="Iron Software" /></span>
          <span class="fb-logo-colour" aria-hidden="true"><Logo kind="wordmark" brand="iron" variant="ondark" height={24} basePath={basePath} label="" /></span>
        </span>
        <p class="fb-address">{address}</p>
      </div>

      <div class="fb-connect">
        <div class="fb-socials">
          {socials.map((s) => (
            <a class="fb-social" href={s.href ?? '#'} aria-label={s.name}>
              <img src={asset(s.icon)} alt="" width="16" height="16" />
            </a>
          ))}
        </div>
        <a class="fb-slack" href={slackHref ?? '#'}>
          <img src={asset('icon-slack.svg')} alt="" width="16" height="16" />
          <span>{slackLabel}</span>
        </a>
      </div>
    </div>
  </div>

  <div class="fb-info">
    <div class="fb-info-inner">
      <div class="fb-partners">
        {partners.map((p) => (
          <img class="fb-partner" src={asset(p.logo)} alt={p.name} width={p.width} height="28" />
        ))}
      </div>

      <div class="fb-legal">
        <p class="fb-copyright">{copyright}</p>
        <div class="fb-legal-links">
          {legal.map((l, i) => (
            <>
              {i > 0 && <span class="fb-div" aria-hidden="true"></span>}
              <a class="fb-legal-link" href={l.href ?? '#'}>{l.label}</a>
            </>
          ))}
        </div>
      </div>

      <div class="fb-donate">
        <span class="fb-donate-label">{donateLabel}</span>
        <img class="fb-donate-img" src={asset(donateImg)} alt="1% For The Planet" height="32" />
      </div>
    </div>
  </div>
</footer>

<style>
  /*
    Token map, 1:1 with the Figma variables on node 877:2953:
      surface/footer-alt      → --color-bg-footer-alt   (menu + brand bands)
      surface/footer          → --color-bg-footer       (legal band)
      text/default/link-menu  → --color-text-link-menu
      text/on color/heading   → --color-text-on-color-heading
      text/on color/body      → --color-text-on-color-body
      transparent/white/20    → --transparent-white-20  (dividers)
      transparent/white/10    → --transparent-white-10  (review card border)
      Typography/UI/Button default → --font-size-btn / --fw-btn / --leading-4
      Typography/Caption SM        → --font-size-caption-sm / --fw-caption-sm
                                     / --letter-spacing-caption-sm
  */
  .fb { width: 100%; font-family: 'Montserrat', sans-serif; }

  /* ── band 1: menu ─────────────────────────────────────────────────────── */
  .fb-menu-bar { background: var(--color-bg-footer-alt); display: flex; justify-content: center; padding: var(--spacing-xs) var(--spacing-xl) 0; }
  /* 1176px is Figma's own number for the menu row — not a container token. The
     items are centred inside it and only add up to ~866, so the width is
     headroom rather than a visible edge. */
  .fb-menu { display: flex; align-items: center; justify-content: center; flex-wrap: wrap; list-style: none; margin: 0; padding: 0; width: 100%; max-width: 1176px; }
  /* Figma overlaps every item and divider by 1px so a divider shares an edge
     with the item beside it (About Us ends at 257.5, News starts at 256.5).
     Without this the row is 14px wider than the design. */
  .fb-menu li:not(:first-child) { margin-left: -1px; }
  .fb-menu .fb-div { margin-right: -1px; }
  /* Each <li> is a flex container so the divider and the label share one
     baseline — a block <li> would put the inline label on a font strut instead,
     the same 1.4px drift TopNav hit. */
  .fb-menu li { display: flex; align-items: center; }
  .fb-menu-link { display: inline-flex; align-items: center; gap: var(--spacing-xs); padding: var(--spacing-md); font-size: var(--font-size-btn); font-weight: var(--fw-btn); line-height: var(--leading-4); letter-spacing: var(--letter-spacing-btn); color: var(--color-text-link-menu); text-decoration: none; white-space: nowrap; transition: color var(--duration-base); }
  /* The menu palette comes in a pair — link-menu resting, link-menu-hover on
     hover. Same as TopNav's .tn-item. Dimming with opacity instead would drop
     the brand pink the pair exists to deliver. */
  .fb-menu-link:hover { color: var(--color-text-link-menu-hover); }
  /* Measured off the Free tools variant, where the item is visible: 16 padding,
     8 gap, 13x14 caret — 16+71+8+13+16 = the 124 Figma reports. The same node
     in the Default variant is hidden and keeps stale coordinates, so it cannot
     be measured there. */
  .fb-caret { width: 13px; height: 14px; flex-shrink: 0; }

  .fb-div { width: 1px; height: var(--leading-4); flex-shrink: 0; background: var(--transparent-white-20); }

  /* ── band 1b: the Free tools panel ───────────────────────────────────────
     Figma's `Free tool open` variant (880:915, section 880:1078). The trigger
     becomes a tab joined to the panel below it, so the two are styled together.

     The open/close is `grid-template-rows: 0fr → 1fr` rather than an animated
     max-height. A max-height has to be a guess: too small clips the panel, too
     large makes the close look like it stalls, and either way the number goes
     stale the moment someone adds a link. 0fr→1fr animates to the content's own
     height with no measuring and no JS. */
  .fb-tools { display: grid; grid-template-rows: 0fr; background: var(--color-bg-footer-alt); transition: grid-template-rows var(--duration-slow) var(--ease-emphasized); }
  .fb.fb-tools-open .fb-tools { grid-template-rows: 1fr; }
  .fb-tools-clip { min-height: 0; overflow: hidden; }

  .fb-tools-panel { position: relative; padding: var(--spacing-xl) var(--spacing-hero) var(--spacing-2xl); }
  /* Figma exports this as a raster. It is a pure vertical gradient — sampled
     across every row the horizontal spread is 1/255 — so stretching it to any
     width is lossless despite the frame being named "Free Tools + dots". */
  .fb-tools-bg { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; pointer-events: none; }
  .fb-tools-inner { position: relative; display: flex; align-items: flex-start; justify-content: center; gap: var(--spacing-3xl); padding: 0 var(--spacing-xl); }

  .fb-tools-group { display: flex; flex-direction: column; gap: var(--spacing-md); }
  /* Figma gives the last group `flex: 1 0 0` and stretches it, which is what
     puts the close button against the right edge — 1232 in a 1280 frame. Doing
     it with `margin-left: auto` on the close instead lands the button in the
     same place but leaves this group at its content width, so the measurement
     against the design silently disagrees. */
  .fb-tools-group:last-of-type { flex: 1 0 0; min-width: 0; align-self: stretch; }
  .fb-tools-title { margin: 0; display: flex; align-items: center; gap: var(--spacing-xs); font-size: var(--font-size-xs); font-weight: var(--fw-nav-label); line-height: var(--leading-4); letter-spacing: var(--letter-spacing-nav-label); text-transform: uppercase; color: var(--color-text-on-color-heading); white-space: nowrap; }
  /* Height, not width. Figma sets these as Font Awesome *text* at 12px, so the
     glyph is 12 tall and as wide as its own aspect ratio makes it — square for
     arrows-rotate and pen-to-square, 13.5 for the 576-wide wrench (Figma rounds
     it to 14). Forcing a 12x12 box instead would squash the wrench. */
  .fb-tools-title-icon { height: 1em; width: auto; flex-shrink: 0; }
  .fb-tools-cols { display: flex; align-items: flex-start; gap: var(--spacing-2xl); }
  .fb-tools-col { display: flex; flex-direction: column; gap: var(--spacing-xs); }
  .fb-tools-link { font-size: var(--font-size-xs); font-weight: var(--fw-nav-label); line-height: var(--leading-4); letter-spacing: var(--letter-spacing-nav-label); color: var(--color-text-link); text-decoration: none; white-space: nowrap; }
  .fb-tools-link:hover { color: var(--color-text-link-hover); }

  .fb-tools-close { flex-shrink: 0; display: flex; align-items: center; justify-content: center; width: 24px; height: 24px; padding: 0; border: 0; border-radius: var(--rounded-sm); background: var(--transparent-black-50); color: var(--color-text-link-menu); cursor: pointer; }
  /* Same rule as the group headings: 14 tall, width from the glyph. `xmark` is
     384x512, so it lands at 10.5 wide against Figma's 11. */
  .fb-tools-close svg { height: 14px; width: auto; display: block; }
  .fb-tools-close:hover { color: var(--color-text-link-menu-hover); }

  /* The trigger is a <button> pretending to be a menu link, so the browser's
     button defaults have to be undone before .fb-menu-link's own rules land. */
  .fb-tools-trigger { border: var(--border-width-1) solid transparent; background: none; font-family: inherit; cursor: pointer; border-radius: var(--rounded-lg) var(--rounded-lg) 0 0; }
  .fb.fb-tools-open .fb-tools-trigger { background: var(--slate-800); border-color: var(--transparent-white-10); border-bottom-color: transparent; }
  .fb-caret { transition: transform var(--duration-slow) var(--ease-emphasized); }
  .fb.fb-tools-open .fb-tools-trigger .fb-caret { transform: rotate(180deg); }

  /* Each column rises as the panel opens, one after the next. The delay is only
     applied on the way IN: leaving it on the way out makes closing feel broken,
     because the panel has already collapsed past the content by the time the
     last group starts fading. */
  .fb-tools-group,
  .fb-tools-close { opacity: 0; transform: translateY(8px); transition: opacity var(--duration-slow) var(--ease-default), transform var(--duration-slow) var(--ease-emphasized); }
  .fb.fb-tools-open .fb-tools-group,
  .fb.fb-tools-open .fb-tools-close { opacity: 1; transform: none; transition-delay: calc(var(--i, 0) * 70ms + 80ms); }

  @media (prefers-reduced-motion: reduce) {
    .fb-tools,
    .fb-tools-group,
    .fb-tools-close,
    .fb-caret { transition-duration: 1ms; }
    .fb.fb-tools-open .fb-tools-group,
    .fb.fb-tools-open .fb-tools-close { transition-delay: 0s; }
  }

  /* ── band 2: reviews, brand, socials ──────────────────────────────────── */
  .fb-mid { background: var(--color-bg-footer-alt); display: flex; justify-content: center; padding: var(--spacing-md) var(--spacing-xl) var(--spacing-xl); }
  /* No max-width here on purpose: Figma's middle row is full width inside the
     24px padding (1392 at a 1440 canvas). Only the legal row below is capped. */
  .fb-mid-inner { display: flex; align-items: center; gap: var(--spacing-md); width: 100%; }

  .fb-reviews { display: flex; align-items: flex-start; gap: var(--spacing-md); flex: 1 0 0; min-width: 0; }
  /* An inset shadow, not a border. Figma's 124x48 leaves no room for one
     (8+32+8+68+8 = 124 exactly) because its stroke is drawn *inside* the frame;
     a CSS border on an auto-width box adds 2px instead. */
  .fb-review { display: flex; align-items: center; gap: var(--spacing-xs); padding: var(--spacing-xs); box-shadow: inset 0 0 0 var(--border-width-1) var(--transparent-white-10); border-radius: var(--rounded-sm); }
  .fb-review-logo { width: 32px; height: 32px; display: block; flex-shrink: 0; }
  .fb-review-rating { display: flex; flex-direction: column; align-items: flex-start; }
  /* Figma node 885:630 draws Default State and Hover State side by side for each
     card: the logo and the score are already full strength at rest, and only the
     star row changes — white at 30% to `brand/accent-1` (--color-accent-1) at
     full. Each card hovers on its own. */
  .fb-stars { width: 68px; height: 12px; display: block; }
  .fb-stars-hover { width: 68px; height: 12px; display: none; }
  .fb-review:hover .fb-stars { display: none; }
  .fb-review:hover .fb-stars-hover { display: block; }
  /* Deliberately not flex: the "/ 5" has to keep the space in front of it, and
     flex drops a leading whitespace text node. The 12px span makes the line box
     1px taller than the 20px leading, which the card absorbs. */
  .fb-score { margin: 0; font-size: var(--font-size-sm); font-weight: var(--fw-label); line-height: var(--leading-5); color: var(--color-text-on-color-heading); white-space: nowrap; }
  .fb-outof { font-size: var(--font-size-xs); font-weight: var(--fw-body); }

  .fb-brand { display: flex; align-items: center; justify-content: center; gap: var(--spacing-lg); flex-shrink: 0; }
  /* Everything in this bar that is dimmed at rest comes back to full strength on
     hover — the brand lockup, the socials, the partner marks. Measured off
     ironsoftware.com, which transitions these over .2s, not the .16s used for
     link colour. */
  .fb-logo { display: flex; align-items: center; opacity: var(--opacity-60); transition: opacity var(--duration-base); }
  .fb-logo:hover { opacity: 1; }
  .fb-logo-colour { display: none; }
  .fb-logo:hover .fb-logo-mono { display: none; }
  .fb-logo:hover .fb-logo-colour { display: block; }
  .fb-address { margin: 0; font-size: var(--font-size-caption-sm); font-weight: var(--fw-caption-sm); line-height: var(--leading-4); letter-spacing: var(--letter-spacing-caption-sm); color: var(--color-text-on-color-body); opacity: var(--opacity-75); text-align: right; white-space: nowrap; }

  .fb-connect { display: flex; flex-direction: column; align-items: flex-end; gap: var(--spacing-xs); flex: 1 0 0; min-width: 0; }
  /* Each icon lights on its own — Ball's call, 2026-08-02, matching the partner
     marks. The dimming therefore sits on the icon, not on the row: with it on
     .fb-socials there is no way to raise one child above its parent's opacity.

     These five files carried the same baked `opacity="0.6"` the partner marks
     did, here on a `<g id="socials">` — Figma had applied the socials group's
     opacity to every icon on export. Combined with the CSS they rendered at 36%
     and could not pass 60% hovered. Stripped 2026-08-02. */
  .fb-socials { display: flex; align-items: center; gap: var(--spacing-sm); }
  .fb-social { display: flex; opacity: var(--opacity-60); }
  .fb-social img { width: 16px; height: 16px; display: block; }
  .fb-social:hover { opacity: 1; }
  .fb-slack { display: flex; align-items: center; gap: var(--spacing-micro); text-decoration: none; }
  /* 16px, not the 24 the component's own frame reports — the *instance* placed
     in this variant is 16, in a 20px-tall row. The Free tools variant places a
     24px one instead; the two variants disagree in Figma. */
  .fb-slack img { width: 16px; height: 16px; display: block; }
  .fb-slack span { font-size: var(--font-size-sm); line-height: var(--leading-5); color: var(--color-text-on-color-body); white-space: nowrap; transition: color var(--duration-base); }
  /* This used to be `opacity: var(--opacity-hover-footer)` — 0.8 — so hovering
     the row made it FAINTER, the opposite of every other hover in this bar.
     Figma puts Join Slack outside the socials' opacity group, so there is no
     dimming to undo here; the label goes from on-color/body to on-color/heading
     instead, which is the same "back to full strength" move in colour terms. */
  .fb-slack:hover span { color: var(--color-text-on-color-heading); }

  /* ── band 3: partners, legal, donate ──────────────────────────────────── */
  .fb-info { background: var(--color-bg-footer); display: flex; align-items: center; justify-content: center; padding: var(--spacing-xl); }
  /* No gap: Figma's three columns are exactly a third of 1392 each, so any gap
     here comes straight out of their width (16px of gap = 10.7px off each). */
  .fb-info-inner { display: flex; align-items: center; justify-content: space-between; width: 100%; max-width: var(--size-container-max); }

  .fb-partners { display: flex; align-items: center; gap: var(--spacing-xl); flex: 1 0 0; min-width: 0; }
  /* Figma greys the partner marks with mix-blend-luminosity over the band fill,
     which is why they read as flat grey rather than tinted. Hover drops both the
     blend and the dimming so the mark returns to full colour.

     ironsoftware.com greys these with `filter: brightness(0) invert(.6)` instead —
     a flat silhouette rather than a luminance-preserving blend. The REST
     appearance stays on Figma's mechanism, which is what the design file
     specifies and is only a shade off the site's.

     Each mark lights on its own. This was briefly row-wide (`ab6eeee`); Figma
     node 885:630 then drew Default and Hover per logo, so it is back to
     per-element, which is also what the live site does.

     No transition — Ball's call, 2026-08-02: the swap is immediate. `mix-blend-mode`
     could not animate anyway, so a fading opacity next to a snapping blend mode was
     never one movement.

     The artwork must be full strength for this to work. All three files shipped with
     `opacity="0.6"` baked onto their outer <g> by the Figma export, on top of the 60%
     this CSS applies — so the rest state was really 36% and hover could never pass
     60%, which is what Ball saw. Stripped from the SVGs, 2026-08-02; the dimming now
     lives in exactly one place.

     The same export had also baked `style="mix-blend-mode:luminosity"` onto that <g>,
     which survived the opacity sweep because we were only looking for `opacity`. It
     cost nothing visible in Chrome and broke the hover completely in Safari: WebKit
     flattens that inner blend group against black once, permanently, so the marks
     were greyscale in the file itself and no CSS could bring the colour back. Chrome
     treats the same group as a no-op, which is why it looked fine here for a week.
     Stripped 2026-08-03; measured 0.000 → 0.487 saturation on hover in WebKit
     afterwards, against 0.000 → 0.000 before. The CSS below did not change.

     **If these marks are ever re-exported, strip BOTH `opacity` and
     `mix-blend-mode` off the wrapper <g> — Figma bakes in every group-level paint
     property, and a blend mode does it silently in one engine only.** The five other
     assets carrying a baked `multiply` were checked at the same time and render the
     same in both engines; luminosity is the one that flattens. */
  .fb-partner { height: 28px; width: auto; display: block; mix-blend-mode: luminosity; opacity: var(--opacity-60); }
  .fb-partner:hover { mix-blend-mode: normal; opacity: 1; }

  .fb-legal { display: flex; align-items: center; justify-content: center; gap: var(--spacing-lg); flex: 1 0 0; min-width: 0; }
  .fb-copyright { margin: 0; font-size: var(--font-size-2xs); font-weight: var(--fw-body); line-height: var(--leading-3); color: var(--color-text-on-color-body); text-align: center; white-space: nowrap; }
  .fb-legal-links { display: flex; align-items: center; justify-content: center; gap: var(--spacing-xs); }
  .fb-legal-links .fb-div { height: var(--leading-3); }
  .fb-legal-link { font-size: var(--font-size-2xs); font-weight: var(--fw-caption-sm); line-height: var(--leading-3); letter-spacing: var(--letter-spacing-btn); color: var(--color-text-link-menu); text-decoration: none; white-space: nowrap; transition: color var(--duration-base); }
  .fb-legal-link:hover { color: var(--color-text-link-menu-hover); }

  /* Dimmed at rest and back to full on hover, same as the brand lockup, the
     socials and the partner marks. Ball's call, 2026-08-02. */
  .fb-donate { display: flex; align-items: center; justify-content: flex-end; gap: var(--spacing-xs); flex: 1 0 0; min-width: 0; opacity: var(--opacity-60); transition: opacity var(--duration-base); }
  .fb-donate:has(:hover) { opacity: 1; }
  /* Figma sets line-height 1.2 on 12px = 14.4, which is off our leading ramp
     (12 → 16). 16 is the nearest step and the label stays centred against the
     32px logo beside it, so the 1.6px is invisible. */
  .fb-donate-label { font-size: var(--font-size-caption-sm); line-height: var(--leading-4); color: var(--color-text-on-color-body); white-space: nowrap; }
  .fb-donate-img { height: 32px; width: auto; display: block; }
</style>

<script>
  // Disclosure pattern (WAI-ARIA APG): the trigger owns aria-expanded and points
  // at the panel with aria-controls. The panel stays in the DOM so it can
  // animate, which means it also stays in the tab order — `inert` is what keeps
  // a collapsed panel from swallowing focus. Toggling display or visibility
  // instead would fix focus and kill the animation.
  function initFooterTools(root: ParentNode = document) {
    root.querySelectorAll<HTMLElement>('.fb:not([data-fb-init])').forEach((fb) => {
      const trigger = fb.querySelector<HTMLButtonElement>('.fb-tools-trigger');
      const panel = fb.querySelector<HTMLElement>('.fb-tools');
      if (!trigger || !panel) return;
      fb.dataset.fbInit = '1';

      const setOpen = (open: boolean) => {
        fb.classList.toggle('fb-tools-open', open);
        trigger.setAttribute('aria-expanded', String(open));
        // inert lands immediately in both directions. It hides the subtree from
        // focus and assistive tech without touching layout, so the closing
        // animation still plays out underneath it.
        if (open) panel.removeAttribute('inert');
        else panel.setAttribute('inert', '');
      };

      const close = (returnFocus: boolean) => {
        if (!fb.classList.contains('fb-tools-open')) return;
        setOpen(false);
        if (returnFocus) trigger.focus();
      };

      trigger.addEventListener('click', () => setOpen(!fb.classList.contains('fb-tools-open')));
      panel.querySelector<HTMLButtonElement>('.fb-tools-close')?.addEventListener('click', () => close(true));

      // Escape closes from anywhere inside the footer, and hands focus back to
      // the trigger — otherwise it is left on a control that just went inert.
      fb.addEventListener('keydown', (e) => {
        if ((e as KeyboardEvent).key === 'Escape') close(true);
      });
    });
  }

  document.addEventListener('DOMContentLoaded', () => initFooterTools());
  document.addEventListener('astro:page-load', () => initFooterTools());
</script>
