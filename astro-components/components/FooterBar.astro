---
/**
 * FooterBar — the site footer bar from Figma's "Footer 2026" section
 * (node 263:1386; the lg component set is `footer-lg`, 877:2953).
 *
 * NOT the same component as Footer.astro. Footer.astro is `.footer-top`, the
 * violet IRONSUITE cross-sell band that sits ABOVE this; FooterBar is the black
 * bar underneath it — menu, review badges, brand, socials, partner logos and
 * legal line. They stack, they do not replace each other.
 *
 * Three bands, and the fills are the opposite way round to what the token names
 * suggest: the menu row and the brand row are both `surface/footer-alt`
 * (--color-bg-footer-alt, neutral/950) and only the bottom legal row is
 * `surface/footer` (--color-bg-footer, neutral/900).
 *
 * This is the first consumer either of those tokens has ever had — they were
 * imported with the colour ramp and sat unread until now.
 *
 * Deviations from the Figma node, all deliberate:
 *  · ~~Gotham on eight text nodes, Light Gray as a style, and a 6px lockup gap~~
 *    — **all closed on the design side 2026-08-10.** The eight review scores are
 *    Montserrat now, "Join Iron Slack" and "Every Iron Suite Donates" bind their
 *    variables, and the lockup gap is 4px (`spacing-micro`) in all four frames
 *    after the instance was detached. The gap had looked like a broken binding
 *    and was not: `spacing-xl` is 24 and correct, the instance was scaled 4x.
 *  · Converting the review scores off Gotham changed four things, not one: the
 *    runs close up (`4.9/5`, no spaces), the number goes SemiBold, both runs
 *    take `tracking/wider` 0.8, and the colour drops from white to
 *    `text/on dark/body`. Figma binds those as variables but gives the role no
 *    type style, so it is unnamed on both sides — hence --fw-btn and
 *    --letter-spacing-overline below, borrowed for their values.
 *  · Both star rows are white at 30% — they are the *empty* state, which is why
 *    they read as grey. G2 sets the opacity on each of the five stars and
 *    Capterra sets it on the group; same result, two different ways of saying
 *    it. Neither needs help from CSS, and adding any would double it.
 *  · **A review rating is drawn in `brand/accent-1`, not in the partner's own
 *    colour** — Ball's ruling 2026-08-21, and it settles a question raised from
 *    the consuming room, which had the same widget drawn in G2's #FF492C.
 *    One amber for every partner, so a row of badges reads as one row.
 *
 *    The line runs through the MIDDLE of this component, which is the part worth
 *    remembering: the stars are ours and the logos are theirs. Measured — the
 *    four star files are entirely on the ramp (#ffffff, #fda509) while
 *    `logo-g2.svg` and `logo-capterra.svg` carry #ff492c and
 *    #ff9d28/#68c5ed/#044d80/#e54747, which belong to G2 and Capterra and must
 *    stay off it. `check:logo-fills` holds exactly that split: `stars-*` is in
 *    scope, the partner logos are not.
 *
 *    THE HOVER IS RIGHT HERE AND WRONG ELSEWHERE. It stays in this bar. The
 *    homepage's NuGet section drops it — Ball, same day: over there the resting
 *    stars beside a printed "4.9" read as confusing rather than as an
 *    affordance. Note that the hover carries no information either way: the
 *    stars are `alt=""`, the score is text beside them, and no keyboard or touch
 *    user ever sees the amber state. It is decoration, and decoration is
 *    allowed to differ by context.
 *
 *    The two drawings do not otherwise converge and are not meant to: 68x12 here
 *    against 96x16 there is 5.667 versus 6.000, a different drawing rather than
 *    a scale of one.
 *  · ~~The two lg variants disagree about the Slack row~~ — **closed
 *    2026-08-10.** Ball ruled for 16 back in August and the code always used it;
 *    all four frames now read 127x20 around a 16px icon.
 *  · The Free tools panel's four icons — three headings plus the close button —
 *    are *text* nodes in `Font Awesome 7 Pro: Solid` (U+F021, U+F044, U+F0AD,
 *    U+F00D), not vectors, so nothing can be exported. All four code points are
 *    in the Free tier and Free Solid 7.3.1 matches the nine icons already in
 *    ../icons byte for byte, so they are inlined the same way — no Pro licence,
 *    no new dependency. Checked 2026-08-03.
 *  · At md and sm the menu wraps, and Figma's own wrap is a flat list: at 768
 *    a divider is left dangling at the end of row 1, at 375 one leads row 3.
 *    Here a divider is always grouped with the label it precedes, so it never
 *    strands at a row end — 375 matches Figma exactly and 768 differs by that
 *    one divider. It is a wrap artifact on Figma's side, not a decision.
 *  · The divider between Free Tools and Webinars shows while the panel is
 *    CLOSED and hides while it is open — **Ball's third ruling on it**: "draw
 *    it" (2026-08-02), "never draw it" (2026-08-10), then this. It ran ahead of
 *    Figma for a few hours; `880:774` is drawn now and `880:936` stays hidden,
 *    so both sides say the same thing and no exception is outstanding.
 *
 * Assets are real files, like Logo.astro — a partner logo is artwork, no token
 * can stand in for it. `basePath` points at wherever docs/assets/ was copied to.
 *
 * Every exported SVG here was cleaned before being committed. Figma's export
 * carries the node's whole ancestor chain — the section frame, its fill, even
 * the dashed selection outline — plus a canvas-sized backdrop rect, and it
 * bakes in any opacity set on a parent group. Left alone that renders as a grey
 * box behind each logo, and any opacity CSS then applies a second time. Only
 * the innermost artwork group is kept.
 */
import Logo from './Logo.astro';
import { icons } from '../icons';

interface Link {
  label: string;
  href?: string;
  /** Renders a caret after the label — the Free Tools item is the only one. */
  caret?: boolean;
}

interface Review {
  /** Alt text and the label the rating is read as, e.g. "G2". */
  name: string;
  /** Artwork filename inside basePath, e.g. "logo-g2.svg". */
  logo: string;
  /** Star artwork filename inside basePath — the resting row, white at 30%. */
  stars: string;
  /**
   * The filled row shown while the card is hovered — Figma binds those stars to
   * `brand/accent-1`, which is `--color-accent-1` here (iron-orange/500). The
   * value lives in the exported artwork, not in this component's CSS.
   * A second file rather than a CSS filter: the 30% is baked into the resting
   * artwork as `opacity="0.3"` on white paths, and nothing CSS can do to an
   * `<img>` reaches inside it to raise the alpha, let alone recolour it.
   */
  starsHover: string;
  /** e.g. "4.9" — rendered large; `outOf` follows it small. */
  score: string;
  outOf?: string;
}

interface Social {
  name: string;
  icon: string;
  href?: string;
}

interface Partner {
  name: string;
  logo: string;
  /** Rendered width in px; height is fixed at 28 to match the row. */
  width: number;
}

/**
 * One heading in the Free tools panel. `columns` is a list of columns, each a
 * list of links — Figma lays PDF Converters out as five columns of two rather
 * than one wrapping list, and column breaks are an editorial choice, not
 * something a layout algorithm should guess at.
 */
interface ToolGroup {
  title: string;
  /**
   * Glyph shown before the title. Named, not free-form — same approach as
   * FormCard/TrialKeyCard. Figma sets these as *text* in `Font Awesome 7 Pro:
   * Solid`, so they cannot be exported as vectors; all three code points are in
   * the Free tier, which is where the path data in ../icons comes from.
   * Optional: a group without one still lays out, the title just sits alone.
   */
  icon?: 'arrowsRotate' | 'penToSquare' | 'wrench';
  columns: Link[][];
}

interface Props {
  menu?: Link[];
  /** Figma's `Property 1=Free tools version` — shows the Free Tools item, which
   *  exists in the Default variant too but is hidden there. */
  freeTools?: boolean;
  freeToolsLabel?: string;
  freeToolsHref?: string;
  /** Figma's `Property 1=Free tool open` — the panel the Free Tools item opens. */
  toolGroups?: ToolGroup[];
  /** Render the panel already open. Off by default; the trigger owns it after that. */
  toolsOpen?: boolean;
  closeToolsLabel?: string;
  reviews?: Review[];
  address?: string;
  socials?: Social[];
  slackLabel?: string;
  slackHref?: string;
  partners?: Partner[];
  copyright?: string;
  legal?: Link[];
  donateLabel?: string;
  donateImg?: string;
  basePath?: string;
  class?: string;
}

const {
  menu = [
    { label: 'About Us' },
    { label: 'News' },
    { label: 'Customers' },
    { label: 'Careers' },
    { label: 'Academy' },
    { label: 'Webinars' },
    { label: 'Customer HUB Login' },
    { label: 'Contact Us' },
  ],
  reviews = [
    { name: 'G2', logo: 'logo-g2.svg', stars: 'stars-g2.svg', starsHover: 'stars-g2-hover.svg', score: '4.9', outOf: '/5' },
    { name: 'Capterra', logo: 'logo-capterra.svg', stars: 'stars-capterra.svg', starsHover: 'stars-capterra-hover.svg', score: '5', outOf: '/5' },
  ],
  /* The spaces inside the phone number are non-breaking on purpose. This is
     one line at 1440 and 768, but at 375 it wraps, and left to itself the
     browser breaks at the widest space that fits — which lands mid-number,
     "+1 (312)" over "252-3088". Holding the number together moves the break to
     the space before it, which is where Figma puts it (879:541 is two lines,
     address then phone). Only this default is treated that way; a caller's own
     string is passed through untouched. */
  address = '205 N. Michigan Ave. Chicago, IL 60611 USA +1\u00A0(312)\u00A0252-3088',
  socials = [
    { name: 'GitHub', icon: 'icon-github.svg' },
    { name: 'YouTube', icon: 'icon-youtube.svg' },
    { name: 'X', icon: 'icon-x.svg' },
    { name: 'Facebook', icon: 'icon-facebook.svg' },
    { name: 'LinkedIn', icon: 'icon-linkedin.svg' },
  ],
  freeTools = false,
  freeToolsLabel = 'Free tools',
  freeToolsHref,
  /* Column breaks copied from Figma node 880:1078, which splits PDF Converters
     into 5 columns, PDF Editors into 2 and Others into 1. */
  toolGroups = [
    {
      title: 'PDF Converters',
      icon: 'arrowsRotate',
      columns: [
        [{ label: 'PDF to JPG' }, { label: 'URL to PDF' }],
        [{ label: 'HTML to PDF' }, { label: 'PDF to PNG' }],
        [{ label: 'Tiff to PDF' }, { label: 'SVG to PDF' }],
        [{ label: 'JPG to PDF' }, { label: 'Docx to PDF' }],
        [{ label: 'Text to PDF' }],
      ],
    },
    {
      title: 'PDF Editors',
      icon: 'penToSquare',
      columns: [
        [{ label: 'Password Protect PDF' }, { label: 'Flatten PDF Form' }],
        [{ label: 'Merge PDF' }, { label: 'Compress PDF' }],
      ],
    },
    { title: 'Others', icon: 'wrench', columns: [[{ label: 'JSON to C#' }]] },
  ],
  toolsOpen = false,
  closeToolsLabel = 'Close free tools',
  slackLabel = 'Join Iron Slack',
  slackHref,
  partners = [
    { name: 'PDF Association Member', logo: 'logo-pdf-association-member.svg', width: 46 },
    { name: 'Microsoft Partner', logo: 'logo-microsoft.svg', width: 92 },
    { name: 'AWS Partner Network', logo: 'logo-aws.svg', width: 86 },
  ],
  copyright = 'Copyright © Iron Software 2013-2026',
  legal = [{ label: 'Terms' }, { label: 'Privacy' }, { label: 'Cookie' }],
  donateLabel = 'Every Iron Suite Donates',
  donateImg = '1% logo - Horizontal.png',
  basePath = 'assets',
  class: className,
} = Astro.props;

/* Asset names are encoded, not interpolated raw. `1% logo - Horizontal.png`
   contains a percent sign, and `% l` is an invalid escape sequence — the browser
   fails the whole URL and renders a broken image. */
const asset = (file: string) => `${basePath}/${encodeURIComponent(file)}`;

/* Figma keeps the Free Tools item in every variant and only toggles its
   visibility, so it belongs in the same list rather than in its own slot. It
   sits between Academy and Webinars; if Webinars is not in the menu it goes
   last, which is the only sensible answer for a caller with a custom list. */
/* The Free Tools item becomes a real disclosure button when there is a panel to
   disclose, and stays a plain link when there is not — so `freeTools` alone is
   still the flat "Free tools version" of the design. The id follows the
   `prefix-8hex` shape build-demos.mjs normalises, so the generated docs markup
   does not churn on every build. */
const hasPanel = freeTools && toolGroups.length > 0;
const panelId = `fbtools-${Math.random().toString(16).slice(2, 10)}`;

/* `icons.chevronDown` is drawn inside a 16x16 viewBox, but its ink is only
   12.25 x 7 and sits at (1, 5.125) — measured with getBBox, not eyeballed. Two
   consequences, and Figma's caret has neither: rendering the 16-box at 13x14
   scaled the drawing to 0.8125, so it came out 9.95 x 5.69 against the 12.25 x 7
   `caret-vector` the design file now holds; and rotating the BOX 180 degrees for
   the open state spun the ink about (8, 8) when its own centre is (7.125,
   8.625), so it shifted as it turned.

   Cropping the viewBox to the ink fixes both at once: scale becomes 1, and the
   element is the drawing, so the rotation is about the caret's own centre — the
   same thing Figma does by wrapping `rotate-180` around a 12.25 x 7 frame.
   TopNav offsets a viewBox for the same kind of reason.

   The numbers come from the shared path; if `icons.chevronDown` is ever redrawn
   this crop goes stale silently, so it is stated here rather than hidden. */
const CARET_VB = '1 5.125 12.25 7';

const items: Link[] = [...menu];
/* The divider after Free Tools shows while the panel is CLOSED and hides while
   it is open — Ball's ruling 2026-08-10, his third on this one line: "draw it"
   (08-02), then "never draw it" (08-10), then this. It is the item AFTER Free
   Tools that owns the divider, because a divider renders as the first child of
   each <li>. With no Webinars to sit before, Free Tools lands last and there is
   nothing after it to mark.

   Figma agrees, as of 2026-08-10: `880:774` (Freetools, panel CLOSED) is drawn,
   `880:936` (Freetools-open) is hidden, and `880:557` (Default) is moot because
   Free Tools is hidden there too. This briefly ran ahead of the file and no
   longer does — the earlier "code leads Figma" note is gone with it.

   The state is toggled at runtime by the trigger, so this cannot be decided
   here — the flag only MARKS the divider and `.fb-tools-open` does the hiding
   in CSS. Deciding it in the template would freeze it at the initial prop. */
let toolsDivider = -1;
if (freeTools) {
  const at = items.findIndex((i) => i.label === 'Webinars');
  const seat = at === -1 ? items.length : at;
  items.splice(seat, 0, {
    label: freeToolsLabel,
    href: freeToolsHref,
    caret: true,
  });
  toolsDivider = seat + 1;
}
---

<footer class:list={['fb', { 'fb-tools-open': hasPanel && toolsOpen }, className]}>
  <nav class="fb-menu-bar" aria-label="Footer">
    <ul class="fb-menu">
      {items.map((item, i) => (
        <li>
          {i > 0 && <span class:list={['fb-div', { 'fb-div-tools': i === toolsDivider }]} aria-hidden="true"></span>}
          {item.caret && hasPanel ? (
            <button type="button" class="fb-menu-link fb-tools-trigger" aria-expanded={toolsOpen ? 'true' : 'false'} aria-controls={panelId}>
              {item.label}
              <svg class="fb-caret" viewBox={CARET_VB} fill="currentColor" aria-hidden="true"><path d={icons.chevronDown.path} /></svg>
            </button>
          ) : (
            <a class="fb-menu-link" href={item.href ?? '#'}>
              {item.label}
              {item.caret && (
                <svg class="fb-caret" viewBox={CARET_VB} fill="currentColor" aria-hidden="true"><path d={icons.chevronDown.path} /></svg>
              )}
            </a>
          )}
        </li>
      ))}
    </ul>
  </nav>

  {hasPanel && (
    <div class="fb-tools" id={panelId} inert={!toolsOpen}>
      <div class="fb-tools-clip">
        <div class="fb-tools-panel">
          <img class="fb-tools-bg" src={asset('footerbar-freetools-bg.png')} alt="" aria-hidden="true" />
          <div class="fb-tools-inner">
            {toolGroups.map((group, gi) => (
              <div class="fb-tools-group" style={`--i:${gi}`}>
                <p class="fb-tools-title">
                  {group.icon && (
                    <svg class="fb-tools-title-icon" viewBox={icons[group.icon].viewBox} fill="currentColor" aria-hidden="true"><path d={icons[group.icon].path} /></svg>
                  )}
                  {group.title}
                </p>
                <div class="fb-tools-cols">
                  {group.columns.map((col) => (
                    <div class="fb-tools-col">
                      {col.map((link) => (
                        <a class="fb-tools-link" href={link.href ?? '#'}>{link.label}</a>
                      ))}
                    </div>
                  ))}
                </div>
              </div>
            ))}
            <button type="button" class="fb-tools-close" style={`--i:${toolGroups.length}`} aria-label={closeToolsLabel}>
              <svg viewBox={icons.xmark.viewBox} fill="currentColor" aria-hidden="true"><path d={icons.xmark.path} /></svg>
            </button>
          </div>
        </div>
      </div>
    </div>
  )}

  <div class="fb-mid">
    <div class="fb-mid-inner">
      <div class="fb-reviews">
        {reviews.map((r) => (
          <div class="fb-review">
            <img class="fb-review-logo" src={asset(r.logo)} alt={r.name} width="32" height="32" />
            <div class="fb-review-rating">
              <img class="fb-stars" src={asset(r.stars)} alt="" width="68" height="12" />
              <img class="fb-stars-hover" src={asset(r.starsHover)} alt="" width="68" height="12" />
              {/* No space before the "/5" — Figma sets the two runs hard against
                  each other, and the separator carries its own size and weight. */}
              <p class="fb-score">{r.score}{r.outOf && <span class="fb-outof">{r.outOf}</span>}</p>
            </div>
          </div>
        ))}
      </div>

      <div class="fb-brand">
        {/* Both lockups are rendered and swapped on hover, the same way TopNav
            does it. At rest Figma's Main logo is the all-white `mono` at 60%;
            hovering reveals `ondark`, which carries the colour mark and the pink
            SOFTWARE. Swapping the file rather than filtering the mono one is
            what makes the mark come back in its real brand colours. */}
        <span class="fb-logo">
          <span class="fb-logo-mono"><Logo kind="wordmark" brand="iron" variant="mono" height={24} basePath={basePath} label="Iron Software" /></span>
          <span class="fb-logo-colour" aria-hidden="true"><Logo kind="wordmark" brand="iron" variant="ondark" height={24} basePath={basePath} label="" /></span>
        </span>
        <p class="fb-address">{address}</p>
      </div>

      <div class="fb-connect">
        <div class="fb-socials">
          {socials.map((s) => (
            <a class="fb-social" href={s.href ?? '#'} aria-label={s.name}>
              <img src={asset(s.icon)} alt="" width="16" height="16" />
            </a>
          ))}
        </div>
        <a class="fb-slack" href={slackHref ?? '#'}>
          <img src={asset('icon-slack.svg')} alt="" width="16" height="16" />
          <span>{slackLabel}</span>
        </a>
      </div>
    </div>
  </div>

  <div class="fb-info">
    <div class="fb-info-inner">
      <div class="fb-partners">
        {partners.map((p) => (
          <img class="fb-partner" src={asset(p.logo)} alt={p.name} width={p.width} height="28" />
        ))}
      </div>

      <div class="fb-legal">
        <p class="fb-copyright">{copyright}</p>
        <div class="fb-legal-links">
          {legal.map((l, i) => (
            <>
              {i > 0 && <span class="fb-div" aria-hidden="true"></span>}
              <a class="fb-legal-link" href={l.href ?? '#'}>{l.label}</a>
            </>
          ))}
        </div>
      </div>

      <div class="fb-donate">
        <span class="fb-donate-label">{donateLabel}</span>
        <img class="fb-donate-img" src={asset(donateImg)} alt="1% for the Planet" height="32" />
      </div>
    </div>
  </div>
</footer>

<style>
  /*
    Token map, 1:1 with the Figma variables on node 877:2953:
      surface/footer-alt      → --color-bg-footer-alt   (menu + brand bands)
      surface/footer          → --color-bg-footer       (legal band)
      text/default/link-menu  → --color-text-link-menu
      text/on dark/heading    → --color-text-on-dark-heading
      text/on dark/body       → --color-text-on-dark-body
      transparent/white/20    → --transparent-white-20  (dividers)
      transparent/white/10    → --transparent-white-10  (review card border)
      Typography/UI/Button default → --font-size-btn / --fw-btn / --leading-4
      Typography/Caption SM        → --font-size-caption-sm / --fw-caption-sm
                                     / --letter-spacing-caption-sm
  */
  .fb { width: 100%; font-family: 'Montserrat', sans-serif; }

  /* ── band 1: menu ─────────────────────────────────────────────────────── */
  .fb-menu-bar { background: var(--color-bg-footer-alt); display: flex; justify-content: center; padding: var(--spacing-xs) var(--spacing-xl) 0; }
  /* 1176px is Figma's own number for the menu row — not a container token. The
     items are centred inside it and only add up to ~866, so the width is
     headroom rather than a visible edge. */
  .fb-menu { display: flex; align-items: center; justify-content: center; flex-wrap: wrap; list-style: none; margin: 0; padding: 0; width: 100%; max-width: 1176px; }
  /* Figma overlaps every item and divider by 1px so a divider shares an edge
     with the item beside it (About Us ends at 257.5, News starts at 256.5).
     Without this the row is 14px wider than the design. */
  .fb-menu li:not(:first-child) { margin-left: -1px; }
  .fb-menu .fb-div { margin-right: -1px; }
  /* Each <li> is a flex container so the divider and the label share one
     baseline — a block <li> would put the inline label on a font strut instead,
     the same 1.4px drift TopNav hit. */
  .fb-menu li { display: flex; align-items: center; }
  .fb-menu-link { display: inline-flex; align-items: center; gap: var(--spacing-xs); padding: var(--spacing-md); font-size: var(--font-size-btn); font-weight: var(--fw-btn); line-height: var(--leading-4); letter-spacing: var(--letter-spacing-btn); color: var(--color-text-link-menu); text-decoration: none; white-space: nowrap; transition: color var(--duration-base); }
  /* The menu palette comes in a pair — link-menu resting, link-menu-hover on
     hover. Same as TopNav's .tn-item. Dimming with opacity instead would drop
     the brand pink the pair exists to deliver. */
  .fb-menu-link:hover { color: var(--color-text-link-menu-hover); }
  /* Measured off the Free tools variant, where the item is visible: 16 padding,
     8 gap, 13x14 caret — 16+71+8+13+16 = the 124 Figma reports. The same node
     in the Default variant is hidden and keeps stale coordinates, so it cannot
     be measured there. */
  .fb-caret { width: 12.25px; height: 7px; flex-shrink: 0; }

  .fb-div { width: 1px; height: var(--leading-4); flex-shrink: 0; background: var(--transparent-white-20); }
  /* `visibility`, not `display`. At lg the divider is 1px against a -1px margin,
     so removing it is layout-neutral — but at md/sm that margin is 0 and the row
     is on a 12px flex gap, where display:none would take 13px out of a wrapping
     menu and move the wrap. Hiding the paint keeps every band identical. */
  .fb-tools-open .fb-div-tools { visibility: hidden; }

  /* ── band 1b: the Free tools panel ───────────────────────────────────────
     Figma's `Free tool open` variant (880:915, section 880:1078). The trigger
     becomes a tab joined to the panel below it, so the two are styled together.

     The open/close is `grid-template-rows: 0fr → 1fr` rather than an animated
     max-height. A max-height has to be a guess: too small clips the panel, too
     large makes the close look like it stalls, and either way the number goes
     stale the moment someone adds a link. 0fr→1fr animates to the content's own
     height with no measuring and no JS. */
  .fb-tools { display: grid; grid-template-rows: 0fr; background: var(--color-bg-footer-alt); transition: grid-template-rows var(--duration-slow) var(--ease-emphasized); }
  .fb.fb-tools-open .fb-tools { grid-template-rows: 1fr; }
  .fb-tools-clip { min-height: 0; overflow: hidden; }

  .fb-tools-panel { position: relative; padding: var(--spacing-xl) var(--spacing-hero) var(--spacing-2xl); }
  /* Figma exports this as a raster. It is a pure vertical gradient — sampled
     across every row the horizontal spread is 1/255 — so stretching it to any
     width is lossless despite the frame being named "Free Tools + dots". */
  .fb-tools-bg { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; pointer-events: none; }
  /* Capped for the same reason as .fb-mid-inner, and to the same edge. The
     panel and its gradient stay full-bleed — only the content stops. The cap is
     the container minus the panel's own hero padding, so at 1440 it is exactly
     the 1280 this row already was and nothing below 1488 moves. Without it the
     last group's `flex: 1 0 0` keeps pushing the close button out to the window
     while the columns stay pinned at 104: measured 2026-08-15 at 2560 with the
     columns at 104 and the row below them starting at 560. */
  .fb-tools-inner { position: relative; display: flex; align-items: flex-start; justify-content: center; gap: var(--spacing-3xl); padding: 0 var(--spacing-xl); max-width: calc(var(--size-container-max) - var(--spacing-hero) * 2); margin-inline: auto; }

  .fb-tools-group { display: flex; flex-direction: column; gap: var(--spacing-md); }
  /* Figma gives the last group `flex: 1 0 0` and stretches it, which is what
     puts the close button against the right edge — 1232 in a 1280 frame. Doing
     it with `margin-left: auto` on the close instead lands the button in the
     same place but leaves this group at its content width, so the measurement
     against the design silently disagrees. */
  .fb-tools-group:last-of-type { flex: 1 0 0; min-width: 0; align-self: stretch; }
  .fb-tools-title { margin: 0; display: flex; align-items: center; gap: var(--spacing-xs); font-size: var(--font-size-xs); font-weight: var(--fw-nav-label); line-height: var(--leading-4); letter-spacing: var(--letter-spacing-nav-label); text-transform: uppercase; color: var(--color-text-on-dark-heading); white-space: nowrap; }
  /* Height, not width. Figma sets these as Font Awesome *text* at 12px, so the
     glyph is 12 tall and as wide as its own aspect ratio makes it — square for
     arrows-rotate and pen-to-square, 13.5 for the 576-wide wrench (Figma rounds
     it to 14). Forcing a 12x12 box instead would squash the wrench. */
  .fb-tools-title-icon { height: 1em; width: auto; flex-shrink: 0; }
  .fb-tools-cols { display: flex; align-items: flex-start; gap: var(--spacing-2xl); }
  .fb-tools-col { display: flex; flex-direction: column; gap: var(--spacing-xs); }
  .fb-tools-link { font-size: var(--font-size-xs); font-weight: var(--fw-nav-label); line-height: var(--leading-4); letter-spacing: var(--letter-spacing-nav-label); color: var(--color-text-link); text-decoration: none; white-space: nowrap; }
  .fb-tools-link:hover { color: var(--color-text-link-hover); }

  .fb-tools-close { flex-shrink: 0; display: flex; align-items: center; justify-content: center; width: 24px; height: 24px; padding: 0; border: 0; border-radius: var(--rounded-sm); background: var(--transparent-black-50); color: var(--color-text-link-menu); cursor: pointer; }
  /* Same rule as the group headings: 14 tall, width from the glyph. `xmark` is
     384x512, so it lands at 10.5 wide against Figma's 11. */
  .fb-tools-close svg { height: 14px; width: auto; display: block; }
  .fb-tools-close:hover { color: var(--color-text-link-menu-hover); }

  /* The trigger is a <button> pretending to be a menu link, so the browser's
     button defaults have to be undone before .fb-menu-link's own rules land.

     The transparent border is reserved so the open tab can paint its edge
     without shifting the row — the same reserve Button documents. Unlike
     Button, this one sits in a row of eight <a>s that carry no border at all,
     so the reserve does not cancel out between siblings: it made this item 50
     where the other eight are 48, and the menu bar 58 against footer-lg
     2373:4247's 56. The compensation therefore belongs on the bordered
     element, which is the direction Button's own note picks. `padding-block`
     rather than a shorthand so the narrow-band override below, which sets its
     own `padding`, keeps deciding that band by itself.

     Border + padding is 16 on each block edge either way, so the label sits on
     exactly the pixels it did before and the open state paints what it always
     painted; only the box stops growing. Measured on the freetools demo at
     1440: menu bar 58 -> 56, and the Free tools item 50 -> 48 beside its eight
     neighbours. Compensating the INLINE edges too would be wrong — the row's
     width is not in dispute, and the sides are what the radius rounds. */
  .fb-tools-trigger { border: var(--border-width-1) solid transparent; padding-block: calc(var(--spacing-md) - var(--border-width-1)); background: none; font-family: inherit; cursor: pointer; border-radius: var(--rounded-lg) var(--rounded-lg) 0 0; }
  .fb.fb-tools-open .fb-tools-trigger { background: var(--slate-800); border-color: var(--transparent-white-10); border-bottom-color: transparent; }
  .fb-caret { transition: transform var(--duration-slow) var(--ease-emphasized); }
  .fb.fb-tools-open .fb-tools-trigger .fb-caret { transform: rotate(180deg); }

  /* Each column rises as the panel opens, one after the next. The delay is only
     applied on the way IN: leaving it on the way out makes closing feel broken,
     because the panel has already collapsed past the content by the time the
     last group starts fading. */
  .fb-tools-group,
  .fb-tools-close { opacity: 0; transform: translateY(8px); transition: opacity var(--duration-slow) var(--ease-default), transform var(--duration-slow) var(--ease-emphasized); }
  .fb.fb-tools-open .fb-tools-group,
  .fb.fb-tools-open .fb-tools-close { opacity: 1; transform: none; transition-delay: calc(var(--i, 0) * 70ms + 80ms); }

  @media (prefers-reduced-motion: reduce) {
    .fb-tools,
    .fb-tools-group,
    .fb-tools-close,
    .fb-caret { transition-duration: 1ms; }
    .fb.fb-tools-open .fb-tools-group,
    .fb.fb-tools-open .fb-tools-close { transition-delay: 0s; }
  }

  /* ── band 2: reviews, brand, socials ──────────────────────────────────── */
  .fb-mid { background: var(--color-bg-footer-alt); display: flex; justify-content: center; padding: var(--spacing-md) var(--spacing-xl) var(--spacing-xl); }
  /* Capped with the legal row below it, which is the row it visibly aligns
     with — the review badges sit directly above the partner logos.

     This used to read "no max-width here on purpose: Figma's middle row is full
     width inside the 24px padding (1392 at a 1440 canvas)". That is still true
     AT the canvas and the cap does not change it: 1440 - 24 - 24 = 1392, so
     every width up to 1488 renders identically. What the note missed is that
     Figma cannot rule on widths it was never drawn at. Above 1488 the other two
     bands stop (.fb-menu at its own 1176, .fb-info-inner at the container) and
     this one kept spreading — measured 2026-08-15 at 1920 with the first review
     badge at x=24 against the partner logo beneath it at x=240, and 24 against
     560 at 2560. Reported from a consuming page, not by anything here: every
     harness in this repo tops out at 1440. */
  .fb-mid-inner { display: flex; align-items: center; gap: var(--spacing-md); width: 100%; max-width: var(--size-container-max); }

  .fb-reviews { display: flex; align-items: flex-start; gap: var(--spacing-md); flex: 1 0 0; min-width: 0; }
  /* An inset shadow, not a border. Figma's 124x48 leaves no room for one
     (8+32+8+68+8 = 124 exactly) because its stroke is drawn *inside* the frame;
     a CSS border on an auto-width box adds 2px instead. */
  .fb-review { display: flex; align-items: center; gap: var(--spacing-xs); padding: var(--spacing-xs); box-shadow: inset 0 0 0 var(--border-width-1) var(--transparent-white-10); border-radius: var(--rounded-sm); }
  .fb-review-logo { width: 32px; height: 32px; display: block; flex-shrink: 0; }
  .fb-review-rating { display: flex; flex-direction: column; align-items: flex-start; }
  /* Figma node 885:630 draws Default State and Hover State side by side for each
     card: the logo and the score are already full strength at rest, and only the
     star row changes — white at 30% to `brand/accent-1` (--color-accent-1) at
     full. Each card hovers on its own. */
  .fb-stars { width: 68px; height: 12px; display: block; }
  .fb-stars-hover { width: 68px; height: 12px; display: none; }
  .fb-review:hover .fb-stars { display: none; }
  .fb-review:hover .fb-stars-hover { display: block; }
  /* Deliberately not flex: the "/ 5" has to keep the space in front of it, and
     flex drops a leading whitespace text node. The 12px span makes the line box
     1px taller than the 20px leading, which the card absorbs. */
  /* The role has a name of its own now — `typography/ui/review` in the W3C
     source, and --font-size/--line-height/--fw/--letter-spacing-review here.
     It used to borrow --fw-btn for the 600 and --letter-spacing-overline for
     the 0.8: the right numbers under the wrong roles, so retuning buttons or
     overlines would have dragged the score along. Figma still binds these as
     loose variables with no type style, and cannot hold one — the score is two
     sizes on one line — so the name lives on this side (Ball, 2026-08-11).
     letter-spacing inherits, so .fb-outof picks the 0.8 up from here. */
  .fb-score { margin: 0; font-size: var(--font-size-review); font-weight: var(--fw-review); line-height: var(--line-height-review); letter-spacing: var(--letter-spacing-review); color: var(--color-text-on-dark-body); white-space: nowrap; }
  /* line-height 1 is not a style choice, it stops this span from growing the
     line box. Two font sizes share one line: the 14px strut is 20 tall, but a
     12px inline box with the same 20px leading has a lower baseline, and the
     line box is the union of both — 20.74, which the card rounds up to 49
     against Figma's 124x48. Capping the smaller run's own leading pulls its
     box back inside the strut without moving the glyphs, which sit on the
     baseline either way. This is also the 1px that made the lg bar 225 tall
     against the 56/88/80 = 224 the design file measures.

     The declaration below said `var(--leading-5)` — 20px, the very leading the
     paragraph above explains this rule exists to escape — from the component's
     first commit (8a58a9c) to 2026-08-25. The comment was never wrong and the
     value never matched it, so nothing here read as suspect and the 1px stayed
     shipped: `.fb-score` measured 21, `.fb-review-rating` 33 against 32,
     `.fb-review` 49 against 48, `.fb-mid` 89 against 88. It survived because
     no gate in this repo measures a band against its node — the arithmetic was
     written down instead of asserted. */
  .fb-outof { font-size: var(--font-size-xs); font-weight: var(--fw-body); line-height: 1; }

  .fb-brand { display: flex; align-items: center; justify-content: center; gap: var(--spacing-lg); flex-shrink: 0; }
  /* Everything in this bar that is dimmed at rest comes back to full strength on
     hover — the brand lockup, the socials, the partner marks. Measured off
     ironsoftware.com, which transitions these over .2s, not the .16s used for
     link colour. */
  .fb-logo { display: flex; align-items: center; opacity: var(--opacity-60); transition: opacity var(--duration-base); }
  .fb-logo:hover { opacity: 1; }
  /* Both wrappers are flex, not the default inline. Logo.astro's root is an
     `inline-flex`, so inside an inline-level wrapper it sits on a baseline and
     the line box adds a 4px descender under a 24px lockup. At 1440 that box is
     centred in a 49px row and the 4 is invisible, but stacked at 768 and 375 it
     lands on the band height — footer-md measured 353 against Figma's 348 until
     this changed. */
  .fb-logo-mono { display: flex; }
  .fb-logo-colour { display: none; }
  .fb-logo:hover .fb-logo-mono { display: none; }
  .fb-logo:hover .fb-logo-colour { display: flex; }
  .fb-address { margin: 0; font-size: var(--font-size-caption-sm); font-weight: var(--fw-caption-sm); line-height: var(--leading-4); letter-spacing: var(--letter-spacing-caption-sm); color: var(--color-text-on-dark-body); opacity: var(--opacity-75); text-align: right; white-space: nowrap; }

  .fb-connect { display: flex; flex-direction: column; align-items: flex-end; gap: var(--spacing-xs); flex: 1 0 0; min-width: 0; }
  /* Each icon lights on its own — Ball's call, 2026-08-02, matching the partner
     marks. The dimming therefore sits on the icon, not on the row: with it on
     .fb-socials there is no way to raise one child above its parent's opacity.

     These five files carried the same baked `opacity="0.6"` the partner marks
     did, here on a `<g id="socials">` — Figma had applied the socials group's
     opacity to every icon on export. Combined with the CSS they rendered at 36%
     and could not pass 60% hovered. Stripped 2026-08-02. */
  .fb-socials { display: flex; align-items: center; gap: var(--spacing-sm); }
  .fb-social { display: flex; opacity: var(--opacity-60); }
  .fb-social img { width: 16px; height: 16px; display: block; }
  .fb-social:hover { opacity: 1; }
  .fb-slack { display: flex; align-items: center; gap: var(--spacing-micro); text-decoration: none; }
  /* 16px, not the 24 the component's own frame reports — the *instance* placed
     in this variant is 16, in a 20px-tall row. The Free tools variant places a
     24px one instead; the two variants disagree in Figma. */
  .fb-slack img { width: 16px; height: 16px; display: block; }
  .fb-slack span { font-size: var(--font-size-sm); line-height: var(--leading-5); color: var(--color-text-on-dark-body); white-space: nowrap; transition: color var(--duration-base); }
  /* This used to be `opacity: var(--opacity-hover-footer)` — 0.8 — so hovering
     the row made it FAINTER, the opposite of every other hover in this bar.
     Figma puts Join Slack outside the socials' opacity group, so there is no
     dimming to undo here; the label goes from on-dark/body to on-dark/heading
     instead, which is the same "back to full strength" move in colour terms. */
  .fb-slack:hover span { color: var(--color-text-on-dark-heading); }

  /* ── band 3: partners, legal, donate ──────────────────────────────────── */
  .fb-info { background: var(--color-bg-footer); display: flex; align-items: center; justify-content: center; padding: var(--spacing-xl); }
  /* No gap: Figma's three columns are exactly a third of 1392 each, so any gap
     here comes straight out of their width (16px of gap = 10.7px off each). */
  .fb-info-inner { display: flex; align-items: center; justify-content: space-between; width: 100%; max-width: var(--size-container-max); }

  .fb-partners { display: flex; align-items: center; gap: var(--spacing-xl); flex: 1 0 0; min-width: 0; }
  /* Figma greys the partner marks with mix-blend-luminosity over the band fill,
     which is why they read as flat grey rather than tinted. Hover drops both the
     blend and the dimming so the mark returns to full colour.

     ironsoftware.com greys these with `filter: brightness(0) invert(.6)` instead —
     a flat silhouette rather than a luminance-preserving blend. The REST
     appearance stays on Figma's mechanism, which is what the design file
     specifies and is only a shade off the site's.

     Each mark lights on its own. This was briefly row-wide (`ab6eeee`); Figma
     node 885:630 then drew Default and Hover per logo, so it is back to
     per-element, which is also what the live site does.

     No transition — Ball's call, 2026-08-02: the swap is immediate. `mix-blend-mode`
     could not animate anyway, so a fading opacity next to a snapping blend mode was
     never one movement.

     The artwork must be full strength for this to work. All three files shipped with
     `opacity="0.6"` baked onto their outer <g> by the Figma export, on top of the 60%
     this CSS applies — so the rest state was really 36% and hover could never pass
     60%, which is what Ball saw. Stripped from the SVGs, 2026-08-02; the dimming now
     lives in exactly one place.

     The same export had also baked `style="mix-blend-mode:luminosity"` onto that <g>,
     which survived the opacity sweep because we were only looking for `opacity`. It
     cost nothing visible in Chrome and broke the hover completely in Safari: WebKit
     flattens that inner blend group against black once, permanently, so the marks
     were greyscale in the file itself and no CSS could bring the colour back. Chrome
     treats the same group as a no-op, which is why it looked fine here for a week.
     Stripped 2026-08-03; measured 0.000 → 0.487 saturation on hover in WebKit
     afterwards, against 0.000 → 0.000 before. The CSS below did not change.

     **If these marks are ever re-exported, strip BOTH `opacity` and
     `mix-blend-mode` off the wrapper <g> — Figma bakes in every group-level paint
     property, and a blend mode does it silently in one engine only.** The five other
     assets carrying a baked `multiply` were checked at the same time and render the
     same in both engines; luminosity is the one that flattens. */
  .fb-partner { height: 28px; width: auto; display: block; mix-blend-mode: luminosity; opacity: var(--opacity-60); }
  .fb-partner:hover { mix-blend-mode: normal; opacity: 1; }

  .fb-legal { display: flex; align-items: center; justify-content: center; gap: var(--spacing-lg); flex: 1 0 0; min-width: 0; }
  .fb-copyright { margin: 0; font-size: var(--font-size-2xs); font-weight: var(--fw-body); line-height: var(--leading-3); color: var(--color-text-on-dark-body); text-align: center; white-space: nowrap; }
  .fb-legal-links { display: flex; align-items: center; justify-content: center; gap: var(--spacing-xs); }
  .fb-legal-links .fb-div { height: var(--leading-3); }
  .fb-legal-link { font-size: var(--font-size-2xs); font-weight: var(--fw-caption-sm); line-height: var(--leading-3); letter-spacing: var(--letter-spacing-btn); color: var(--color-text-link-menu); text-decoration: none; white-space: nowrap; transition: color var(--duration-base); }
  .fb-legal-link:hover { color: var(--color-text-link-menu-hover); }

  /* Dimmed at rest and back to full on hover, same as the brand lockup, the
     socials and the partner marks. Ball's call, 2026-08-02. */
  .fb-donate { display: flex; align-items: center; justify-content: flex-end; gap: var(--spacing-xs); flex: 1 0 0; min-width: 0; opacity: var(--opacity-60); transition: opacity var(--duration-base); }
  .fb-donate:has(:hover) { opacity: 1; }
  /* Figma sets line-height 1.2 on 12px = 14.4, which is off our leading ramp
     (12 → 16). 16 is the nearest step and the label stays centred against the
     32px logo beside it, so the 1.6px is invisible. */
  .fb-donate-label { font-size: var(--font-size-caption-sm); line-height: var(--leading-4); color: var(--color-text-on-dark-body); white-space: nowrap; }
  .fb-donate-img { height: 32px; width: auto; display: block; }

  /* ── responsive ───────────────────────────────────────────────────────────
     Figma draws three frames: footer-lg (877:2953), footer-md (879:649, at
     768) and footer-sm (879:650, at 375). They land on the project's own
     breakpoint scale — --breakpoint-md is 768 and --breakpoint-lg is 1024 — so
     the lg layout holds down to 1024, footer-md covers 768 to 1023 and
     footer-sm everything below. 1024 is also where the lg layout genuinely
     stops fitting: its middle band puts the reviews, the brand lockup, the
     nowrap address and the socials on one line, which needs about 995px inside
     the 24px padding.

     The numbers are written out rather than read from --breakpoint-md/-lg
     because a custom property is not allowed in a media query's condition —
     `@media (max-width: var(--breakpoint-lg))` never matches anything. The .98
     keeps 768 and 1024 themselves on the larger layout, which matters because
     Figma drew footer-md *at* 768.

     Both small frames are two bands where lg is three, but the top two lg
     bands already carry the same fill (surface/footer-alt), so nothing has to
     merge in the DOM — only the padding and the gaps change. */

  /* ── the Free-tools panel only · below 1253 ───────────────────────────────
     The panel's three groups side by side need 1253px, and the bar's own
     breakpoint is at 1024 — so 1024 to 1252 rendered a row that did not fit,
     including 1024, 1152 and 1200. `.fb-tools-clip` is `overflow: hidden` for
     the open/close reveal, so the excess was CUT rather than scrolled: the
     "Others" column lost 75px, the close button and the last group 52.8px, and
     at 1152 the X painted on top of the OTHERS heading. No scrollbar, and
     `document.scrollWidth` clean throughout — the same silent failure as the
     product rows in 3a0198a.

     This is the panel's own breakpoint and not the bar's on purpose. Moving the
     1023.98 below would have brought the whole footer-md layout up with it —
     stacked brand, wrapping menu, the lot — at widths Figma drew footer-lg for.
     The panel is the one part of this component Figma never drew for md or sm
     (all three of its variants live on footer-lg), so it is the one part free to
     have a breakpoint of its own.

     Measured against the alternative. Adopting the md layout here also fixes the
     overflow, but it stacks the groups and takes the panel from 72px to 288px at
     1200 — a laptop-width change out of all proportion to the problem. Shedding
     the hero padding alone is not enough on its own: still 74.98px over at 1024
     and 40.66 at 1100. Padding plus the two gaps clears every width in the band
     with the row intact and the panel still 72px tall.

     It sits BEFORE the footer-md block so that below 1024 the md rules, which
     come later, win — the panel goes on stacking there exactly as it did. */
  @media (max-width: 1252.98px) {
    /* 80 a side is a framing margin for a 1440 canvas; at 1024 it is 160px of
       the width the content needs. */
    .fb-tools-panel { padding: var(--spacing-xl) var(--spacing-xl) var(--spacing-2xl); }
    .fb-tools-inner { gap: var(--spacing-2xl); padding: 0; }
    .fb-tools-cols { gap: var(--spacing-md); }
  }

  /* ── the reviews row only · below 1180 ────────────────────────────────────
     The same band, a different number, because it is different content. The
     middle row — two review cards, the brand lockup, the address, the socials
     and the Slack line — needs 1180px, and it was squashing rather than
     overflowing: `.fb-reviews` is `flex: 1 0 0; min-width: 0`, so flex takes it
     below its own content instead of letting it stick out, and the second card
     left the group by 77.4px at 1024, 39.4 at 1100 and 1.9 at 1175. Same
     mechanism as TopNav's overlapping labels.

     This is the md layout's own grid, lifted to the width where the row
     actually stops fitting rather than left at the bar's 1024. Not the whole md
     block: the menu wrapping, the info row and the paddings all belong to the
     768–1023 frame Figma drew, and only this row's arithmetic changed.

     `min-width: auto` alone was measured first and is not enough — it takes 1024
     from 77.4px over to 18.8, because the row genuinely needs two lines there.
     The brand keeps its horizontal lockup here; going to the md column form as
     well buys nothing at these widths and costs a taller row. */
  @media (max-width: 1179.98px) {
    .fb-mid-inner {
      display: grid;
      grid-template-columns: auto minmax(0, 1fr);
      grid-template-areas: 'reviews reviews' 'brand connect';
      gap: var(--spacing-xl);
      align-items: center;
    }
    .fb-reviews { grid-area: reviews; justify-content: center; }
    .fb-brand { grid-area: brand; }
    .fb-connect { grid-area: connect; }
  }

  /* ── the legal row only · below 1060 ──────────────────────────────────────
     The third band in this component and the smallest: the copyright line and
     its links left `.fb-legal` by 6.19px at 1024, tapering to 1.02 at 1055 and
     gone by 1060. Same cause as the row above — `flex: 1 0 0; min-width: 0`
     lets flex take the group below its own content — but here the fix is only
     to stop that, because there IS room: with the floor restored nothing else
     in the row overflows, at any width in the band. The squash was flex
     distributing badly, not a shortage.

     Deliberately not a layout change. Adopting the md grid also clears it, and
     takes the row from 32px to 68px to buy back six pixels. Tightening the 20px
     gap to 8 clears it too, but that gap is a drawn value and this is not the
     width to argue with it. */
  @media (max-width: 1059.98px) {
    .fb-legal { min-width: auto; }
  }

  /* ── footer-md (879:649) · 768 – 1023 ─────────────────────────────────── */
  @media (max-width: 1023.98px) {
    /* Figma has one container padded 24 on every side. Here that is still two
       elements sharing a fill, so the 24 between the menu and the reviews is
       the menu band's 0 bottom plus the middle band's 24 top. */
    .fb-menu-bar { padding: var(--spacing-xl) var(--spacing-xl) 0; }
    .fb-mid { padding: var(--spacing-xl); }

    /* The menu stops being a row of padded links and becomes a wrapping row on
       a flat 12 gap — including between a divider and the label it belongs to,
       which is why the gap is set on the <li> as well. The 1px overlap goes
       with the padding: it only ever existed to close the gap the padding
       opened between an item and the divider beside it. */
    .fb-menu { gap: var(--spacing-sm); align-content: center; }
    .fb-menu li { gap: var(--spacing-sm); }
    .fb-menu li:not(:first-child) { margin-left: 0; }
    .fb-menu .fb-div { margin-right: 0; }
    .fb-menu-link { padding: 0; }
    /* At padding 0 the open Free-tools tab would paint tight against its
       label, so the trigger keeps 8 of its own and pulls it back out of the
       layout — the item still sits on the same 12 grid as its neighbours. */
    .fb-tools-trigger { padding: 0 var(--spacing-xs); margin: 0 calc(var(--spacing-xs) * -1); }

    /* Reviews take a centred row of their own and the brand lockup and the
       socials share the one below. A grid rather than a wrap because those two
       have to stay on one line while the reviews span both columns. */
    .fb-mid-inner {
      display: grid;
      grid-template-columns: auto minmax(0, 1fr);
      grid-template-areas: 'reviews reviews' 'brand connect';
      gap: var(--spacing-xl);
      align-items: center;
    }
    .fb-reviews { grid-area: reviews; justify-content: center; }
    /* Side by side at 1440, stacked here, and on 4 rather than the 20 the
       horizontal version uses. */
    .fb-brand { grid-area: brand; flex-direction: column; align-items: flex-start; gap: var(--spacing-micro); }
    .fb-connect { grid-area: connect; }
    .fb-address { text-align: left; }

    /* The partner marks and the donate block keep a row; copyright and the
       legal links drop to a centred row underneath. */
    .fb-info-inner {
      display: grid;
      grid-template-columns: auto minmax(0, 1fr);
      grid-template-areas: 'partners donate' 'legal legal';
      gap: var(--spacing-xl);
      align-items: center;
    }
    .fb-partners { grid-area: partners; }
    .fb-donate { grid-area: donate; }
    .fb-legal { grid-area: legal; }

    /* NOT DRAWN — Figma has no md or sm frame for the Free tools panel, all
       three of its variants live on footer-lg. So rather than invent two fixed
       layouts, this one fits itself to whatever width it is given and there is
       not a single breakpoint-specific number in it.

       The groups stack: three side-by-side lists cannot survive 768. Inside a
       group, Figma's editorial column breaks stay intact — each .fb-tools-col
       is still exactly the pair of links the design put together, and auto-fill
       only decides how many of those sit per row. That is the part worth
       protecting: the breaks are an editorial choice, so reflowing the columns
       is fine and redistributing the links between them would not be. */
    .fb-tools-panel { padding: var(--spacing-xl); }
    .fb-tools-inner { display: grid; grid-template-columns: minmax(0, 1fr); gap: var(--spacing-xl); padding: 0; }
    .fb-tools-group:last-of-type { flex: 0 0 auto; align-self: auto; }
    /* 160 is the floor a track may not go under, not a column width; 1fr then
       spreads whatever is left over. It comes from the longest label actually
       in the set — "Password Protect PDF" measures 149px at 12px Montserrat —
       plus headroom, because the labels are `nowrap` and a track narrower than
       its text overflows rather than wrapping.

       The gap drops from lg's 32 to 16 because the two numbers are not
       independent: auto-fill fits n tracks when n*floor + (n-1)*gap clears the
       width, so the gap is spending the same pixels the floor needs. At 720 a
       32 gap holds four 150s but only three 160s, and at 343 it holds two 150s
       but only one 160 — raising the floor for safety silently halved the
       columns. At 16 the counts are 4 per row at 768 and 2 at 375 with the
       full 11px of headroom kept. Measured, not reasoned: every one of the 14
       labels was checked against its own track at 1440/768/375/320. */
    .fb-tools-cols { display: grid; grid-template-columns: repeat(auto-fill, minmax(160px, 1fr)); gap: var(--spacing-md); }
    /* Last in flow rather than pinned to a corner. Absolute top-right would sit
       on top of the first group's links once the groups span the full width,
       and moving it up visually would put it first on screen while it stays
       last in the tab order. Escape still closes from anywhere in the bar. */
    .fb-tools-close { justify-self: end; }
  }

  /* ── footer-sm (879:650) · below 768 ──────────────────────────────────── */
  @media (max-width: 767.98px) {
    /* 16 at the sides instead of 24. The vertical 24 does not change. */
    .fb-menu-bar { padding: var(--spacing-xl) var(--spacing-md) 0; }
    .fb-mid { padding: var(--spacing-xl) var(--spacing-md); }
    .fb-info { padding: var(--spacing-xl) var(--spacing-md); }
    /* The panel narrows with the bands it sits between. */
    .fb-tools-panel { padding: var(--spacing-xl) var(--spacing-md); }

    /* Everything below the menu stacks and centres, and the rhythm opens from
       24 to 32 — Figma sets that gap on both the reviews-to-brand step and the
       brand-to-socials one. */
    .fb-mid-inner {
      grid-template-columns: minmax(0, 1fr);
      grid-template-areas: 'reviews' 'brand' 'connect';
      gap: var(--spacing-2xl);
    }
    .fb-brand { align-items: center; }
    .fb-connect { align-items: center; }
    /* The one width where the address is allowed to break. At 1440 and at 768
       it is a single nowrap line; at 375 Figma gives it the full 343 and it
       falls onto two, breaking after USA on its own. */
    .fb-address { white-space: normal; text-align: center; }

    .fb-info-inner {
      grid-template-columns: minmax(0, 1fr);
      grid-template-areas: 'partners' 'donate' 'legal';
    }
    .fb-partners { justify-content: center; }
    .fb-donate { justify-content: center; }
    /* Copyright above the links rather than beside them, and at 12 not 20. */
    .fb-legal { flex-direction: column; gap: var(--spacing-sm); }
  }
</style>

<script>
  // Disclosure pattern (WAI-ARIA APG): the trigger owns aria-expanded and points
  // at the panel with aria-controls. The panel stays in the DOM so it can
  // animate, which means it also stays in the tab order — `inert` is what keeps
  // a collapsed panel from swallowing focus. Toggling display or visibility
  // instead would fix focus and kill the animation.
  function initFooterTools(root: ParentNode = document) {
    root.querySelectorAll<HTMLElement>('.fb:not([data-fb-init])').forEach((fb) => {
      const trigger = fb.querySelector<HTMLButtonElement>('.fb-tools-trigger');
      const panel = fb.querySelector<HTMLElement>('.fb-tools');
      if (!trigger || !panel) return;
      fb.dataset.fbInit = '1';

      const setOpen = (open: boolean) => {
        fb.classList.toggle('fb-tools-open', open);
        trigger.setAttribute('aria-expanded', String(open));
        // inert lands immediately in both directions. It hides the subtree from
        // focus and assistive tech without touching layout, so the closing
        // animation still plays out underneath it.
        if (open) panel.removeAttribute('inert');
        else panel.setAttribute('inert', '');
      };

      const close = (returnFocus: boolean) => {
        if (!fb.classList.contains('fb-tools-open')) return;
        setOpen(false);
        if (returnFocus) trigger.focus();
      };

      trigger.addEventListener('click', () => setOpen(!fb.classList.contains('fb-tools-open')));
      panel.querySelector<HTMLButtonElement>('.fb-tools-close')?.addEventListener('click', () => close(true));

      // Escape closes from anywhere inside the footer, and hands focus back to
      // the trigger — otherwise it is left on a control that just went inert.
      fb.addEventListener('keydown', (e) => {
        if ((e as KeyboardEvent).key === 'Escape') close(true);
      });
    });
  }

  document.addEventListener('DOMContentLoaded', () => initFooterTools());
  document.addEventListener('astro:page-load', () => initFooterTools());
</script>
