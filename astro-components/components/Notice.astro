---
/**
 * Built to Figma's spec frame `852:1267` (↳ Notice), which Ball ruled the side to
 * follow on 2026-11-18, and drawn there since as the `Notice` component set
 * `1733:73` (variant × intent) — the spec frame now holds its instances.
 *
 * The bands are measured on the docs page's `figma` region, which renders all
 * ten at Figma's 645 with each frame's own copy: a notice's height IS its copy,
 * so any other text would answer a different question.
 *
 * All ten are declared, and agree to the pixel. Until Figma moved the bordered icon
 * out of the text (2026-11-18), bordered could not be: a line holding a 20px glyph
 * among 16px text grows by 1 in Figma (a glyph of 17 or less keeps it at 28), so
 * Figma said 101 / 73 where a browser says 100 / 72. The icon is its own layer now,
 * the text is indented 24 on its first line, and the lines are 28 on both sides.
 *
 * @figma-size info-filled
 *   node   1733:74
 *   frame  Notice
 *   page   component-notice.html
 *   region figma
 *   select [data-figma="info-filled"] > aside
 *   at     1440
 *   height 168
 *   why    title 28 + 8 + three lines of 28 + 24 + 24
 *
 * @figma-size success-filled
 *   node   1733:84
 *   frame  Notice
 *   page   component-notice.html
 *   region figma
 *   select [data-figma="success-filled"] > aside
 *   at     1440
 *   height 112
 *   why    title 28 + 8 + one line of 28 + 24 + 24
 *
 * @figma-size important-filled
 *   node   1733:94
 *   frame  Notice
 *   page   component-notice.html
 *   region figma
 *   select [data-figma="important-filled"] > aside
 *   at     1440
 *   height 140
 *   why    title 28 + 8 + two lines of 28 + 24 + 24
 *
 * @figma-size warning-filled
 *   node   1733:104
 *   frame  Notice
 *   page   component-notice.html
 *   region figma
 *   select [data-figma="warning-filled"] > aside
 *   at     1440
 *   height 112
 *   why    title 28 + 8 + one line of 28 + 24 + 24
 *
 * @figma-size danger-filled
 *   node   1733:114
 *   frame  Notice
 *   page   component-notice.html
 *   region figma
 *   select [data-figma="danger-filled"] > aside
 *   at     1440
 *   height 112
 *   why    title 28 + 8 + one line of 28 + 24 + 24
 *
 * @figma-size info-bordered
 *   node   1733:81
 *   frame  Notice
 *   page   component-notice.html
 *   region figma
 *   select [data-figma="info-bordered"] > aside
 *   at     1440
 *   height 100
 *   why    8 + three lines of 28 + 8
 *
 * @figma-size success-bordered
 *   node   1733:91
 *   frame  Notice
 *   page   component-notice.html
 *   region figma
 *   select [data-figma="success-bordered"] > aside
 *   at     1440
 *   height 72
 *   why    8 + two lines of 28 + 8
 *
 * @figma-size important-bordered
 *   node   1733:101
 *   frame  Notice
 *   page   component-notice.html
 *   region figma
 *   select [data-figma="important-bordered"] > aside
 *   at     1440
 *   height 72
 *   why    8 + two lines of 28 + 8
 *
 * @figma-size warning-bordered
 *   node   1733:111
 *   frame  Notice
 *   page   component-notice.html
 *   region figma
 *   select [data-figma="warning-bordered"] > aside
 *   at     1440
 *   height 72
 *   why    8 + two lines of 28 + 8
 *
 * @figma-size danger-bordered
 *   node   1733:121
 *   frame  Notice
 *   page   component-notice.html
 *   region figma
 *   select [data-figma="danger-bordered"] > aside
 *   at     1440
 *   height 72
 *   why    8 + two lines of 28 + 8
 */
interface Props {
  /** `filled` is a tinted card with the title on its own line; `bordered` is a left bar with the title leading into the text. */
  variant?: 'filled' | 'bordered';
  /** The icon and bar colour, by meaning — the text itself always stays neutral. */
  intent?: 'info' | 'success' | 'important' | 'warning' | 'danger';
  /** The bold heading, or the lead-in on `bordered`. */
  title: string;
  /** The body paragraph. */
  text: string;
  /**
   * Whether the notice announces itself to a screen reader.
   * Default: `true` for a notice that appeared in response to something the user
   * did, which is what the intents describe. Pass `false` when the notice is
   * static page furniture — a live region that is already on screen at load can
   * be announced out of nowhere, which is worse than saying nothing.
   */
  live?: boolean;
  /** Extra classes on the `<aside>`, after the component's own. */
  class?: string;
}

const { variant = 'filled', intent = 'info', title, text, live = true, class: className } = Astro.props;

/* warning and danger interrupt; the rest wait for a pause. Nothing here invents a
   role for a notice that opted out of being live — `role="status"` with no live
   behaviour would be a lie to the accessibility tree. */
const role = !live ? undefined : intent === 'danger' || intent === 'warning' ? 'alert' : 'status';

import { icons } from '../icons';

// Figma's five intent icons (FA 7 Pro Regular, exported from the `icon` frames on
// ↳ Notice — see icons.ts). One 20x20 box each, ink centred, so filled and
// bordered render the same pair at two sizes.
const iconFor = {
  info: icons.noticeInfo,
  success: icons.noticeSuccess,
  important: icons.noticeImportant,
  warning: icons.noticeWarning,
  danger: icons.noticeDanger,
} as const;
const icon = iconFor[intent];
/* Bordered sets the icon inline at 20px of INK. The 20-box carries 2 units of air
   on each side (ink 16, centred), so the inline icon crops to the ink box and
   draws it at 20 — no negative margin, nothing outside the paragraph. important's
   message tail reaches y=19, one unit past the crop: `overflow: visible` keeps it. */
const INLINE_VIEWBOX = '2 2 16 16';
---

<aside class:list={['notice', `notice--${variant}`, `notice--${intent}`, className]} role={role}>
  {variant === 'filled' ? (
    <>
      <p class="notice-header">
        <svg class="notice-icon" viewBox={icon.viewBox} fill="currentColor" aria-hidden="true"><path d={icon.path} /></svg>
        <strong class="notice-title">{title}</strong>
      </p>
      <p class="notice-text">{text}</p>
    </>
  ) : (
    <p class="notice-text"><svg class="notice-icon" viewBox={INLINE_VIEWBOX} fill="currentColor" aria-hidden="true"><path d={icon.path} /></svg> <strong>{title}:</strong> {text}</p>
  )}
</aside>

<style>
  /*
    The root is <aside> on purpose. The HTML spec names "call-out boxes" as an
    aside, which is exactly what this is — and the element costs nothing in the
    accessibility tree here, because the default `role` prop puts status/alert on
    it and an explicit role overrides the complementary landmark. Only a notice
    built with `live={false}` becomes a landmark, which is the one case where a
    standing call-out genuinely is complementary content.

    Both paragraphs zero their own margin. The docs pages get this free from the
    `*` reset in docs.css, so nothing here re-renders — but a consumer app with no
    reset was picking up the UA's 1em block margins on top of the flex `gap`, and
    the component cannot assume someone else zeroed them.
  */
  /*
    Every value below is read off Figma's spec frame `852:1267` (↳ Notice) on
    2026-11-18, when Ball ruled Figma the side to follow:
      · 645 wide — every frame, both variants.
      · body 16/28 (Typography/body), title-lg 18/28 bold for the filled title,
        body-title 16/28 bold for the bordered lead-in.
      · filled: padding spacing-xl (24), gap spacing-xs (8), rounded-lg; icon in
        a 20x20 box with 8 to the title, so the title starts at 28; text BODY.
      · bordered: padding spacing-xs down (8) and spacing-xl across (24, counted
        from the outer edge — so 20 after the 4px bar); the icon sits inline at
        20px of ink, the 20-box cropped to its ink.
  */
  .notice { display: flex; flex-direction: column; gap: var(--spacing-xs); padding: var(--spacing-xl); max-width: 645px; box-sizing: border-box; }
  .notice-icon { flex-shrink: 0; }
  .notice-header { display: flex; align-items: center; gap: var(--spacing-xs); margin: 0; }
  .notice-header .notice-icon { width: 20px; height: 20px; }
  .notice-title { font-family: 'Montserrat', sans-serif; font-size: var(--font-size-title-lg); line-height: var(--line-height-title-lg); font-weight: var(--fw-title-lg); color: var(--color-text-heading); }
  .notice-text { font-family: 'Montserrat', sans-serif; font-size: var(--font-size-body); line-height: var(--line-height-body); font-weight: var(--fw-body); margin: 0; color: var(--color-text-body); }
  .notice-text strong { font-weight: var(--fw-body-title); }
  /* inline: the ink box (viewBox 2 2 16 16) drawn at 20 — Figma's 20px glyph */
  /* top of the 28px line, then 4 down: (28 - 20) / 2, as Figma places it. `relative`
     moves the paint, not the line box, so the line stays 28. */
  .notice-text .notice-icon { width: 20px; height: 20px; vertical-align: top; position: relative; top: 4px; overflow: visible; }

  /* filled — tinted rounded card, only the icon carries the intent colour */
  .notice--filled { border-radius: var(--rounded-lg); }

  /* bordered — no fill, a coloured left bar; icon carries the intent colour, text stays neutral */
  .notice--bordered { border-left: var(--border-width-4) solid; padding: var(--spacing-xs) var(--spacing-xl) var(--spacing-xs) calc(var(--spacing-xl) - var(--border-width-4)); }

  /* Each intent reads its own fill and accent tokens (tokens.css "Notice"), which
     re-theme under .dark to Badge's dark fills and */300 accents — Ball's option B,
     2026-11-18. Before that the fills were bare */50 primitives that stayed light in
     dark mode under light text: 1.19:1. */
  .notice--info      { --notice-fill: var(--color-notice-info-fill);      --notice-accent: var(--color-notice-info-accent); }
  .notice--success   { --notice-fill: var(--color-notice-success-fill);   --notice-accent: var(--color-notice-success-accent); }
  .notice--important { --notice-fill: var(--color-notice-important-fill); --notice-accent: var(--color-notice-important-accent); }
  .notice--warning   { --notice-fill: var(--color-notice-warning-fill);   --notice-accent: var(--color-notice-warning-accent); }
  .notice--danger    { --notice-fill: var(--color-notice-danger-fill);    --notice-accent: var(--color-notice-danger-accent); }
  .notice--filled { background: var(--notice-fill); }
  .notice-icon { color: var(--notice-accent); }
  .notice--bordered { border-left-color: var(--notice-accent); }
</style>
