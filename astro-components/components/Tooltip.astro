---
import { randomUUID } from 'node:crypto';
// Figma draws the link's trailing arrow as a Font Awesome `arrow-right` glyph in
// a 16px box. `icons.arrowRight` is that same glyph, so this needs no new asset.
import { icons, type IconName } from '../icons';

interface Props {
  /** Figma's `Variant`. `action` left-aligns the bubble and opens the title's
   *  icon slot; `default` centres everything. A tooltip carrying a link is
   *  `action` whether or not you say so — Figma draws no centred tooltip with a
   *  link, and that inference is what the component did before the prop existed. */
  variant?: 'default' | 'action';
  title?: string;
  /** Leading glyph in the title, by name from `../icons`. Figma draws
   *  `buildings`; any icon in the set works. Needs a `title` to sit in, and is
   *  ignored on the `default` variant, which Figma draws without one. */
  icon?: IconName;
  body: string;
  linkHref?: string;
  linkText?: string;
  placement?: 'above' | 'below' | 'left' | 'right';
  /** Widens the bubble to a fixed 350px for long copy. Was `maxWidth` until
   *  2026-08-06 — a boolean named like a length, setting `width`, not `max-width`. */
  wide?: boolean;
  class?: string;
}

const {
  variant = 'default',
  title,
  icon,
  body,
  linkHref,
  linkText,
  placement = 'above',
  wide = false,
  class: className,
} = Astro.props;

const arrowFor = { above: 'arrow-bottom', below: 'arrow-top', left: 'arrow-right', right: 'arrow-left' } as const;

// Unique per instance so aria-describedby ties the trigger to this bubble even
// when several tooltips render on the same page.
const ttId = `tt-${randomUUID().slice(0, 8)}`;
// Figma centres a plain tooltip but left-aligns the one carrying a link. That
// inference predates the `variant` prop and stays, so callers written before it
// keep the layout they had; `variant="action"` is the way to ask for it outright.
const hasLink = Boolean(linkHref && linkText);
const isAction = variant === 'action' || hasLink;
// Figma puts the leading glyph in the Action title only, so an icon on a centred
// tooltip is a combination the canvas does not draw and is dropped rather than
// invented. It also needs a title to sit in.
const titleIcon = isAction && title && icon ? icons[icon] : null;
---

<span class:list={['tt', 'show-on-hover', className]} tabindex="0" aria-describedby={ttId}>
  <slot />
  <span id={ttId} role="tooltip" class:list={['tt-bubble', placement, { wide, 'has-link': isAction }]}>
    <span class:list={['tt-arrow', arrowFor[placement]]}></span>
    <!-- .tt-content holds the rounded, filled box; keeps the arrow un-clipped -->
    <span class="tt-content">
      {title && (
        <span class:list={['tt-title', { 'has-icon': titleIcon }]}>
          {titleIcon && (
            <span class="tt-title-icon"><svg viewBox={titleIcon.viewBox} fill="currentColor" aria-hidden="true"><path d={titleIcon.path}/></svg></span>
          )}
          {title}
        </span>
      )}
      <span class="tt-body">{body}</span>
      {linkHref && linkText && (
        <a class="tt-link" href={linkHref}>
          {linkText}
          {/* An icon, not a "→" character. Montserrat has no arrow glyph, so a
              bare one falls through the font stack to the system face and
              changes width — the same trap FormCard and Select hit. */}
          <span class="tt-link-icon"><svg viewBox={icons.arrowRight.viewBox} fill="currentColor" aria-hidden="true"><path d={icons.arrowRight.path}/></svg></span>
        </a>
      )}
    </span>
  </span>
</span>

<style>
  .tt { position: relative; display: inline-block; }
  .tt-bubble { position: absolute; width: 200px; display: none; flex-direction: column; z-index: 20; text-align: center; }
  .tt-bubble.has-link { text-align: left; }
  .tt-bubble.js-open { display: flex; }
  .tt-bubble.wide { width: 350px; }
  .tt-bubble.above { bottom: calc(100% + 10px); left: 50%; transform: translateX(-50%); }
  .tt-bubble.below { top: calc(100% + 10px); left: 50%; transform: translateX(-50%); }
  .tt-bubble.right { left: calc(100% + 10px); top: 50%; transform: translateY(-50%); }
  .tt-bubble.left  { right: calc(100% + 10px); top: 50%; transform: translateY(-50%); }
  /* .tt-content is separate from .tt-bubble so overflow:hidden (needed to clip the
     title bar's square corners) doesn't also clip the arrow poking out of .tt-bubble */
  /* z-index so the box covers the inner half of the arrow's rotated square —
     see .tt-arrow. Without it the arrow paints a dark diamond corner across the
     bubble's lighter fill, because a positioned sibling wins over a static one
     whatever the DOM order. */
  .tt-content { background: var(--neutral-800); border: var(--border-width-1) solid var(--neutral-950); border-radius: var(--rounded-md); box-shadow: var(--shadow-tooltip); overflow: hidden; display: flex; flex-direction: column; position: relative; z-index: 1; }
  /* Figma types the link as `Typography/UI/Button small` outright — semibold with
     wide tracking — and gives the title the same 600, so both borrow --fw-btn-sm
     rather than earning a weight token of their own. */
  .tt-title { padding: var(--spacing-xs) var(--spacing-md); font-size: var(--font-size-sm); font-weight: var(--fw-btn-sm); color: var(--color-text-on-dark-heading); background: var(--neutral-950); line-height: var(--leading-5); }
  .tt-body { padding: var(--spacing-sm) var(--spacing-md) var(--spacing-md); font-size: var(--font-size-xs); font-weight: 400; color: var(--color-text-on-dark-body); line-height: var(--leading-5); }
  /* Figma keeps body and link in ONE padded box: 12 above the body, 12 between
     the two, 16 below the link. Flattened here into two siblings, the 16 has to
     move to the bottom of the link and the body's own bottom becomes the 12 —
     the code had those two numbers the other way round. With no link the body
     is the last child and keeps the box's 16. */
  .has-link .tt-body { padding-bottom: var(--spacing-sm); }
  /* Only the icon turns the title into a flex row. Left as-is otherwise, because
     `.tt-title` is worn by hand-written cells across the docs page that hold a
     bare text node, and making every title a flex container would have changed
     all of them to buy nothing. Figma's Action title is gap-xs, items-center. */
  .tt-title.has-icon { display: flex; align-items: center; gap: var(--spacing-xs); }
  /* 16px box, and the glyph's own 14px of ink is already centred inside its 16
     viewBox — the same box-vs-ink split as the link's trailing arrow. Colour is
     Figma's `brand/secondary`, which is this system's --color-secondary. */
  .tt-title-icon { display: inline-flex; align-items: center; justify-content: center; width: 16px; height: 16px; flex-shrink: 0; color: var(--color-secondary); }
  .tt-title-icon svg { display: block; width: 16px; height: 16px; }
  /* Two tokens that resolve to the same #2693EC today, kept apart because they
     mean different things and Figma binds them separately: the icon is
     `brand/secondary`, the link text is `text/default/link` (Ball's ruling,
     2026-08-10, matching TextLink's plain variant, which pairs it with
     --color-text-link-hover). They part company under the root `.dark` remap.

     line-height 1 is Figma's `Typography/UI/btn-sm` outright; without it the row
     inherits whatever the host page sets. */
  .tt-link { display: inline-flex; align-items: center; gap: var(--spacing-micro); font-size: var(--font-size-xs); font-weight: var(--fw-btn-sm); line-height: 1; letter-spacing: var(--letter-spacing-caption-sm); color: var(--color-text-link); text-decoration: none; padding: 0 var(--spacing-md) var(--spacing-md); transition: color var(--duration-fast); }
  .tt-link:hover, .tt-link:focus-visible { color: var(--color-text-link-hover); }
  /* Figma centres a 12px glyph in a 16px box, so the gap token measures to the
     box edge and not to the ink. */
  .tt-link-icon { display: inline-flex; align-items: center; justify-content: center; width: 16px; height: 16px; flex-shrink: 0; }
  .tt-link-icon svg { display: block; width: 12px; height: 12px; }
  /* Figma's arrow is 12 across and 5.17157 deep, which is not an arbitrary
     number: it is a 90-degree tip with a 2px corner radius, and 6 - 2(√2 - 1) =
     5.17157 exactly. So it is a square rotated 45 degrees with one corner
     rounded, not a triangle — which is why this is a rotated box and not the
     border trick it used to be. A CSS border triangle cannot round its tip, and
     it was also drawing the full 6px depth.

     Side 8.4853 = 12 / √2, so the visible half spans Figma's 12. Offsetting by
     half the side puts the square's centre on the bubble edge, and .tt-content
     covers the half that ends up inside. Deliberately NOT an inline SVG: the
     arrow is worn by 19 hand-written cells across the docs page, and a markup
     change would have left every one of them without an arrow. */
  .tt-arrow { position: absolute; width: 8.4853px; height: 8.4853px; background: var(--neutral-950); z-index: 0; }
  .tt-arrow.arrow-bottom { left: 50%; bottom: -4.2426px; transform: translateX(-50%) rotate(45deg); border-bottom-right-radius: 2px; }
  .tt-arrow.arrow-top    { left: 50%; top: -4.2426px; transform: translateX(-50%) rotate(45deg); border-top-left-radius: 2px; }
  .tt-arrow.arrow-left   { top: 50%; left: -4.2426px; transform: translateY(-50%) rotate(45deg); border-bottom-left-radius: 2px; }
  .tt-arrow.arrow-right  { top: 50%; right: -4.2426px; transform: translateY(-50%) rotate(45deg); border-top-right-radius: 2px; }
</style>

<script>
  /* Pure-CSS :hover breaks when there's a gap between trigger and bubble (mouse
     crosses empty space before reaching a link inside). JS with a short close-delay
     keeps it open while moving from the trigger, across the gap, into the bubble. */
  function initTooltips(root: ParentNode = document) {
    root.querySelectorAll<HTMLElement>('.tt.show-on-hover:not([data-tt-init])').forEach((tt) => {
      tt.dataset.ttInit = '1';
      const bubble = tt.querySelector<HTMLElement>('.tt-bubble');
      if (!bubble) return;
      let closeTimer: ReturnType<typeof setTimeout> | null = null;
      const open = () => { if (closeTimer) clearTimeout(closeTimer); bubble.classList.add('js-open'); };
      const scheduleClose = () => {
        if (closeTimer) clearTimeout(closeTimer);
        closeTimer = setTimeout(() => bubble.classList.remove('js-open'), 200);
      };
      tt.addEventListener('mouseenter', open);
      tt.addEventListener('mouseleave', scheduleClose);
      tt.addEventListener('focusin', open);
      tt.addEventListener('focusout', scheduleClose);
      // WCAG 1.4.13 — dismissible: Esc hides the bubble without moving focus.
      tt.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && bubble.classList.contains('js-open')) {
          if (closeTimer) clearTimeout(closeTimer);
          bubble.classList.remove('js-open');
        }
      });
    });
  }

  document.addEventListener('DOMContentLoaded', () => initTooltips());
  document.addEventListener('astro:page-load', () => initTooltips());
</script>
