---
/**
 * ProductMenu — the full-width product header from Figma node 790:4778
 * ("Product menu", canvas 231:1473 " ↳ Navigation menu").
 *
 * Two variants, matching Figma's `Varient` property:
 *   default  — one 72px tier: product lockup · menu · search/AI · CTA
 *   submenu  — adds a second 65px tier of sub-navigation chips
 *
 * Figma's own property names are kept where they exist (`hasTrailingIcon`,
 * `showMenuItems2`) so the component stays traceable to the design file.
 *
 * NOTE: Figma specifies this at 1440px desktop only — its Do/Don't sheet talks
 * about "desktop screen breakpoints" and there is no mobile frame. The narrow
 * behaviour below (drop the runtime label, then the util bubbles, then let the
 * menu scroll) is an implementation decision, not a design that was handed over.
 *
 * ── The bands this component declares, and what draws them ────────────────
 *
 * The two tiers are the claim, and so is their sum: `790:4779` is 140, which is
 * the 72 above plus the 68 below, and all of it is declared so a tier cannot
 * move without one of them saying so. Inside the second tier the same shape
 * again — 68 is 12 + the 44 the chips stand in + 12.
 *
 * ALL FOUR OF THOSE MOVED ON 2026-09-03 and no gate could have said so. Ball
 * bound the chip label to `Typography/UI/nav-sub`, whose `leading/5` is 20 where
 * the unbound Gotham it replaced sat at 17: the chip went 41 → 44, the tier 65 →
 * 68, the variant 137 → 140. `check:figma-size` compares the RENDER against the
 * number written here, so while the component and this block agreed with each
 * other it stayed green against a node that had moved underneath both. A
 * declared band is a claim about a node at the moment someone read it.
 *
 * FOUR THINGS IN THIS BAR CANNOT BE DECLARED, and that is the gate refusing
 * rather than passing. `.pm-bar`, `.pm-brand`, `.pm-item`, `.pm-utils` and
 * `.pm-right` are either `min-height: 72px` or flex children stretched into it,
 * so 10px of injected padding does not move them and arm 3 will not call the
 * reading a reading. Their node heights — 40 for the lockup, 36 for the util
 * pair, 48 for the CTA — describe CONTENT inside a stretched box, which is a
 * different question from the one this gate asks.
 *
 * @figma-size cta
 *   node   314:205
 *   frame  Product menu
 *   page   component-productmenu.html
 *   region default
 *   select .pm-right
 *   at     1440
 *   height 48
 *   why    the CTA row with button-Nuget in it; 12 + 48 + 12 is the tier
 *
 * @figma-size cta-button
 *   node   314:205
 *   frame  Product menu
 *   page   component-productmenu.html
 *   region cta-button
 *   select .pm-right
 *   at     1440
 *   height 48
 *   why    the same row with 231:1411 swapped in, which is why md is fixed
 *
 * @figma-size bar
 *   node   790:1177
 *   frame  Product menu
 *   page   component-productmenu.html
 *   region default
 *   select .pm
 *   at     1440
 *   height 72
 *   why    the whole component in the one-tier variant; it was 73
 *
 * @figma-size bar-submenu
 *   node   790:4779
 *   frame  Product menu
 *   page   component-productmenu.html
 *   region submenu
 *   select .pm
 *   at     1440
 *   height 140
 *   why    72 + 68, and both halves are declared below
 *
 * @figma-size sub
 *   node   799:846
 *   frame  Product menu
 *   page   component-productmenu.html
 *   region submenu
 *   select .pm-sub
 *   at     1440
 *   height 68
 *   why    the second tier; 12 + 44 + 12, with its rule inside
 *
 * @figma-size sub-inner
 *   node   799:847
 *   frame  Product menu
 *   page   component-productmenu.html
 *   region submenu
 *   select .pm-sub-inner
 *   at     1440
 *   height 44
 *   why    the chip row itself, inset 12 from the tier
 *
 * @figma-size chip
 *   node   507:5503
 *   frame  Product menu
 *   page   component-productmenu.html
 *   region submenu
 *   select .pm-chip
 *   at     1440
 *   height 44
 *   why    seven Product sub menu instances: the lead, five in the slot, one in
 *   count  7
 *
 * The chips used to land on 40.8 against a 41 node, and that 0.2 was written up
 * here as `line-height: 1.2` on 14px giving 16.8 where the node's text sat at
 * 17, with the note that the day the label got a type role in Figma was the day
 * to spend it. It did, on 2026-09-03: `Typography/UI/nav-sub` is 14/20, the
 * component takes `--line-height-nav-sub` now, and 12 + 20 + 12 is 44 exactly
 * with no remainder to explain.
 */

// chevron-down and graduation-cap each repeat several times below — see ../icons.
// The search / Ask AI / CTA vectors stay inline: one use each, and the CTA glyph
// needs fill-rule="evenodd", which the shared Icon shape does not model.
import { icons } from '../icons';
import NugetButton from './NugetButton.astro';
import Button from './Button.astro';

interface MenuItem {
  label: string;
  href?: string;
  active?: boolean;
  /** Figma shows a caret on every top item except the active one. */
  caret?: boolean;
}

interface SubItem {
  label: string;
  href?: string;
}

interface Props {
  variant?: 'default' | 'submenu';
  /** Mark artwork — same keys as Logo.astro's `product`. */
  product?: string;
  /** Coloured half of the wordmark, e.g. "PDF" in IRONPDF. */
  productName?: string;
  /** Trailing runtime label, e.g. "for .NET". Omit to hide. */
  runtime?: string;
  productHref?: string;
  /** Figma `hasTrailingIcon` — the caret after the product lockup. */
  hasTrailingIcon?: boolean;
  items?: MenuItem[];
  /** Sub tier: the current-page chip, drawn boxed. Figma keeps its label the
   *  default colour and turns it brand-pink only on hover. */
  subLead?: SubItem;
  subItems?: SubItem[];
  /** Figma `showMenuItems2` — trailing links at the right end of the sub tier. */
  showMenuItems2?: boolean;
  subItemsTrailing?: SubItem[];
  /**
   * Which component fills the CTA slot. Figma models this as an INSTANCE-SWAP
   * property called `Instance` on `790:4778`, whose preferred list is exactly
   * two: `button-Nuget` and `button` pinned at `231:1411`
   * (`Variant=primary, Size=md`). A closed set of two is a prop here rather
   * than a slot — it is an enum on the canvas, this repo does not spell a
   * variant axis as a boolean or an open hole, and a prop is the only one of
   * the two that `check:props-table` and the manifest can see.
   *
   * BOTH VALUES ARE 48 TALL AND THAT IS THE WHOLE CONSTRAINT. `314:205` is
   * 368 x 48.0004 inside a 72 tier — 12 + 48 + 12 — so the swap is safe only at
   * `size=md`. `button` at lg is 56 and would make the tier 80; that is why the
   * preferred instance is pinned to a VARIANT and not to the `231:1406` set,
   * and why `size` is fixed here rather than exposed. The `cta` band below
   * measures both values so a future edit cannot quietly reintroduce it.
   */
  cta?: 'nuget' | 'button';
  ctaLabel?: string;
  ctaHref?: string;
  showSearch?: boolean;
  showAskAi?: boolean;
  searchLabel?: string;
  askAiLabel?: string;
  basePath?: string;
  class?: string;
}

const {
  variant = 'default',
  product = 'pdf',
  productName = 'PDF',
  runtime = 'for .NET',
  productHref = '/',
  hasTrailingIcon = true,
  items = [],
  subLead,
  subItems = [],
  showMenuItems2 = false,
  subItemsTrailing = [],
  cta = 'nuget',
  ctaLabel = 'Start for Free',
  ctaHref = '#',
  showSearch = true,
  showAskAi = true,
  searchLabel = 'Search',
  askAiLabel = 'Ask AI',
  basePath = 'assets',
  class: className,
} = Astro.props;

const markSrc = `${basePath}/mark-${product}.svg`;
const hasSub = variant === 'submenu';

/* Same id scheme as TopNav's corporate menu and FooterBar's tools panel: the
   trigger has to point at the panel with aria-controls, and a page may carry
   more than one product header. */
const menuId = `pmmenu-${Math.random().toString(16).slice(2, 10)}`;
---

<nav class:list={['pm', { 'pm--submenu': hasSub }, className]} aria-label="Product">
  <div class="pm-bar">
    <a class="pm-brand" href={productHref}>
      <img class="pm-mark" src={markSrc} alt="" width="40" height="40" />
      <span class="pm-name"><b>IRON</b><span class="pm-name-hl">{productName}</span></span>
      {runtime && <span class="pm-runtime">{runtime}</span>}
      {hasTrailingIcon && (
        <svg class="pm-caret" viewBox={icons.chevronDown.viewBox} fill="currentColor" aria-hidden="true"><path d={icons.chevronDown.path}/></svg>
      )}
    </a>

    <div class="pm-center" id={menuId}>
      <ul class="pm-menu">
        {items.map((it) => (
          <li>
            <a class:list={['pm-item', { 'is-active': it.active }]} href={it.href ?? '#'} aria-current={it.active ? 'page' : undefined}>
              {it.label}
              {(it.caret ?? !it.active) && (
                <svg class="pm-caret" viewBox={icons.chevronDown.viewBox} fill="currentColor" aria-hidden="true"><path d={icons.chevronDown.path}/></svg>
              )}
            </a>
          </li>
        ))}
      </ul>

      {(showSearch || showAskAi) && (
        <div class="pm-utils">
          {showSearch && (
            <button class="pm-util" type="button" aria-label={searchLabel}>
              <svg viewBox="0 0 16.0078 16.0156" fill="currentColor" aria-hidden="true"><path d="M11.5 6.5C11.5 4.71875 10.5312 3.09375 9 2.1875C7.4375 1.28125 5.53125 1.28125 4 2.1875C2.4375 3.09375 1.5 4.71875 1.5 6.5C1.5 8.3125 2.4375 9.9375 4 10.8438C5.53125 11.75 7.4375 11.75 9 10.8438C10.5312 9.9375 11.5 8.3125 11.5 6.5ZM10.5312 11.625C9.40625 12.5 8 13 6.5 13C2.90625 13 0 10.0938 0 6.5C0 2.9375 2.90625 0 6.5 0C10.0625 0 13 2.9375 13 6.5C13 8.03125 12.4688 9.4375 11.5938 10.5625L15.7812 14.7188C16.0625 15.0312 16.0625 15.5 15.7812 15.7812C15.4688 16.0938 15 16.0938 14.7188 15.7812L10.5312 11.625Z"/></svg>
            </button>
          )}
          {showAskAi && (
            <button class="pm-util" type="button" aria-label={askAiLabel}>
              <svg viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"><path d="M8 1C8.28125 1 8.53125 1.1875 8.65625 1.4375L10.5312 5.46875L14.5625 7.34375C14.8125 7.46875 15 7.71875 15 8C15 8.3125 14.8125 8.5625 14.5625 8.6875L10.5312 10.5625L8.65625 14.5938C8.53125 14.8438 8.28125 15 8 15C7.6875 15 7.4375 14.8438 7.3125 14.5938L5.4375 10.5625L1.40625 8.6875C1.15625 8.5625 1 8.3125 1 8C1 7.71875 1.15625 7.46875 1.40625 7.34375L5.4375 5.46875L7.3125 1.4375C7.4375 1.1875 7.6875 1 8 1ZM8 3.5625L6.6875 6.34375C6.625 6.5 6.5 6.65625 6.3125 6.71875L3.53125 8L6.3125 9.3125C6.5 9.375 6.625 9.5 6.6875 9.6875L8 12.4688L9.28125 9.6875C9.34375 9.5 9.46875 9.375 9.65625 9.3125L12.4375 8L9.65625 6.71875C9.5 6.65625 9.34375 6.53125 9.28125 6.34375L8 3.5625Z"/><path d="M2.87109 0.289062L3.57422 1.80078L5.08594 2.50391C5.17969 2.55078 5.25 2.64453 5.25 2.75C5.25 2.86719 5.17969 2.96094 5.08594 3.00781L3.57422 3.71094L2.87109 5.22266C2.82422 5.31641 2.73047 5.375 2.625 5.375C2.50781 5.375 2.41406 5.31641 2.36719 5.22266L1.66406 3.71094L0.152344 3.00781C0.0585938 2.96094 0 2.86719 0 2.75C0 2.64453 0.0585938 2.55078 0.152344 2.50391L1.66406 1.80078L2.36719 0.289062C2.41406 0.195312 2.50781 0.125 2.625 0.125C2.73047 0.125 2.82422 0.195312 2.87109 0.289062Z"/></svg>
            </button>
          )}
        </div>
      )}
    </div>

    <div class="pm-right">
      {/* THE CTA IS `NugetButton`, and Figma says so: node 790:1177 — the
          Default variant of this very component — contains `790:2393`, an
          INSTANCE of `button-Nuget` at md with its Download Count layer hidden.
          The bar hand-drew the same pill until 2026-08-19 and had drifted off
          the node on two counts, both measured before this changed:
            width  183.64 against the node's 187.00. The 3px is exactly the
                   caret: `.pm-cta-caret` was a raw 9x6 glyph beside the flat
                   `gap-xs`, where the node centres an 8.745x5.271 vector in a
                   16px box with `spacing-micro` beside it. 16 - 9 - (8 - 4) = 3.
                   Composed it renders 186.64, and the 0.36 left over is text
                   measurement — the node's label run is 95, ours is 94.64.
            ring   a 2px `--color-border-focus` outline, which resolves to
                   #2693EC: a BLUE ring on a pink button. NugetButton carries
                   `--shadow-focus-magenta`, which its source records as the
                   node's ring exactly.
          Composing also deleted the second copy of two SVG paths and left
          `--color-text-on-primary` with no users at all — `.pm-cta` was the only
          one in the library, which settles a question that was open. */}
      {cta === 'button'
        ? <Button variant="primary" size="md" href={ctaHref} class="pm-cta-swap">{ctaLabel}</Button>
        : <NugetButton size="md" href={ctaHref} label={ctaLabel} />}

      {/* The centre group needs 769px of bar to lay out, and below that it was
          simply `display: none` — the whole product menu gone with nothing in
          its place, which is the same hole TopNav had before `deb78df`. The
          trigger turns it into a panel instead. It is the SAME `<ul>` at every
          width, inline above the breakpoint and a panel below it, so there is
          one set of links and no screen reader hears "Licensing" twice. */}
      {items.length > 0 && (
        <button type="button" class="pm-burger" aria-expanded="false" aria-controls={menuId} aria-label="Product menu">
          <svg class="pm-burger-icon" viewBox={icons.bars.viewBox} fill="currentColor" aria-hidden="true"><path d={icons.bars.path}/></svg>
        </button>
      )}
    </div>
  </div>

  {hasSub && (
    <div class="pm-sub">
      <div class="pm-sub-inner">
        {subLead && (
          <>
            <a class="pm-chip is-active" href={subLead.href ?? '#'} aria-current="page">
              <svg viewBox={icons.graduationCap.viewBox} fill="currentColor" aria-hidden="true"><path d={icons.graduationCap.path}/></svg>
            {subLead.label}
            </a>
            <span class="pm-div" aria-hidden="true"></span>
          </>
        )}
        <ul class="pm-chips">
          {subItems.map((s) => (
            <li>
              <a class="pm-chip" href={s.href ?? '#'}>
                <svg viewBox={icons.graduationCap.viewBox} fill="currentColor" aria-hidden="true"><path d={icons.graduationCap.path}/></svg>
                {s.label}
              </a>
            </li>
          ))}
        </ul>
        {showMenuItems2 && subItemsTrailing.length > 0 && (
          <div class="pm-chips-2">
            <span class="pm-div" aria-hidden="true"></span>
            <ul class="pm-chips">
              {subItemsTrailing.map((s) => (
                <li>
                  <a class="pm-chip" href={s.href ?? '#'}>
                    <svg viewBox={icons.graduationCap.viewBox} fill="currentColor" aria-hidden="true"><path d={icons.graduationCap.path}/></svg>
                    {s.label}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        )}
      </div>
    </div>
  )}
</nav>

<style>
  /*
    Figma node 790:4778 ("Product menu"). Every colour, space and size below is a
    token — the Figma variables map 1:1 onto the system's own names:
      surface/nav        → --color-bg-nav    · surface/card-alt → --iron-blue-50
      surface/nav-alt    → --color-bg-nav-alt
      border/default     → --slate-200       · border/strong    → --slate-300
      brand|button/primary → --color-primary  · text/default/heading → --color-text-on-light-heading

    THIS BAR DOES NOT FOLLOW THE THEME — Ball's call, 2026-09-03. Every one of
    those names on the right is a token `.dark` never remaps: `--color-bg-nav` is
    a fixed light surface the way `--color-bg-footer` is a fixed dark one, and
    the type on it takes the `text-on-light` pair whose whole reason for existing
    is that `--color-text-heading` flips and it must not. The border, card-alt
    and link semantics all flip too, so their light values are written as the
    primitives they resolve to — the same thing `.tn--default` does with
    `--slate-800` and `.pm-div` already did with `--slate-300`.

    Pinning the SURFACE alone would have been the bug: a white band under
    `--color-text-heading` that had turned #FAFAFA in dark mode is white on
    white. Six tokens flip here, and they move together or not at all.
    Menu items use Figma's "Typography/UI/Button large" style (--fw-btn-lg / 16px),
    the CTA uses "Typography/UI/Button default" (--fw-btn / 14px / --leading-4).
    The 40px mark is Figma's own size here — it is deliberately off the 24/48/96/192
    grid the logo specimen documents, so it is set explicitly rather than via Logo.astro.
  */
  .pm { width: 100%; background: var(--color-bg-nav); font-family: 'Montserrat', sans-serif; }
  /* THE CLOSING RULE IS FULL-BLEED AND THE CONTENT ROW IS NOT — two different
     boxes, and until 2026-08-31 they were the same one. `.pm-bar` carried both
     the rule and the flex row, so capping it to the node's 1392 would have
     stopped the rule at 1440 as well. The rule belongs to the root, which is
     where 790:1177 draws it; an inset shadow paints it without taking a pixel,
     the same reading as `.pm-sub` and `.pm-chip` below.
     Only the ONE-TIER variant closes here. In the submenu variant the component
     closes on `.pm-sub`, which has carried that rule since 13828a1. */
  .pm:not(.pm--submenu) { box-shadow: inset 0 calc(-1 * var(--border-width-1)) 0 var(--slate-300); }
  /* NO border-bottom here. It used to carry one, in border/strong, ON TOP of the
     one .pm-bar already keeps inside its 72 — two rules stacked, and the
     component measured 73 against 790:1177's 72 in the default variant and
     140.8 against 790:4779's 137 in the submenu one. The comment below had the
     principle exactly right and nothing asserted it; `check:figma-size` does
     now. 790:1177 draws ONE stroke, border/strong, on the ROOT with h-72
     including it, so the colour moves down to .pm-bar and the rule does not. */
  /* box-sizing so the cap below counts the padding, the way `.tn-inner` does:
     1440 total is the node's 1392 of content plus 24 either side. Figma's tier
     is 72px total (137px = 72 + 65 on the submenu variant).
     THE CAP. `content` on 790:1177 is `Fill container` with `Max width: 1392`,
     confirmed by Ball 2026-08-27. Without it the row just kept growing — 1872
     at 1920, 2512 at 2560 — and the brand and the CTA drifted to the far edges
     while `.tn-inner` stopped at 1440 in the bar directly above. `npm run wide`
     cannot see this class of fault and it is not a hole in the sweep: it skips
     an element that PAINTS, because a full-bleed painted band is deliberate,
     and this band both paints and holds the content. Every other component
     that stacks these two jobs splits them — `.tn-inner`, `.fb-mid-inner`,
     `.fb-tools-inner`, `.fb-info-inner` — and this one did not.
     `position: relative` is here for the narrow-width menu panel, which drops
     out of the bar and is positioned against it rather than against the page. */
  .pm-bar { display: flex; align-items: stretch; gap: var(--spacing-md); min-height: 72px; box-sizing: border-box; max-width: var(--size-container-max); margin-inline: auto; padding: 0 var(--spacing-xl); background: var(--color-bg-nav); position: relative; }

  /* Both side columns are flex:1 0 0 (Figma `flex-[1_0_0]`), not 1 0 auto — that is
     what keeps the menu optically centred instead of pushed by the brand's width. */
  .pm-brand { display: flex; align-items: center; gap: var(--spacing-xs); flex: 1 0 0; min-width: 0; text-decoration: none; color: var(--color-text-on-light-heading); }
  .pm-mark { display: block; width: 40px; height: 40px; flex-shrink: 0; }
  .pm-name { font-size: var(--font-size-xl); line-height: 1; letter-spacing: -0.04em; white-space: nowrap; }
  .pm-name b { font-weight: var(--fw-btn-lg); }
  .pm-name-hl { font-weight: var(--fw-body); color: var(--color-primary); text-transform: uppercase; }
  .pm-runtime { font-size: var(--font-size-sm); font-weight: var(--fw-body); color: var(--color-text-on-light-heading); white-space: nowrap; }
  .pm-caret { width: 14px; height: 14px; flex-shrink: 0; }
  /* The MENU caret only. `507:5519` is a `size-[16px]` box holding a 14px glyph,
     and `icons.chevronDown` is drawn on a 16 viewBox with the same slack around
     it — so 16 here is the node's box, not a bigger arrow. At 14 every item with
     a caret measured ~2.5 short of the node (134.59 against 137, 127.05 against
     130, 113.14 against 116, 95.66 against 98) while Home, which has none, was
     the only one over. The brand's chevron stays 14: `790:4783` is a 14-wide
     text node, a different box that happens to share this class. */
  .pm-item .pm-caret { width: 16px; height: 16px; }

  .pm-center { display: flex; align-items: stretch; gap: var(--spacing-sm); min-width: 0; }
  .pm-menu { display: flex; align-items: stretch; list-style: none; margin: 0; padding: 0; min-width: 0; }
  .pm-menu li { display: flex; }
  /* Items stretch to the bar instead of carrying their own 72px, so the whole tier
     stays clickable without re-stating the height in two places. */
  .pm-item { display: flex; align-items: center; gap: var(--spacing-xs); padding: 0 var(--spacing-md); font-size: var(--font-size-base); font-weight: var(--fw-btn-lg); line-height: 1; color: var(--color-text-on-light-heading); text-decoration: none; white-space: nowrap; }
  .pm-item:hover { color: var(--color-primary); }
  /* THE ACTIVE ITEM IS A DIFFERENT VARIANT IN EACH BAR, and the node says so in
     pixels: 790:1177's active item is #FFFFFF at every row of its 72 with no
     rule on either side — `Active no bg` — while 790:4779's carries the wash and
     the side rules — `Active`. Which is the sensible reading: the panel is a TAB,
     and a tab wants a tier to be a tab TO. Until 2026-09-03 the panel was drawn
     in both, on Ball's 2026-07-30 choice, taken before the submenu variant
     existed to make the distinction. */
  .pm-item.is-active { color: var(--color-primary); }
  /* Three background layers, not a background plus two borders, and both halves
     of that matter. The side rules are a GRADIENT — sampled down 507:5526's own
     edge: #FEFEFE · #F5F7FA · #ECF0F5 · #E3E8F0 · #E2E8F0, white at the top and
     border/default exactly where it meets the divider under the tier — which a
     solid border cannot draw and which codegen flattens to `border-[white]`,
     its first stop. And a border took 2px of layout, so an item grew when it
     became active; a background layer takes none. */
  .pm--submenu .pm-item.is-active {
    background:
      linear-gradient(to bottom, var(--color-bg-nav), var(--slate-200)) left / var(--border-width-1) 100% no-repeat,
      linear-gradient(to bottom, var(--color-bg-nav), var(--slate-200)) right / var(--border-width-1) 100% no-repeat,
      linear-gradient(to bottom, var(--color-bg-nav), var(--color-bg-nav-alt));
  }
  .pm-item.is-active .pm-caret { transform: rotate(180deg); }

  .pm-utils { display: flex; align-items: center; gap: var(--spacing-sm); flex-shrink: 0; }
  .pm-util { display: inline-flex; align-items: center; justify-content: center; width: 36px; height: 36px; flex-shrink: 0; padding: 0; background: var(--iron-blue-50); border: var(--border-width-1) solid var(--slate-200); border-radius: var(--rounded-full); color: var(--iron-blue-500); cursor: pointer; }
  .pm-util svg { width: 16px; height: 16px; display: block; }
  .pm-util:hover { border-color: var(--slate-300); }
  .pm-util:focus-visible { outline: var(--border-width-2) solid var(--color-border-focus); outline-offset: 2px; }

  /* `position: relative` so the narrow-width label below clips against the pill
     rather than against whatever positioned ancestor happens to be above it. The
     pill itself is NugetButton now and brings its own fill, height, padding,
     radius, type and focus ring — this is the one thing the bar still says about
     it, and it is a containing block, not a look. */
/* `align-self: center` and not the bar's `stretch`, which is what this
     inherited. Two reasons and they are the same reason. `314:205` is 48 tall,
     inset 12 in a 72 tier — stretched it measured 71, a structural difference
     the picture hides because the CTA centres either way. And stretched, the
     CTA's own height stops mattering: a 56px button would sit inside 71 and
     move NOTHING, so no rendered band could ever see it. Centred, this box IS
     the CTA's height, which is what makes `cta` below a band that can fail. */
  .pm-right { display: flex; align-items: center; justify-content: flex-end; align-self: center; flex: 1 0 0; min-width: 0; }

  .pm-burger { display: none; align-items: center; justify-content: center; width: 24px; height: 24px; flex-shrink: 0; padding: 0; border: 0; background: none; color: var(--color-text-on-light-heading); cursor: pointer; }
  .pm-burger:hover { color: var(--color-primary); }
  .pm-burger:focus-visible { outline: var(--border-width-2) solid var(--color-border-focus); outline-offset: 2px; }
  .pm-burger-icon { width: 16px; height: 16px; display: block; }

  /* 799:846 is 65 and its content sits at y=12 with height 41, so 12 + 41 + 12 is
     the whole tier and the stroke is drawn INSIDE it. A border-bottom is a 66th
     pixel; an inset shadow paints the same line and takes no space. Same reading
     as the Footer review card, whose 124x48 has its stroke inside too. */
  /* TWO rules, both inset, both full-bleed: border/default ON TOP divides the
     tiers, border/strong underneath closes the component. The soft one used to
     live on `.pm-bar` as a border-bottom, and moved here when `.pm-bar` was
     capped — a divider between two full-bleed bands cannot stop at 1440. */
  .pm-sub { display: flex; align-items: center; justify-content: center; padding: var(--spacing-sm) var(--spacing-xl); background: var(--color-bg-nav-alt); box-shadow: inset 0 var(--border-width-1) 0 var(--slate-200), inset 0 calc(-1 * var(--border-width-1)) 0 var(--slate-300); }
  .pm-sub-inner { display: flex; align-items: center; gap: var(--spacing-md); min-width: 0; }
  .pm-chips { display: flex; align-items: center; gap: var(--spacing-xs); list-style: none; margin: 0; padding: 0; }
  .pm-chips-2 { display: flex; align-items: center; gap: var(--spacing-md); }
  /* ALL FOUR variants of 507:5503 are 125x41 — Default, Hover, Active and
     Activehover — so the box does not grow when the border appears, and the
     node's text sits at x=16 y=12 in a chip that is 12 + 17 + 12. A reserved
     transparent border, the pattern Button and FooterBar's trigger use, adds 2
     here instead of nothing: the chip measured 42.8. An inset shadow needs no
     reserve at all, because it never took part in layout in the first place. */
  .pm-chip { display: inline-flex; align-items: center; gap: var(--spacing-xs); padding: var(--spacing-sm) var(--spacing-md); border-radius: var(--rounded-lg); font-size: var(--font-size-nav-sub); font-weight: var(--fw-nav-sub); line-height: var(--line-height-nav-sub); color: var(--color-text-on-light-heading); text-decoration: none; white-space: nowrap; }
  /* The icon at the size it was drawn. `icons.graduationCap` is outlined on an
     `0 0 18 14` viewBox — its own ink box — and 507:5505 is an 18-wide node, so
     16x13 was this SVG scaled to 89% and it cost the chip 2 of the 2.91 it was
     short. The node is 18x16, the 16 being the text line box around a 14-tall
     glyph, which is what centring 14 in the 44 already does. */
  .pm-chip svg { width: 18px; height: 14px; flex-shrink: 0; }
  .pm-chip:hover { color: var(--color-primary); }
  .pm-chip.is-active { background: var(--color-bg-nav); box-shadow: inset 0 0 0 var(--border-width-1) var(--slate-200); border-radius: var(--rounded-lg); }
  /* Figma `Activehover` — the box darkens its border and the label turns brand.
     Figma's `Active` leaves the label its default colour, so the brand colour
     belongs to the hover, not to being active. */
  .pm-chip.is-active:hover { box-shadow: inset 0 0 0 var(--border-width-1) var(--slate-300); color: var(--color-primary); }
  .pm-div { width: 1px; height: 24px; flex-shrink: 0; background: var(--slate-300); }

  /* ── SHEDDING THE OPTIONAL PIECES ──────────────────────────────────────
     Figma covers 1440px desktop only, so the bar drops what it can spare
     before it breaks. There are three drops and they happen in this order:
     the runtime label, then the util bubbles (and the menu starts scrolling),
     then the CTA's label and the brand's chevron.

     WHICH WIDTH EACH ONE HAPPENS AT IS MEASURED AT RUNTIME, NOT WRITTEN HERE.
     Every number this block used to carry — 1180, 1058, 434 — was measured
     against the component's OWN DEFAULT STRINGS, and they are right for
     `IRONPDF` / `Start for Free` and wrong for anything else a consumer passes.
     Measured 2026-08-31 with `productName="SUITE"` and `ctaLabel="Buy License
     Today"`: `.pm-right` left `.pm-bar` by 31.55px at 434-435, and the brand's
     chevron left `.pm-brand` by 13.52px at 1181. Both are one pixel above a
     breakpoint, which is the signature of a threshold measured against content
     that has since changed — except here the content did not change, the
     CONSUMER did, and no number written in this file can be right for every
     string it will be given.

     So the script measures what the bar's three columns actually need and adds
     the drop classes below until they fit. `.pm--fit` on the root says that has
     happened; the media queries at the bottom of this block are the no-JS
     fallback and carry the old numbers, which remain correct for the defaults.

     A CONTAINER QUERY WOULD NOT HAVE FIXED THIS, and it was the first thing
     suggested. `.pm-bar` is full-bleed, so its inline size IS the viewport up to
     the 1440 cap; `@container (max-width: 434px)` computes the same answer the
     media query does. It would buy independence from the PLACEMENT, which is a
     real thing to want and a different thing from this. */
  .pm-drop-runtime .pm-runtime { display: none; }
  .pm-drop-runtime .pm-item { padding: 0 var(--spacing-sm); }

  .pm-drop-utils .pm-utils { display: none; }
  .pm-drop-utils .pm-menu { overflow-x: auto; scrollbar-width: none; }
  .pm-drop-utils .pm-menu::-webkit-scrollbar { display: none; }
  /* Basis auto, not 0 — this is the whole fix for what used to be 769–961. With
     basis 0 on both side columns the free space is split equally between them
     whatever they need, and .pm-center is never forced to give anything up, so
     the shrink lands on two columns that cannot shrink (mark, nowrap wordmark,
     nowrap CTA) and their children leave the box. With basis auto the columns
     state their width, the shrink falls on the one child that can absorb it,
     and the menu scrolls — which it already does by this point. Kept off the
     base rule on purpose: while the utils are still up, basis 0 is what centres
     the menu optically rather than pushing it by the brand's width. */
  .pm-drop-utils .pm-brand, .pm-drop-utils .pm-right { flex: 1 0 auto; }

  .pm-drop-label .pm-brand > .pm-caret { display: none; }

  /* ── THE NO-JS FALLBACK, and the numbers live only here now ─────────────
     Same three drops at the widths they were measured at for the DEFAULT
     strings, which is the best a stylesheet can do without measuring. Scoped
     to `:not(.pm--fit)` so the script's answer wins the moment it has one.
     1180: where `IRONPDF for .NET` stops fitting beside the menu.
     1058, not 1024: with the util bubbles up the bar needs 1058 for the CTA,
     so 1025–1057 had it hanging 96.55px out of `.pm-right`.
     434: the bar needs 410 for the brand and the full CTA, and the 24px burger
     plus its 16px gap took that to 434.

     RE-READ 2026-09-03, off the script rather than off the layout: `?frame=` runs
     the fit script, so the widths where it changes its mind ARE these numbers.
     Swept 1440 → 320 and refined to 1px, with the defaults:

       none → drop-runtime                1184   (this rule: was 1180)
       drop-runtime → +drop-utils         1019   (1057.98, fires 39 early)
       the panel takes over, nothing needed 768
       none → drop-runtime again           512
       → +drop-label                       387   (433.98, fires 47 early)

     Only the first moved this pass and only that one is changed: every menu item
     gained 2px with the caret box, the centre column took 10 of the bar, and the
     brand chevron — which is what actually leaves first, by 0.44px here — began
     leaving 4px sooner. 1181–1184 was a band where a no-JS page overflowed.

     THE OTHER TWO FIRE EARLY, WHICH IS THE SAFE SIDE, and both are left alone:
     they hide something that would still have fitted rather than letting it
     escape, and pulling a breakpoint 39 and 47 pixels is a visible change to
     make on purpose. Measured here so the next person does not re-derive them.
     The sub tier's own 1042.98 is still right: its row needs 994.66 + 48 of
     padding = 1042.66, so the scroller arrives 0.32px before it is needed. */
  @media (max-width: 1184px) {
    .pm:not(.pm--fit) .pm-runtime { display: none; }
    .pm:not(.pm--fit) .pm-item { padding: 0 var(--spacing-sm); }
  }
  @media (max-width: 1057.98px) {
    .pm:not(.pm--fit) .pm-utils { display: none; }
    .pm:not(.pm--fit) .pm-menu { overflow-x: auto; scrollbar-width: none; }
    .pm:not(.pm--fit) .pm-menu::-webkit-scrollbar { display: none; }
    .pm:not(.pm--fit) .pm-brand, .pm:not(.pm--fit) .pm-right { flex: 1 0 auto; }
  }

  /* 1043 is the sub tier's own number and has nothing to do with the bar's —
     .pm-chips-2 leaves .pm-sub-inner by 273.66px until then. That 273.66 is now
     APPROXIMATE by about 16: the chips lost the 2px their reserved border was
     adding to each of eight, on 2026-08-28. It is stale in the safe direction —
     narrower content leaves the row by less, so the scroller is needed no
     earlier — and re-measuring it moves a breakpoint, which is a change to make
     on purpose rather than as a side effect. The scroller below
     already existed; it just started at 768, 275px under where it was needed. */
  @media (max-width: 1042.98px) { .pm-sub-inner { overflow-x: auto; scrollbar-width: none; } .pm-sub-inner::-webkit-scrollbar { display: none; } }

  /* 769 is where the centre group stops fitting inline. Below it the same <ul>
     becomes a panel under the bar rather than disappearing. `.pm-bar` is the
     positioning context so the panel hangs off the bar's real height instead of
     a hard-coded 72px, which the sub tier variant would have got wrong. */
  @media (max-width: 768px) {
    .pm-burger { display: inline-flex; }
    .pm-center { display: none; position: absolute; top: 100%; left: 0; right: 0; z-index: 20; flex-direction: column; align-items: stretch; gap: 0; padding: var(--spacing-xs) var(--spacing-xl) var(--spacing-sm); background: var(--color-bg-nav); border-bottom: var(--border-width-1) solid var(--slate-200); }
    .pm.pm-menu-open .pm-center { display: flex; }
    /* The inline tier scrolls sideways; a stacked panel must not, or the rows
       inherit a scroller with nothing to scroll and swallow the horizontal
       gesture. */
    .pm-menu { flex-direction: column; align-items: stretch; overflow-x: visible; }
    .pm-menu li { display: flex; }
    /* Each row is its own hit target across the panel, so the caret sits at the
       end of the line rather than tight against the label as it does inline. */
    .pm-item { justify-content: space-between; width: 100%; padding: var(--spacing-sm) 0; }
    /* `is-active` is a 72px tab — a wash down the tier with its side rules.
       Stacked, that reads as a stray box, so the panel keeps only the colour.
       Qualified by `.pm--submenu` to MATCH the rule it is overriding: as a bare
       `.pm-item.is-active` it lost on specificity and the tab came back inside
       the panel. */
    .pm--submenu .pm-item.is-active { background: none; }
  }

  /* THE THIRD DROP's no-JS half. The CTA keeps its pill and both glyphs but
     takes its label out of the flow, and the brand drops its chevron: 434 -> 310
     for the defaults, which is 10px of room at 320. The label goes to a clipped
     1px box, NOT `display: none`, so the link keeps its accessible name and the
     pill is still "Start for Free" to a screen reader. */
  @media (max-width: 433.98px) {
    .pm:not(.pm--fit) .pm-brand > .pm-caret { display: none; }
  }
</style>

<!--
  THE OTHER HALF OF THAT BREAKPOINT, and it has to be global. The label is
  NugetButton's, and Astro's scoping stamps a different `data-astro-cid` on that
  component's elements than on this one's — so a scoped `.pm-right
  [data-part='label']` compiles to a selector requiring THIS component's id on
  the label and matches nothing. Measured, not guessed: with the rule scoped, the
  label read `position: static` at 320/375/433 and the bar's content was cut at
  391px inside 320.

  `is:global` rather than `:global()`, the same choice FlyoutMenu records: the
  docs page carries every rule verbatim for check:parity, and `:global()` is not
  a real pseudo-class, so the browser would drop the whole rule there — costing
  the docs page exactly the behaviour this rule exists to show.

  Kept to one selector, under `.pm-right`, inside the media query. The rule stays
  HERE rather than in NugetButton because 434 is this bar's number — brand + CTA
  + burger — and a button has no business owning a breakpoint measured from a
  layout it is only a part of. Ball's call, 2026-08-19.
-->
<style is:global>
  .pm-drop-label .pm-right [data-part='label'] { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }
  @media (max-width: 433.98px) {
    .pm:not(.pm--fit) .pm-right [data-part='label'] { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }
  }
</style>
<style is:global>
  /* The NuGet CTA is a COMPOSED child, so this cannot be scoped. Astro rewrites a
     scoped selector with the component's own `data-astro-cid-…` on both sides —
     `.pm-right[cid] > a[cid]` — and NugetButton's <a> carries a different scope
     or none, so the rule never matched it in a real app. It only ever applied on
     the docs pages, where build-component-css.mjs flattens every block unscoped.
     Found by `check:flat-scope` on 2026-08-19, which asks the rendered tree what
     each rule reaches once the scoping is stripped.

     `.pm-right` is this component's own prefixed class, so global costs nothing
     here: it reaches a direct <a> child of a ProductMenu right-hand group and
     nothing else. Same arrangement TopNav uses to style the flyout it composes.

     It is a containing block, not a look — the pill brings its own fill, height,
     padding, radius, type and focus ring. */
  .pm-right > a { position: relative; }

  /* THE SWAPPED CTA'S HALF OF THE 434 BREAKPOINT. The pill above it keeps its
     shape and drops its label, because it still has two glyphs to show; a plain
     button has none, so collapsing its label would leave an empty pill. It gives
     up its inline padding instead — the same trade, made the other way round.
     `npm run overflow` is what asked for this: at 320 the swapped CTA left
     `.pm-bar` by 30.72px, visible and unclipped, while the pill form was clean.

     Two classes deep on purpose. A single utility class is one deep, and which
     of the two wins is decided by their order in the compiled stylesheet rather
     than by where they are written — the same trap `wrap` exists to avoid on
     Button. `.pm-right > a.pm-cta-swap` cannot lose that race whichever sheet
     lands first. Global for the reason above: the button is a composed child and
     a scoped selector would stamp this component's id on both sides. */
  .pm-drop-label .pm-right > a.pm-cta-swap { padding-inline: var(--spacing-xs); }
  @media (max-width: 433.98px) {
    .pm:not(.pm--fit) .pm-right > a.pm-cta-swap { padding-inline: var(--spacing-xs); }
  }
</style>


<script>
  // Disclosure pattern (WAI-ARIA APG), the same one TopNav's corporate menu and
  // FooterBar's tools panel use: the trigger owns aria-expanded and points at
  // the panel it controls. The menu stays in the DOM at every width — above the
  // breakpoint it is the inline centre group, below it the same element is the
  // panel — so there is one set of links rather than two to keep in sync.
  function initProductMenu(scope: ParentNode = document) {
    scope.querySelectorAll<HTMLElement>('.pm:not([data-pm-init])').forEach((pm) => {
      const trigger = pm.querySelector<HTMLButtonElement>('.pm-burger');
      const menu = pm.querySelector<HTMLElement>('.pm-center');
      if (!trigger || !menu) return;
      pm.dataset.pmInit = '1';

      const setOpen = (open: boolean) => {
        pm.classList.toggle('pm-menu-open', open);
        trigger.setAttribute('aria-expanded', String(open));
      };
      const close = (focusTrigger: boolean) => {
        if (!pm.classList.contains('pm-menu-open')) return;
        setOpen(false);
        if (focusTrigger) trigger.focus();
      };

      // ── FITTING THE BAR TO ITS OWN CONTENT ──────────────────────────────
      // The three drops used to happen at three widths written into the
      // stylesheet, each measured against this component's DEFAULT strings and
      // each wrong for a consumer who passes longer ones. Nothing in CSS can
      // ask "does this fit"; this can, so it does, and the stylesheet keeps
      // those numbers only as the no-JS fallback.
      //
      // WHAT IS MEASURED is the rendered result, not an estimate of it. The
      // first version of this added up `scrollWidth` across the three columns
      // and compared the total to the bar — and under-reported, because a flex
      // child with `min-width: 0` whose nowrap content overflows does not
      // report that content in `scrollWidth`. It left the drops off entirely
      // and `npm run overflow` came back with 13 findings where the stylesheet
      // alone had had 2, including the DEFAULT strings at 900. So this asks the
      // same question the sweep asks: has anything left the box it is in.
      const bar = pm.querySelector<HTMLElement>('.pm-bar');
      const DROPS = ['pm-drop-runtime', 'pm-drop-utils', 'pm-drop-label'];
      const SLACK = 0.5;

      const overflows = () => {
        if (!bar) return false;
        const cs = getComputedStyle(bar);
        const box = bar.getBoundingClientRect();
        const stack: Array<[HTMLElement, number, number]> = [[
          bar,
          box.left + parseFloat(cs.paddingLeft) - SLACK,
          box.right - parseFloat(cs.paddingRight) + SLACK,
        ]];

        // Depth-first over the bar's own subtree, which is a few dozen nodes.
        // Not just the columns and their direct children: the CTA is a composed
        // button that is `overflow: hidden`, so when its label stops fitting the
        // PILL clips it and the bar reports that everything fits. Measured at
        // 434 with `ctaLabel="Buy License Today"` — the label span was 8.2px
        // outside its own <a>, cut, with the row itself inside the bar. A cut is
        // the worse half of this: there is no scrollbar to show for it.
        while (stack.length) {
          const [el, left, right] = stack.pop()!;
          for (const child of Array.from(el.children) as HTMLElement[]) {
            const ccs = getComputedStyle(child);
            // display:none is not in the row; an absolutely positioned child is
            // out of flow — below the panel breakpoint the menu is both in turn.
            if (ccs.display === 'none' || ccs.position === 'absolute') continue;
            const cbox = child.getBoundingClientRect();
            if (cbox.right > right || cbox.left < left) return true;
            // A box that SCROLLS is meant to hold more than it shows — the menu
            // is the entire reason the second drop exists — so a child
            // leaving it is the design working. `hidden` is not that: it is a
            // silent cut, and it is checked like anything else.
            const scrolls = ccs.overflowX === 'auto' || ccs.overflowX === 'scroll';
            if (scrolls) continue;
            stack.push([child, cbox.left - SLACK, cbox.right + SLACK]);
          }
        }
        return false;
      };

      let fitting = false;
      const fit = () => {
        if (!bar || fitting) return;
        fitting = true;
        pm.classList.remove(...DROPS);
        for (const drop of DROPS) {
          if (!overflows()) break;
          pm.classList.add(drop);
        }
        fitting = false;
      };

      // `.pm--fit` switches the fallback media queries off, so it is added in
      // the same frame as the first measurement rather than before it.
      fit();
      pm.classList.add('pm--fit');

      // Re-measure when the bar changes width, and again once the webfont has
      // landed: every width above is a text measurement, and the first one is
      // taken in whatever face was available at the time.
      // Straight from the observer, not through a rAF. A ResizeObserver
      // callback already runs once per frame after layout, so the throttle
      // bought nothing and cost a frame: the drops landed one frame after the
      // resize, which a person does not see and `npm run overflow` does —
      // it sets a viewport, waits a single frame, and read the bar mid-flight.
      // Re-entry is guarded by `fitting`, and the classes this adds do not
      // change the bar's own width, so the observer does not re-fire on them.
      if (bar && typeof ResizeObserver !== 'undefined') {
        new ResizeObserver(() => fit()).observe(bar);
      }
      if (document.fonts?.ready) document.fonts.ready.then(fit);

      trigger.addEventListener('click', () => setOpen(!pm.classList.contains('pm-menu-open')));
      // Escape closes from anywhere in the bar and hands focus back, and a click
      // outside closes without stealing it — an open panel that survives a click
      // on the page behind it is the thing users report as stuck.
      pm.addEventListener('keydown', (e) => {
        if ((e as KeyboardEvent).key === 'Escape') close(true);
      });
      document.addEventListener('click', (e) => {
        if (!pm.contains(e.target as Node)) close(false);
      });
    });
  }
  document.addEventListener('DOMContentLoaded', () => initProductMenu());
  document.addEventListener('astro:page-load', () => initProductMenu());
</script>
