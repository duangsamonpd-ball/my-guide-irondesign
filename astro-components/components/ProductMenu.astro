---
/**
 * ProductMenu — the full-width product header from Figma node 790:4778
 * ("Product menu", canvas 231:1473 " ↳ Navigation menu").
 *
 * Two variants, matching Figma's `Varient` property:
 *   default  — one 72px tier: product lockup · menu · search/AI · CTA
 *   submenu  — adds a second 65px tier of sub-navigation chips
 *
 * Figma's own property names are kept where they exist (`hasTrailingIcon`,
 * `showMenuItems2`) so the component stays traceable to the design file.
 *
 * NOTE: Figma specifies this at 1440px desktop only — its Do/Don't sheet talks
 * about "desktop screen breakpoints" and there is no mobile frame. The narrow
 * behaviour below (drop the runtime label, then the util bubbles, then let the
 * menu scroll) is an implementation decision, not a design that was handed over.
 *
 * ── The bands this component declares, and what draws them ────────────────
 *
 * The two tiers are the claim, and so is their sum: `790:4779` is 137, which is
 * the 72 above plus the 65 below, and all of it is declared so a tier cannot
 * move without one of them saying so. Inside the second tier the same shape
 * again — 65 is 12 + the 41 the chips stand in + 12.
 *
 * FOUR THINGS IN THIS BAR CANNOT BE DECLARED, and that is the gate refusing
 * rather than passing. `.pm-bar`, `.pm-brand`, `.pm-item`, `.pm-utils` and
 * `.pm-right` are either `min-height: 72px` or flex children stretched into it,
 * so 10px of injected padding does not move them and arm 3 will not call the
 * reading a reading. Their node heights — 40 for the lockup, 36 for the util
 * pair, 48 for the CTA — describe CONTENT inside a stretched box, which is a
 * different question from the one this gate asks.
 *
 * @figma-size cta
 *   node   314:205
 *   frame  Product menu
 *   page   component-productmenu.html
 *   region default
 *   select .pm-right
 *   at     1440
 *   height 48
 *   why    the CTA row with button-Nuget in it; 12 + 48 + 12 is the tier
 *
 * @figma-size cta-button
 *   node   314:205
 *   frame  Product menu
 *   page   component-productmenu.html
 *   region cta-button
 *   select .pm-right
 *   at     1440
 *   height 48
 *   why    the same row with 231:1411 swapped in, which is why md is fixed
 *
 * @figma-size bar
 *   node   790:1177
 *   frame  Product menu
 *   page   component-productmenu.html
 *   region default
 *   select .pm
 *   at     1440
 *   height 72
 *   why    the whole component in the one-tier variant; it was 73
 *
 * @figma-size bar-submenu
 *   node   790:4779
 *   frame  Product menu
 *   page   component-productmenu.html
 *   region submenu
 *   select .pm
 *   at     1440
 *   height 137
 *   why    72 + 65, and both halves are declared below; it was 140.8
 *
 * @figma-size sub
 *   node   799:846
 *   frame  Product menu
 *   page   component-productmenu.html
 *   region submenu
 *   select .pm-sub
 *   at     1440
 *   height 65
 *   why    the second tier; 12 + 41 + 12, with its rule inside
 *
 * @figma-size sub-inner
 *   node   799:847
 *   frame  Product menu
 *   page   component-productmenu.html
 *   region submenu
 *   select .pm-sub-inner
 *   at     1440
 *   height 41
 *   why    the chip row itself, inset 12 from the tier
 *
 * @figma-size chip
 *   node   507:5503
 *   frame  Product menu
 *   page   component-productmenu.html
 *   region submenu
 *   select .pm-chip
 *   at     1440
 *   height 41
 *   why    seven Product sub menu instances: the lead, five in the slot, one in
 *   count  7
 *
 * The chips land on 40.8, not 41, and the 0.2 is understood rather than
 * tolerated: `line-height: 1.2` on 14px is 16.8 where the node's text node is
 * 17 tall. It sits inside the gate's half-pixel, which still refuses the 1.8
 * this pass removed. If the sub-menu label ever gets a type role in Figma, that
 * 0.2 is where to spend it.
 */

// chevron-down and graduation-cap each repeat several times below — see ../icons.
// The search / Ask AI / CTA vectors stay inline: one use each, and the CTA glyph
// needs fill-rule="evenodd", which the shared Icon shape does not model.
import { icons } from '../icons';
import NugetButton from './NugetButton.astro';
import Button from './Button.astro';

interface MenuItem {
  label: string;
  href?: string;
  active?: boolean;
  /** Figma shows a caret on every top item except the active one. */
  caret?: boolean;
}

interface SubItem {
  label: string;
  href?: string;
}

interface Props {
  variant?: 'default' | 'submenu';
  /** Mark artwork — same keys as Logo.astro's `product`. */
  product?: string;
  /** Coloured half of the wordmark, e.g. "PDF" in IRONPDF. */
  productName?: string;
  /** Trailing runtime label, e.g. "for .NET". Omit to hide. */
  runtime?: string;
  productHref?: string;
  /** Figma `hasTrailingIcon` — the caret after the product lockup. */
  hasTrailingIcon?: boolean;
  items?: MenuItem[];
  /** Sub tier: the current-page chip, drawn boxed. Figma keeps its label the
   *  default colour and turns it brand-pink only on hover. */
  subLead?: SubItem;
  subItems?: SubItem[];
  /** Figma `showMenuItems2` — trailing links at the right end of the sub tier. */
  showMenuItems2?: boolean;
  subItemsTrailing?: SubItem[];
  /**
   * Which component fills the CTA slot. Figma models this as an INSTANCE-SWAP
   * property called `Instance` on `790:4778`, whose preferred list is exactly
   * two: `button-Nuget` and `button` pinned at `231:1411`
   * (`Variant=primary, Size=md`). A closed set of two is a prop here rather
   * than a slot — it is an enum on the canvas, this repo does not spell a
   * variant axis as a boolean or an open hole, and a prop is the only one of
   * the two that `check:props-table` and the manifest can see.
   *
   * BOTH VALUES ARE 48 TALL AND THAT IS THE WHOLE CONSTRAINT. `314:205` is
   * 368 x 48.0004 inside a 72 tier — 12 + 48 + 12 — so the swap is safe only at
   * `size=md`. `button` at lg is 56 and would make the tier 80; that is why the
   * preferred instance is pinned to a VARIANT and not to the `231:1406` set,
   * and why `size` is fixed here rather than exposed. The `cta` band below
   * measures both values so a future edit cannot quietly reintroduce it.
   */
  cta?: 'nuget' | 'button';
  ctaLabel?: string;
  ctaHref?: string;
  showSearch?: boolean;
  showAskAi?: boolean;
  searchLabel?: string;
  askAiLabel?: string;
  basePath?: string;
  class?: string;
}

const {
  variant = 'default',
  product = 'pdf',
  productName = 'PDF',
  runtime = 'for .NET',
  productHref = '/',
  hasTrailingIcon = true,
  items = [],
  subLead,
  subItems = [],
  showMenuItems2 = false,
  subItemsTrailing = [],
  cta = 'nuget',
  ctaLabel = 'Start for Free',
  ctaHref = '#',
  showSearch = true,
  showAskAi = true,
  searchLabel = 'Search',
  askAiLabel = 'Ask AI',
  basePath = 'assets',
  class: className,
} = Astro.props;

const markSrc = `${basePath}/mark-${product}.svg`;
const hasSub = variant === 'submenu';

/* Same id scheme as TopNav's corporate menu and FooterBar's tools panel: the
   trigger has to point at the panel with aria-controls, and a page may carry
   more than one product header. */
const menuId = `pmmenu-${Math.random().toString(16).slice(2, 10)}`;
---

<nav class:list={['pm', { 'pm--submenu': hasSub }, className]} aria-label="Product">
  <div class="pm-bar">
    <a class="pm-brand" href={productHref}>
      <img class="pm-mark" src={markSrc} alt="" width="40" height="40" />
      <span class="pm-name"><b>IRON</b><span class="pm-name-hl">{productName}</span></span>
      {runtime && <span class="pm-runtime">{runtime}</span>}
      {hasTrailingIcon && (
        <svg class="pm-caret" viewBox={icons.chevronDown.viewBox} fill="currentColor" aria-hidden="true"><path d={icons.chevronDown.path}/></svg>
      )}
    </a>

    <div class="pm-center" id={menuId}>
      <ul class="pm-menu">
        {items.map((it) => (
          <li>
            <a class:list={['pm-item', { 'is-active': it.active }]} href={it.href ?? '#'} aria-current={it.active ? 'page' : undefined}>
              {it.label}
              {(it.caret ?? !it.active) && (
                <svg class="pm-caret" viewBox={icons.chevronDown.viewBox} fill="currentColor" aria-hidden="true"><path d={icons.chevronDown.path}/></svg>
              )}
            </a>
          </li>
        ))}
      </ul>

      {(showSearch || showAskAi) && (
        <div class="pm-utils">
          {showSearch && (
            <button class="pm-util" type="button" aria-label={searchLabel}>
              <svg viewBox="0 0 16.0078 16.0156" fill="currentColor" aria-hidden="true"><path d="M11.5 6.5C11.5 4.71875 10.5312 3.09375 9 2.1875C7.4375 1.28125 5.53125 1.28125 4 2.1875C2.4375 3.09375 1.5 4.71875 1.5 6.5C1.5 8.3125 2.4375 9.9375 4 10.8438C5.53125 11.75 7.4375 11.75 9 10.8438C10.5312 9.9375 11.5 8.3125 11.5 6.5ZM10.5312 11.625C9.40625 12.5 8 13 6.5 13C2.90625 13 0 10.0938 0 6.5C0 2.9375 2.90625 0 6.5 0C10.0625 0 13 2.9375 13 6.5C13 8.03125 12.4688 9.4375 11.5938 10.5625L15.7812 14.7188C16.0625 15.0312 16.0625 15.5 15.7812 15.7812C15.4688 16.0938 15 16.0938 14.7188 15.7812L10.5312 11.625Z"/></svg>
            </button>
          )}
          {showAskAi && (
            <button class="pm-util" type="button" aria-label={askAiLabel}>
              <svg viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"><path d="M8 1C8.28125 1 8.53125 1.1875 8.65625 1.4375L10.5312 5.46875L14.5625 7.34375C14.8125 7.46875 15 7.71875 15 8C15 8.3125 14.8125 8.5625 14.5625 8.6875L10.5312 10.5625L8.65625 14.5938C8.53125 14.8438 8.28125 15 8 15C7.6875 15 7.4375 14.8438 7.3125 14.5938L5.4375 10.5625L1.40625 8.6875C1.15625 8.5625 1 8.3125 1 8C1 7.71875 1.15625 7.46875 1.40625 7.34375L5.4375 5.46875L7.3125 1.4375C7.4375 1.1875 7.6875 1 8 1ZM8 3.5625L6.6875 6.34375C6.625 6.5 6.5 6.65625 6.3125 6.71875L3.53125 8L6.3125 9.3125C6.5 9.375 6.625 9.5 6.6875 9.6875L8 12.4688L9.28125 9.6875C9.34375 9.5 9.46875 9.375 9.65625 9.3125L12.4375 8L9.65625 6.71875C9.5 6.65625 9.34375 6.53125 9.28125 6.34375L8 3.5625Z"/><path d="M2.87109 0.289062L3.57422 1.80078L5.08594 2.50391C5.17969 2.55078 5.25 2.64453 5.25 2.75C5.25 2.86719 5.17969 2.96094 5.08594 3.00781L3.57422 3.71094L2.87109 5.22266C2.82422 5.31641 2.73047 5.375 2.625 5.375C2.50781 5.375 2.41406 5.31641 2.36719 5.22266L1.66406 3.71094L0.152344 3.00781C0.0585938 2.96094 0 2.86719 0 2.75C0 2.64453 0.0585938 2.55078 0.152344 2.50391L1.66406 1.80078L2.36719 0.289062C2.41406 0.195312 2.50781 0.125 2.625 0.125C2.73047 0.125 2.82422 0.195312 2.87109 0.289062Z"/></svg>
            </button>
          )}
        </div>
      )}
    </div>

    <div class="pm-right">
      {/* THE CTA IS `NugetButton`, and Figma says so: node 790:1177 — the
          Default variant of this very component — contains `790:2393`, an
          INSTANCE of `button-Nuget` at md with its Download Count layer hidden.
          The bar hand-drew the same pill until 2026-08-19 and had drifted off
          the node on two counts, both measured before this changed:
            width  183.64 against the node's 187.00. The 3px is exactly the
                   caret: `.pm-cta-caret` was a raw 9x6 glyph beside the flat
                   `gap-xs`, where the node centres an 8.745x5.271 vector in a
                   16px box with `spacing-micro` beside it. 16 - 9 - (8 - 4) = 3.
                   Composed it renders 186.64, and the 0.36 left over is text
                   measurement — the node's label run is 95, ours is 94.64.
            ring   a 2px `--color-border-focus` outline, which resolves to
                   #2693EC: a BLUE ring on a pink button. NugetButton carries
                   `--shadow-focus-magenta`, which its source records as the
                   node's ring exactly.
          Composing also deleted the second copy of two SVG paths and left
          `--color-text-on-primary` with no users at all — `.pm-cta` was the only
          one in the library, which settles a question that was open. */}
      {cta === 'button'
        ? <Button variant="primary" size="md" href={ctaHref} class="pm-cta-swap">{ctaLabel}</Button>
        : <NugetButton size="md" href={ctaHref} label={ctaLabel} />}

      {/* The centre group needs 769px of bar to lay out, and below that it was
          simply `display: none` — the whole product menu gone with nothing in
          its place, which is the same hole TopNav had before `deb78df`. The
          trigger turns it into a panel instead. It is the SAME `<ul>` at every
          width, inline above the breakpoint and a panel below it, so there is
          one set of links and no screen reader hears "Licensing" twice. */}
      {items.length > 0 && (
        <button type="button" class="pm-burger" aria-expanded="false" aria-controls={menuId} aria-label="Product menu">
          <svg class="pm-burger-icon" viewBox={icons.bars.viewBox} fill="currentColor" aria-hidden="true"><path d={icons.bars.path}/></svg>
        </button>
      )}
    </div>
  </div>

  {hasSub && (
    <div class="pm-sub">
      <div class="pm-sub-inner">
        {subLead && (
          <>
            <a class="pm-chip is-active" href={subLead.href ?? '#'} aria-current="page">
              <svg viewBox={icons.graduationCap.viewBox} fill="currentColor" aria-hidden="true"><path d={icons.graduationCap.path}/></svg>
            {subLead.label}
            </a>
            <span class="pm-div" aria-hidden="true"></span>
          </>
        )}
        <ul class="pm-chips">
          {subItems.map((s) => (
            <li>
              <a class="pm-chip" href={s.href ?? '#'}>
                <svg viewBox={icons.graduationCap.viewBox} fill="currentColor" aria-hidden="true"><path d={icons.graduationCap.path}/></svg>
                {s.label}
              </a>
            </li>
          ))}
        </ul>
        {showMenuItems2 && subItemsTrailing.length > 0 && (
          <div class="pm-chips-2">
            <span class="pm-div" aria-hidden="true"></span>
            <ul class="pm-chips">
              {subItemsTrailing.map((s) => (
                <li>
                  <a class="pm-chip" href={s.href ?? '#'}>
                    <svg viewBox={icons.graduationCap.viewBox} fill="currentColor" aria-hidden="true"><path d={icons.graduationCap.path}/></svg>
                    {s.label}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        )}
      </div>
    </div>
  )}
</nav>

<style>
  /*
    Figma node 790:4778 ("Product menu"). Every colour, space and size below is a
    token — the Figma variables map 1:1 onto the system's own names:
      surface/background → --color-bg-base   · surface/card-alt → --color-bg-card-alt
      border/default     → --color-border    · border/strong    → --color-border-strong
      brand|button/primary → --color-primary  · text/default/heading → --color-text-heading
    Menu items use Figma's "Typography/UI/Button large" style (--fw-btn-lg / 16px),
    the CTA uses "Typography/UI/Button default" (--fw-btn / 14px / --leading-4).
    The 40px mark is Figma's own size here — it is deliberately off the 24/48/96/192
    grid the logo specimen documents, so it is set explicitly rather than via Logo.astro.
  */
  .pm { width: 100%; background: var(--color-bg-base); font-family: 'Montserrat', sans-serif; }
  /* NO border-bottom here. It used to carry one, in border/strong, ON TOP of the
     one .pm-bar already keeps inside its 72 — two rules stacked, and the
     component measured 73 against 790:1177's 72 in the default variant and
     140.8 against 790:4779's 137 in the submenu one. The comment below had the
     principle exactly right and nothing asserted it; `check:figma-size` does
     now. 790:1177 draws ONE stroke, border/strong, on the ROOT with h-72
     including it, so the colour moves down to .pm-bar and the rule does not. */
  /* box-sizing so the 1px rule sits *inside* the 72px — Figma's tier is 72px total
     (137px = 72 + 65 on the submenu variant), not 72 plus a border. */
  /* `position: relative` is here for the narrow-width menu panel, which drops
     out of the bar and is positioned against it rather than against the page. */
  .pm-bar { display: flex; align-items: stretch; gap: var(--spacing-md); min-height: 72px; box-sizing: border-box; padding: 0 var(--spacing-xl); background: var(--color-bg-base); border-bottom: var(--border-width-1) solid var(--color-border-strong); position: relative; }
  /* Now that the base rule is border/strong this actually does something: it
     had been restating the base colour, so the tiers were divided by the same
     rule that closes the component. The soft one belongs between them. */
  .pm--submenu .pm-bar { border-bottom-color: var(--color-border); }

  /* Both side columns are flex:1 0 0 (Figma `flex-[1_0_0]`), not 1 0 auto — that is
     what keeps the menu optically centred instead of pushed by the brand's width. */
  .pm-brand { display: flex; align-items: center; gap: var(--spacing-xs); flex: 1 0 0; min-width: 0; text-decoration: none; color: var(--color-text-heading); }
  .pm-mark { display: block; width: 40px; height: 40px; flex-shrink: 0; }
  .pm-name { font-size: var(--font-size-xl); line-height: 1; letter-spacing: -0.04em; white-space: nowrap; }
  .pm-name b { font-weight: var(--fw-btn-lg); }
  .pm-name-hl { font-weight: var(--fw-body); color: var(--color-primary); text-transform: uppercase; }
  .pm-runtime { font-size: var(--font-size-sm); font-weight: var(--fw-body); color: var(--color-text-heading); white-space: nowrap; }
  .pm-caret { width: 14px; height: 14px; flex-shrink: 0; }

  .pm-center { display: flex; align-items: stretch; gap: var(--spacing-sm); min-width: 0; }
  .pm-menu { display: flex; align-items: stretch; list-style: none; margin: 0; padding: 0; min-width: 0; }
  .pm-menu li { display: flex; }
  /* Items stretch to the bar instead of carrying their own 72px, so the whole tier
     stays clickable without re-stating the height in two places. */
  .pm-item { display: flex; align-items: center; gap: var(--spacing-xs); padding: 0 var(--spacing-md); font-size: var(--font-size-base); font-weight: var(--fw-btn-lg); line-height: 1; color: var(--color-text-heading); text-decoration: none; white-space: nowrap; }
  .pm-item:hover { color: var(--color-primary); }
  /* Figma `Active` is a tab-like panel — a white→neutral/50 wash down the full
     72px tier with white side rules. `Active no bg` is the same minus the wash;
     the panel is the default here. */
  .pm-item.is-active { color: var(--color-primary); background: linear-gradient(to bottom, var(--color-bg-base), var(--neutral-50)); border-left: var(--border-width-1) solid var(--color-bg-base); border-right: var(--border-width-1) solid var(--color-bg-base); }
  .pm-item.is-active .pm-caret { transform: rotate(180deg); }

  .pm-utils { display: flex; align-items: center; gap: var(--spacing-sm); flex-shrink: 0; }
  .pm-util { display: inline-flex; align-items: center; justify-content: center; width: 36px; height: 36px; flex-shrink: 0; padding: 0; background: var(--color-bg-card-alt); border: var(--border-width-1) solid var(--color-border); border-radius: var(--rounded-full); color: var(--color-text-link); cursor: pointer; }
  .pm-util svg { width: 16px; height: 16px; display: block; }
  .pm-util:hover { border-color: var(--color-border-strong); }
  .pm-util:focus-visible { outline: var(--border-width-2) solid var(--color-border-focus); outline-offset: 2px; }

  /* `position: relative` so the narrow-width label below clips against the pill
     rather than against whatever positioned ancestor happens to be above it. The
     pill itself is NugetButton now and brings its own fill, height, padding,
     radius, type and focus ring — this is the one thing the bar still says about
     it, and it is a containing block, not a look. */
/* `align-self: center` and not the bar's `stretch`, which is what this
     inherited. Two reasons and they are the same reason. `314:205` is 48 tall,
     inset 12 in a 72 tier — stretched it measured 71, a structural difference
     the picture hides because the CTA centres either way. And stretched, the
     CTA's own height stops mattering: a 56px button would sit inside 71 and
     move NOTHING, so no rendered band could ever see it. Centred, this box IS
     the CTA's height, which is what makes `cta` below a band that can fail. */
  .pm-right { display: flex; align-items: center; justify-content: flex-end; align-self: center; flex: 1 0 0; min-width: 0; }

  .pm-burger { display: none; align-items: center; justify-content: center; width: 24px; height: 24px; flex-shrink: 0; padding: 0; border: 0; background: none; color: var(--color-text-heading); cursor: pointer; }
  .pm-burger:hover { color: var(--color-primary); }
  .pm-burger:focus-visible { outline: var(--border-width-2) solid var(--color-border-focus); outline-offset: 2px; }
  .pm-burger-icon { width: 16px; height: 16px; display: block; }

  /* 799:846 is 65 and its content sits at y=12 with height 41, so 12 + 41 + 12 is
     the whole tier and the stroke is drawn INSIDE it. A border-bottom is a 66th
     pixel; an inset shadow paints the same line and takes no space. Same reading
     as the Footer review card, whose 124x48 has its stroke inside too. */
  .pm-sub { display: flex; align-items: center; justify-content: center; padding: var(--spacing-sm) var(--spacing-xl); background: var(--neutral-50); box-shadow: inset 0 calc(-1 * var(--border-width-1)) 0 var(--color-border-strong); }
  .pm-sub-inner { display: flex; align-items: center; gap: var(--spacing-md); min-width: 0; }
  .pm-chips { display: flex; align-items: center; gap: var(--spacing-xs); list-style: none; margin: 0; padding: 0; }
  .pm-chips-2 { display: flex; align-items: center; gap: var(--spacing-md); }
  /* ALL FOUR variants of 507:5503 are 125x41 — Default, Hover, Active and
     Activehover — so the box does not grow when the border appears, and the
     node's text sits at x=16 y=12 in a chip that is 12 + 17 + 12. A reserved
     transparent border, the pattern Button and FooterBar's trigger use, adds 2
     here instead of nothing: the chip measured 42.8. An inset shadow needs no
     reserve at all, because it never took part in layout in the first place. */
  .pm-chip { display: inline-flex; align-items: center; gap: var(--spacing-xs); padding: var(--spacing-sm) var(--spacing-md); border-radius: var(--rounded-3xl); font-size: var(--font-size-sm); font-weight: var(--fw-nav-sub); line-height: 1.2; color: var(--color-text-heading); text-decoration: none; white-space: nowrap; }
  .pm-chip svg { width: 16px; height: 13px; flex-shrink: 0; }
  .pm-chip:hover { color: var(--color-primary); }
  .pm-chip.is-active { background: var(--color-bg-base); box-shadow: inset 0 0 0 var(--border-width-1) var(--color-border); border-radius: var(--rounded-lg); }
  /* Figma `Activehover` — the box darkens its border and the label turns brand.
     Figma's `Active` leaves the label its default colour, so the brand colour
     belongs to the hover, not to being active. */
  .pm-chip.is-active:hover { box-shadow: inset 0 0 0 var(--border-width-1) var(--color-border-strong); color: var(--color-primary); }
  .pm-div { width: 1px; height: 24px; flex-shrink: 0; background: var(--slate-300); }

  /* Figma covers 1440px desktop only — shed the optional pieces before the bar
     breaks. Every number below is the width its own content measured out at,
     not a device size: a round breakpoint sitting under the measured one is the
     bug this component had at 769–1057, and the one the sweep exists to find. */
  @media (max-width: 1180px) { .pm-runtime { display: none; } .pm-item { padding: 0 var(--spacing-sm); } }

  /* 1058, not 1024. With the util bubbles on screen the bar needs 1058 for the
     CTA to fit, so 1025–1057 had it hanging 96.55px out of .pm-right. */
  @media (max-width: 1057.98px) {
    .pm-utils { display: none; }
    .pm-menu { overflow-x: auto; scrollbar-width: none; }
    .pm-menu::-webkit-scrollbar { display: none; }
    /* Basis auto, not 0 — this is the whole fix for 769–961. With basis 0 on
       both side columns the free space is split equally between them whatever
       they need, and .pm-center is never forced to give anything up, so the
       shrink lands on two columns that cannot shrink (mark, nowrap wordmark,
       nowrap CTA) and their children leave the box. With basis auto the columns
       state their width, the shrink falls on the one child that can absorb it,
       and the menu scrolls — which it already does at these widths anyway.
       Kept out of the base rule on purpose: at >=1058 basis 0 is what centres
       the menu optically rather than pushing it by the brand's width. */
    .pm-brand, .pm-right { flex: 1 0 auto; }
  }

  /* 1043 is the sub tier's own number and has nothing to do with the bar's —
     .pm-chips-2 leaves .pm-sub-inner by 273.66px until then. That 273.66 is now
     APPROXIMATE by about 16: the chips lost the 2px their reserved border was
     adding to each of eight, on 2026-08-28. It is stale in the safe direction —
     narrower content leaves the row by less, so the scroller is needed no
     earlier — and re-measuring it moves a breakpoint, which is a change to make
     on purpose rather than as a side effect. The scroller below
     already existed; it just started at 768, 275px under where it was needed. */
  @media (max-width: 1042.98px) { .pm-sub-inner { overflow-x: auto; scrollbar-width: none; } .pm-sub-inner::-webkit-scrollbar { display: none; } }

  /* 769 is where the centre group stops fitting inline. Below it the same <ul>
     becomes a panel under the bar rather than disappearing. `.pm-bar` is the
     positioning context so the panel hangs off the bar's real height instead of
     a hard-coded 72px, which the sub tier variant would have got wrong. */
  @media (max-width: 768px) {
    .pm-burger { display: inline-flex; }
    .pm-center { display: none; position: absolute; top: 100%; left: 0; right: 0; z-index: 20; flex-direction: column; align-items: stretch; gap: 0; padding: var(--spacing-xs) var(--spacing-xl) var(--spacing-sm); background: var(--color-bg-base); border-bottom: var(--border-width-1) solid var(--color-border); }
    .pm.pm-menu-open .pm-center { display: flex; }
    /* The inline tier scrolls sideways; a stacked panel must not, or the rows
       inherit a scroller with nothing to scroll and swallow the horizontal
       gesture. */
    .pm-menu { flex-direction: column; align-items: stretch; overflow-x: visible; }
    .pm-menu li { display: flex; }
    /* Each row is its own hit target across the panel, so the caret sits at the
       end of the line rather than tight against the label as it does inline. */
    .pm-item { justify-content: space-between; width: 100%; padding: var(--spacing-sm) 0; }
    /* `is-active` is a 72px tab — a wash down the tier with white side rules.
       Stacked, that reads as a stray box, so the panel keeps only the colour. */
    .pm-item.is-active { background: none; border-left-color: transparent; border-right-color: transparent; }
  }

  /* 434, and it is the trigger that put it there. The bar needs 410 for the
     brand and the full CTA; adding a 24px button and its 16px gap took that to
     434, so 320/375/414 — clean a moment earlier — broke. Below it the CTA
     keeps its pill and both glyphs but drops the label out of the flow, and the
     brand drops its chevron: 434 -> 310, which is 10px of room at 320. The
     label goes to a clipped 1px box, NOT `display: none`, so the link keeps its
     accessible name and the pill is still "Start for Free" to a screen reader. */
  @media (max-width: 433.98px) {
    .pm-brand > .pm-caret { display: none; }
  }
</style>

<!--
  THE OTHER HALF OF THAT BREAKPOINT, and it has to be global. The label is
  NugetButton's, and Astro's scoping stamps a different `data-astro-cid` on that
  component's elements than on this one's — so a scoped `.pm-right
  [data-part='label']` compiles to a selector requiring THIS component's id on
  the label and matches nothing. Measured, not guessed: with the rule scoped, the
  label read `position: static` at 320/375/433 and the bar's content was cut at
  391px inside 320.

  `is:global` rather than `:global()`, the same choice FlyoutMenu records: the
  docs page carries every rule verbatim for check:parity, and `:global()` is not
  a real pseudo-class, so the browser would drop the whole rule there — costing
  the docs page exactly the behaviour this rule exists to show.

  Kept to one selector, under `.pm-right`, inside the media query. The rule stays
  HERE rather than in NugetButton because 434 is this bar's number — brand + CTA
  + burger — and a button has no business owning a breakpoint measured from a
  layout it is only a part of. Ball's call, 2026-08-19.
-->
<style is:global>
  @media (max-width: 433.98px) {
    .pm-right [data-part='label'] { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }
  }
</style>
<style is:global>
  /* The NuGet CTA is a COMPOSED child, so this cannot be scoped. Astro rewrites a
     scoped selector with the component's own `data-astro-cid-…` on both sides —
     `.pm-right[cid] > a[cid]` — and NugetButton's <a> carries a different scope
     or none, so the rule never matched it in a real app. It only ever applied on
     the docs pages, where build-component-css.mjs flattens every block unscoped.
     Found by `check:flat-scope` on 2026-08-19, which asks the rendered tree what
     each rule reaches once the scoping is stripped.

     `.pm-right` is this component's own prefixed class, so global costs nothing
     here: it reaches a direct <a> child of a ProductMenu right-hand group and
     nothing else. Same arrangement TopNav uses to style the flyout it composes.

     It is a containing block, not a look — the pill brings its own fill, height,
     padding, radius, type and focus ring. */
  .pm-right > a { position: relative; }

  /* THE SWAPPED CTA'S HALF OF THE 434 BREAKPOINT. The pill above it keeps its
     shape and drops its label, because it still has two glyphs to show; a plain
     button has none, so collapsing its label would leave an empty pill. It gives
     up its inline padding instead — the same trade, made the other way round.
     `npm run overflow` is what asked for this: at 320 the swapped CTA left
     `.pm-bar` by 30.72px, visible and unclipped, while the pill form was clean.

     Two classes deep on purpose. A single utility class is one deep, and which
     of the two wins is decided by their order in the compiled stylesheet rather
     than by where they are written — the same trap `wrap` exists to avoid on
     Button. `.pm-right > a.pm-cta-swap` cannot lose that race whichever sheet
     lands first. Global for the reason above: the button is a composed child and
     a scoped selector would stamp this component's id on both sides. */
  @media (max-width: 433.98px) {
    .pm-right > a.pm-cta-swap { padding-inline: var(--spacing-xs); }
  }
</style>


<script>
  // Disclosure pattern (WAI-ARIA APG), the same one TopNav's corporate menu and
  // FooterBar's tools panel use: the trigger owns aria-expanded and points at
  // the panel it controls. The menu stays in the DOM at every width — above the
  // breakpoint it is the inline centre group, below it the same element is the
  // panel — so there is one set of links rather than two to keep in sync.
  function initProductMenu(scope: ParentNode = document) {
    scope.querySelectorAll<HTMLElement>('.pm:not([data-pm-init])').forEach((pm) => {
      const trigger = pm.querySelector<HTMLButtonElement>('.pm-burger');
      const menu = pm.querySelector<HTMLElement>('.pm-center');
      if (!trigger || !menu) return;
      pm.dataset.pmInit = '1';

      const setOpen = (open: boolean) => {
        pm.classList.toggle('pm-menu-open', open);
        trigger.setAttribute('aria-expanded', String(open));
      };
      const close = (focusTrigger: boolean) => {
        if (!pm.classList.contains('pm-menu-open')) return;
        setOpen(false);
        if (focusTrigger) trigger.focus();
      };

      trigger.addEventListener('click', () => setOpen(!pm.classList.contains('pm-menu-open')));
      // Escape closes from anywhere in the bar and hands focus back, and a click
      // outside closes without stealing it — an open panel that survives a click
      // on the page behind it is the thing users report as stuck.
      pm.addEventListener('keydown', (e) => {
        if ((e as KeyboardEvent).key === 'Escape') close(true);
      });
      document.addEventListener('click', (e) => {
        if (!pm.contains(e.target as Node)) close(false);
      });
    });
  }
  document.addEventListener('DOMContentLoaded', () => initProductMenu());
  document.addEventListener('astro:page-load', () => initProductMenu());
</script>
