---
import Button from './Button.astro';
import { icons } from '../icons';

interface Product {
  prefix: string;   // e.g. "IRON"
  suffix: string;   // e.g. "PDF"
  desc: string;
  accent?: string;  // CSS color for the suffix, e.g. "var(--iron-blue-500)"
  href?: string;
}

interface Props {
  /** Suite: full-brand headline for homepage/generic pages. Default: names the current product (cross-sell). */
  variant?: 'suite' | 'default';
  /** Required when variant="default" — e.g. "IronPDF" */
  productName?: string;
  products: Product[];
  donateImgSrc?: string;
  suiteLogoImgSrc?: string;
  productLogoSrc?: string;
  class?: string;
}

const {
  variant = 'default',
  productName,
  products,
  donateImgSrc = 'assets/1% logo - Horizontal.png',
  suiteLogoImgSrc = 'assets/hash-white color.svg',
  productLogoSrc = 'assets/logo.svg',
  class: className,
} = Astro.props;

/* These props are whole paths, so encode segment by segment — encoding the lot
   would eat the slashes, and encodeURI would leave the `%` alone, which is the
   one character that actually breaks. `1% logo - Horizontal.png` reaches the
   browser as the invalid escape `% l` and the image never loads; it had been
   broken in both variants since this component shipped, because every gate here
   only ever asked whether the file exists on disk. */
const src = (p: string) => p.split('/').map(encodeURIComponent).join('/');
---

<div class:list={['footer-top', className]}>
  <div class="ft-inner">
    <div class="ft-left">
      <div class="ft-donate">Every Iron Suite Donates <img src={src(donateImgSrc)} alt="1% For The Planet" /></div>
      <div class="ft-main">
        <div class="ft-text">
          {variant === 'suite' ? (
            <div class="f-suite-logo">
              <img src={src(suiteLogoImgSrc)} alt="" />
              <span><span class="hl">IRON</span><span class="ac">SUITE</span></span>
            </div>
          ) : (
            <div class="ft-headline">{productName} is a part of <span class="hl">IRON</span><span class="ac">SUITE</span></div>
          )}
          <p class="ft-tagline"><span class="dim">10 .NET API products</span><span class="support"> for your office documents</span></p>
        </div>
        <div class="ft-actions">
          <Button variant="tertiary" size="lg" href="#" class="ft-cta">
            Get Full 10 products Suite
            <svg class="arr" viewBox={icons.arrowRight.viewBox} fill="currentColor" aria-hidden="true"><path d={icons.arrowRight.path}/></svg>
          </Button>
          <Button variant="ghost" size="lg" href="#" class="ft-cta">
            <svg viewBox={icons.key.viewBox} fill="currentColor" aria-hidden="true"><path d={icons.key.path}/></svg>
            Start Free Trial
            <svg class="arr" viewBox={icons.arrowRight.viewBox} fill="currentColor" aria-hidden="true"><path d={icons.arrowRight.path}/></svg>
          </Button>
        </div>
      </div>
    </div>
    <div class="ft-divider"></div>
    <div class="ft-right">
      <ul class="f-products">
        {products.map((p) => (
          <li class="fp-row">
            <span class="fp-logo"><img src={src(productLogoSrc)} alt="" /></span>
            <span class="fp-name">{p.prefix}<span class="suffix" style={p.accent ? { color: p.accent } : undefined}>{p.suffix}</span></span>
            <span class="fp-sep">-</span>
            <span class="fp-desc">{p.desc}</span>
          </li>
        ))}
      </ul>
    </div>
  </div>
</div>

<style>
  .footer-top {
    background-color: var(--color-bg-dark-shade);
    background-image: url('assets/Rainbow.svg'); background-size: cover; background-position: center;
    color: var(--color-text-on-color-heading); position: relative; overflow: hidden;
  }
  .ft-inner { max-width: var(--size-container-content); margin: 0 auto; display: flex; align-items: stretch; padding: var(--spacing-4xl) 0; }
  /* 24 outside, 48 in towards the divider — not 48 both sides. Figma insets the
     row by 24 (node 566:8083, 1232 wide inside the 1280) and then leaves 48 to
     the divider, which makes each column 567: 24 + 567 + 48 + 2 + 48 + 567 + 24.
     At 48/48 the columns come out 543, and the right edges still line up, so the
     24 that goes missing on each outer edge is invisible until something has to
     fit — the two CTAs total 556.5 and were wrapping to a second line. */
  .ft-left { flex: 1; padding: 0 var(--spacing-3xl) 0 var(--spacing-xl); display: flex; flex-direction: column; }
  .ft-divider { background: var(--transparent-white-10); width: 2px; flex-shrink: 0; align-self: stretch; }
  .ft-right { flex: 1; padding: 0 var(--spacing-xl) 0 var(--spacing-3xl); }
  .ft-donate { display: flex; align-items: center; justify-content: flex-end; gap: var(--spacing-xs); font-size: var(--font-size-xs); font-weight: 500; color: var(--color-text-on-color-heading); letter-spacing: var(--letter-spacing-nav-label); }
  .ft-donate img { height: 30px; width: auto; display: block; }
  .ft-main { display: flex; flex-direction: column; gap: var(--spacing-2xl); padding-top: var(--spacing-3xl); }
  .ft-text { display: flex; flex-direction: column; gap: var(--spacing-md); }
  .f-suite-logo { font-weight: 700; font-size: var(--font-size-3xl); display: flex; align-items: center; gap: var(--spacing-micro); }
  .f-suite-logo img { height: 30px; width: auto; display: block; }
  .ft-headline { font-weight: 700; font-size: var(--font-size-3xl); color: var(--color-text-on-color-heading); line-height: 1.2; }
  .ft-headline .hl, .f-suite-logo .hl { color: var(--color-text-on-color-heading); font-weight: 700; }
  .ft-headline .ac, .f-suite-logo .ac { color: var(--color-primary); font-weight: 400; }
  .ft-tagline { font-size: var(--font-size-xl); font-weight: 700; line-height: var(--leading-7); }
  .ft-tagline .dim { color: var(--color-text-dark-heading); }     /* near-white */
  .ft-tagline .support { color: var(--color-text-dark-support); } /* dusty violet */
  /* Figma's CTA frame (507:4077) sets no gap — it is `justify-between` across the
     567 column, and the 18px you can measure between the two buttons is just what
     that produced at Figma's own widths. Ours come out 3-4px wider each (Solid
     glyphs where Figma sets Regular, plus text rendering), so a fixed gap of any
     size would push the pair past the column; space-between absorbs it. The row
     gap is for the wrapped state only. */
  .ft-actions { display: flex; align-items: center; justify-content: space-between; row-gap: var(--spacing-md); flex-wrap: wrap; }
  /* Both CTAs are the DS Button (Figma composes two `button` instances here,
     507:4078 tertiary and 507:4079 ghost, both large). This used to be a pair of
     hand-rolled `.btn-dark` / `.btn-text-light` rules that had drifted: gap 8
     against Figma's 12, and the second one was not a button at all — 19px tall,
     no padding, no pill, white where Figma paints `on-action-tertiary` blue.
     Button owns all of that now; what is left here is only what Button has no
     opinion about. */
  .ft-cta svg { height: 1em; width: auto; flex-shrink: 0; }
  /* Not from Figma — this component has always slid the arrow on hover, and it
     is worth keeping. Scoped to `.arr` so the leading key icon stays put. */
  .ft-cta .arr { transition: transform var(--duration-base); }
  .ft-cta:hover .arr { transform: translateX(3px); }
  .f-products { list-style: none; display: flex; flex-direction: column; gap: 6px; margin: 0; padding: 0; }
  .fp-row { display: flex; align-items: center; white-space: nowrap; line-height: 1.5; gap: var(--spacing-micro); cursor: pointer; }
  .fp-logo { width: 22px; height: 22px; flex-shrink: 0; display: flex; align-items: center; }
  .fp-logo img { width: 22px; height: 22px; display: block; opacity: 0; transition: opacity var(--duration-base); }
  .fp-row:hover .fp-logo img { opacity: 1; }
  .fp-name { font-size: var(--font-size-lg); font-weight: 700; letter-spacing: var(--letter-spacing-h4); color: var(--color-text-on-color-heading); display: flex; align-items: baseline; }
  .fp-name .suffix { font-weight: 400; }
  .fp-sep { font-size: var(--font-size-sm); color: var(--color-text-dark-support); margin: 0 var(--spacing-micro); transition: color var(--duration-base); }
  .fp-row:hover .fp-sep { color: var(--color-text-on-color-heading); }
  .fp-desc { font-size: var(--font-size-sm); color: var(--color-text-dark-support); transition: color var(--duration-base); }
  .fp-row:hover .fp-desc { color: var(--color-text-on-color-body); }
  @media (max-width: 640px) { .ft-inner { flex-direction: column; gap: 32px; } .ft-divider { display: none; } }
</style>
