---
import Button from './Button.astro';
import { icons } from '../icons';
import FooterProduct from '../internal/FooterProduct.astro';

interface Product {
  prefix: string;   // e.g. "IRON"
  suffix: string;   // e.g. "PDF"
  desc: string;
  accent?: string;  // CSS color for the suffix, e.g. "var(--iron-blue-500)"
  href?: string;
}

interface Props {
  /** Suite: full-brand headline for homepage/generic pages. Default: names the current product (cross-sell). */
  variant?: 'suite' | 'default';
  /** Required when variant="default" — e.g. "IronPDF" */
  productName?: string;
  products: Product[];
  /**
   * Heading level for the band's headline. The band is a section of a page, not a
   * page of its own, so it cannot know how deep it sits — pass the level that
   * keeps the host page's outline unbroken. Default 2.
   */
  headingLevel?: 2 | 3 | 4;
  /** Accessible name for the band's landmark, read by the "list of regions" view. */
  label?: string;
  /**
   * Asset paths. These default to SITE-ROOT paths, not paths relative to the
   * page: `assets/logo.svg` resolves against the current URL, so it is correct
   * only on a page that happens to sit at `/` and 404s on `/pricing` — silently,
   * because a missing image logs nothing a build can fail on. A consuming app
   * that keeps these in `public/assets/` needs to pass nothing; anything else
   * passes its own path. The docs are the one caller that must override, because
   * they are published under a repository subpath.
   */
  donateImgSrc?: string;
  suiteLogoImgSrc?: string;
  productLogoSrc?: string;
  /**
   * The band's rainbow backdrop. It is a PROP and painted inline for a reason:
   * as a bracketed `bg-` arbitrary value holding the url, the path was baked
   * into the compiled stylesheet, where a consumer's bundler rewrote it to
   * `/_astro/assets/Rainbow.svg` and it 404'd with the band rendering flat — and
   * no prop existed to correct it, so the roi-calculator carried an
   * `!important` global override instead of a value.
   *
   * The class is deliberately NOT spelled out above. Tailwind extracts
   * candidates from the whole file, COMMENTS INCLUDED, so writing it compiles it
   * straight back into every consumer's stylesheet — the exact bug this prop
   * exists to remove. The band stopped wearing the class on 2026-08-18
   * (`ececa65`); the string survived in this comment until 2026-08-21, and every
   * consumer build in between still printed `assets/Rainbow.svg … didn't resolve
   * at build time`. Nothing here could see it: this repo's own pipeline strips
   * comments before Tailwind reads them (`build-utilities.mjs`) and a consumer's
   * does not. `check:prose-classes` fails if it comes back.
   */
  rainbowSrc?: string;
  class?: string;
}

const {
  variant = 'default',
  productName,
  products,
  headingLevel = 2,
  label = 'Iron Suite',
  donateImgSrc = '/assets/1% logo - Horizontal.png',
  suiteLogoImgSrc = '/assets/hash-white color.svg',
  productLogoSrc = '/assets/logo.svg',
  rainbowSrc = '/assets/Rainbow.svg',
  class: className,
} = Astro.props;

const Heading = `h${headingLevel}` as 'h2' | 'h3' | 'h4';

/* These props are whole paths, so encode segment by segment — encoding the lot
   would eat the slashes, and encodeURI would leave the `%` alone, which is the
   one character that actually breaks. A leading `/` survives: split gives an
   empty first segment, which encodes to nothing and rejoins as the same slash. `1% logo - Horizontal.png` reaches the
   browser as the invalid escape `% l` and the image never loads; it had been
   broken in both variants since this component shipped, because every gate here
   only ever asked whether the file exists on disk. */
const src = (p: string) => p.split('/').map(encodeURIComponent).join('/');
---

<section class:list={['bg-bg-dark-shade bg-cover bg-center text-text-on-dark-heading relative overflow-hidden', className]} style={{ backgroundImage: `url("${src(rainbowSrc)}")` }} aria-label={label}>
  {/* NO BREAKPOINT. Ball's ruling 2026-08-24: `auto-fit` + a measured minimum,
      the same lever `03-spacing` used, rather than moving the round number.

      This band stacked below `lg` 1024 while the two columns needed a measured
      width, which is the one responsive bug this system keeps having. Measured
      on `max-content` clones so the number is the CONTENT's and not the width
      the page happened to be at: the products column needs 634.81 (562.81 of
      row — "IRONWORD - Edit DOCX Word Files. No Office Interop required." — plus
      72 of padding) and the left column 628.44. The products column binds, so
      635, and two of those plus the 2px rule is 1272 — which is exactly where
      the old flex layout was measured to stop wrapping, from the other
      direction. Below it the grid drops to one column on its own and there is no
      number to keep in sync.

      `min(635px,100%)` and not a bare 635px, and `npm run overflow` is what said
      so — 6 cut elements at 320/375/414 on the first version. A minmax FLOOR is
      a floor at every width: below 635 the single track stayed 635 and the
      column hung 315px out of a container that had just been given
      `overflow-hidden`, so it was cut in silence with a clean `scrollWidth`.
      That is the exact failure this sweep exists for, and the reason 03-spacing
      never hit it is that its 260px floor is smaller than any viewport.

      `overflow-hidden` is load-bearing, not tidiness: it is what hides the rule
      when the grid collapses. See the products column below. */}
  <div class="max-w-[var(--size-container-content)] mx-auto grid grid-cols-[repeat(auto-fit,minmax(min(635px,100%),1fr))] gap-x-[2px] gap-y-[32px] py-4xl overflow-hidden">
    <div class="pl-xl pr-3xl flex flex-col">
      {/* 32, which is BOTH the node's row height (`346:428`) and the PNG's own
          natural size — `file` reports 76x32, so the old `h-[30px]` was
          resampling a raster to 71.25x30 for no reason. `leading-4` is Figma's
          `Typography/caption-sm` 12/16; `leading-[normal]` was ~14.6 here and
          the row measured 30 against the node's 32. */}
      <p class="flex items-center justify-end gap-xs text-xs leading-4 font-medium text-text-on-dark-heading tracking-nav-label m-0">Every Iron Suite Donates <img class="h-[32px] w-auto block" src={src(donateImgSrc)} alt="1% for the Planet" /></p>
      {/* `pt-hero` 80 and `gap-3xl` 48 are the node's, and both were short —
          `pt-3xl` 48 and `gap-2xl` 32. Together with the two fixes above and the
          heading's leading below, the column goes 247 -> 296, which is what
          `346:427` measures. It changes NO band height: this column is the
          shorter of the two in both variants and the product list sets the
          480. What it was doing was floating the whole block 45px too high. */}
      <div class="flex flex-col gap-3xl pt-hero">
        <div class="flex flex-col gap-md">
          {variant === 'suite' ? (
            /* `leading-9` 36 is `--line-height-h2`, and Ball ruled on 2026-08-24
               that the Suite heading takes it like every other h2 — the node had
               drawn this one text at 30 while the Default variant's was 36, the
               one place the two variants disagreed with each other. Both are 36
               now. `leading-[normal]` computed to ~36.6 here, which is why the
               row measured 37.

               The mark is sized by WIDTH, not height. Figma draws it as a 32x32
               box whose visible vector is 32 x 26.67 — the same 1.2 ratio as our
               own `hash-white color.svg` (viewBox 18x15), so it is one drawing in
               two wrappers, not two drawings. Sizing by height made it 36 WIDE
               against the node's 32. At `w-[32px]` the glyph lands 32 x 26.67 and
               centres to the same y as Figma's padded box: (36-26.67)/2 = 4.67,
               and 2 + 2.67 = 4.67. `gap-xs` 8 is the node's 40 - 32. */
            <Heading class="font-bold text-3xl leading-9 flex items-center gap-xs m-0">
              <img class="w-[32px] h-auto block" src={src(suiteLogoImgSrc)} alt="" />
              <span><span class="text-text-on-dark-heading font-bold">IRON</span><span class="text-primary font-normal">SUITE</span></span>
            </Heading>
          ) : (
            <Heading class="font-bold text-3xl text-text-on-dark-heading leading-[1.2] m-0">{productName}{' is a part of '}<span class="text-text-on-dark-heading font-bold">IRON</span><span class="text-primary font-normal">SUITE</span></Heading>
          )}
          {/* 20/28/800 is the h4 role exactly, and `346:438` binds all three —
              size/xl, leading/7 and `weight/extrabold`. The size and leading were
              already right and the weight was `font-bold` 700, which is h3's.
              `font-h4` is the role's own class and two other components already
              wear it.

              The first run is `text/default/body`, which reads #D4D4D4 in this
              band's mode — `--color-text-dark-body`. It was on
              `text-text-dark-heading` #F5F5F5, one step too bright. Worth knowing
              how that was pinned: the SAME variable came back #262626 on the
              light mega-menu panel earlier the same day, so a single reading of
              `text/default/*` says nothing about which value applies — it is the
              node's mode that decides, and two readings are what identify it. */}
          <p class="text-xl font-h4 leading-7 m-0"><span class="text-text-dark-body">10 .NET API products</span><span class="text-text-dark-support"> for your office documents</span></p>
        </div>
        {/* `wrap` is the same fix the product rows above already carry: a label
            that cannot bend does not shrink, it leaves the box — and this band
            is `overflow: hidden`, so it is cut rather than scrolled, with no
            scrollbar to hint at it. "Get Full 10 products Suite" is 213.5px of
            text + a 16px arrow + a 12px gap + 64px of padding = 309.5px against
            248px of room at a 320 viewport, and it was losing 61.5px there and
            6.5px at 375. Padding is not the lever: taking all 64px away still
            leaves it 2.5px over at 320.

            It is a prop and not a class because a class cannot win — see the
            note on `wrap` in Button. */}
        <div class="flex items-center justify-between gap-y-md flex-wrap">
          <Button variant="tertiary" size="lg" href="#" wrap class="group">
            Get Full 10 products Suite
            <svg class="h-[1em] w-auto shrink-0 transition-transform duration-[var(--duration-base)] group-hover:translate-x-[3px]" viewBox={icons.arrowRight.viewBox} fill="currentColor" aria-hidden="true"><path d={icons.arrowRight.path}/></svg>
          </Button>
          <Button variant="ghost" size="lg" href="#" wrap class="group">
            <svg class="h-[1em] w-auto shrink-0" viewBox={icons.key.viewBox} fill="currentColor" aria-hidden="true"><path d={icons.key.path}/></svg>
            Start Free Trial
            <svg class="h-[1em] w-auto shrink-0 transition-transform duration-[var(--duration-base)] group-hover:translate-x-[3px]" viewBox={icons.arrowRight.viewBox} fill="currentColor" aria-hidden="true"><path d={icons.arrowRight.path}/></svg>
          </Button>
        </div>
      </div>
    </div>
    {/* The rule was a 2px flex item with `max-lg:hidden`. With no breakpoint left
        there is nothing to hang that `hidden` on, so it becomes a pseudo-element
        drawn in the 2px column gap — and the CLIP is what replaces the media
        query. In two columns it sits at -2px from this column, inside the gap.
        When `auto-fit` collapses, this column starts at the grid's left edge, so
        -2px is outside the container and `overflow-hidden` above eats it. The
        layout mode hides it, rather than a number that has to agree with one. */}
    <div class="pl-3xl pr-xl relative before:content-[''] before:absolute before:left-[-2px] before:top-0 before:bottom-0 before:w-[2px] before:bg-[var(--transparent-white-10)]">
      <ul class="list-none flex flex-col gap-xs m-0 p-0">
        {products.map((p) => <FooterProduct product={p} logoSrc={src(productLogoSrc)} />)}
      </ul>
    </div>
  </div>
</section>

