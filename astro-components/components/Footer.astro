---
import Button from './Button.astro';
import { icons } from '../icons';

interface Product {
  prefix: string;   // e.g. "IRON"
  suffix: string;   // e.g. "PDF"
  desc: string;
  accent?: string;  // CSS color for the suffix, e.g. "var(--iron-blue-500)"
  href?: string;
}

interface Props {
  /** Suite: full-brand headline for homepage/generic pages. Default: names the current product (cross-sell). */
  variant?: 'suite' | 'default';
  /** Required when variant="default" — e.g. "IronPDF" */
  productName?: string;
  products: Product[];
  /**
   * Heading level for the band's headline. The band is a section of a page, not a
   * page of its own, so it cannot know how deep it sits — pass the level that
   * keeps the host page's outline unbroken. Default 2.
   */
  headingLevel?: 2 | 3 | 4;
  /** Accessible name for the band's landmark, read by the "list of regions" view. */
  label?: string;
  donateImgSrc?: string;
  suiteLogoImgSrc?: string;
  productLogoSrc?: string;
  class?: string;
}

const {
  variant = 'default',
  productName,
  products,
  headingLevel = 2,
  label = 'Iron Suite',
  donateImgSrc = 'assets/1% logo - Horizontal.png',
  suiteLogoImgSrc = 'assets/hash-white color.svg',
  productLogoSrc = 'assets/logo.svg',
  class: className,
} = Astro.props;

const Heading = `h${headingLevel}` as 'h2' | 'h3' | 'h4';

/* These props are whole paths, so encode segment by segment — encoding the lot
   would eat the slashes, and encodeURI would leave the `%` alone, which is the
   one character that actually breaks. `1% logo - Horizontal.png` reaches the
   browser as the invalid escape `% l` and the image never loads; it had been
   broken in both variants since this component shipped, because every gate here
   only ever asked whether the file exists on disk. */
const src = (p: string) => p.split('/').map(encodeURIComponent).join('/');
---

<section class:list={['bg-bg-dark-shade bg-[url(assets/Rainbow.svg)] bg-cover bg-center text-text-on-color-heading relative overflow-hidden', className]} aria-label={label}>
  <div class="max-w-[var(--size-container-content)] mx-auto flex items-stretch py-4xl max-lg:flex-col max-lg:gap-[32px]">
    <div class="flex-1 pl-xl pr-3xl flex flex-col">
      <p class="flex items-center justify-end gap-xs text-xs leading-[normal] font-medium text-text-on-color-heading tracking-nav-label m-0">Every Iron Suite Donates <img class="h-[30px] w-auto block" src={src(donateImgSrc)} alt="1% For The Planet" /></p>
      <div class="flex flex-col gap-2xl pt-3xl">
        <div class="flex flex-col gap-md">
          {variant === 'suite' ? (
            <Heading class="font-bold text-3xl leading-[normal] flex items-center gap-micro m-0">
              <img class="h-[30px] w-auto block" src={src(suiteLogoImgSrc)} alt="" />
              <span><span class="text-text-on-color-heading font-bold">IRON</span><span class="text-primary font-normal">SUITE</span></span>
            </Heading>
          ) : (
            <Heading class="font-bold text-3xl text-text-on-color-heading leading-[1.2] m-0">{productName}{' is a part of '}<span class="text-text-on-color-heading font-bold">IRON</span><span class="text-primary font-normal">SUITE</span></Heading>
          )}
          <p class="text-xl font-bold leading-7 m-0"><span class="text-text-dark-heading">10 .NET API products</span><span class="text-text-dark-support"> for your office documents</span></p>
        </div>
        <div class="flex items-center justify-between gap-y-md flex-wrap">
          <Button variant="tertiary" size="lg" href="#" class="group">
            Get Full 10 products Suite
            <svg class="h-[1em] w-auto shrink-0 transition-transform duration-[var(--duration-base)] group-hover:translate-x-[3px]" viewBox={icons.arrowRight.viewBox} fill="currentColor" aria-hidden="true"><path d={icons.arrowRight.path}/></svg>
          </Button>
          <Button variant="ghost" size="lg" href="#" class="group">
            <svg class="h-[1em] w-auto shrink-0" viewBox={icons.key.viewBox} fill="currentColor" aria-hidden="true"><path d={icons.key.path}/></svg>
            Start Free Trial
            <svg class="h-[1em] w-auto shrink-0 transition-transform duration-[var(--duration-base)] group-hover:translate-x-[3px]" viewBox={icons.arrowRight.viewBox} fill="currentColor" aria-hidden="true"><path d={icons.arrowRight.path}/></svg>
          </Button>
        </div>
      </div>
    </div>
    <div class="bg-[var(--transparent-white-10)] w-[2px] shrink-0 self-stretch max-lg:hidden" aria-hidden="true"></div>
    <div class="flex-1 pl-3xl pr-xl">
      <ul class="list-none flex flex-col gap-[6px] m-0 p-0">
        {products.map((p) => (
          <li>
            <a class="group flex items-center flex-wrap leading-[1.5] gap-micro pl-[26px] no-underline text-inherit focus-visible:outline-[length:var(--border-width-2)] focus-visible:outline-solid focus-visible:outline-border-focus focus-visible:outline-offset-[2px] focus-visible:rounded-sm" href={p.href ?? '#'}>
              <span class="w-[22px] h-[22px] shrink-0 flex items-center ml-[-26px]"><img class="w-[22px] h-[22px] block opacity-0 transition-opacity duration-[var(--duration-base)] group-hover:opacity-100 group-focus-visible:opacity-100" src={src(productLogoSrc)} alt="" /></span>
              <span class="text-lg leading-[inherit] font-bold tracking-h4 text-text-on-color-heading flex items-baseline">{p.prefix}<span class="font-normal" style={p.accent ? { color: p.accent } : undefined}>{p.suffix}</span></span>
              <span class="text-sm leading-[inherit] text-text-dark-support mx-micro transition-colors duration-[var(--duration-base)] group-hover:text-text-on-color-heading group-focus-visible:text-text-on-color-heading" aria-hidden="true">-</span>
              <span class="text-sm leading-[inherit] text-text-dark-support transition-colors duration-[var(--duration-base)] min-w-0 group-hover:text-text-on-color-body group-focus-visible:text-text-on-color-body">{p.desc}</span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>

