---
/**
 * ── Why this component declares no `figma-size` band ──────────────────────
 *
 * It has no box. `.tlink` is a bare inline `<a>` with no `display` of its own,
 * so its height is whatever line box the host page gives it, and padding on an
 * inline element does not move one — the gate would refuse the reading, and it
 * would be right to. Figma draws it as two SPEC FRAMES rather than a variant
 * set for the same reason: a text link is a role, not a shape.
 */
import { icons } from '../icons';

interface Props {
  /** Where the link goes. */
  href: string;
  /**
   * `plain` is link-coloured text for general pages; `underline` is body-coloured text with a soft underline for long-form reading.
   * @figma `variant` on the `TextLink` set — same two values, same default
   */
  variant?: 'plain' | 'underline';
  /**
   * The colours for a dark background.
   * @figma `dark` — the same Figma variables in their Dark Purple mode
   */
  dark?: boolean;
  /**
   * Opens in a new tab (`target="_blank"`, `rel="noopener"`), adds a north-east arrow, and tells a screen reader it will.
   * The arrow is `plain` only: an `underline` link sits inside a sentence, and an
   * icon there breaks the line a reader is following (Ball, 2026-10-01). It still
   * opens a new tab and still says so to a screen reader.
   * @figma `external` — the ↗ only, and on `plain` only; the new tab and the spoken label are code's
   */
  external?: boolean;
  /**
   * A trailing → for a standalone link that leads on within the site — "Learn
   * more", "See all products". It nudges right on hover and focus. Meant for a
   * link that stands on its own, not one inside a sentence, where a moving icon
   * pulls the eye off the text. `external` wins if both are set: the ↗ already
   * says where the link goes. `plain` only, for the same reason as the ↗.
   * @figma `arrow` — on `plain` only, prototyped with Smart Animate on hover
   */
  arrow?: boolean;
  /** What a screen reader hears after an `external` link's text — change it for a page in another language. */
  newTabLabel?: string;
  /** Extra classes on the `<a>`, after the component's own. */
  class?: string;
}

const { href, variant = 'plain', dark = false, external = false, arrow = false, newTabLabel = '(opens in a new tab)', class: className } = Astro.props;

const externalProps = external ? { target: '_blank', rel: 'noopener' } : {};

/* Icons are a `plain` thing. `underline` is the in-sentence link — the same look
   Prose gives Markdown links, which carry no icon either — so it draws neither
   the ↗ nor the →. `external` keeps its behaviour and its spoken label. */
const showIcons = variant === 'plain';

/*
 * THE EXTERNAL MARKER IS AN ICON, NOT A "↗" CHARACTER — this was the last
 * component in the library still setting one in type. Montserrat carries U+2191
 * and U+2193 but not U+2197, so the arrow fell out of --font-sans onto whatever
 * face the OS picked: measured at 0.7em of 16px text, .SF NS painted 6.63px of
 * ink in an 8.88px box while Hiragino Sans painted 9.90px in 11.20px. Not a
 * value this system could set, on either machine.
 *
 * It is `arrowRight` ROTATED, because Font Awesome Free Solid has no bare
 * north-east arrow — `arrow-up-right` is Pro, and `arrow-up-right-from-square`
 * is free but a different mark, where Figma's set draws a bare ↗. Rotating is
 * also why this is the one caller not using the module's viewBox: 512x384 of
 * ink turned 45deg needs (512+384)/√2 = 633 units of box, so the stock 512
 * would clip both tips. The path data is still the shared one.
 *
 * THE ANCHOR IS WRITTEN ON ONE LINE ON PURPOSE. Laid out over several, Astro
 * emits the indentation between <slot /> and the icon as text nodes, and the
 * `underline` variant paints its underline through them: before this, a 4.42px
 * space sat between the text and the icon's own 3px margin, and a SECOND 4.42px
 * space trailed the icon inside the <a>, drawing a stub of underline after the
 * arrow with a gap beneath it. That predates the icon — the character had it
 * too. The gap is `margin-left` alone now, in em so it tracks the inherited
 * size.
 *
 * WHAT REMOVING THE SPACE DID NOT FIX, measured rather than assumed: at 375px
 * the arrow still wraps onto a line of its own, because an atomic inline offers
 * a break opportunity at its own boundary with no whitespace needed. A U+2060
 * WORD JOINER was tried in that gap and Chrome broke there anyway — verified
 * present in the built markup first, so that is Chrome's answer and not a
 * pipeline miss. The only reliable fix is `white-space: nowrap` around the last
 * word AND the icon, which a <slot> cannot reach into. Pre-existing: the
 * character wrapped the same way, and off a space, more easily.
 */
---

<a href={href} class:list={['tlink', variant, { dark }, className]} {...externalProps}><slot />{showIcons && arrow && !external && <svg class="arrow-icon" viewBox={icons.arrowRight.viewBox} fill="currentColor" aria-hidden="true"><path d={icons.arrowRight.path} /></svg>}{showIcons && external && <svg class="ext-icon" viewBox="-64 -64 640 640" fill="currentColor" aria-hidden="true"><path transform="rotate(-45 256 256)" d={icons.arrowRight.path} /></svg>}{external && <span class="ext-label"> {newTabLabel}</span>}</a>

<style>
  .tlink {
    font-weight: 600;
    transition: color var(--duration-fast), text-decoration-color var(--duration-fast), text-decoration-thickness var(--duration-fast);
  }

  /* plain — general/marketing pages: coloured text, no underline */
  .tlink.plain { color: var(--color-text-link); text-decoration: none; }
  .tlink.plain:hover { color: var(--color-text-link-hover); }
  .tlink.plain:focus-visible { outline: var(--border-width-2) solid var(--color-text-link); outline-offset: 3px; border-radius: 2px; }
  .tlink.plain.dark { color: var(--color-text-dark-link); }
  .tlink.plain.dark:hover { color: var(--color-text-dark-link-hover); }
  .tlink.plain.dark:focus-visible { outline-color: var(--color-text-dark-link); }

  /* underline — long-form content (blog, news): neutral text, a separate
     underline that goes 50% → 100% opacity AND thickens on hover (Tailwind-style).

     THE OFFSET IS A PERCENTAGE and the thickness is not, which looks inconsistent
     until you ask what each one has to agree with. Thickness lands on tokens that
     already exist on both sides — --border-width-1 / -1-5, `border-width-1` /
     `border-width-1,5` in Figma. Offset has a token on neither, so nothing is
     gained by pinning it to a length, and 21.5% is what the Figma nodes hold
     (993:210, 993:240, and the usage line 931:5653 since 2026-08-18). CSS
     resolves the percentage against 1em, exactly as Figma resolves it against the
     font size, so the two agree at every size this component is dropped into —
     and it is dropped into several, since it sets no font-size of its own. */
  .tlink.underline {
    color: var(--color-text-body);
    text-decoration: underline; text-decoration-color: color-mix(in srgb, var(--color-border-selected) 50%, transparent);
    text-decoration-thickness: var(--border-width-1); text-underline-offset: 21.5%;
  }
  .tlink.underline:hover { text-decoration-color: var(--color-border-selected); text-decoration-thickness: var(--border-width-1-5); }
  .tlink.underline:focus-visible { outline: var(--border-width-2) solid var(--color-border-selected); outline-offset: 3px; border-radius: 2px; }
  .tlink.underline.dark { color: var(--color-text-dark-body); text-decoration-color: color-mix(in srgb, var(--color-border-dark-alt) 50%, transparent); }
  .tlink.underline.dark:hover { text-decoration-color: var(--color-border-dark-alt); }
  .tlink.underline.dark:focus-visible { outline-color: var(--color-border-dark-alt); }

  /* THE TWO ICONS SHARE ONE BOX, from Ball's idea frame (`1264:3744`,
     2026-10-01): a 14px box 4px after the text, Font Awesome SOLID by his call.
     Both are em so they follow the run the link inherits — 0.875em and 0.25em
     at 16px. The ↗ was 0.55em with 0.46em of margin until then, sized to the
     x-height; it grew to match the → so a page using both does not show two
     sizes of arrow.

     `vertical-align: -0.09em` centres the box on the capitals, which is where
     the frame centres it: an inline <svg> sits ON the baseline, so a 0.875em
     box would ride 0.0875em above the cap-height middle (0.35em) without it.

     THE NUDGE IS A TRANSFORM, never the margin. The frame draws hover as gap
     4 -> 8; in a browser that would widen the link by 4px and shove whatever
     follows it on the line. A transform moves the paint and leaves layout
     alone. → goes right; ↗ goes along its own diagonal. On focus too, so a
     keyboard user gets the same cue, and not at all under reduced motion. */
  .tlink .arrow-icon,
  .tlink .ext-icon {
    width: 0.875em; height: 0.875em; margin-left: 0.25em; vertical-align: -0.09em;
    transition: transform var(--duration-base) var(--ease-default);
  }
  .tlink:hover .arrow-icon, .tlink:focus-visible .arrow-icon { transform: translateX(0.25em); }
  .tlink:hover .ext-icon, .tlink:focus-visible .ext-icon { transform: translate(0.15em, -0.15em); }
  @media (prefers-reduced-motion: reduce) {
    .tlink .arrow-icon, .tlink .ext-icon { transition: none; }
  }

  /* The arrow is aria-hidden, so on its own it told only a sighted reader that
     the link leaves the tab — a screen-reader user heard a plain link and was
     moved to a new tab with no Back history (WCAG technique G201). This says it
     in words, and paints nothing: the standard visually-hidden pattern, clipped
     to 1px, so the underline variant draws no stub past the arrow either.
     `clip-path: inset(50%)` rather than the older `clip: rect()` — the spelling
     Tailwind's own sr-only uses, and the one `npm run audit` knows to skip. Ball's
     choice 2026-09-18 over labelling the <svg> (inconsistent inside links) or
     dropping target=_blank (a behaviour change for every consumer). */
  .tlink .ext-label {
    position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px;
    overflow: hidden; clip-path: inset(50%); white-space: nowrap; border: 0;
  }
</style>
