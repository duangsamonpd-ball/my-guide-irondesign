---
/**
 * ── The band this component declares, and what draws it ───────────────────
 *
 * A SINGLE-LINE ROW IS 20, and that number has been wrong once already. The
 * shared control rule carried a bare `mt-px` — the only class in `choice.ts`
 * with no reason written beside it — which pushed the box a pixel below the
 * label and made the row 21. The canvas top-aligns them: 922:5422 and 335:31 are both y=0 h=20 inside 335:30,
 * so the box and the label share a top edge and the row is the label's line.
 * Consumers were cancelling it by hand before anyone here noticed.
 *
 * The control itself is NOT declared: it is `size-[var(--size-box-md)]`, a
 * literal, so injected padding cannot move it and arm 3 refuses the reading.
 * Its diameter is held by `check:theme` instead. The row is the emergent one,
 * and the row is where the fault was.
 *
 * `preview` and not `states`, and the reason is a docs bug rather than a
 * component one: the states grid gives each cell a 160px minimum, and
 * "Accept terms" does not fit the ~94px left after the cell padding, the box and
 * the gap — so all four of those rows wrap to two lines and measure 40. Radio's
 * same grid says "Option" and fits, which is why only one of the two pages
 * showed it. Nothing overflows, nothing is cut, and no sweep here asks whether a
 * two-word label stayed on one line. Reported rather than fixed: widening that
 * grid is a decision about the page.
 *
 * @figma-size row-described
 *   node   335:30
 *   frame  Checkbox
 *   page   component-checkbox.html
 *   region preview
 *   select label:has(span.text-caption)
 *   at     1440
 *   height 64
 *   why    label 20 + gap-micro 4 + a 2-line description 40, as 340:352 draws
 *   count  1
 *
 * @figma-size row
 *   node   922:5422
 *   frame  Checkbox
 *   page   component-checkbox.html
 *   region preview
 *   select label:not(:has(span.text-caption))
 *   at     1440
 *   height 20
 *   why    box and label share a top edge, so the row is the label's one line
 *   count  1
 *
 * @figma-size label-text
 *   node   335:31
 *   frame  Checkbox
 *   page   component-checkbox.html
 *   region preview
 *   select span.text-label-lg
 *   at     1440
 *   height 20
 *   why    leading-label-lg is --leading-5; the line the row is made of
 *   count  2
 *
 * @figma-size card
 *   node   340:630
 *   frame  Checkbox Card
 *   page   component-checkbox.html
 *   region layouts
 *   select label.bg-bg-card
 *   at     1440
 *   height 88
 *   why    12 + row-described 64 + 12; the stroke is INSIDE the 12, not added to it
 *   count  2
 */

import {
  choiceRow, choiceInput, choiceControl, choiceSize, choiceText,
  choiceLabel, choiceDesc, choiceCard, choiceDisabled, choiceEnabled, inputAttrs,
} from '../choice';
import { fieldError, fieldErrorIcon } from '../field';
import { icons } from '../icons';

interface Props {
  /**
   * The text beside the control; the whole row is clickable. For a label that
   * needs markup — a consent line with a link in it — pass it as the default
   * slot instead, which wins over this prop.
   * A link inside the label follows the link when clicked and does not tick the
   * box (the HTML label rule for interactive content) — but only a link WITH an
   * href: an <a> without one is not interactive, so clicking it ticks the box
   * like the rest of the row. Every other part of the row ticks it. The whole slot, link text included, is the checkbox's
   * accessible name.
   * @figma `Label Text`
   */
  label?: string;
  /**
   * A second, muted line under the label; shown only with a label (prop or slot).
   * @figma `Text description`, with `Show description` as its switch — on by default in Figma; here the line shows whenever the prop is set
   */
  description?: string;
  /** The input's id; falls back to `name`, then to a generated one. */
  id?: string;
  /** The form field name — also the id when `id` is not given. */
  name?: string;
  /** What the form submits for this box when it is ticked; without one the browser sends `on`. */
  value?: string;
  /** Must be ticked before the form submits — the browser's own validation. No `*` is drawn: the Figma set has none, and a consent line says so in words. */
  required?: boolean;
  /**
   * Control size: 16 / 20 / 24px for `sm` / `md` / `lg`.
   * @figma `Size` — same three values, same default
   */
  size?: 'sm' | 'md' | 'lg';
  /**
   * Starts checked.
   * @figma `Variant=Checked` (and `Invalid+Checked`) — Figma folds checked and invalid into one axis; code keeps them as two
   */
  checked?: boolean;
  /**
   * Error state: a danger edge (and fill once checked) plus `aria-invalid`; pair it with `errorMessage` so the error is not colour alone. A form script can set or clear the input's `aria-invalid` instead — the look follows that attribute, not the prop.
   * @figma `Variant=Invalid` (and `Invalid+Checked`)
   */
  invalid?: boolean;
  /**
   * The message under the label while `invalid` is set, with a warning icon, read out with the checkbox.
   * @figma `Error message`
   */
  errorMessage?: string;
  /** Names the checkbox for assistive tech when there is no visible label (prop or slot) — without one of them it has no name at all. */
  ariaLabel?: string;
  /**
   * Disables it and dims the whole row to 50%.
   * @figma `Disabled` — a `false` / `true` variant, so Figma shows it as a toggle
   */
  disabled?: boolean;
  /**
   * Wraps the row in a bordered card that takes the selected outline and tint when chosen.
   * @figma the separate `Checkbox Card` set — `Default` / `Checked` × `Disabled`, with no invalid state and no size axis
   */
  card?: boolean;
  /** Extra classes on the row (or card), after the component's own. */
  class?: string;
}

const {
  label,
  description,
  id,
  name,
  size = 'md',
  checked = false,
  invalid = false,
  errorMessage,
  ariaLabel,
  disabled = false,
  card = false,
  value,
  required = false,
  class: className,
  ...rest
} = Astro.props;

const inputId = id ?? name ?? `cbx-${Math.random().toString(36).slice(2, 9)}`;

/* The label is a SLOT as well as a prop (page-experiments #10, 2026-11-02): a
   string cannot hold a link, so suite-upgrade's consent line ("…Upgrade terms
   and conditions.") rendered the box alone with `ariaLabel` and put a second
   <label for> beside it. The slot renders inside the same span the prop does,
   so it takes the same type and the same id for aria-labelledby. */
const hasSlot = Astro.slots.has('default');
const hasLabel = hasSlot || !!label;

/* The error message sits in the text column, under the label, so it lines up
   with the text it is about and the component keeps one root. But everything
   inside a <label> becomes the input's accessible name, so while a message is
   showing the name is narrowed to the label text alone (aria-labelledby) and
   the description and message are announced as descriptions instead. With no
   message the markup is exactly what it was before 2026-09-18.

   `invalid` without a message still sets aria-invalid, but a sighted reader
   sees only the red edge — WCAG 1.4.1 asks for more than colour, which is what
   `errorMessage` is for. */
const errId = invalid && errorMessage ? `${inputId}-err` : undefined;
const labelId = errId && hasLabel ? `${inputId}-label` : undefined;
const descTextId = errId && hasLabel && description ? `${inputId}-desc` : undefined;
const describedBy = [descTextId, errId].filter(Boolean).join(' ') || undefined;

/* Figma ships the tick at 0.7 x the box — 14 at MD, confirmed against `329:108`,
   so 11.2 and 16.8 at the other two. Kept as arbitrary values rather than rounded
   onto the spacing scale, because the ratio is the design, not the pixel. */
const TICK = { sm: 'size-[11.2px]', md: 'size-[14px]', lg: 'size-[16.8px]' } as const;

/* Small is the one size that drops to the tighter radius; MD and LG hold
   rounded-md. Both confirmed on the same node. */
const RADIUS = { sm: 'rounded-sm', md: 'rounded-md', lg: 'rounded-md' } as const;
---

<label
  class:list={[choiceRow, disabled ? choiceDisabled : choiceEnabled, card && choiceCard, className]}
  for={inputId}
>
  {/* Any attribute that is not a prop — `data-*`, `aria-*`, `form` — lands on the
      <input>, the element a form script reads, and never over the component's
      own (see inputAttrs in choice.ts). The ROI calculator carried its per-option
      numbers as JSON on a wrapper and looked them up by id because there was
      nowhere to put a `data-hours` (page-experiments, Calculator.astro). */}
  <input
    {...inputAttrs(rest, {
      class: `peer ${choiceInput}`, id: inputId, name, value, type: 'checkbox', checked, disabled, required,
      'aria-invalid': invalid ? 'true' : undefined,
      'aria-label': hasLabel ? undefined : ariaLabel,
      'aria-labelledby': labelId,
      'aria-describedby': describedBy,
    })}
  />
  <span
    class:list={[
      choiceControl, choiceSize[size], RADIUS[size],
      /* Figma draws no border on a checked box; matching the border to the fill
         is the same picture and keeps the outer size identical across states.
         The fill binds `brand/secondary` on `329:96`, which is --color-secondary
         here. It briefly bound `button/secondary` and the code followed; Ball
         then unified the whole family on 2026-08-10, so **every** Checkbox and
         Radio set — box, labelled and card — now takes `brand/secondary`, and
         only the CARD's selected outline is `border/selected`. One rule, and
         `choice.ts` already had that outline right.

         The unchecked edge is `border/input` since 2026-09-15 (`329:94` and every
         sibling) — `border/strong` was 1.49:1 and WCAG 1.4.11 asks 3 of a
         control's boundary. Invalid is `border/input-danger`. A checked invalid
         box keeps the status red fill: Figma draws no checked+invalid state, and
         the white tick holds 4.55:1 on it in both modes, where input-danger's
         dark value would put white at 2:1. */
      'border-border-input group-has-[:checked]:bg-secondary group-has-[:checked]:border-secondary',
      /* Invalid is read off the input's own `aria-invalid`, not chosen here at
         render time, so a form script that sets or clears that ONE attribute gets
         the whole look — page-experiments' suite-upgrade kept an inert
         `<Checkbox invalid>` in a <template> only to copy its classes onto the
         live box. `peer`, not `group-has`: Tailwind compiles group-has to ANY
         `.group` ancestor, so an invalid Input elsewhere inside an outer `.group`
         would have reddened this box; a peer is this input and nothing else.
         Checked + invalid is the compound, one class heavier than the checked
         rule it overrides. */
      'peer-aria-invalid:border-border-input-danger peer-aria-invalid:peer-checked:bg-danger peer-aria-invalid:peer-checked:border-danger',
    ]}
  >
    <svg
      class:list={[
        TICK[size],
        'text-primary-on opacity-0 scale-50',
        'transition-[opacity,transform] duration-[var(--duration-fast)]',
        'group-has-[:checked]:opacity-100 group-has-[:checked]:scale-100',
      ]}
      viewBox="0 0 12 12" fill="none" aria-hidden="true"
    >
      <path d="M2 6.2 4.6 8.8 10 3" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
    </svg>
  </span>
  {(hasLabel || errId) && (
    <span class={choiceText}>
      {hasLabel && <span id={labelId} class={choiceLabel}>{hasSlot ? <slot /> : label}</span>}
      {hasLabel && description && <span id={descTextId} class={choiceDesc}>{description}</span>}
      {errId && (
        <span id={errId} class={fieldError}><svg class={fieldErrorIcon} viewBox={icons.circleExclamation.viewBox} fill="currentColor" aria-hidden="true"><path d={icons.circleExclamation.path} /></svg>{errorMessage}</span>
      )}
    </span>
  )}
</label>
