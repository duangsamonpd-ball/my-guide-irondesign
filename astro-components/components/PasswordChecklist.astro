---
/**
 * The password rule, shown under a password `<Input>` as a checklist that
 * fills in while the user types.
 *
 * A separate component and not an Input prop, by Ball's ruling 2026-09-21: the
 * field stays a field, and a page that needs a different rule writes its own
 * list under the same Input. The two are tied by ids — `for` names the input,
 * and the input names this list through its `describedby` prop — so a screen
 * reader reads the rule with the field.
 *
 *   <Input id="pw" type="password" label="Password" autocomplete="new-password"
 *          required describedby="pw-rules" />
 *   <PasswordChecklist for="pw" id="pw-rules" />
 *
 * ── How it behaves, and why ────────────────────────────────────────────────
 *
 *  · Two levels. The top level is what must pass: the length, and "3 of the
 *    following". The four character types sit under the second. They are
 *    NEVER red: once three pass, the fourth is not a mistake.
 *  · The counts ("7 / 12", "2 of 3") are the progress. Without them the user
 *    sees ticks and still does not know how far there is to go.
 *  · Nothing turns red while the user is typing. A top-level item that has not
 *    passed turns red (with a different icon, so colour is never the only cue)
 *    only after the field is left with something in it, or the form is
 *    submitted. The `touched` prop starts it in that state, for a form the
 *    server re-renders after a failed submit.
 *  · The input gets `setCustomValidity`, so native validation and
 *    `form.checkValidity()` refuse a password the list has not passed, and
 *    `aria-invalid` once it is touched, so the field's danger border follows.
 *  · A screen reader hears "met" or "not met" at the end of each item instead of
 *    an icon, and the live region speaks once — when everything first passes,
 *    or when the field is left — never on every keystroke.
 *  · No strength meter. The rule already decides pass or fail; a meter would
 *    count the same things again in a second, vaguer way.
 *
 * The rule itself is in `password.ts` and is the same function here, in the
 * browser script below, and wherever a form imports `checkPassword`.
 */
import { checkPassword, PASSWORD_MIN_LENGTH, PASSWORD_MIN_TYPES } from '../password';

interface Props {
  /** The `id` of the password `<input>` this list checks. */
  for: string;
  /** This list's id, for the input's `describedby`. Defaults to `<for>-rules`. */
  id?: string;
  /**
   * Minimum length, counted in characters (code points), not UTF-16 units.
   * @figma the `Label` and `Count` text of the `Length` line ("At least 12 characters", "0 / 12")
   */
  minLength?: number;
  /**
   * How many of the four character types must be present.
   * @figma the `Label` and `Count` text of the `Types rule` line ("At least 3 of the following", "0 of 3")
   */
  minTypes?: number;
  /**
   * The value to render the list against on the server, e.g. a re-rendered form. The browser re-checks the live input either way.
   * @figma no value in Figma: set each of the six exposed lines' `State` (and the two `Count`s) to what the value would give
   */
  value?: string;
  /**
   * Start in the checked state, where unmet items are red — for a form re-rendered after a failed submit. Pass `error` to the Input as well when the value fails, so its danger border is in the first HTML rather than faded in when the script runs.
   * @figma `State=Fail` on the `Length` / `Types rule` lines that have not passed, with the Input at `State=Error` and its error row hidden
   */
  touched?: boolean;
  /** Extra classes on the wrapper. */
  class?: string;
}

const {
  for: forId,
  id,
  minLength = PASSWORD_MIN_LENGTH,
  minTypes = PASSWORD_MIN_TYPES,
  value = '',
  touched = false,
  class: className,
} = Astro.props;

const listId = id ?? `${forId}-rules`;
const r = checkPassword(value, minLength, minTypes);
const state = (ok: boolean) => (ok ? 'met' : touched ? 'fail' : 'pending');
const sr = (ok: boolean) => (ok ? ', met' : ', not met');

/* Caption SM, as the field's own hint: the list reads as the field's helper
   text, one step quieter than the label. */
const caption = 'text-caption-sm font-caption-sm leading-caption-sm tracking-caption-sm';
/* The icon and the text take the state colour, NOT the <li>: the nested type
   list sits inside the second item, and must not inherit its red. */
const ruleTone = 'group-data-[state=met]/rule:text-success-strong group-data-[state=fail]/rule:text-text-danger';
const typeTone = 'group-data-[state=met]/type:text-success-strong';
---

<div
  class:list={['text-text-support', caption, className]}
  data-password-checklist
  data-for={forId}
  data-min-length={minLength}
  data-min-types={minTypes}
  data-touched={touched ? '' : undefined}
>
  <ul id={listId} class="flex flex-col gap-xs">
    <li class="group/rule grid grid-cols-[16px_1fr] gap-x-micro items-start" data-rule="length" data-state={state(r.lengthOk)}>
      <span class:list={['grid size-[16px] place-items-center', ruleTone]} aria-hidden="true">
        <svg class="size-[14px] group-data-[state=met]/rule:hidden group-data-[state=fail]/rule:hidden" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="8" cy="8" r="6.25" /></svg>
        <svg class="hidden size-[14px] group-data-[state=met]/rule:block" viewBox="0 0 16 16" fill="currentColor"><path fill-rule="evenodd" d="M8 15A7 7 0 1 0 8 1a7 7 0 0 0 0 14Zm3.28-8.72a.75.75 0 0 0-1.06-1.06L7 8.44 5.78 7.22a.75.75 0 0 0-1.06 1.06l1.75 1.75c.3.3.77.3 1.06 0l3.75-3.75Z" /></svg>
        <svg class="hidden size-[14px] group-data-[state=fail]/rule:block" viewBox="0 0 16 16" fill="currentColor"><path fill-rule="evenodd" d="M8 15A7 7 0 1 0 8 1a7 7 0 0 0 0 14Zm.75-10.25a.75.75 0 0 0-1.5 0v3.5a.75.75 0 0 0 1.5 0v-3.5ZM8 11.75a1 1 0 1 0 0-2 1 1 0 0 0 0 2Z" /></svg>
      </span>
      <span class:list={['flex flex-wrap items-baseline gap-x-xs', ruleTone]}>
        At least {minLength} characters
        <span class="font-semibold tabular-nums" aria-hidden="true" data-count>{Math.min(r.length, 99)} / {minLength}</span>
        <span class="sr-only" data-sr>{sr(r.lengthOk)}</span>
      </span>
    </li>
    <li class="group/rule grid grid-cols-[16px_1fr] gap-x-micro items-start" data-rule="types" data-state={state(r.typesOk)}>
      <span class:list={['grid size-[16px] place-items-center', ruleTone]} aria-hidden="true">
        <svg class="size-[14px] group-data-[state=met]/rule:hidden group-data-[state=fail]/rule:hidden" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="8" cy="8" r="6.25" /></svg>
        <svg class="hidden size-[14px] group-data-[state=met]/rule:block" viewBox="0 0 16 16" fill="currentColor"><path fill-rule="evenodd" d="M8 15A7 7 0 1 0 8 1a7 7 0 0 0 0 14Zm3.28-8.72a.75.75 0 0 0-1.06-1.06L7 8.44 5.78 7.22a.75.75 0 0 0-1.06 1.06l1.75 1.75c.3.3.77.3 1.06 0l3.75-3.75Z" /></svg>
        <svg class="hidden size-[14px] group-data-[state=fail]/rule:block" viewBox="0 0 16 16" fill="currentColor"><path fill-rule="evenodd" d="M8 15A7 7 0 1 0 8 1a7 7 0 0 0 0 14Zm.75-10.25a.75.75 0 0 0-1.5 0v3.5a.75.75 0 0 0 1.5 0v-3.5ZM8 11.75a1 1 0 1 0 0-2 1 1 0 0 0 0 2Z" /></svg>
      </span>
      <span class:list={['flex flex-wrap items-baseline gap-x-xs', ruleTone]}>
        At least {minTypes} of the following
        <span class="font-semibold tabular-nums" aria-hidden="true" data-count>{Math.min(r.have, minTypes)} of {minTypes}</span>
        <span class="sr-only" data-sr>{sr(r.typesOk)}</span>
      </span>
      <ul class="col-start-2 mt-micro grid grid-cols-[repeat(auto-fit,minmax(140px,1fr))] gap-x-sm gap-y-micro">
        {r.types.map((t) => (
          <li class="group/type grid grid-cols-[12px_1fr] gap-x-micro items-start" data-type={t.id} data-state={t.ok ? 'met' : 'pending'}>
            <span class:list={['grid h-[16px] w-[12px] place-items-center', typeTone]} aria-hidden="true">
              <svg class="size-[12px] group-data-[state=met]/type:hidden" viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="6" cy="6" r="4" /></svg>
              <svg class="hidden size-[12px] group-data-[state=met]/type:block" viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2.5 6.25 5 8.75l4.5-5" /></svg>
            </span>
            <span class={typeTone}>{t.label}<span class="sr-only" data-sr>{t.ok ? ', included' : ', not included'}</span></span>
          </li>
        ))}
      </ul>
    </li>
  </ul>
  <p class="sr-only" aria-live="polite" data-live></p>
</div>

<script>
  import { checkPassword, passwordSummary } from '../password';

  function initPasswordChecklists(root: ParentNode = document) {
    root.querySelectorAll<HTMLElement>('[data-password-checklist]:not([data-pc-init])').forEach((pc) => {
      const input = document.getElementById(pc.dataset.for ?? '') as HTMLInputElement | null;
      if (!input) return;
      pc.dataset.pcInit = '1';
      const minLength = Number(pc.dataset.minLength);
      const minTypes = Number(pc.dataset.minTypes);
      const live = pc.querySelector<HTMLElement>('[data-live]');
      let touched = pc.hasAttribute('data-touched');
      let wasOk = false;

      const setRule = (name: string, ok: boolean, count: string) => {
        const li = pc.querySelector<HTMLElement>(`[data-rule="${name}"]`);
        if (!li) return;
        li.dataset.state = ok ? 'met' : touched ? 'fail' : 'pending';
        li.querySelector('[data-count]')!.textContent = count;
        li.querySelector(':scope > span > [data-sr]')!.textContent = ok ? ', met' : ', not met';
      };

      const update = () => {
        const r = checkPassword(input.value, minLength, minTypes);
        setRule('length', r.lengthOk, `${Math.min(r.length, 99)} / ${minLength}`);
        setRule('types', r.typesOk, `${Math.min(r.have, minTypes)} of ${minTypes}`);
        for (const t of r.types) {
          const li = pc.querySelector<HTMLElement>(`[data-type="${t.id}"]`);
          if (!li) continue;
          li.dataset.state = t.ok ? 'met' : 'pending';
          li.querySelector('[data-sr]')!.textContent = t.ok ? ', included' : ', not included';
        }
        /* Empty is `required`'s message to give, not ours. */
        input.setCustomValidity(r.ok || !input.value ? '' : passwordSummary(r, minLength, minTypes));
        if (touched && !r.ok) input.setAttribute('aria-invalid', 'true');
        else input.removeAttribute('aria-invalid');
        if (r.ok && !wasOk && live) live.textContent = passwordSummary(r, minLength, minTypes);
        wasOk = r.ok;
        return r;
      };

      const check = () => {
        touched = true;
        const r = update();
        if (live) live.textContent = passwordSummary(r, minLength, minTypes);
      };

      input.addEventListener('input', update);
      input.addEventListener('blur', () => { if (input.value) check(); });
      /* `invalid` fires on a submit the browser blocks; a `novalidate` form never
         fires it, so its submit marks the list too. Neither handler cancels the
         submit — that stays the form's decision. */
      input.addEventListener('invalid', check);
      input.form?.addEventListener('submit', check);
      update();
    });
  }

  document.addEventListener('DOMContentLoaded', () => initPasswordChecklists());
  document.addEventListener('astro:page-load', () => initPasswordChecklists());
</script>
