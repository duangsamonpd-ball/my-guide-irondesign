---
/**
 * ── The bands this component declares, and what draws them ────────────────
 *
 * The OPEN menu is where this component's geometry lives, and it is the one
 * state no screenshot diff of a docs page has ever compared, because it needs a
 * class the demo adds by hand. `911:1685` is 4 of padding round five options on
 * a 48 pitch — 44 tall with a 4 gap — and the docs draw three, so the menu's own
 * 244 is content and only the option is structural. The option is the one that
 * matters anyway: 12/8 padding round a 28px line is what makes 44, and both
 * halves of that are rungs.
 *
 * `field` is declared on `preview` and not `states`, because the node's 72 is a
 * LABEL plus the control and the states demo renders no labels — five correct
 * 44s that are not the same measurement.
 *
 * @figma-size field
 *   node   911:1698
 *   frame  Select
 *   page   component-select.html
 *   region preview
 *   select .sel
 *   at     1440
 *   height 72
 *   why    label 20 + gap-xs 8 + the --size-input control 44
 *
 * @figma-size option
 *   node   911:1686
 *   frame  Select
 *   page   component-select.html
 *   region menu
 *   select .sel-opt
 *   at     1440
 *   height 44
 *   why    px-sm 12 / py-xs 8 round a 28px line; the docs draw three of five
 *   count  3
 */
import { randomUUID } from 'node:crypto';
import { fieldRequiredMark } from '../field';
import { icons } from '../icons';

interface Option {
  value: string;
  label: string;
}

interface Props {
  /** The visible label; the trigger is named by it for assistive tech. */
  label?: string;
  /** The choices, each `{ value, label }`. */
  options: Option[];
  /** The `value` of the option selected at first; omit it to show `placeholder`. */
  value?: string;
  /** Text shown until an option is picked. */
  placeholder?: string;
  /** The form field name, carried by a hidden native `<select>` so the choice submits with the form. */
  name?: string;
  /** Error state: danger border and `aria-invalid`, with `errorMessage` shown in place of `hint`. */
  error?: boolean;
  /** The message under an errored field, with a warning icon; shown only while `error` is set. */
  errorMessage?: string;
  /** Helper text under the field, read out with it; replaced by `errorMessage` while `error` is set. */
  hint?: string;
  /** Disables the trigger and the hidden `<select>`, and greys it out. */
  disabled?: boolean;
  /** Marks the field required — native form validation, `aria-required`, and a `*` after the label. */
  required?: boolean;
  /** Label size: `md` is the 14px form label, `sm` the 12px caption for dense rows. */
  labelSize?: 'sm' | 'md';
  /** Extra classes on the wrapper that holds label, trigger and menu. */
  class?: string;
}

const {
  label,
  options,
  value,
  placeholder = 'Select…',
  name,
  error = false,
  errorMessage,
  hint,
  disabled = false,
  required = false,
  labelSize = 'md',
  class: className,
} = Astro.props;

const selected = options.find((o) => o.value === value);

// Unique per instance so aria-* references (label/trigger/listbox/options/description)
// don't collide when multiple <Select>s render on the same page.
const uid = `sel-${randomUUID().slice(0, 8)}`;
const labelId = `${uid}-label`;
const triggerId = `${uid}-trigger`;
const listboxId = `${uid}-listbox`;
const descId = error && errorMessage ? `${uid}-err` : hint ? `${uid}-hint` : undefined;
---

<div class:list={['sel group relative w-full', className]}>
  {label && (
    <label
      id={labelId}
      class:list={[
        /* Figma 461:32 binds Typography/Label text — Montserrat Medium, size/sm,
           leading/5. The leading was the one part with no utility here, so the
           label took whatever the page's body line-height happened to be. */
        'block text-text-heading font-medium leading-5 mb-xs',
        /* labelSize="sm" — the 12px caption ramp, for dense rows where this label
           sits beside fields already labelled in captions. Both ramps resolve to
           weight 500, so only size and tracking differ. */
        labelSize === 'sm' ? 'text-caption-sm tracking-caption-sm' : 'text-label',
      ]}
    >{label}{/* The same marker, in the same class, as Input and Textarea — Select
         drew none until 2026-09-18, so a sighted user could not tell a required
         Select from an optional one while a screen reader was told by
         aria-required. Code-only in all three: no Figma node draws it. */}{required && <span class={fieldRequiredMark}> *</span>}</label>
  )}
  <button
    type="button"
    id={triggerId}
    class:list={[
      /* Figma 461:32: spacing-sm inline, spacing-xs gap, border-width-1. All
         three were off it — 16 (Ball's earlier scale ruling), 10, and 1.5. */
      'sel-trigger w-full h-[var(--size-input)] rounded-md px-sm',
      'flex items-center justify-between gap-xs',
      'font-sans text-body leading-body outline-none',
      'border',
      'transition-[border-color,box-shadow,background-color] duration-[var(--duration-fast)]',
      /* Written as branches rather than layered utilities because the rules they
         replace were decided by specificity, not by order. `.sel.disabled
         .sel-trigger` (0,3,0) beat `.sel-trigger.is-placeholder` (0,2,0), so a
         disabled placeholder rendered disabled-grey; as two equal-weight
         utilities that would have come down to which one Tailwind emitted last. */
      /* `bg-bg-disabled` — and Figma now agrees. This was a deliberate override
         when it was written: the node bound `surface/background-shade`, the
         generic band fill, while this system has a token whose stated purpose is
         "disabled input / control fill" and Input and Textarea already used it.
         Ball added `surface/disabled` (#F8FAFC, the same value) and re-bound the
         Disabled state to it, so the two sides match and nothing here is an
         override any more. Worth keeping in mind if it is ever revisited: the two
         tokens are NOT interchangeable under `.dark`, where disabled resolves to
         iron-violet/900 and shade to iron-violet/950. */
      /* The field fills (Figma `461:32`: surface/input, -hover, -disabled). Hover
         is the fill now, not the border — scoped `:not(.open)` like the rest. */
      disabled
        ? 'bg-bg-input-disabled text-text-disabled [&.is-placeholder]:text-text-disabled cursor-not-allowed'
        : 'bg-bg-input text-text-body [&.is-placeholder]:text-text-placeholder cursor-pointer group-[:not(.open)]:hover:bg-bg-input-hover',
      /* Same reason. `.sel.error .sel-trigger` and `.sel.open .sel-trigger` had
         equal specificity with error later in the file, so an errored Select kept
         the danger border when open and never took the hover border at all. The
         `:not(.open)` says that instead of relying on emission order.

         FOCUS-VISIBLE IS NEW, and it is a fix rather than a port. This set
         `outline: none` and hung its only ring on `.open`, so a trigger reached
         by Tab and not yet opened showed NOTHING — measured: border unchanged,
         box-shadow none, outline-style none. That is a WCAG 2.4.7 failure, it
         predates the Tailwind conversion, and Figma 461:32 draws Focus as a
         CLOSED field with the blue border and ring. Colours follow Input and
         Textarea: blue normally, `input-danger` red when the field is in error,
         and 2px as an inset shadow over the 1px border — see fieldBorder in
         field.ts for why not a 2px border. Disabled takes its own border and
         wins over error, as the canvas draws no disabled-and-errored state.

         `focus-visible`, not `focus`, because this is a button — `:focus` would
         paint the ring on every mouse click, on top of the open state that the
         same click triggers. Both variants are scoped `:not(.open)`: once open,
         DOM focus is on the listbox, not here.

         Specificity, again deliberately: the group variants make hover and
         focus-visible both (0,3,0), and Tailwind emits focus-visible after
         hover — so a trigger that is hovered AND focused shows focus. A plain
         `focus-visible:` would have been (0,2,0) and lost to hover. */
      disabled
        ? 'border-border-input-disabled'
        : error
          ? 'border-border-input-danger group-[:not(.open)]:focus-visible:[box-shadow:inset_0_0_0_1px_var(--color-border-input-danger),var(--shadow-focus-danger)] group-[.open]:[box-shadow:inset_0_0_0_1px_var(--color-border-input-danger),var(--shadow-focus-danger)]'
          : 'border-border-input group-[:not(.open)]:focus-visible:border-border-focus group-[:not(.open)]:focus-visible:[box-shadow:inset_0_0_0_1px_var(--color-border-focus),var(--shadow-focus-blue)] group-[.open]:border-border-focus group-[.open]:[box-shadow:inset_0_0_0_1px_var(--color-border-focus),var(--shadow-focus-blue)]',
    ]}
    disabled={disabled}
    aria-haspopup="listbox"
    aria-expanded="false"
    aria-controls={listboxId}
    aria-labelledby={label ? `${labelId} ${triggerId}` : undefined}
    aria-invalid={error ? 'true' : undefined}
    aria-required={required ? 'true' : undefined}
    aria-describedby={descId}
  >
    <span class="sel-value">{selected ? selected.label : placeholder}</span>
    {/* The chevron Figma draws (461:32, `chevron`), not the `▾` this used to set
        in type. It is stroke-drawn, so it stays inline here rather than going
        into icons.ts — that module models `fill="currentColor"` paths only, and
        says so about Checkbox's tick for the same reason.

        viewBox is the path's GEOMETRY box (0.75,0.75 → 10.75,5.75 = the 10×5
        Figma gives it) rather than the exported file's 11.5×6.81, which is the
        geometry plus the round caps' overflow. At width 10 that renders 1:1, so
        stroke-width lands at exactly 1.5px, and `overflow-visible` lets the caps
        paint outside the box the way they do on the canvas.

        Worth knowing: this also takes Select out of the font-fallback problem
        for good. `▾` (U+25BE) is not in Montserrat, so it was measured twice
        changing width when the family list changed. A vector cannot. */}
    <svg
      class="w-[10px] h-[5px] shrink-0 overflow-visible text-text-support transition-transform duration-[var(--duration-base)] group-[.open]:rotate-180"
      viewBox="0.75 0.75 10 5" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"
      aria-hidden="true"
    ><path d="M0.75 0.75L5.75 5.75L10.75 0.75"/></svg>
  </button>
  {/* Reconciled against Figma `911:1706` (the open state, drawn 2026-08-06 at
      Ball's request — until then this half of the component had no design and
      these were my numbers). Two of the four I guessed came out right: the 8px
      offset and the 4px inset are what the node draws.

      The radius did not. I had changed it 8 -> 6 arguing `rounded-md` was "the
      only radius token this component's Figma node binds" — but that was the
      CLOSED-state node, which contains no menu. Reasoning from what an unrelated
      node does not mention is not evidence; `rounded-lg` is what the menu was
      always meant to be, and what it had been before I touched it.

      `shadow-float` stays: the node now binds `shadow/float`, 0 2px 16px at 20%,
      which is this token exactly.

      Not taken: Figma sets `overflow: clip` here. The rows sit 4px inside a
      radius they cannot reach, so it buys nothing today, and it would silence
      the scrollTop path in the script below if this ever gets a max-height. */}
  <div
    id={listboxId}
    class="sel-menu absolute top-full mt-xs left-0 right-0 z-[5] p-micro flex-col gap-micro bg-bg-card border border-border rounded-lg shadow-float hidden group-[.open]:flex"
    role="listbox"
    tabindex="-1"
    aria-labelledby={label ? labelId : undefined}
  >
    {options.map((opt, i) => (
      <div
        id={`${uid}-opt-${i}`}
        class:list={[
          /* Figma `911:1706`: 16px at leading/7. The size was already right —
             `Typography/Body` binds size/base, which is the same 16 the field
             uses and the same 16 recorded as a deliberate correction over the
             node's older 14. Only the line-height was missing, and it is what
             makes the row 44px (8 + 28 + 8) rather than the 35 it was. */
          'sel-opt group/opt flex items-center justify-between gap-xs px-sm py-xs',
          'rounded-md text-body leading-body text-text-body cursor-pointer',
          /* `.sel-opt.selected` sat after `:hover` and `.active` at equal
             specificity, so the selected row kept its tint under both. The
             `:not(.selected)` carries that forward without depending on which
             utility Tailwind emits last. */
          '[&:not(.selected):hover]:bg-bg-shade [&:not(.selected).active]:bg-bg-shade',
          /* Selected text is `text/default/heading` (Figma `911:1687`, 2026-09-15):
             `brand/secondary` on card-alt was 3.05:1, under AA for 16px text. The
             blue stays on the tick, a graphic, where 3.05 clears 3:1. */
          '[&.selected]:bg-bg-card-alt [&.selected]:text-text-heading [&.selected]:font-semibold',
          { selected: opt.value === value },
        ]}
        role="option"
        aria-selected={opt.value === value ? 'true' : 'false'}
        data-value={opt.value}
      >
        {/* The tick Figma draws (`911:1688`) — 8x6, stroke-drawn in
            `brand/secondary`, which is `--color-secondary` to the pixel. It
            replaces the 12x12 Font Awesome `check`, and is inline for the same
            reason the chevron is: icons.ts models filled paths, not stroked
            ones. viewBox is again the geometry box so it renders 1:1 and the
            round caps overflow rather than being scaled down. */}
        {opt.label} <svg class="w-[8px] h-[6px] shrink-0 overflow-visible text-secondary opacity-0 group-[.selected]/opt:opacity-100" viewBox="0.75 0.75 8 6" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" aria-hidden="true"><path d="M0.750001 4.02274L3.60714 6.75001L8.75 0.750014"/></svg>
      </div>
    ))}
  </div>
  <!-- native select carries the real form value; visually hidden, drives progressive enhancement -->
  <select name={name} class="absolute inset-0 opacity-0 pointer-events-none" disabled={disabled} required={required} tabindex="-1" aria-hidden="true">
    <option value="" disabled selected={!value}>{placeholder}</option>
    {options.map((opt) => <option value={opt.value} selected={opt.value === value}>{opt.label}</option>)}
  </select>
  {/* Figma binds Typography/Caption SM to both — size/xs, weight/medium,
      leading/4, tracking/wide — where this set text-caption (14px, no leading,
      no tracking). Error differs from hint by colour alone, as on the canvas. */}
  {error && errorMessage ? (
    <span id={descId} class="flex items-center gap-micro text-caption-sm font-caption-sm leading-caption-sm tracking-caption-sm text-text-danger mt-xs"><svg class="size-[12px] shrink-0" viewBox={icons.circleExclamation.viewBox} fill="currentColor" aria-hidden="true"><path d={icons.circleExclamation.path} /></svg>{errorMessage}</span>
  ) : hint ? (
    <span id={descId} class="block text-caption-sm font-caption-sm leading-caption-sm tracking-caption-sm text-text-support mt-xs">{hint}</span>
  ) : null}
</div>

<script>
  // Button-triggered listbox pattern (WAI-ARIA APG "Select Only" combobox):
  // trigger carries aria-expanded/aria-haspopup/aria-controls, the listbox owns
  // aria-activedescendant while DOM focus stays on it, options carry aria-selected.
  function initSelects(root: ParentNode = document) {
    root.querySelectorAll<HTMLElement>('.sel:not([data-sel-init])').forEach((sel) => {
      sel.dataset.selInit = '1';
      const trigger = sel.querySelector<HTMLButtonElement>('.sel-trigger');
      const menu = sel.querySelector<HTMLElement>('.sel-menu');
      const valueEl = sel.querySelector<HTMLElement>('.sel-value');
      const nativeSelect = sel.querySelector<HTMLSelectElement>('select');
      const opts = Array.from(menu?.querySelectorAll<HTMLElement>('.sel-opt') ?? []);
      if (!trigger || !menu || opts.length === 0) return;

      let activeIndex = Math.max(0, opts.findIndex((o) => o.classList.contains('selected')));

      // Keep the active option in view by scrolling the MENU, never the page.
      // scrollIntoView() walks up to the nearest scrollable ancestor, and since
      // .sel-menu sets no max-height it never scrolls itself — so that ancestor
      // was always the document, and opening a Select low on a long page jumped
      // the viewport every time. Setting scrollTop here is a no-op while the
      // menu still grows to fit, and does the right thing if it ever gets a cap.
      const revealInMenu = (opt: HTMLElement) => {
        const viewTop = menu.scrollTop;
        const viewBottom = viewTop + menu.clientHeight;
        const optTop = opt.offsetTop;
        const optBottom = optTop + opt.offsetHeight;
        if (optTop < viewTop) menu.scrollTop = optTop;
        else if (optBottom > viewBottom) menu.scrollTop = optBottom - menu.clientHeight;
      };

      const setActive = (index: number) => {
        activeIndex = Math.min(Math.max(index, 0), opts.length - 1);
        opts.forEach((o) => o.classList.remove('active'));
        const opt = opts[activeIndex];
        opt.classList.add('active');
        menu.setAttribute('aria-activedescendant', opt.id);
        revealInMenu(opt);
      };

      const open = () => {
        if (trigger.disabled) return;
        sel.classList.add('open');
        trigger.setAttribute('aria-expanded', 'true');
        setActive(activeIndex);
        menu.focus();
      };

      const close = ({ refocusTrigger = true } = {}) => {
        sel.classList.remove('open');
        trigger.setAttribute('aria-expanded', 'false');
        opts.forEach((o) => o.classList.remove('active'));
        menu.removeAttribute('aria-activedescendant');
        if (refocusTrigger) trigger.focus();
      };

      const commit = (index: number) => {
        const opt = opts[index];
        if (!opt) return;
        opts.forEach((o) => {
          o.classList.remove('selected');
          o.setAttribute('aria-selected', 'false');
        });
        opt.classList.add('selected');
        opt.setAttribute('aria-selected', 'true');
        if (valueEl) valueEl.textContent = opt.childNodes[0]?.textContent?.trim() ?? '';
        trigger.classList.remove('is-placeholder');
        if (nativeSelect) nativeSelect.value = opt.dataset.value ?? '';
        sel.dispatchEvent(new CustomEvent('select-change', { detail: opt.dataset.value, bubbles: true }));
      };

      trigger.addEventListener('click', () => {
        sel.classList.contains('open') ? close() : open();
      });

      trigger.addEventListener('keydown', (e) => {
        if (trigger.disabled) return;
        if (['ArrowDown', 'ArrowUp', 'Enter', ' '].includes(e.key)) {
          e.preventDefault();
          open();
        }
      });

      opts.forEach((opt, i) => {
        opt.addEventListener('click', () => {
          commit(i);
          close();
        });
        opt.addEventListener('mouseenter', () => setActive(i));
      });

      menu.addEventListener('keydown', (e) => {
        switch (e.key) {
          case 'ArrowDown':
            e.preventDefault();
            setActive(activeIndex + 1);
            break;
          case 'ArrowUp':
            e.preventDefault();
            setActive(activeIndex - 1);
            break;
          case 'Home':
            e.preventDefault();
            setActive(0);
            break;
          case 'End':
            e.preventDefault();
            setActive(opts.length - 1);
            break;
          case 'Enter':
          case ' ':
            e.preventDefault();
            commit(activeIndex);
            close();
            break;
          case 'Escape':
            e.preventDefault();
            close();
            break;
          case 'Tab':
            close({ refocusTrigger: false });
            break;
        }
      });
    });
  }

  document.addEventListener('click', (e) => {
    document.querySelectorAll<HTMLElement>('.sel.open').forEach((sel) => {
      if (!sel.contains(e.target as Node)) {
        sel.classList.remove('open');
        sel.querySelector('.sel-trigger')?.setAttribute('aria-expanded', 'false');
        sel.querySelector('.sel-menu')?.removeAttribute('aria-activedescendant');
      }
    });
  });

  document.addEventListener('DOMContentLoaded', () => initSelects());
  document.addEventListener('astro:page-load', () => initSelects());
</script>
