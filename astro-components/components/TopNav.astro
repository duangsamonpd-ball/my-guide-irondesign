---
/**
 * TopNav — the corporate utility strip above the product header,
 * from Figma node 507:5349 ("Top Nav", canvas 231:1473 " ↳ Navigation menu").
 *
 * Two variants, matching Figma's `variant` property:
 *   default    — filled with slate/800
 *   transparent — no fill, for sitting over a hero image or dark section
 *
 * A 40px strip: Iron Software lockup + corporate menu on the left, office
 * address, Contact Us and the language picker on the right. Pair it above
 * ProductMenu.astro for the full two-bar header.
 *
 * ── The bands this component declares, and what draws them ────────────────
 *
 * `231:1508` is 1440x40 and holds ONE 16px row inset 12 top and bottom, so the
 * 40 is not a number this component sets — it is 12 + 16 + 12, and `check:figma-size`
 * holds both ends. The strip is the same 40 in both variants; `transparent`
 * only drops the fill, and declaring it twice is what says so.
 *
 * `.tn-item` is scoped away from `.tn-menu-extra` on purpose. The extras are the
 * contact and language links duplicated INTO the menu for the burger, hidden at
 * this width, so a bare `.tn-item` matches nine elements of which two are zero
 * tall — a count that passes while measuring something that is not on screen.
 *
 * @figma-size bar
 *   node   231:1508
 *   frame  Top Nav
 *   page   component-topnav.html
 *   region default
 *   select .tn
 *   at     1440
 *   height 40
 *   why    12 + the 16px row + 12; the strip sets no height of its own
 *
 * @figma-size bar-transparent
 *   node   507:5350
 *   frame  Top Nav
 *   page   component-topnav.html
 *   region transparent
 *   select .tn
 *   at     1440
 *   height 40
 *   why    Variant=Transparent drops the fill and nothing else
 *
 * @figma-size row-left
 *   node   231:1510
 *   frame  Top Nav
 *   page   component-topnav.html
 *   region default
 *   select .tn-left
 *   at     1440
 *   height 16
 *   why    lockup + menu; the node insets it 12 from the top of the strip
 *
 * @figma-size row-right
 *   node   231:1570
 *   frame  Top Nav
 *   page   component-topnav.html
 *   region default
 *   select .tn-right
 *   at     1440
 *   height 16
 *   why    address + Contact Us + the language picker, on the same 16
 *
 * @figma-size brand
 *   node   507:5285
 *   frame  Top Nav
 *   page   component-topnav.html
 *   region default
 *   select .tn-brand
 *   at     1440
 *   height 16
 *   why    the _Top nav iron instance; the mark is 16 and the text rides it
 *
 * @figma-size menu-item
 *   node   507:5171
 *   frame  Top Nav
 *   page   component-topnav.html
 *   region default
 *   select .tn-menu > li:not(.tn-menu-extra) .tn-item
 *   at     1440
 *   height 16
 *   why    the five _Menu Item instances the node draws in 231:1514
 *   count  5
 */

import { icons } from '../icons';
import FlyoutMenu from '../internal/FlyoutMenu.astro';
import LoginFlyout from '../internal/LoginFlyout.astro';

interface NavItem {
  label: string;
  href?: string;
  /** Figma shows a caret on every item; turn it off for a plain link. */
  caret?: boolean;
  /**
   * Turns this item into the trigger for a flyout panel, and names the slot the
   * panel comes from — `flyout: 'products'` renders `<slot name="products" />`.
   *
   * A slot rather than a prop because the panel is the CONSUMER's content: the
   * PRODUCTS mega-menu is ten products, their descriptions and their accents,
   * none of which a corporate nav bar has any business knowing. `ProductFlyout`
   * is what fills it on ironsoftware.com; a different site would put something
   * else there and TopNav would not need to change.
   */
  flyout?: string;
  /**
   * The panel brings its own surface, so FlyoutMenu drops the background,
   * border, radius, shadow and padding it would otherwise draw around it.
   * `ProductFlyout` needs this — it is a card in its own right, and stacking the
   * two put a 12px radius and a modal shadow around a 12px radius and a modal
   * shadow. A panel of plain links does NOT: it has nothing of its own to sit on
   * and would render as loose text over the page.
   */
  flyoutBare?: boolean;
  /**
   * Render the panel open on first paint. For a docs page or a test, never a
   * live nav — see FlyoutMenu's `open`, which this forwards to.
   */
  flyoutOpen?: boolean;
}

interface Props {
  /** Figma's `variant`, with the same two names. The second variant was renamed `Transparent` on the
   *  canvas (it read "Without bg" until Ball's 2026-09-03 pass), so the two
   *  sides now spell it the same way. */
  variant?: 'default' | 'transparent';
  /**
   * The lockup link's accessible name, spoken in place of its visible text.
   * The wordmark is `<b>IRON</b><span>SOFTWARE</span>` with no space between
   * the two, so without a name a screen reader announces one word,
   * "IRONSOFTWARE". The default says the company's name as two words, and a
   * voice-control user saying "Iron Software" still matches it (WCAG 2.5.3).
   * Declared for months and never read until Ball's call on 2026-09-30.
   */
  brandLabel?: string;
  /** Where the Iron Software lockup links to. */
  brandHref?: string;
  /** The corporate menu, each `{ label, href?, caret?, flyout? }` — the caret is
   *  on by default, as Figma draws one on every item. `flyout` turns the item
   *  into a panel trigger fed by the slot of that name. */
  items?: NavItem[];
  /** Figma's `showAddress` toggle. Covers the phone number too — `231:1571`
   *  holds both, and the node has no separate switch for the number. */
  showAddress?: boolean;
  /** The office address, linked to a map derived from this string so the two cannot disagree. */
  address?: string;
  /**
   * `1123:2433`, the number beside the address and under the same
   * `showAddress` — it is the half that leaves first, below 1400. Both it and the address are
   * links (Ball, 2026-09-03) though Figma draws them as flat text: a phone
   * number you cannot tap is a defect on the device most likely to see one.
   *
   * The two hrefs are DERIVED from the two strings rather than being props with
   * their own defaults, so a consumer who changes the address cannot leave the
   * map pointing at Chicago. Pass `addressHref` / `phoneHref` to override, or
   * `''` to render that half as plain text again.
   */
  phone?: string;
  /** Overrides the derived map URL; `''` renders the address as plain text. */
  addressHref?: string;
  /** Overrides the derived `tel:` link; `''` renders the number as plain text. */
  phoneHref?: string;
  /** The Contact Us link on the right of the strip; pass `null` to drop it. */
  contact?: NavItem;
  /** The locale link, drawn after the globe icon. */
  language?: NavItem;
  /** Shows the globe and locale group. */
  showLanguage?: boolean;
  /**
   * The account icon between Contact Us and the language picker, and the
   * Customer HUB panel it opens. Figma `login-hubspot` `1245:1966`, added
   * 2026-09-30; the node has no property for it, so it is on by default like
   * the rest of the strip.
   */
  showLogin?: boolean;
  /** Where the login panel's "View your Ticket" tile goes. */
  ticketHref?: string;
  /** Where the login panel's "View your License" tile goes. */
  licenseHref?: string;
  /** Renders the login panel open on first paint, for a docs page or a test — never a live nav. */
  loginOpen?: boolean;
  /** Extra classes on the outer bar. */
  class?: string;
}

const {
  variant = 'default',
  brandLabel = 'Iron Software',
  brandHref = '/',
  items = [],
  showAddress = true,
  address = '205 N. Michigan Ave. Chicago, IL 60611, USA',
  phone = '+1 (312) 500-3060',
  addressHref,
  phoneHref,
  contact = { label: 'Contact Us' },
  language = { label: 'EN' },
  showLanguage = true,
  showLogin = true,
  ticketHref = '#',
  licenseHref = '#',
  loginOpen = false,
  class: className,
} = Astro.props;

/* `1245:1967`, the Font Awesome 7 Pro Solid `user-lock` glyph (U+F502) set as
   text in the node, taken from Figma's own SVG export — which renders the glyph
   server-side, so this is the drawing and not a guess at it. The export is
   16x15 from the text node's top edge, and the node sits 1px down inside its
   16px group, hence the viewBox starting at -1. Single-use, so it stays here
   rather than in `icons.ts`, as the pin and globe do. */
const userLock = {
  viewBox: '0 -1 16 16',
  path: 'M5.6875 0C7.49219 0 8.96875 1.47656 8.96875 3.28125C8.96875 5.08594 7.49219 6.5625 5.6875 6.5625C3.88281 6.5625 2.40625 5.08594 2.40625 3.28125C2.40625 1.47656 3.88281 0 5.6875 0ZM4.86719 8.09375H6.50781C7.30078 8.09375 8.06641 8.28516 8.75 8.64062V8.75C8.20312 9.24219 7.875 9.95312 7.875 10.7188V13.3438C7.875 13.4805 7.90234 13.6445 7.90234 13.7812H0.820312C0.355469 13.7812 0 13.4258 0 12.9609C0 10.2812 2.1875 8.09375 4.86719 8.09375ZM13.125 8.09375C13.125 7.60156 12.7422 7.21875 12.25 7.21875C11.7578 7.21875 11.375 7.60156 11.375 8.09375V9.40625H13.125V8.09375ZM9.1875 10.7188C9.1875 10.1445 9.54297 9.65234 10.0625 9.48828V8.09375C10.0625 6.89062 11.0469 5.90625 12.25 5.90625C13.4531 5.90625 14.4375 6.89062 14.4375 8.09375V9.48828C14.957 9.65234 15.3125 10.1445 15.3125 10.7188V13.3438C15.3125 14.082 14.7383 14.6562 14 14.6562H10.5C9.78906 14.6562 9.1875 14.082 9.1875 13.3438V10.7188Z',
};

/* The caret moved to `icons.ts` as `caretDown` on 2026-08-19, so the links here
   and FlyoutMenu's trigger draw the same one. Its viewBox is offset to centre the
   6.246x3.765 triangle inside 16x16 — Figma uses that box as the gap. */

/* Derived, not defaulted — see the props. `??` and not `||`, so an explicit
   empty string survives as "do not link this half" rather than falling back to
   the derived URL. `tel:` keeps `+` and digits only; a dialler cannot read the
   brackets and spaces the label needs. */
const addressLink = addressHref ?? `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(address)}`;
const phoneLink = phoneHref ?? `tel:${phone.replace(/[^+\d]/g, '')}`;

/* An `<a href="">` is a link to the current page, so the un-linked form has to
   be a different ELEMENT, not an anchor with nothing in it. */
const AddressTag = addressLink ? 'a' : 'span';
const PhoneTag = phoneLink ? 'a' : 'span';

/* Same id scheme as FooterBar's tools panel: the trigger has to point at the
   panel with aria-controls, and a page may carry more than one bar. */
const menuId = `tnmenu-${Math.random().toString(16).slice(2, 10)}`;
---

<div class:list={['tn', `tn--${variant}`, items.length > 0 && 'tn--has-menu', className]}>
  <nav class="tn-inner" aria-label="Corporate">
    <div class="tn-left">
      <a class="tn-brand" href={brandHref} aria-label={brandLabel || undefined}>
        <svg class="tn-mark" viewBox="0 0 16.0002 13.3333" fill="currentColor" aria-hidden="true">
          <path d="M6.60254 7.74121L5.10417 13.3333H2.41781L3.22152 10.3335L0 10.3338L0.695313 7.7391L6.60254 7.74121Z"/>
          <path d="M14.0353 10.3328H10.8177L10.0169 13.3333H7.33089L8.82927 7.74121L14.7303 7.73812L14.0353 10.3328Z"/>
          <path d="M7.17643 5.59733L1.27165 5.59456L1.96696 3.00033L5.1862 2.99967L5.9904 0H8.67676L7.17643 5.59733Z"/>
          <path d="M12.7783 2.99951H16.0002L15.3052 5.59424L9.39616 5.59701L10.8963 0H13.5824L12.7783 2.99951Z"/>
        </svg>
        {/* Hover artwork — Figma draws it as two layers over the same footprint:
            the bars inset 27.08% vertically, the strokes inset 8.33%/15.11%.
            Those insets are relative to a 16x16 box, so against this 16x13.3333
            viewBox they become translate(0 3) and translate(2.4176 0). */}
        <svg class="tn-mark tn-mark-colour" viewBox="0 0 16.0002 13.3333" fill="none" aria-hidden="true">
          <g transform="translate(0 3)">
            <path class="mk-green"  d="M6.46004 4.73922L5.7647 7.33389L0 7.33426L0.695341 4.73959L6.46004 4.73922Z"/>
            <path class="mk-orange" d="M14.0353 7.33324L9.20556 7.33398L9.20593 7.33324H8.29819L8.99353 4.73894L14.7303 4.73857L14.0353 7.33324Z"/>
            <path class="mk-green"  d="M15.3051 2.59467L10.3446 2.59542L10.3449 2.59467H9.56836L10.2637 0.000372637L16.0001 0L15.3051 2.59467Z"/>
            <path class="mk-orange" d="M7.73204 0L7.0367 2.59467L1.27163 2.59505L1.96697 0.000745274L7.73204 0Z"/>
          </g>
          <g transform="translate(2.4176 0)">
            <path class="mk-sky"  d="M2.68634 13.3333H0L1.49837 7.74117H4.18472L2.68634 13.3333Z"/>
            <path class="mk-pink" d="M7.59908 13.3333H4.91311L6.41148 7.74117H9.09745L7.59908 13.3333Z"/>
            <path class="mk-sky"  d="M11.1645 0L9.66431 5.59701H6.97834L8.47858 0H11.1645Z"/>
            <path class="mk-pink" d="M6.2589 0L4.75866 5.59738H2.07232L3.57255 0H6.2589Z"/>
          </g>
        </svg>
        <span class="tn-brand-text"><b>IRON</b><span>SOFTWARE</span></span>
      </a>

      {items.length > 0 && (
        <ul class="tn-menu" id={menuId}>
          {items.map((it) => (
            <li>
              {it.flyout ? (
                /* The caret is FlyoutMenu's own here, not `.tn-caret` — it has to
                   rotate when the panel opens, and the one below is a static
                   affordance on a link that goes somewhere. Rendering both would
                   put two carets on one trigger. */
                <FlyoutMenu label={it.label} align="center" openOnHover notch bare={it.flyoutBare ?? false} open={it.flyoutOpen ?? false}>
                  <slot name={it.flyout} />
                </FlyoutMenu>
              ) : (
                <a class="tn-item" href={it.href ?? '#'}>
                  {it.label}
                  {(it.caret ?? true) && <svg class="tn-caret" viewBox={icons.caretDown.viewBox} fill="currentColor" aria-hidden="true"><path d={icons.caretDown.path}/></svg>}
                </a>
              )}
            </li>
          ))}
          {/* Below 420 the strip cannot hold these two either, so they move into
              the panel rather than disappearing. They are marked up here and
              hidden above that width, so exactly one copy is ever rendered —
              the alternative, duplicating them into a second list, gives a
              screen reader two "Contact Us" links to choose between. */}
          {contact && (
            <li class="tn-menu-extra">
              <a class="tn-item" href={contact.href ?? '#'}>
                {contact.label}
                {(contact.caret ?? true) && <svg class="tn-caret" viewBox={icons.caretDown.viewBox} fill="currentColor" aria-hidden="true"><path d={icons.caretDown.path}/></svg>}
              </a>
            </li>
          )}
          {showLanguage && language && (
            <li class="tn-menu-extra">
              <a class="tn-item" href={language.href ?? '#'}>
                {language.label}
                {(language.caret ?? true) && <svg class="tn-caret" viewBox={icons.caretDown.viewBox} fill="currentColor" aria-hidden="true"><path d={icons.caretDown.path}/></svg>}
              </a>
            </li>
          )}
        </ul>
      )}
    </div>

    <div class="tn-right">
      {showAddress && (
        /* Two boxes inside one <address>, which is how `231:1571` draws it: the
           pin and the street line are `Address Block` 1123:2445, the number is
           1123:2433 beside it. They are separate elements and not one run of
           text because they are two destinations — a map and a dialler — and
           because the number is the half that leaves first below 1400. */
        <address class="tn-address">
          <AddressTag class="tn-address-block" href={addressLink || undefined}>
            <svg class="tn-pin" viewBox="0 0 11 15" fill="currentColor" aria-hidden="true"><path d="M0 5.16797C0 2.29688 2.35156 0 5.25 0C8.14844 0 10.5 2.29688 10.5 5.16797C10.5 8.42188 7.21875 12.332 5.85156 13.8086C5.52344 14.1641 4.97656 14.1641 4.64844 13.8086C3.28125 12.332 0 8.42188 0 5.16797ZM5.25 7C6.20703 7 7 6.20703 7 5.25C7 4.29297 6.20703 3.5 5.25 3.5C4.29297 3.5 3.5 4.29297 3.5 5.25C3.5 6.20703 4.29297 7 5.25 7Z"/></svg>
            {address}
          </AddressTag>
          {phone && <PhoneTag class="tn-phone" href={phoneLink || undefined}>{phone}</PhoneTag>}
        </address>
      )}

      {contact && (
        <a class="tn-item" href={contact.href ?? '#'}>
          {contact.label}
          {(contact.caret ?? true) && <svg class="tn-caret" viewBox={icons.caretDown.viewBox} fill="currentColor" aria-hidden="true"><path d={icons.caretDown.path}/></svg>}
        </a>
      )}

      {showLogin && (
        /* `end`, not `center` like PRODUCTS: the trigger is the second-last thing
           on the bar, and a 297 panel centred on it runs ~40px off a 1440 screen.
           The notch is still aimed at the icon — FlyoutMenu measures it. */
        <FlyoutMenu class="tn-login" label="Customer HUB Login" icon={userLock} align="end" openOnHover notch bare open={loginOpen}>
          <LoginFlyout ticketHref={ticketHref} licenseHref={licenseHref} />
        </FlyoutMenu>
      )}

      {showLanguage && language && (
        <span class="tn-lang">
          <svg class="tn-globe" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"><path d="M9.9375 13.125C10.5312 11.9375 10.9375 10.2812 11 8.5H5C5.0625 10.2812 5.5 11.9375 6.09375 13.125C6.78125 14.5312 7.53125 15 8 15C8.5 15 9.21875 14.5312 9.9375 13.125ZM11 7.5C10.9375 5.71875 10.5312 4.09375 9.9375 2.875C9.21875 1.46875 8.5 1 8 1C7.53125 1 6.78125 1.46875 6.09375 2.875C5.5 4.09375 5.0625 5.71875 5 7.5H11ZM12 8.5C11.9062 10.9688 11.1875 13.2812 10.1562 14.6562C12.8125 13.8125 14.7812 11.4062 14.9688 8.5H12ZM14.9688 7.5C14.7812 4.625 12.8125 2.21875 10.1562 1.34375C11.1875 2.71875 11.9062 5.03125 12 7.5H14.9688ZM4 7.5C4.09375 5.03125 4.8125 2.71875 5.84375 1.34375C3.1875 2.21875 1.21875 4.625 1.03125 7.5H4ZM1.03125 8.5C1.21875 11.4062 3.1875 13.8125 5.84375 14.6562C4.8125 13.2812 4.09375 10.9688 4 8.5H1.03125ZM8 16C3.59375 16 0 12.4062 0 8C0 3.59375 3.59375 0 8 0C12.4062 0 16 3.59375 16 8C16 12.4062 12.4062 16 8 16Z"/></svg>
          <a class="tn-item" href={language.href ?? '#'}>
            {language.label}
            {(language.caret ?? true) && <svg class="tn-caret" viewBox={icons.caretDown.viewBox} fill="currentColor" aria-hidden="true"><path d={icons.caretDown.path}/></svg>}
          </a>
        </span>
      )}

      {/* The corporate menu needs 911px of bar to lay out and the strip is only
          as wide as the viewport, so from 945 down it cannot be shown inline —
          measured, not guessed, and no amount of tightening closes it: gap
          20 → 8 buys 48px of the 143 missing at 768. Before this button the
          menu was simply hidden below 720, which left 721–944 rendering items
          on top of each other (`.tn-menu` is `min-width: 0`, so flex squashed
          them past their own text instead of overflowing). */}
      {items.length > 0 && (
        <button type="button" class="tn-burger" aria-expanded="false" aria-controls={menuId} aria-label="Corporate menu">
          <svg class="tn-burger-icon" viewBox={icons.bars.viewBox} fill="currentColor" aria-hidden="true"><path d={icons.bars.path}/></svg>
        </button>
      )}
    </div>
  </nav>
</div>

<style>
  /*
    Figma node 507:5349 ("Top Nav"). Token map, all 1:1 with the system's names:
      slate/800             → --slate-800 (the strip fill)
      text/on-dark/heading → --color-text-on-dark-heading
    Labels use Figma's "Typography/UI/Nav label" style (--fw-nav-label /
    --font-size-xs / --leading-4 / --letter-spacing-nav-label), the address uses
    "Typography/Caption SM" (--fw-caption-sm / --letter-spacing-caption-sm).

    The brand mark is --color-neutral, NOT white — verified against both the
    exported SVG's fill and the pixels of Figma's own render. It reads as a
    deliberately recessive mark next to the white wordmark.
  */
  /* `position: relative` is here for the narrow-width menu, which drops out of
     the 40px strip and is positioned against the bar rather than the page. */
  .tn { width: 100%; font-family: 'Montserrat', sans-serif; position: relative; }
  .tn--default { background: var(--slate-800); }
  .tn--transparent { background: transparent; }

  .tn-inner { display: flex; align-items: center; justify-content: space-between; gap: var(--spacing-xl); height: 40px; box-sizing: border-box; max-width: 1440px; margin: 0 auto; padding: var(--spacing-sm) var(--spacing-xl); }

  .tn-left { display: flex; align-items: center; gap: var(--spacing-xl); min-width: 0; }
  .tn-right { display: flex; align-items: center; gap: var(--spacing-md); min-width: 0; }

  .tn-brand { display: flex; align-items: center; gap: var(--spacing-micro); flex-shrink: 0; text-decoration: none; }
  /* Figma puts the mark in a 16px square with the 16x13.33 artwork centred inside,
     the same box height as the 16px text line — so every item shares one baseline. */
  .tn-mark { width: 16px; height: 16px; flex-shrink: 0; color: var(--color-neutral); }
  .tn-brand-text { font-size: var(--font-size-xs); line-height: var(--leading-4); letter-spacing: var(--letter-spacing-nav-label); color: var(--color-text-on-dark-heading); text-transform: uppercase; white-space: nowrap; }
  .tn-brand-text b { font-weight: var(--fw-nav-label); }
  .tn-brand-text span { font-weight: var(--fw-caption-sm); }

  .tn-menu { display: flex; align-items: center; gap: var(--spacing-md); list-style: none; margin: 0; padding: 0; min-width: 0; }
  /* Each <li> must be a flex container, not a block. As a block it lays out an
     inline line box with a strut from the inherited font, and the inline-flex
     .tn-item then sits on that strut's baseline — about 1.4px below the brand
     lockup, which is a plain flex item and has no strut. This puts every label
     on one line. */
  /* `>` and not a descendant, and the difference is a bug that shipped. Since a
     nav item can now hold a FlyoutMenu, the panel — and everything a consumer
     slots into it — lives inside one of these <li>s. `.tn-menu li` therefore
     reached every <li> in the mega-menu too: each product row became a flex ITEM
     and shrank to its content, so the hover fill stopped 42px short of its
     column (240 against 282, measured). A component may not style descendants it
     does not own; the same rule that makes it publish [data-part] hooks instead
     of classes. Every `.tn-menu li` below is a child selector for that reason. */
  .tn-menu > li { display: flex; align-items: center; }
  .tn-item { display: inline-flex; align-items: center; gap: 0; font-size: var(--font-size-xs); font-weight: var(--fw-nav-label); line-height: var(--leading-4); letter-spacing: var(--letter-spacing-nav-label); color: var(--color-text-on-dark-heading); text-transform: uppercase; text-decoration: none; white-space: nowrap; }
  /* Figma's `_Top nav iron` carries a Hover state: the SOFTWARE half turns brand
     pink while IRON stays white. Figma also swaps the mark for a two-tone version;
     that needs vectors we do not have, so the mark stays single-colour here. */
  /* The mark is monochrome slate at rest and full-colour on hover — two separate
     artworks in Figma, not a recolour of one. Colours come from the brand
     primitives because a logo is not "success green", it is Iron green. */
  .tn-mark-colour { display: none; }
  .tn-brand:hover .tn-mark { display: none; }
  .tn-brand:hover .tn-mark-colour { display: block; }
  .tn-mark-colour .mk-green  { fill: var(--iron-green-500); }
  .tn-mark-colour .mk-orange { fill: var(--iron-orange-500); }
  .tn-mark-colour .mk-sky    { fill: var(--iron-sky-500); }
  .tn-mark-colour .mk-pink   { fill: var(--iron-pink-500); }
  /* On the transparent variant the bar has no fill of its own, so the mark drops
     its recessive slate and goes white with the rest of the lockup. */
  .tn--transparent .tn-mark { color: var(--color-text-on-dark-heading); }
  .tn-brand:hover .tn-brand-text span { color: var(--color-primary); }
  .tn-item:hover { color: var(--color-text-link-menu-hover); }
  .tn-item:focus-visible { outline: var(--border-width-2) solid var(--color-border-focus); outline-offset: 3px; }
  .tn-caret { width: 16px; height: 16px; flex-shrink: 0; }

  /* <address> is the element for the contact details of the nearest article or
     document, which is exactly what this office line is. It costs two resets:
     the UA italicises it, and it is a block element with its own margins. */
  /* `spacing-xs` is the wrapper's own gap, between the two boxes; the 4 that
     used to be here belongs to `Address Block` and moved down with it. With the
     number hidden the wrapper has one child and the gap draws nothing, so the
     address measures the same 293.33 it did before the split. */
  .tn-address { display: inline-flex; align-items: center; gap: var(--spacing-xs); font-size: var(--font-size-xs); font-weight: var(--fw-caption-sm); line-height: var(--leading-4); letter-spacing: var(--letter-spacing-caption-sm); color: var(--color-text-on-dark-heading); white-space: nowrap; font-style: normal; margin: 0; }
  /* `color: inherit` because a UA link colour would beat the inherited white,
     and the hover is the bar's one hover — the same brand pink `.tn-item` uses.
     Figma draws no state for either half; a link with no affordance at all is
     the worse answer. */
  .tn-address-block { display: inline-flex; align-items: center; gap: var(--spacing-micro); color: inherit; text-decoration: none; }
  .tn-phone { color: inherit; text-decoration: none; }
  .tn-address-block:hover, .tn-phone:hover { color: var(--color-text-link-menu-hover); }
  .tn-address-block:focus-visible, .tn-phone:focus-visible { outline: var(--border-width-2) solid var(--color-border-focus); outline-offset: 3px; }
  /* 10 AND NOT 11, ON PURPOSE — Ball's call, 2026-09-03, after the audit raised
     it. `231:1572` measures 11 wide, but the two numbers are not the same kind
     of measurement: Figma's is a TEXT node holding a Font Awesome glyph, so its
     11 is the glyph's advance width, while this is an outlined path in a box we
     choose. Matching the 11 would stretch the drawing to fit a number that
     describes type metrics rather than artwork. It is the only gap over a pixel
     left between this component and its node; every other box lands inside 1.1
     — right 594.94 against 596, address block 293.33 against 294, and that 0.67
     is this. Do not "fix" it to 11. */
  .tn-pin { width: 10px; height: 14px; flex-shrink: 0; }

  .tn-lang { display: inline-flex; align-items: center; gap: var(--spacing-micro); color: var(--color-text-on-dark-heading); }
  /* 14 and not 16: `507:5344` binds `size/sm` now — Ball, 2026-09-03 — and the
     node box went 16x16 to 14x14 with it, taking `Language Selector` from 55 to
     53 and the whole right column from 598 to 596. */
  .tn-globe { width: 14px; height: 14px; flex-shrink: 0; }

  /* The trigger only exists below the breakpoint; above it the menu is inline
     and there is nothing to open. */
  .tn-burger { display: none; align-items: center; justify-content: center; width: 24px; height: 24px; padding: 0; border: 0; background: none; color: var(--color-text-on-dark-heading); cursor: pointer; flex-shrink: 0; }
  .tn-burger:hover { color: var(--color-text-link-menu-hover); }
  .tn-burger:focus-visible { outline: var(--border-width-2) solid var(--color-border-focus); outline-offset: 2px; }
  .tn-burger-icon { width: 16px; height: 16px; display: block; }

  /* Figma covers 1440px desktop only, so every number below is measured off the
     rendered bar rather than read off the canvas: the width the bar REQUIRES is
     `.tn-left` + `.tn-right` + the inner gap and padding with nothing squashed,
     and each rule sits just under the requirement of the state above it.

     Re-derived 2026-09-03, when the phone number arrived and the two gaps went
     to 16. The arm for that pass was the old tree: gap 20 with no number gives
     1256.14, which is the measurement 1259.98 was cut from, so the formula was
     answering the same question it answered the first time before any new number
     was read off it.

       state                                          requires   rule
       address + number + menu                        1346.53    1349.98
       address, no number                             1230.14    1234.98
       menu inline, address gone                       920.81     924.98
       brand + contact + language + trigger            409.41     414.98

     RE-DERIVED 2026-09-30, when the account trigger arrived (`login-hubspot`,
     32 wide) with a 16 gap in `.tn-right`. The arm: the same probe with
     `.tn-login` hidden returned 1346.53 / 1230.14 / 920.81 / 409.41 — the table
     above, to the hundredth — and an injected 100px margin moved it by exactly
     100. With the trigger every state is exactly 48 more. The rules are cut
     above the FLYOUT configuration, not the plain one: a PRODUCTS item that is
     a FlyoutMenu trigger carries its caret on a 4px gap where `.tn-item` has 0,
     so that bar needs 4 more — and it is the bar ironsoftware.com ships.

       state                              plain      flyout     rule
       address + number + menu            1394.53    1398.53    1399.98
       address, no number                 1278.14    1282.14    1284.98
       menu inline, address gone           968.81     972.81     974.98
       brand + contact + login + language
         + trigger                          457.41     457.41     459.98

     The flyout column is also why this pass had to happen at all: without the
     login it needed 1350.53 against a rule at 1349.98, 0.55 over, and nothing
     had ever measured that bar — only the plain one.

     Each requirement fell exactly 2 when the globe went from 16 to 14 later the
     same day, and no rule moved: rounding each one up to its rung lands on the
     same four numbers, and every rule still sits ABOVE what it gates, which is
     the side to be wrong on. The 1254.14 the arm now returns is the old tree
     PLUS that 2 — it no longer reproduces 1259.98 to the pixel, and the reason
     is written here rather than left as a number that stopped matching.

     The number leaves FIRST and the address second — Ball's call, 2026-09-03.
     `231:1571` gives them one `showAddress` between them, but a bar that keeps
     its street address and drops its phone number is the wrong way round only if
     you read the node as a switch; as a layout it is the number that is pure
     duplication of the Contact Us link beside it. The alternative was dropping
     both together at 1350, which takes the address off every 1366 laptop.

     Every threshold used to be too low, leaving a band where the content was
     already too wide but still on screen: the address un-hid at 1101 and needed
     1260, the menu un-hid at 721 and needed 945. In those bands the items
     overlapped rather than overflowed, because `.tn-menu` and `.tn-right` are
     both `min-width: 0` and flex will squash a child past its own text before it
     will let it stick out. Overlapping text reads as a rendering fault, not a
     layout one, which is why it survived every gate and every look at this
     component. */
  @media (max-width: 1399.98px) { .tn-phone { display: none; } }
  @media (max-width: 1284.98px) { .tn-address { display: none; } }

  @media (max-width: 974.98px) {
    .tn-burger { display: inline-flex; }
    /* Out of the strip and across the full bar. `.tn` is the positioning
       context, so this hangs below a 40px-tall bar whatever the page around it
       does. The fill is the default variant's slate even on `transparent`: the
       bar can sit on a hero image, and a menu that let the image through would
       be unreadable. */
    .tn-menu { display: none; position: absolute; top: 40px; left: 0; right: 0; z-index: 20; flex-direction: column; align-items: stretch; gap: 0; padding: var(--spacing-xs) var(--spacing-xl) var(--spacing-sm); background: var(--slate-800); }
    .tn.tn-menu-open .tn-menu { display: flex; }
    .tn-menu > li { padding: var(--spacing-xs) 0; }
    /* Each row is its own hit target across the panel, so the caret sits at the
       end of the line rather than tight against the label as it does inline. */
    .tn-menu .tn-item { justify-content: space-between; width: 100%; }
  }

  /* The strip itself — lockup, Contact Us, the language picker and the trigger —
     needs 420px. Below that the last two move into the panel. `.tn--has-menu`
     gates it: with no items there is no panel to move them into, and hiding them
     would simply lose them. Measured, and it is why 320/375/414 were the widths
     that broke when the trigger was first added: a 24px button and its gap went
     in without anything coming out. */
  .tn-menu > li.tn-menu-extra { display: none; }
  /* THE FLOOR, Ball's call 2026-08-19 — measured off the live sites first.
     ironsoftware.com and ironpdf.com both hide the corporate strip's menu below
     768 and offer NO mobile version of it: `d-none d-md-block`, and Bootstrap's
     `md` is 768. Checked at 767 and 768 on both, and neither shows a burger at
     any width — the whole strip simply is not there on a phone.

     We keep the burger, which they do not, so the collapsed form bottoms out
     here rather than continuing down to 320. Below this the menu and its trigger
     go and the bar keeps only the brand lockup, which is what both sites leave
     at 375. Contact and the language picker ride inside `.tn-menu` at this width
     (see `.tn-menu-extra`), so they leave with it.

     `--breakpoint-md` is 768 and is labelled "Tablet Large" in tokens.css;
     `--breakpoint-sm` 480 is "Tablet". The number here is the one both live
     sites use, not the one whose label reads closest.

     One consequence worth writing down rather than quietly fixing: 459.98 below
     is measured on a strip that still counts the trigger, and this rule has
     taken the trigger away by then. Without it the same strip needs 419.41 (371.41
     before the login trigger), so contact, the login and the language picker
     would survive to 420. Left as it is because
     moving a phone-width breakpoint is a design call, not arithmetic. */
  @media (max-width: 767.98px) {
    .tn-menu, .tn-burger { display: none; }
  }

  @media (max-width: 459.98px) {
    .tn--has-menu .tn-menu > li.tn-menu-extra { display: flex; }
    .tn--has-menu .tn-right > .tn-item { display: none; }
    .tn--has-menu .tn-lang { display: none; }
  }

</style>

<script>
  // Disclosure pattern (WAI-ARIA APG), the same one FooterBar's tools panel
  // uses: the trigger owns aria-expanded and points at the panel it controls.
  // The menu stays in the DOM at every width — above the breakpoint it is the
  // inline list, below it the same <ul> is the panel — so there is one set of
  // links rather than two, and nothing to keep in sync.
  function initTopNav(scope: ParentNode = document) {
    scope.querySelectorAll<HTMLElement>('.tn:not([data-tn-init])').forEach((tn) => {
      const trigger = tn.querySelector<HTMLButtonElement>('.tn-burger');
      const menu = tn.querySelector<HTMLElement>('.tn-menu');
      if (!trigger || !menu) return;
      tn.dataset.tnInit = '1';

      const setOpen = (open: boolean) => {
        tn.classList.toggle('tn-menu-open', open);
        trigger.setAttribute('aria-expanded', String(open));
      };
      const close = (focusTrigger: boolean) => {
        if (!tn.classList.contains('tn-menu-open')) return;
        setOpen(false);
        if (focusTrigger) trigger.focus();
      };

      trigger.addEventListener('click', () => setOpen(!tn.classList.contains('tn-menu-open')));
      // Escape closes from anywhere in the bar and hands focus back, and a click
      // outside closes without stealing it — an open panel that survives a click
      // on the page behind it is the thing users report as stuck.
      tn.addEventListener('keydown', (e) => {
        if ((e as KeyboardEvent).key === 'Escape') close(true);
      });
      document.addEventListener('click', (e) => {
        if (!tn.contains(e.target as Node)) close(false);
      });
    });
  }
  document.addEventListener('DOMContentLoaded', () => initTopNav());
  document.addEventListener('astro:page-load', () => initTopNav());
</script>

<style is:global>
  /* ── The flyout item ──────────────────────────────────────────────────────
     A SECOND, GLOBAL sheet, because Astro's scoping cannot cross into a child
     component's markup. Per-selector `:global()` works in the browser and is
     what this was written with first — but it is not valid standalone CSS, so
     it cannot appear verbatim in the docs page the way `check:parity` requires.
     The same tradeoff Blockquote, List and Text already record. Every selector
     below stays qualified by `.tn`, so nothing leaks onto an unrelated flyout.

     Keyed to FlyoutMenu's published `[data-part]` hooks rather than its `.fm-*`
     classes, which are its own business.

     The trigger has to BE a `.tn-item` — same 12px uppercase nav label, same
     hover. FlyoutMenu's own trigger is sized for a standalone button (btn font,
     padding, border, radius), and every one of those has to come back off.
     `.tn-item` is not reused directly because the trigger is a <button>, and a
     button carries UA font, padding, border and background that a class list
     does not clear. */
  .tn [data-part='trigger'] {
    padding: 0; border: 0; border-radius: 0; gap: var(--spacing-micro);
    font-size: var(--font-size-xs); font-weight: var(--fw-nav-label);
    line-height: var(--leading-4); letter-spacing: var(--letter-spacing-nav-label);
    color: var(--color-text-on-dark-heading); text-transform: uppercase;
  }
  .tn [data-part='trigger']:hover { color: var(--color-text-link-menu-hover); }
  .tn [data-part='trigger']:focus-visible { outline-offset: 3px; }

  /* The OPEN state, from `Preview ideal` (1023:3721) — the trigger and its caret
     go `brand/primary` while the rest of the bar stays white. Keyed to
     `aria-expanded`, which the disclosure already has to set correctly, rather
     than to FlyoutMenu's `.is-open` class: the state is in the accessibility
     tree either way, so styling from there cannot drift from what a screen
     reader is told. Same value as the hover, which is Figma's choice, not an
     alias — an open trigger reads as active whether the pointer is on it or not. */
  .tn [data-part='trigger'][aria-expanded='true'] { color: var(--color-primary); }

  /* The panel is 1200 by design and the bar is 1440 with 24 of padding, so it
     fits with room to spare at the canvas width. `calc(100vw - …)` is what keeps
     it on screen below that, and it is the VIEWPORT it has to stay inside — the
     panel is positioned against the trigger but painted over the page. */
  /* `display: flex` on the flyout is load-bearing, not tidiness. FlyoutMenu
     makes it `inline-block`, whose box carries the line-box descender slack, so
     the panel measured 41.5px from the top of a 40px bar — 1.5px of daylight
     under it where `Preview ideal` has the panel flush at y=40. Flex boxes have
     no such slack, and `calc(100% + var(--spacing-sm))` then lands exactly on
     the bar's edge: 12px of nav padding above the 16px trigger, 12 below. */
  /* `display: flex` on the flyout is two fixes in one.
     `inline-block` carries the line-box descender slack, so the panel measured
     41.5px from the top of a 40px bar — 1.5px of daylight under it where the
     canvas has it flush. And `position: static` hands the panel's containing
     block up to `.tn`, which spans the viewport: `left: 50%` then centres the
     panel ON THE PAGE rather than on the four-letter word that opened it, which
     is what the mega-menu wants and what ironsoftware.com does. The notch stops
     being centred when that happens, so FlyoutMenu aims it at the trigger — see
     `--fm-notch-x` there. */
  .tn [data-part='flyout'] { display: flex; position: static; }

  /* Above the bar, and above anything the page puts under it. `.tn` already
     carries z-index 20 for its own narrow-width menu, and the panel has to clear
     that as well as the bar itself. */
  .tn [data-part='panel'] { z-index: 30; }

  /* ── The account trigger ──────────────────────────────────────────────────
     Everything above is written for PRODUCTS, a 1200 panel centred on the page.
     The login panel is 297 and hangs from its own trigger, so it takes back the
     three things that rule set gives away: the flyout is the containing block
     again, the panel sizes to its content, and the offset is FlyoutMenu's own
     — 12 below a 16px trigger centred in a 40px bar is the bar's bottom edge.
     `login-hubspot` puts the caret straight after the glyph, gap 0. */
  .tn .tn-login[data-part='flyout'] { position: relative; }
  .tn .tn-login [data-part='trigger'] { gap: 0; }
  .tn .tn-login [data-part='panel'] { top: calc(100% + var(--spacing-sm)); width: auto; max-width: none; }

  /* With the burger's panel to carry them, contact and the language picker move
     into it below 460 (see the scoped sheet). The login panel cannot ride in a
     list, so it leaves the strip with them. */
  @media (max-width: 459.98px) {
    .tn--has-menu .tn-login { display: none; }
  }

  .tn [data-part='panel'] {
    /* Flush with the bar, as `Preview ideal` has it — the arrow's base meets the
       panel's top edge with nothing between them.

       FlyoutMenu offsets its panel by `calc(100% + var(--spacing-sm))` from the
       trigger, which is right for a standalone disclosure. Here the containing
       block is `.tn` (see `position: static` above) and `.tn` IS the 40px bar, so
       100% already lands on its bottom edge and the extra 12px became a visible
       gap under the arrow. Measured 52 against a bar ending at 40 before this. */
    top: 100%;
    width: 1200px;
    max-width: calc(100vw - var(--spacing-xl) * 2);
  }
</style>
