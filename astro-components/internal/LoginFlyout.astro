---
/**
 * LoginFlyout — the Customer HUB panel behind TopNav's account trigger, from
 * Figma `FlyoutMenu-login` (`1245:2088`, canvas `231:1473`) on file
 * Yjom8rPbyL5U1wtwOLkgtU. The trigger is `login-hubspot` `1245:1966` inside
 * both Top Nav variants.
 *
 * INTERNAL, for the same reason ProductFlyout is: this is the CONTENT of a
 * panel, not a control anyone should reach for. `FlyoutMenu` owns the trigger,
 * the reveal and the ARIA; this owns what is inside, and brings its own
 * surface, so TopNav opens it `bare`.
 *
 * ## Read off the node, 2026-09-30
 *
 * 297 wide, hugging its height (196). One `border/default` 1px box on
 * `surface/card`, `rounded-lg`, effect style `shadow/modal`, then 20
 * (`spacing-lg`) of padding round a 255 column: the `Typography/overline`
 * title at `opacity-75` in `text/default/support`, 16 (`spacing-md`) down to a
 * row of two tiles on a 16 gap. Each tile is FILL, so 119.5 — the same card
 * box again with 12/16 padding (`spacing-sm` / `spacing-md`) and an 8 gap,
 * holding a 48 circle over a `Typography/UI/nav-sub` label in
 * `text/default/link-menu-alt`. 12 + 48 + 8 + 40 + 12 + the border's 2 = 122,
 * which is why each label is two lines: 119.5 - 32 - 2 leaves 85.5 for it.
 *
 * The set is `1252:1507` since 2026-09-30, `Variant=Default | Hover`: the
 * Default above keeps the id `1245:2088`, Hover is `1252:1488`. A 1px LINE that
 * lay on the container's own top border (`1245:2049`) was deleted by Ball the
 * same day.
 *
 * ## Where the code decides and the canvas does not
 *
 * - **Hover.** Ball's call, 2026-09-30: a tile hovers to `border/strong` and
 *   its label to `link-menu-alt-hover` — the pair `Product sub menu`'s
 *   Activehover uses. Drawn into Figma afterwards as `Variant=Hover`
 *   `1252:1488`, both tiles hovered, which is what `forceHover` renders.
 * - **Links.** The canvas names no URLs, so both are props defaulting to `#`
 *   (Ball, 2026-09-30); the consumer passes the real Customer HUB addresses.
 * - **One mode — Ball, 2026-09-30: the product menu and the flyout menus have
 *   no dark mode.** The node binds semantic tokens that flip (`surface/card`,
 *   `border/*`, `text/default/support`, `link-menu-alt`), so each is written
 *   as the fixed token or primitive its LIGHT value resolves to, and they move
 *   together, as ProductMenu's bar did: a pinned surface under type that had
 *   turned white would be white on white. `--color-text-on-light-heading` is
 *   `link-menu-alt`'s light #171717; `--iron-blue-800` is `support`'s. The pink
 *   hover never flipped. That leaves `--color-text-link-menu-alt` with no
 *   consumer in code — its dark value is the one thing this panel must not do.
 *
 * The two icons are Font Awesome 7 Duotone Solid glyphs (`ticket`, `award`) set
 * as text in the node. Figma's own SVG export renders them server-side, so the
 * paths below are that export, in the 48x48 circle's coordinates, with the
 * primary layer `iron-blue/500` and the secondary what each node binds —
 * `iron-blue/50` for the ticket (the circle's own fill, so it reads as a cut-out)
 * and `iron-blue/300` for the award's ribbon.
 *
 * @figma-size panel
 *   node   1245:2088
 *   frame  FlyoutMenu-login
 *   page   component-flyoutmenu.html
 *   region login
 *   select .lf
 *   at     1440
 *   height 196
 *   why    20 + the 16 title + 16 + a 122 tile + 20, plus the 1px border twice
 *
 * @figma-size tile
 *   node   1245:2054
 *   frame  FlyoutMenu-login
 *   page   component-flyoutmenu.html
 *   region login
 *   select .lf-tile
 *   at     1440
 *   height 122
 *   why    12 + the 48 circle + 8 + two 20px label lines + 12 + a 2px border
 *   count  2
 */

interface Props {
  /** The panel's heading, drawn uppercase. Also the name TopNav gives the trigger that opens it. */
  heading?: string;
  /** Where "View your Ticket" goes. The canvas names no URL, so pass the real Customer HUB address. */
  ticketHref?: string;
  /** Where "View your License" goes. The canvas names no URL, so pass the real Customer HUB address. */
  licenseHref?: string;
  /** Force the hover state on both tiles — for the docs page, never a live nav. */
  forceHover?: boolean;
  class?: string;
}

const {
  heading = 'Customer HUB Login',
  ticketHref = '#',
  licenseHref = '#',
  forceHover = false,
  class: className,
} = Astro.props;

const tiles = [
  {
    label: 'View your Ticket',
    href: ticketHref,
    /* `1245:2057` / `1245:2058` — FA 7 Duotone `ticket`. */
    primary: 'M10.25 18C10.25 16.3594 11.6094 15 13.25 15H34.25C35.8906 15 37.25 16.3594 37.25 18V21C37.25 21.4219 36.9219 21.75 36.5 21.8906C35.6562 22.1719 35 23.0156 35 24C35 24.9844 35.6562 25.8281 36.5 26.1094C36.9219 26.25 37.25 26.5781 37.25 27V30C37.25 31.6406 35.8906 33 34.25 33H13.25C11.6094 33 10.25 31.6406 10.25 30V27C10.25 26.5781 10.5781 26.25 11 26.1094C11.8906 25.8281 12.5 24.9844 12.5 24C12.5 23.0156 11.8906 22.1719 11 21.8906C10.5781 21.75 10.25 21.4219 10.25 21V18ZM15.5 19.5V28.5C15.5 29.3438 16.1562 30 17 30H30.5C31.3438 30 32 29.3438 32 28.5V19.5C32 18.6562 31.3438 18 30.5 18H17C16.1562 18 15.5 18.6562 15.5 19.5ZM17.75 20.25H29.75V27.75H17.75V20.25Z',
    secondary: 'M17.75 20.25V27.75H29.75V20.25H17.75ZM17 18H30.5C31.3438 18 32 18.6562 32 19.5V28.5C32 29.3438 31.3438 30 30.5 30H17C16.1562 30 15.5 29.3438 15.5 28.5V19.5C15.5 18.6562 16.1562 18 17 18Z',
    secondaryClass: 'lf-glyph-cut',
  },
  {
    label: 'View your License',
    href: licenseHref,
    /* `1245:2063` / `1245:2064` — FA 7 Duotone `award`. */
    primary: 'M25.2812 10.7812C26.4062 11.4844 27.1094 11.6719 28.4688 11.625C29.2188 11.625 29.875 12.0469 30.25 12.6562C30.9062 13.8281 31.4219 14.3906 32.5938 15C33.25 15.375 33.625 16.0312 33.625 16.7812C33.5781 18.1406 33.7656 18.8438 34.4688 19.9688C34.8438 20.625 34.8438 21.4219 34.4688 22.0312C33.7656 23.1562 33.5781 23.8594 33.625 25.2188C33.625 25.9688 33.25 26.625 32.5938 27C31.4219 27.6562 30.9062 28.1719 30.25 29.3438C29.875 30 29.2188 30.375 28.4688 30.375C27.1094 30.3281 26.4062 30.5156 25.2812 31.2188C24.6719 31.5938 23.875 31.5938 23.2188 31.2188C22.0938 30.5156 21.3906 30.3281 20.0312 30.375C19.2812 30.375 18.625 30 18.25 29.3438C17.6406 28.1719 17.0781 27.6562 15.9062 27C15.2969 26.625 14.875 25.9688 14.875 25.2188C14.9219 23.8594 14.7344 23.1562 14.0312 22.0312C13.6562 21.4219 13.6562 20.625 14.0312 19.9688C14.7344 18.8438 14.9219 18.1406 14.875 16.7812C14.875 16.0312 15.2969 15.375 15.9062 15C17.0781 14.3906 17.6406 13.8281 18.25 12.6562C18.625 12.0469 19.2812 11.625 20.0312 11.625C21.3906 11.6719 22.0938 11.4844 23.2188 10.7812C23.875 10.4062 24.6719 10.4062 25.2812 10.7812ZM24.25 16.5C21.7656 16.5 19.75 18.5156 19.75 21C19.75 23.4844 21.7656 25.5 24.25 25.5C26.7344 25.5 28.75 23.4844 28.75 21C28.75 18.5156 26.7344 16.5 24.25 16.5Z',
    secondary: 'M15.7656 33.5156L18.0156 28.9219C18.1094 29.0625 18.2031 29.2031 18.25 29.3438C18.625 30 19.2812 30.375 20.0312 30.375C21.3906 30.3281 22.0938 30.5156 23.2188 31.2188C23.875 31.5938 24.625 31.5938 25.2812 31.2188C26.4062 30.5156 27.1094 30.3281 28.4688 30.375C29.2188 30.375 29.875 30 30.25 29.3438C30.2969 29.2031 30.3906 29.0625 30.4844 28.9219L32.7344 33.5156C33.0156 34.0312 32.7812 34.7344 32.2656 35.0156L28.2344 37.0312C27.6719 37.2656 27.0156 37.0781 26.7344 36.5625L24.25 32.1094L21.7656 36.5625C21.4844 37.0781 20.8281 37.3125 20.3125 37.0312L16.2812 35.0156C15.7188 34.7344 15.4844 34.0312 15.7656 33.5156Z',
    secondaryClass: 'lf-glyph-ribbon',
  },
];
---

<div class:list={['lf', { 'is-hover': forceHover }, className]} data-part="login">
  <p class="lf-title">{heading}</p>
  <ul class="lf-tiles">
    {tiles.map((t) => (
      <li class="lf-tile-item">
        <a class="lf-tile" href={t.href}>
          <span class="lf-icon" aria-hidden="true">
            <svg viewBox="0 0 48 48" width="48" height="48">
              <path class="lf-glyph" d={t.primary} />
              <path class={t.secondaryClass} d={t.secondary} />
            </svg>
          </span>
          <span class="lf-label">{t.label}</span>
        </a>
      </li>
    ))}
  </ul>
</div>

<style>
  /* border-box, so 297 is the node's outer width: 1 + 20 + 255 + 20 + 1. */
  .lf {
    box-sizing: border-box; width: 297px; max-width: 100%;
    display: flex; flex-direction: column; gap: var(--spacing-md);
    padding: var(--spacing-lg);
    background: var(--color-bg-nav);
    border: var(--border-width-1) solid var(--slate-200);
    border-radius: var(--rounded-lg);
    box-shadow: var(--shadow-modal);
    font-family: 'Montserrat', sans-serif;
  }

  /* `Typography/overline`, with the node's own `opacity-75` on top of it. */
  .lf-title {
    margin: 0; text-align: center; text-transform: uppercase;
    font-size: var(--font-size-overline); font-weight: var(--fw-overline);
    line-height: var(--line-height-overline); letter-spacing: var(--letter-spacing-overline);
    color: var(--iron-blue-800); opacity: var(--opacity-75);
  }

  .lf-tiles { display: flex; gap: var(--spacing-md); margin: 0; padding: 0; list-style: none; }
  /* `flex: 1 1 0` and `min-width: 0` are what make the two tiles split the 255
     evenly whatever their labels measure — the node's FILL, 119.5 each. */
  .lf-tile-item { display: flex; flex: 1 1 0; min-width: 0; }

  .lf-tile {
    box-sizing: border-box; width: 100%;
    display: flex; flex-direction: column; align-items: center; justify-content: center; gap: var(--spacing-xs);
    padding: var(--spacing-sm) var(--spacing-md);
    background: var(--color-bg-nav);
    border: var(--border-width-1) solid var(--slate-200);
    border-radius: var(--rounded-lg);
    text-decoration: none;
    transition: border-color var(--duration-base) var(--ease-default);
  }
  .lf-tile:focus-visible { outline: var(--border-width-2) solid var(--color-border-focus); outline-offset: 2px; }

  /* 48 round on the raw `iron-blue/50` the node binds. The ring is `border/default`
     at 0.75, drawn INSIDE as the node strokes it — an inset shadow rather than a
     border, so the circle stays 48 and the glyph's 48-unit viewBox stays aligned
     with it. */
  .lf-icon {
    display: block; width: 48px; height: 48px; flex-shrink: 0;
    border-radius: var(--rounded-full);
    background: var(--iron-blue-50);
    box-shadow: inset 0 0 0 0.75px var(--slate-200);
  }
  .lf-icon svg { display: block; }
  .lf-glyph { fill: var(--iron-blue-500); }
  .lf-glyph-cut { fill: var(--iron-blue-50); }
  .lf-glyph-ribbon { fill: var(--iron-blue-300); }

  /* `Typography/UI/nav-sub` — 14/20 semibold, `tracking/normal`. */
  .lf-label {
    text-align: center;
    font-size: var(--font-size-nav-sub); font-weight: var(--fw-nav-sub);
    line-height: var(--line-height-nav-sub); letter-spacing: normal;
    color: var(--color-text-on-light-heading);
    transition: color var(--duration-base) var(--ease-default);
  }

  .lf-tile:hover,
  .lf-tile:focus-visible,
  .lf.is-hover .lf-tile { border-color: var(--slate-300); }
  .lf-tile:hover .lf-label,
  .lf-tile:focus-visible .lf-label,
  .lf.is-hover .lf-label { color: var(--color-text-link-menu-alt-hover); }

  @media (prefers-reduced-motion: reduce) {
    .lf-tile, .lf-label { transition-duration: 1ms; }
  }
</style>
