---
/**
 * FlyoutMenu — a trigger that reveals a floating panel of navigation links.
 *
 * **INTERNAL as of 2026-08-19, Ball's ruling: this is TopNav's, and nothing
 * else's.** It was exported while it was a general-purpose disclosure looking
 * for a home; the Figma frame that landed (`FlyoutMenu-product`) settled that it
 * is the PRODUCTS mega-menu on the corporate strip, so the public surface it had
 * was promising a component nobody was meant to reach for. `internal/` is the
 * same shelf `FooterProduct` and `ProductFlyout` sit on, and the two scripts
 * that must know about that folder — `build-utilities.mjs`,
 * `check-component-vars.mjs` — already walk it.
 *
 * It stays a component rather than being folded into TopNav because the reveal,
 * the ARIA and the script below are the expensive half and they are not about
 * navigation at all. TopNav composes it through `[data-part]` hooks; it never
 * reaches for the classes.
 *
 * **The visual layer here is provisional.** This was built ahead of the Figma
 * frame, on purpose: the interaction and accessibility contract is the same
 * whatever the panel ends up looking like, and it is the half that is expensive
 * to get wrong. Padding, radius, shadow, panel width and the caret are neutral
 * token-based placeholders — expect all of them to change on reconciliation.
 * What should NOT change is anything in the script or the ARIA below.
 *
 * ## It is a disclosure, not a menu — and that is deliberate
 *
 * The obvious-looking `role="menu"` + `role="menuitem"` is wrong for this. That
 * pattern is for application menus (the things in a menu bar: Cut, Copy, Paste)
 * and it makes two promises this component cannot keep. It tells assistive tech
 * that the contents are *commands*, which strips the link semantics from every
 * link inside — a screen reader stops announcing "link" and stops offering them
 * in its links list. And it commits to arrow-key navigation with roving
 * tabindex, where Tab moves out of the whole menu rather than through it, which
 * is not what anyone expects from a site nav.
 *
 * So this follows the WAI-ARIA APG's **Disclosure Navigation** pattern instead,
 * exactly like FooterBar's Free tools panel: a `<button>` owning `aria-expanded`
 * and pointing at the panel with `aria-controls`, the panel holding ordinary
 * links, and Tab walking through them in DOM order.
 *
 * ## What the script guarantees
 *
 *  · **`inert` while closed.** The panel stays in the DOM so it can animate, and
 *    that means it also stays in the tab order — `inert` is the only thing that
 *    keeps a closed panel from swallowing focus. Toggling `display` would fix
 *    focus and kill the animation.
 *  · **Escape closes and gives focus back to the trigger.** Without the second
 *    half, focus is left on a control that just went inert.
 *  · **Focus leaving the component closes it.** Tabbing past the last link is a
 *    dismissal, and `focusout` with a `relatedTarget` check is how you tell that
 *    apart from moving between two links inside.
 *  · **A pointer press outside closes it.** `pointerdown`, not `click`, so it
 *    closes on press rather than release — a `click` listener also fires after a
 *    drag that started inside, which reads as a stray dismissal.
 *  · **One open at a time.** Opening any flyout closes every other one on the
 *    page. Two open panels in a nav is always a bug, never a feature.
 *  · **Hover is opt-in and never the only way in.** `openOnHover` adds hover on
 *    top of click and focus; it does not replace them. Hover-only flyouts are
 *    unreachable by keyboard and unusable on touch, where the first tap becomes
 *    a hover and the panel opens and closes in the same gesture. There is a
 *    close delay so a diagonal cursor path between trigger and panel does not
 *    drop it.
 *  · **`prefers-reduced-motion` collapses the transition to a cut.**
 *
 * Escape and outside-press are bound once at document level rather than per
 * instance — the alternative is N listeners doing identical work, and they would
 * each have to re-derive which flyout the event happened in anyway.
 */
import { icons } from '../icons';

interface Props {
  /** Trigger label. */
  label: string;
  /**
   * Opens on hover as well as on click/focus. Off by default: on touch there is
   * no hover to leave, and the pattern is only ever an enhancement.
   */
  openOnHover?: boolean;
  /** Render open on first paint — for docs and tests, not for a live nav. */
  open?: boolean;
  /**
   * Which edge the panel is pinned to. A wide mega-menu under a trigger near the
   * right of the bar has to hang left or it leaves the viewport; `center` is the
   * ironsoftware.com arrangement, where the panel is much wider than its trigger.
   */
  align?: 'start' | 'center' | 'end';
  /** Draws the notch pointing up at the trigger. */
  notch?: boolean;
  /**
   * Drop the panel's own surface — background, border, radius, shadow and the
   * inner padding — because the content brings its own. `ProductFlyout` does:
   * it is a card in its own right, and stacking the two put a 12px radius and a
   * modal shadow around a 12px radius and a modal shadow.
   *
   * The notch is NOT dropped. It belongs to the flyout, not to the content —
   * it points at the trigger, which the content knows nothing about.
   */
  bare?: boolean;
  class?: string;
}

const {
  label,
  openOnHover = false,
  open = false,
  align = 'start',
  notch = false,
  bare = false,
  class: className,
} = Astro.props;

/* The `prefix-8hex` shape build-demos.mjs normalises, so generated docs markup
   does not churn on every build. Same approach as FooterBar's panel id. */
const panelId = `fm-${Math.random().toString(16).slice(2, 10)}`;
---

<div class:list={['fm', { 'is-open': open }, className]} data-part="flyout" data-fm data-fm-hover={openOnHover ? '' : undefined}>
  <button type="button" class="fm-trigger" data-part="trigger" aria-expanded={open ? 'true' : 'false'} aria-controls={panelId}>
    <span data-part="label">{label}</span>
    <svg class="fm-caret" viewBox={icons.caretDown.viewBox} fill="currentColor" aria-hidden="true"><path d={icons.caretDown.path} /></svg>
  </button>

  <div class:list={['fm-panel', `fm-${align}`, { 'fm-notch': notch, 'is-bare': bare }]} data-part="panel" id={panelId} inert={!open}>
    <div class="fm-panel-inner"><slot /></div>
  </div>
</div>

<style>
  /* PROVISIONAL — see the note at the top of this file. Every value below is a
     neutral token choice made to be legible, not a design decision. */
  .fm { position: relative; display: inline-block; }

  .fm-trigger {
    display: inline-flex; align-items: center; gap: var(--spacing-xs);
    padding: var(--spacing-xs) var(--spacing-sm);
    font-family: inherit; font-size: var(--font-size-btn); font-weight: var(--fw-btn);
    line-height: var(--leading-5); letter-spacing: var(--letter-spacing-btn);
    color: var(--color-text-body); background: none;
    border: var(--border-width-1) solid transparent; border-radius: var(--rounded-md);
    cursor: pointer; transition: color var(--duration-base);
  }
  .fm-trigger:hover { color: var(--color-text-link); }
  .fm-trigger:focus-visible { outline: var(--border-width-2) solid var(--color-border-focus); outline-offset: 2px; }
  /* 16, not 12: `caretDown` centres a 6.246x3.765 triangle inside a 16x16 box
     and Figma uses that box AS the gap. Drawing it at 12 shrinks the triangle and
     reintroduces the spacing the box was providing. */
  .fm-caret { width: 16px; height: 16px; flex-shrink: 0; transition: transform var(--duration-base) var(--ease-emphasized); }
  .fm.is-open .fm-caret { transform: rotate(180deg); }

  /* `visibility` is doing real work, not decoration: at opacity 0 the panel is
     invisible but still hit-testable, so it would swallow clicks meant for the
     page underneath. It is transitioned with a delay rather than a duration so
     it flips at the END of the fade out and at the START of the fade in. */
  .fm-panel {
    position: absolute; top: calc(100% + var(--spacing-sm)); z-index: 20;
    min-width: 220px;
    background: var(--color-bg-card);
    border: var(--border-width-1) solid var(--color-border);
    border-radius: var(--rounded-lg);
    box-shadow: var(--shadow-float);
    opacity: 0; visibility: hidden;
    /* The lift and the scale are one movement, and the scale is the part that
       makes it read as "coming from" the trigger rather than sliding in from
       nowhere. `transform-origin` is what aims it, so it has to follow `align`. */
    /* The horizontal part is a VARIABLE, not a second declaration. `center` used
       to set its own `transform: translate(-50%, …)` in a rule with the same
       specificity as `.fm.is-open .fm-panel` below and less source order, so the
       open state overwrote it and the panel snapped back to the trigger's left
       edge — `align="center"` had never once centred anything. The comment two
       lines down warned about exactly this and the code still walked into it,
       which is what a variable prevents: there is only one `transform` here now
       and nothing can half-win it. */
    --fm-x: 0px;
    transform: translate(var(--fm-x), -6px) scale(0.98);
    transition:
      opacity var(--duration-base) var(--ease-default),
      transform var(--duration-base) var(--ease-emphasized),
      visibility 0s linear var(--duration-base);
  }
  .fm-start  { left: 0;  transform-origin: top left; }
  .fm-end    { right: 0; transform-origin: top right; }
  .fm-center { left: 50%; margin-left: 0; transform-origin: top center; --fm-x: -50%; }

  .fm.is-open .fm-panel {
    opacity: 1; visibility: visible; transform: translate(var(--fm-x), 0) scale(1);
    transition-delay: 0s;
  }
  /* A row, because the shape this exists to serve is a mega-menu: several
     columns side by side. One child still lays out as one column, so the simple
     case costs nothing. `flex-start` keeps columns of different lengths topped
     out rather than stretched to the tallest. */
  .fm-panel-inner { display: flex; align-items: flex-start; padding: var(--spacing-xs); }

  /* The notch, from Figma `1015:2676` (`arrow-flyoutmenu`). It was a rotated
     10x10 square while the panel was provisional; the exported vector is
     19.25 x 8.7966 with a 2px-radius tip, which a rotated square cannot be —
     a 90-degree tip would have to be exactly twice as wide as it is tall
     (17.59), and this is 19.25. So it is the real path, drawn in `currentColor`
     rather than shipped as the exported file, because the export bakes in
     #E2E8F0 and this system has a dark ladder to follow.

     Figma fills it with `border/default`, not the panel surface — it reads as
     the panel's edge lifting toward the trigger rather than as a tab of the
     panel's face.

     Resized to 20x10 by Ball on 2026-08-19, from 19.25 x 8.7966. `top` is the
     full height so the base lands ON the panel's top edge rather than a fraction
     inside it, which is where the old -8 against a height of 8.7966 put it.

     Its offset is NOT Figma's 43px. That number is wherever the arrow happened
     to land under the trigger Ball drew, and it matches the centre of no TopNav
     item — PRODUCTS+caret measures 89.72px, so 44.86 from its left edge, where
     the export puts the arrow's centre at 52.63. The offset belongs to the
     trigger, so it is measured from the trigger here. */
  .fm-notch::before {
    content: ''; position: absolute; top: -10px; width: 20px; height: 10px;
    background: var(--color-border);
    clip-path: path('M0 10L8.53069 0.665923C9.34217 -0.221975 10.6578 -0.221974 11.4693 0.665924L20 10H0Z');
  }
  .fm-start.fm-notch::before  { left: var(--spacing-lg); }
  .fm-end.fm-notch::before    { right: var(--spacing-lg); }
  /* A CENTRED panel is not centred on its trigger — that is the whole point of
     `center`, and it is what ironsoftware.com does: the panel is much wider than
     the word that opens it. So the notch cannot sit at the panel's middle. The
     script writes `--fm-notch-x` when the panel opens; the fallback keeps it
     centred for the pre-script paint and for anyone who renders `open` with no
     JS at all. */
  /* The default lives on the PANEL, not on the ::before that reads it.
     Declaring it inside the `::before` rule shadowed the value `aimNotch` sets —
     the script writes the variable on the panel, the pseudo-element re-declared
     it for itself, and its own declaration won. The arrow sat at the panel's
     centre (left: 590.375px at 1440) while a probe reading the panel's variable
     reported it correctly aimed, because that probe was reading the INPUT and
     not the pixel. Ball's screenshot is what caught it.

     It is declared at all — rather than left to a fallback — for the same reason
     `--i` is: a var() whose name is declared nowhere in the source reads to
     check:vars as a missing theme token. */
  .fm-center.fm-notch { --fm-notch-x: calc(50% - 10px); }
  .fm-center.fm-notch::before { left: var(--fm-notch-x); }

  /* Content that is a card in its own right — see the `bare` prop. */
  .fm-panel.is-bare { background: none; border: 0; border-radius: 0; box-shadow: none; min-width: 0; }
  .fm-panel.is-bare .fm-panel-inner { padding: 0; display: block; }

  @media (prefers-reduced-motion: reduce) {
    .fm-panel,
    .fm-caret { transition-duration: 1ms; }
    .fm-panel { transition-delay: 0s; }
  }
</style>

<!--
  The stagger has to reach SLOTTED children, and Astro's scoping cannot: it
  works by stamping a data attribute on the elements this component renders,
  and slotted content belongs to the caller, so it never gets one.

  The usual answer is `:global(*)`, and FormCard uses it — but a docs page has
  to carry each rule verbatim for check:parity, and `:global()` is not a real
  pseudo-class, so the browser drops the whole rule there. On FormCard that
  costs a `max-width`. Here it would cost exactly the thing this block exists to
  show. `is:global` emits plain CSS instead, which is valid in both places.

  Kept to one distinctive class so the global scope stays narrow.
-->
<style is:global>
  /* Children rise in turn behind the panel. `--i` is set per child by the
     script, so a caller composing arbitrary columns gets the stagger without
     numbering anything by hand. The delay applies only on the way IN — kept on
     the way out, the panel has already faded past the content before the last
     column starts leaving, which reads as broken. Same rule as FooterBar's Free
     tools panel. */
  .fm-panel-inner > * {
    /* Declared here, not just read with a fallback: the stylesheet is where the
       variable's contract belongs, and the script only overrides it per child.
       It also keeps check:vars honest — a `var()` whose name is never declared
       anywhere in the source reads to that gate as a missing theme token. */
    --i: 0;
    opacity: 0; transform: translateY(6px);
    transition:
      opacity var(--duration-base) var(--ease-default),
      transform var(--duration-base) var(--ease-emphasized);
  }
  .fm.is-open .fm-panel-inner > * {
    opacity: 1; transform: none;
    transition-delay: calc(var(--i, 0) * 40ms + 60ms);
  }
  /* A BARE panel's content is one element — the card it brought with it — so the
     stagger above has exactly one thing to stage and the reveal reads as a
     single block appearing. Reach the content's own published parts instead:
     the rail first, then each column behind it. `[data-part]` and not a class,
     because the content is a different component and its classes are its own.
     Anything that publishes a `rail` or a `column` gets this for free; anything
     that publishes neither is untouched. */
  .fm-panel.is-bare [data-part='rail'],
  .fm-panel.is-bare [data-part='column'] {
    --i: 0;
    opacity: 0; transform: translateY(8px);
    transition:
      opacity var(--duration-base) var(--ease-default),
      transform var(--duration-base) var(--ease-emphasized);
  }
  .fm.is-open .fm-panel.is-bare [data-part='rail'],
  .fm.is-open .fm-panel.is-bare [data-part='column'] {
    opacity: 1; transform: none;
  }
  /* The rail leads because it is the thing the panel is selling, and because it
     is the widest single move — the columns reading in after it is what makes
     the reveal feel like one gesture rather than four. */
  .fm.is-open .fm-panel.is-bare [data-part='rail']   { transition-delay: 40ms; }
  .fm.is-open .fm-panel.is-bare [data-part='column'] { transition-delay: calc(var(--i, 0) * 55ms + 110ms); }

  @media (prefers-reduced-motion: reduce) {
    .fm-panel-inner > * { transition-duration: 1ms; }
    .fm.is-open .fm-panel-inner > * { transition-delay: 0s; }
    .fm-panel.is-bare [data-part='rail'],
    .fm-panel.is-bare [data-part='column'] { transition-duration: 1ms; }
    .fm.is-open .fm-panel.is-bare [data-part='rail'],
    .fm.is-open .fm-panel.is-bare [data-part='column'] { transition-delay: 0s; }
  }
</style>

<script>
  // Disclosure Navigation (WAI-ARIA APG). See the file header for why this is
  // not role="menu" — that decision is the one thing here worth defending.
  const OPEN = 'is-open';

  function closeFlyout(fm: HTMLElement, returnFocus = false) {
    if (!fm.classList.contains(OPEN)) return;
    fm.classList.remove(OPEN);
    const trigger = fm.querySelector<HTMLButtonElement>('.fm-trigger');
    const panel = fm.querySelector<HTMLElement>('.fm-panel');
    trigger?.setAttribute('aria-expanded', 'false');
    panel?.setAttribute('inert', '');
    if (returnFocus) trigger?.focus();
  }

  function openFlyout(fm: HTMLElement) {
    // One at a time. Any other open flyout on the page is closed first —
    // including ones in a different nav, which is still what you want.
    document.querySelectorAll<HTMLElement>('[data-fm].' + OPEN).forEach((other) => {
      if (other !== fm) closeFlyout(other);
    });
    fm.classList.add(OPEN);
    fm.querySelector('.fm-trigger')?.setAttribute('aria-expanded', 'true');
    fm.querySelector('.fm-panel')?.removeAttribute('inert');
    aimNotch(fm);
  }

  /**
   * Point a centred panel's notch at the trigger that opened it.
   *
   * Every measurement here is deliberately transform-free. The panel animates
   * open with `translate(-50%, -6px) scale(0.98)` -> `scale(1)`, so a
   * `getBoundingClientRect()` on it during the transition returns an
   * interpolated box — 1200px reads as 1176 at the moment `is-open` lands. So
   * the panel contributes only `offsetWidth`, which is layout and ignores
   * transforms, and the horizontal frame comes from its offsetParent and the
   * trigger, neither of which is transformed. `left: 50%` + `translateX(-50%)`
   * puts the untransformed left edge at half the parent minus half the panel,
   * which is all this needs to know.
   */
  /** Half the notch's width — it is 20px wide, so its centre is 10px in. */
  const HALF = 10;

  function aimNotch(fm: HTMLElement) {
    const panel = fm.querySelector<HTMLElement>('.fm-panel');
    /* The LABEL, not the button. Ball's call, 2026-08-19: the notch points at the
       middle of the word. The button also contains a 16px caret box whose glyph
       is a 6px triangle, so its centre sits ~10px to the right of the word's and
       the arrow reads as aiming at the gap between them rather than at PRODUCTS.
       Measured: label centre 213, button centre 223, and Figma's hand-placed
       arrow 217 — between the two, nearer the word. */
    const trigger = fm.querySelector<HTMLElement>('[data-part="label"]')
      ?? fm.querySelector<HTMLElement>('.fm-trigger');
    if (!panel || !trigger || !panel.classList.contains('fm-center')) return;
    const parent = panel.offsetParent as HTMLElement | null;
    if (!parent) return;
    const parentRect = parent.getBoundingClientRect();
    const triggerRect = trigger.getBoundingClientRect();
    const panelLeft = parentRect.width / 2 - panel.offsetWidth / 2;
    const centre = triggerRect.left - parentRect.left + triggerRect.width / 2;
    panel.style.setProperty('--fm-notch-x', `${centre - panelLeft - HALF}px`);
  }

  window.addEventListener('resize', () => {
    document.querySelectorAll<HTMLElement>('[data-fm].' + OPEN).forEach(aimNotch);
  });

  function initFlyouts(root: ParentNode = document) {
    root.querySelectorAll<HTMLElement>('[data-fm]:not([data-fm-init])').forEach((fm) => {
      const trigger = fm.querySelector<HTMLButtonElement>('.fm-trigger');
      if (!trigger) return;
      fm.dataset.fmInit = '1';

      /* A panel rendered `open` never went through openFlyout, so nothing has
         aimed its notch. The docs pages do exactly that. */
      if (fm.classList.contains(OPEN)) aimNotch(fm);

      // Number the panel's own children so each one can be delayed a step
      // further into the reveal. Done here rather than asked of the caller —
      // whoever composes the columns should not have to hand-number them, and
      // they would go stale the moment one was inserted in the middle.
      fm.querySelectorAll<HTMLElement>('.fm-panel-inner > *').forEach((child, i) => {
        child.style.setProperty('--i', String(i));
      });
      // Same numbering for a bare panel's own columns, which are a level deeper.
      fm.querySelectorAll<HTMLElement>('.fm-panel.is-bare [data-part="column"]').forEach((col, i) => {
        col.style.setProperty('--i', String(i));
      });

      trigger.addEventListener('click', () => {
        if (!fm.classList.contains(OPEN)) { openFlyout(fm); return; }
        // Ball's call, 2026-08-05: on a hover flyout a click must never close.
        // The failure it fixes is common and feels broken — the pointer arrives,
        // the panel opens, and the user clicks the trigger anyway because that
        // is what triggers are for, which shut the panel in their face and left
        // it shut until they moved away and came back.
        //
        // The `:hover` test is what keeps that from costing the keyboard its
        // toggle. A disclosure that reports `aria-expanded="true"` and then
        // refuses to collapse on Enter is a broken contract, so the rule is
        // narrowed to what Ball actually described: a click that lands while
        // the pointer is over the component, which is the only way a hover
        // could have opened it. Opened by Tab and Enter, it still closes on
        // Enter.
        if (fm.dataset.fmHover !== undefined && fm.matches(':hover')) return;
        closeFlyout(fm);
      });

      // Tabbing out of the last link is a dismissal. relatedTarget is where
      // focus is going — inside the component means it was just a move between
      // two links, and null means focus left the document entirely (a blur to
      // the browser chrome), which is not a reason to close.
      fm.addEventListener('focusout', (e) => {
        const to = (e as FocusEvent).relatedTarget as Node | null;
        if (to && !fm.contains(to)) closeFlyout(fm);
      });

      if (fm.dataset.fmHover !== undefined) {
        // The delay covers the diagonal: the cursor leaves the trigger, crosses
        // the gap and lands on the panel, and without it the panel closes
        // mid-journey. Cancelled the moment the pointer arrives anywhere in the
        // component, so it never fights a real re-entry.
        let closeTimer: number | undefined;
        const cancel = () => { clearTimeout(closeTimer); closeTimer = undefined; };
        fm.addEventListener('pointerenter', (e) => {
          if ((e as PointerEvent).pointerType === 'touch') return; // a tap is not a hover
          cancel();
          openFlyout(fm);
        });
        fm.addEventListener('pointerleave', (e) => {
          if ((e as PointerEvent).pointerType === 'touch') return;
          cancel();
          closeTimer = window.setTimeout(() => closeFlyout(fm), 150);
        });
        fm.addEventListener('pointerdown', cancel);
      }
    });
  }

  // Bound once for the whole document rather than per instance: N copies would
  // do identical work and each would still have to work out which flyout the
  // event landed in.
  document.addEventListener('keydown', (e) => {
    if (e.key !== 'Escape') return;
    const open = document.querySelector<HTMLElement>('[data-fm].' + OPEN);
    if (open) closeFlyout(open, true);
  });

  // pointerdown, not click: it dismisses on press, and a click listener would
  // also fire at the end of a drag that began inside the panel.
  document.addEventListener('pointerdown', (e) => {
    const target = e.target as Node;
    document.querySelectorAll<HTMLElement>('[data-fm].' + OPEN).forEach((fm) => {
      if (!fm.contains(target)) closeFlyout(fm);
    });
  });

  document.addEventListener('DOMContentLoaded', () => initFlyouts());
  document.addEventListener('astro:page-load', () => initFlyouts());
</script>
