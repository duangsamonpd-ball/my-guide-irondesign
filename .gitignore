.DS_Store
._*
node_modules/

# local Figma reference exports (not committed)
design-refs/

# per-machine Claude Code overrides — .claude/launch.json IS committed, this isn't
.claude/settings.local.json

# playground build artefacts — the GENERATED markup it produces lands in docs/
# and is committed; the render itself is disposable.
playground/dist/
playground/.astro/

# `astro check` writes its generated ambient types here. Disposable: it is
# regenerated on every run, and nothing reads it but the checker.
astro-components/.astro/
