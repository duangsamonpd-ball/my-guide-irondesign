{
  "name": "@iron-software/design-system",
  "version": "0.1.0",
  "private": true,
  "description": "Iron Software Design System — tokens, Tailwind theme and Astro components",
  "//": "No \"type\": \"module\" on purpose — tailwind.config.js is CommonJS and the checker loads it with require(). The checker itself is .mjs, so it is ESM regardless.",
  "//workspaces": "The playground is a real Astro app used only to RENDER components so docs demo markup can be generated instead of hand-written. npm workspaces cannot link the root package to its own workspaces, so playground depends on it as \"file:..\" — see playground/README.md.",
  "workspaces": [
    "astro-components",
    "playground"
  ],
  "scripts": {
    "build:theme": "node scripts/build-theme.mjs",
    "build:utilities": "node scripts/build-utilities.mjs",
    "check:theme": "node scripts/build-theme.mjs --check",
    "check:utilities": "node scripts/build-utilities.mjs --check",
    "check:tokens": "node scripts/check-token-drift.mjs",
    "check:alt-text": "node scripts/check-alt-text.mjs --self-test && node scripts/check-alt-text.mjs",
    "check:logo-fills": "node scripts/check-logo-fills.mjs --self-test && node scripts/check-logo-fills.mjs",
    "check:flat-scope": "node scripts/check-flat-scope.mjs --self-test && node scripts/check-flat-scope.mjs",
    "check:type-scale": "node scripts/check-type-scale.mjs --self-test && node scripts/check-type-scale.mjs",
    "check:parity": "node scripts/check-component-parity.mjs",
    "check:exports": "node scripts/check-exports.mjs",
    "check:vars": "tailwindcss -i tailwind/theme.css -o node_modules/.tmp/theme.compiled.css && node scripts/check-component-vars.mjs node_modules/.tmp/theme.compiled.css",
    "build:demos": "node scripts/build-demos.mjs",
    "check:render": "node scripts/build-demos.mjs --check",
    "check:docs-css": "node scripts/check-docs-css.mjs",
    "check:contrast": "node scripts/check-contrast.mjs",
    "check:catalogue": "node scripts/check-catalogue.mjs --self-test && node scripts/check-catalogue.mjs",
    "build:seo": "node scripts/build-seo.mjs",
    "build:shell": "node scripts/build-shell.mjs",
    "check:shell": "node scripts/build-shell.mjs --check",
    "build:manifest": "node scripts/build-manifest.mjs",
    "check:manifest": "node scripts/build-manifest.mjs --check",
    "check:fonts": "node scripts/vendor-fonts.mjs --check",
    "vendor:fonts": "node scripts/vendor-fonts.mjs",
    "check:seo": "node scripts/build-seo.mjs --check",
    "check": "npm run check:theme && npm run check:utilities && npm run check:tokens && npm run check:alt-text && npm run check:logo-fills && npm run check:type-scale && npm run check:parity && npm run check:exports && npm run check:vars && npm run check:docs-css && npm run check:components-css && npm run check:contrast && npm run check:catalogue && npm run check:seo && npm run check:shell && npm run check:manifest && npm run check:fonts && npm run check:code && npm run check:render",
    "preview": "node scripts/preview.mjs",
    "audit": "node scripts/preview.mjs --all",
    "preview:self-test": "node scripts/preview.mjs --self-test",
    "state-diff": "node scripts/state-diff.mjs",
    "overflow": "node scripts/check-overflow.mjs",
    "overflow:self-test": "node scripts/check-overflow.mjs --self-test",
    "wide": "node scripts/check-wide.mjs",
    "wide:self-test": "node scripts/check-wide.mjs --self-test",
    "layout": "node scripts/check-layout.mjs",
    "layout:self-test": "node scripts/check-layout.mjs --self-test",
    "state-diff:self-test": "node scripts/state-diff.mjs --self-test",
    "build:code": "node scripts/build-code-samples.mjs",
    "check:code": "node scripts/build-code-samples.mjs --check",
    "check:types": "astro check --root astro-components",
    "check:peer-range": "node scripts/check-peer-range.mjs --self-test && node scripts/check-peer-range.mjs",
    "check:prose-classes": "node scripts/check-prose-classes.mjs --self-test && node scripts/check-prose-classes.mjs",
    "build:components-css": "node scripts/build-component-css.mjs",
    "check:components-css": "node scripts/build-component-css.mjs --self-test && node scripts/build-component-css.mjs --check"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@astrojs/compiler": "^2.13.1",
    "@astrojs/compiler-rs": "^0.3.2",
    "@tailwindcss/cli": "^4.3.3",
    "@types/node": "^26.2.0",
    "playwright-core": "^1.62.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3"
  },
  "//exports": "utilities.css is the compiled stylesheet for consumers who do NOT run Tailwind. It lives under docs/ because the docs site links it too; the path is an implementation detail and the specifier is the contract.",
  "exports": {
    "./tokens.css": "./tailwind/tokens.css",
    "./theme.css": "./tailwind/theme.css",
    "./colors.css": "./tailwind/colors.css",
    "./utilities.css": "./docs/utilities.css",
    "./tokens.json": "./tokens/tokens.w3c.json",
    "./package.json": "./package.json"
  }
}
