---
/**
 * Demo source for docs/component-textlink.html.
 *
 * Preview, Modes, Anatomy and the Do card are generated as of 2026-08-13;
 * External joined them on 2026-08-17, when the trailing ↗ stopped being a
 * character. Nothing in docs/ had ever rendered `external` — it appeared only
 * in the Code tab — so the icon was the one part of this component no harness
 * could see.
 *
 * TWO PARTS STAY HAND-WRITTEN, both on purpose:
 *
 * Variants weaves its example links into the middle of editorial paragraphs —
 * "…keeps hero sections clean. <a>Native vs Remote Engine</a>" — so a region
 * there would have to be one link wide and would carry no demo of its own. The
 * prose is the demo.
 *
 * The Don't card is an anti-example: a bare <a> with no component at all,
 * styled inline to look like a heading someone underlined by hand. That is the
 * mistake being warned about, and it cannot come from the component any more
 * than Logo's squashed mark can.
 *
 * Hover cannot be rendered statically. It travels as `class`, which TextLink
 * puts on the anchor, and the page styles `.demo-link-hover` and
 * `.demo-link-hover-underline` — the two inline styles the Anatomy examples
 * used to carry.
 */
import { TextLink, Prose } from '@iron-software/astro-components';

const P = 'font-size:0.95rem;color:var(--color-text-heading);line-height:1.7;';
/* The External region's third line is deliberately smaller: the arrow is sized
   in em, so the only way to show that it tracks the run it sits in is to put
   two sizes next to each other. */
const P_SM = 'font-size:0.78rem;color:var(--color-text-support);line-height:1.7;';
const modes = [
  { variant: 'plain' as const },
  { variant: 'underline' as const },
];
/* Prose's demo code spans name the docs' mono face — Prose styles links only,
   and the overflow harness refuses text that falls back to the UA monospace. */
const codeStyle = "font-family:'Roboto Mono',monospace;font-size:0.875em;";
---

<html lang="en">
  <body>
    <div data-demo="preview">
      <p style={P}>Save 80% on all 10 products with the new <TextLink href="#">Iron Suite</TextLink></p>
      <p style={P}>Save 80% on all 10 products with the new <TextLink href="#" variant="underline">Iron Suite</TextLink></p>
    </div>

    <div data-demo="external">
      <p style={P}>Read the <TextLink href="https://example.com" external>Native vs Remote Engine</TextLink> comparison.</p>
      <p style={P}>Read the <TextLink href="https://example.com" variant="underline" external>Native vs Remote Engine</TextLink> comparison.</p>
      <p style={P_SM}>Also in a caption-sized run: <TextLink href="https://example.com" external>Learn more</TextLink></p>
    </div>

    {/* Ball's idea frame `1264:3744`: a standalone link with a trailing → that
        nudges right, and the ↗ nudging along its diagonal. The second column
        is the hover state held still with the docs-only `demo-link-hover`
        class — hover cannot be rendered statically. */}
    <div data-demo="arrow">
      <div class="arrow-grid">
        <span class="arrow-lbl">Default</span>
        <span class="arrow-lbl">Hover · focus</span>
        <TextLink href="#" arrow>See all products</TextLink>
        <TextLink href="#" arrow class="demo-link-hover">See all products</TextLink>
        <TextLink href="https://example.com" external>Native vs Remote Engine</TextLink>
        <TextLink href="https://example.com" external class="demo-link-hover">Native vs Remote Engine</TextLink>
      </div>
    </div>

    {/* Prose — Markdown/CMS links. Moved here from its own page on 2026-10-01
        (Ball): it is how links look inside content you do not write, so it is
        documented beside the link it imitates. The anchors are PLAIN <a> on
        purpose: that is what a Markdown renderer hands you. */}
    <div data-demo="prose">
      <Prose>
        <p style="margin:0;max-width:640px;font-size:1rem;line-height:1.75;color:var(--color-text-body);">
          Style elements on hover, focus and more using <a href="#">pseudo-classes</a>, like
          <code style={codeStyle}>:hover</code> and <code style={codeStyle}>:focus</code>. Read the
          <a href="#">IronPDF docs</a> for the full list, or start from the <a href="#">HTML to PDF tutorial</a>.
        </p>
      </Prose>
    </div>

    <div data-demo="prose-dark">
      <Prose dark>
        <p style="margin:0;max-width:640px;font-size:1rem;line-height:1.75;color:var(--color-text-dark-body);">
          On a dark band the links move to the dark tokens &mdash; see the <a href="#">release notes</a> for what changed.
        </p>
      </Prose>
    </div>

    {modes.map((m) => (
      <div data-demo={`modes-${m.variant}`}>
        <div class="mode-cell">
          <TextLink href="#" variant={m.variant}>Create Blank PDF</TextLink>
          <div class="mode-lbl">Light</div>
        </div>
        <div class="mode-cell dark">
          <TextLink href="#" variant={m.variant} dark>Create Blank PDF</TextLink>
          <div class="mode-lbl" style="color:#90A1B9;">Dark</div>
        </div>
      </div>
    ))}

    <div data-demo="anatomy-plain">
      <TextLink href="#" class="demo-link-hover">Create Blank PDF</TextLink>
    </div>

    <div data-demo="anatomy-underline">
      <TextLink href="#" variant="underline" class="demo-link-hover-underline">Create Blank PDF</TextLink>
    </div>

    <div data-demo="do">
      <TextLink href="#">Iron Suite</TextLink>
      <TextLink href="#" variant="underline">Iron Suite</TextLink>
    </div>
  </body>
</html>
