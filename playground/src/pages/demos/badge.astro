---
/**
 * Demo source for docs/component-badge.html.
 *
 * Every `data-demo="…"` region below is rendered by `astro build`, extracted by
 * scripts/build-demos.mjs and written into the matching
 * `<!-- demo:… -->` … `<!-- /demo:… -->` sentinels in the docs page. The docs
 * markup is therefore generated, never hand-typed — that is the whole point.
 *
 * Regions deliberately NOT covered here (still hand-written in the docs page):
 *   · Anatomy — the badge there is distorted on purpose with an inline
 *     font-size/padding override, which is not a prop the component accepts.
 *   · Token Reference table — documentation prose, not a usage demo.
 *   · The Code pane — a syntax-highlighted snippet, a separate concern.
 *
 * Docs-only layout chrome (.cell, .lbl, the flex rows) lives inside the regions
 * so the whole region is generated as one unit.
 */
import { Badge } from '@iron-software/astro-components';

const intents = ['success', 'warning', 'danger', 'info', 'important', 'neutral'] as const;

const colourNotes: Record<(typeof intents)[number], [string, string]> = {
  success: ['Success', 'positive / done'],
  warning: ['Warning', 'caution'],
  danger: ['Danger', 'error / failed'],
  info: ['Info', 'neutral note'],
  important: ['Important', 'needs attention'],
  neutral: ['Neutral', 'default'],
};

const previewLabels: Record<(typeof intents)[number], string> = {
  success: 'Active',
  warning: 'Pending',
  danger: 'Failed',
  info: 'Beta',
  important: 'Important',
  neutral: 'Draft',
};

/* Every combination the "Try it" panel can ask for, rendered by the real
   component — 6 x 2 x 2 x 2 x 2 = 96. The panel on the docs page only picks
   which one is visible; it never builds a badge itself, so what it shows is
   exactly what `<Badge>` renders and check:render keeps it that way. */
const tryCombos = intents.flatMap((intent) =>
  (['subtle', 'solid'] as const).flatMap((variant) =>
    (['md', 'sm'] as const).flatMap((size) =>
      [false, true].flatMap((pill) => [false, true].map((dot) => ({ intent, variant, size, pill, dot }))))));

const rowStyle = 'display:flex;gap:10px;flex-wrap:wrap;align-items:center;';
const rowLabelStyle = 'font-size:0.66rem;font-weight:700;color:var(--color-text-muted);width:46px;';
---

<html lang="en">
  <body>
    <div data-demo="preview">
      {intents.map((intent) => (
        <Badge intent={intent} dot={intent === 'success'}>{previewLabels[intent]}</Badge>
      ))}
    </div>

    <div data-demo="colours">
      {intents.map((intent) => (
        <div class="cell">
          <Badge intent={intent}>{colourNotes[intent][0]}</Badge>
          <div class="lbl">{colourNotes[intent][0]}<small>{colourNotes[intent][1]}</small></div>
        </div>
      ))}
    </div>

    <div data-demo="subtle-solid">
      <div style={rowStyle}>
        <span style={rowLabelStyle}>Subtle</span>
        {intents.map((intent) => <Badge intent={intent}>{previewLabels[intent]}</Badge>)}
      </div>
      <div style={rowStyle}>
        <span style={rowLabelStyle}>Solid</span>
        {intents.map((intent) => <Badge intent={intent} variant="solid">{previewLabels[intent]}</Badge>)}
      </div>
    </div>

    <div data-demo="dark">
      {intents.map((intent) => (
        <Badge intent={intent} dot={intent === 'success'}>{previewLabels[intent]}</Badge>
      ))}
    </div>

    {/* The same three rows, labels and order as Figma's "Sizes, dot & shape"
        section on the Badge doc frame (`1265:153`), so the two docs read alike. */}
    <div data-demo="variants">
      <div style={rowStyle}>
        <span style={rowLabelStyle}>Size</span>
        <Badge intent="success">md · 24</Badge>
        <Badge intent="success" size="sm">sm · 20</Badge>
      </div>
      <div style={rowStyle}>
        <span style={rowLabelStyle}>Dot</span>
        <Badge intent="success">Dot off</Badge>
        <Badge intent="success" dot>Dot on</Badge>
      </div>
      <div style={rowStyle}>
        <span style={rowLabelStyle}>Shape</span>
        <Badge intent="success">Rounded</Badge>
        <Badge intent="success" pill>Pill</Badge>
      </div>
    </div>

    <div data-demo="try">
      {tryCombos.map((c) => (
        <span class="try-one" data-try={`${c.intent} ${c.variant} ${c.size} ${c.pill} ${c.dot}`} hidden={!(c.intent === 'neutral' && c.variant === 'subtle' && c.size === 'md' && !c.pill && !c.dot)}>
          <Badge intent={c.intent} variant={c.variant} size={c.size} pill={c.pill} dot={c.dot}>Badge</Badge>
        </span>
      ))}
    </div>

    <div data-demo="do">
      <Badge intent="success">Paid</Badge>
      <Badge intent="warning">Overdue</Badge>
      <Badge intent="neutral">Archived</Badge>
    </div>

    <div data-demo="dont">
      <Badge intent="danger" variant="solid">Click here to retry now</Badge>
    </div>

    {/* The anatomy diagram is drawn larger so its callouts have room. That used
        to be an inline style on the badge; it is `.anatomy .demo-zoom` on the
        page now, since Badge puts `class` on the badge itself. */}
    <div data-demo="anatomy">
      <Badge intent="success" dot class="demo-zoom">Active</Badge>
    </div>

  </body>
</html>
