---
/**
 * Demo source for docs/component-productmenu.html.
 *
 * Both regions are complete component instances, so both are generated. Every
 * other prop the docs demos rely on — product, productName, runtime, the CTA
 * label, Search and Ask AI — is already the component's default, so only the
 * menu items and the sub tier need stating here.
 */
import { ProductMenu } from '@iron-software/astro-components';

const items = [
  { label: 'Home', href: '#', active: true },
  { label: 'Licensing', href: '#', caret: true },
  { label: 'Features', href: '#', caret: true },
  { label: 'Demos', href: '#', caret: true },
  { label: 'Docs', href: '#', caret: true },
];

const sub = { label: 'Submenu', href: '#' };
---

<html lang="en">
  <body>
    <div data-demo="default">
      <ProductMenu items={items} />
    </div>

    <div data-demo="cta-button">
      <ProductMenu items={items} cta="button" />
    </div>

    {/* A CONSUMER'S strings, not the defaults — iron-suite's exact props, from
        page-experiments (#4). Every other region uses the component's defaults,
        and every narrow-width fault this bar has had was right for the defaults
        and wrong for a consumer: at 320 this one left the bar by 10.16px with
        all three drops of the day applied. It is here so `npm run overflow`
        sweeps it, and on the docs page ("Longer names") because build-demos
        refuses a region without a sentinel there. */}
    <div data-demo="consumer">
      <ProductMenu items={items} product="suite" productName="SUITE" runtime="for .NET" hasTrailingIcon={false} ctaLabel="Buy License Today" />
    </div>

    <div data-demo="submenu">
      <ProductMenu
        variant="submenu"
        items={items}
        subLead={sub}
        subItems={[sub, sub, sub, sub, sub]}
        showMenuItems2
        subItemsTrailing={[sub]}
      />
    </div>
  </body>
</html>
