---
/**
 * Demo source for docs/component-radio.html.
 *
 * Every region on that page is generated as of 2026-08-13 — preview, states,
 * card group, anatomy and both Do/Don't cards. Nothing about the component is
 * hand-written in docs/ any more; what stays hand-written there is the prose:
 * the `.atag` callouts beside the anatomy, the `.top` labels on the cards, and
 * the `<ul>` of advice under each.
 *
 * The three added last are the reason this matters. Their hand-written copies
 * still said `font-medium leading-5` months after choice.ts moved to
 * `font-label-lg leading-label-lg` — identical values, so nothing rendered
 * wrong and no gate could see it, which is exactly how the earlier drift got
 * in. A copy that renders correctly is still a copy.
 *
 * Radio derives its id from `${name}-${value}`, and the hand-written markup
 * carried a `name` but no `value` and no id — so, as on the checkbox page, no
 * label was tied to its control. Generating them ties each one.
 */
import { Radio } from '@iron-software/astro-components';

const plans = [
  { value: 'starter', label: 'Starter', desc: 'For individuals getting started.', checked: true },
  { value: 'pro', label: 'Pro', desc: 'For growing teams that ship daily.' },
  { value: 'enterprise', label: 'Enterprise', desc: 'Advanced controls & support.' },
];
const states = [
  { name: 's1', value: 'a', props: {}, lbl: 'Unselected', note: 'border-strong' },
  { name: 's2', value: 'b', props: { checked: true }, lbl: 'Selected', note: 'secondary dot' },
  { name: 's3', value: 'c', props: { disabled: true }, lbl: 'Disabled', note: 'opacity .5' },
  { name: 's4', value: 'd', props: { invalid: true }, lbl: 'Invalid', note: 'danger ring' },
];
---

<html lang="en">
  <body>
    <div data-demo="preview">
      {plans.map((p) => (
        <Radio name="plan" value={p.value} label={p.label} description={p.desc} checked={p.checked} />
      ))}
    </div>

    <div data-demo="states">
      {states.map((s) => (
        <div class="cell">
          <Radio name={s.name} value={s.value} label="Option" {...s.props} />
          <div class="lbl">{s.lbl}<small>{s.note}</small></div>
        </div>
      ))}
    </div>

    <div data-demo="card-group">
      <Radio name="bill" value="monthly" label="Monthly" description="$29 / month, cancel anytime." card checked />
      <Radio name="bill" value="yearly" label="Yearly" description="$290 / year — two months free." card />
    </div>

    {/* The `.anatomy-tags` callouts beside this stay hand-written on the page —
        they name tokens, which is prose, and check:catalogue gates them. */}
    <div data-demo="anatomy">
      <Radio
        name="an"
        value="selected"
        label="Selected option"
        description="With a supporting description."
        checked
      />
    </div>

    <div data-demo="do">
      <Radio name="g1" value="one" label="One per group" checked />
    </div>

    <div data-demo="dont">
      <Radio name="g2" value="toggle" label="Toggle me" />
    </div>
  </body>
</html>
