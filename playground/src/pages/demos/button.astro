---
/**
 * Demo source for docs/component-button.html.
 *
 * Every region is generated as of 2026-08-13 — states, anatomy and both
 * Do/Don't cards join preview, variants and sizes.
 *
 * States needed three docs-only illustrations and lost one. `disabled` is a real
 * prop and the component already ships `disabled:opacity-50
 * disabled:cursor-not-allowed disabled:pointer-events-none`, so
 * `.demo-disabled-btn` was decoration and is gone. Hover, the two focus rings
 * and the spinner cannot be rendered statically, so they travel as `class`,
 * which Button puts on the button element:
 *   .demo-hover-primary  the hover fill, lifted out of an inline style
 *   .demo-focus-magenta  the primary focus halo   (already on the page)
 *   .demo-focus-ghost    the ghost focus border   (already on the page)
 * The Loading cell is a real button with an extra `.spin` span as its child —
 * Button has no loading prop, and inventing one to serve the docs is the thing
 * this file is trying not to do.
 *
 * The Variants grid's on-dark cell keeps its dark background inline — that is
 * docs chrome around the button, not an override on it, so it lives inside the
 * region like any other cell wrapper.
 */
import { Button } from '@iron-software/astro-components';

const variants = [
  ['primary', 'Primary', 'button/primary'],
  ['secondary', 'Secondary', 'button/secondary'],
  ['tertiary', 'Tertiary', 'button/tertiary → pink'],
  ['outline', 'Outline', 'border/default'],
] as const;
---

<html lang="en">
  <body>
    <div data-demo="preview">
      <Button size="lg">Download Free Trial</Button>
      <Button size="lg" variant="outline">Learn more</Button>
      <Button size="lg" variant="ghost">Docs<span class="ico">→</span></Button>
    </div>

    <div data-demo="variants">
      {variants.map(([v, name, note]) => (
        <div class="cell">
          <Button variant={v}>{name}</Button>
          <div class="lbl">{name}<small>{note}</small></div>
        </div>
      ))}
      <div class="cell" style="background:#1D293D;border-color:#334155;">
        <Button variant="ondark">On-dark</Button>
        <div class="lbl" style="color:#CAD5E2;">Outline · on-dark<small style="color:#90A1B9;">transparent + blur</small></div>
      </div>
      <div class="cell">
        <Button variant="ghost">Ghost</Button>
        <div class="lbl">Ghost<small>text only</small></div>
      </div>
    </div>

    <div data-demo="sizes">
      <Button size="lg">Large</Button>
      <Button size="md">Default</Button>
      <Button size="sm">Small</Button>
    </div>

    <div data-demo="states">
      <div class="cell"><Button>Default</Button><div class="lbl">Default</div></div>
      <div class="cell"><Button class="demo-hover-primary">Hover</Button><div class="lbl">Hover<small>primary-hover</small></div></div>
      <div class="cell"><Button class="demo-focus-magenta">Focus</Button><div class="lbl">Focus<small>pink halo</small></div></div>
      <div class="cell"><Button disabled>Disabled</Button><div class="lbl">Disabled<small>opacity .5</small></div></div>
      <div class="cell"><Button variant="ghost" class="demo-focus-ghost">Focus</Button><div class="lbl">Ghost focus<small>border/focused</small></div></div>
      <div class="cell"><Button><span class="spin"></span>Loading</Button><div class="lbl">Loading<small>spinner (extra)</small></div></div>
    </div>

    <div data-demo="anatomy">
      <Button size="lg"><span class="ico">↓</span> Download Free Trial</Button>
    </div>

    <div data-demo="do">
      <Button>Get started</Button>
    </div>

    <div data-demo="dont">
      <Button>Save</Button>
      <Button>Cancel</Button>
    </div>

  </body>
</html>
