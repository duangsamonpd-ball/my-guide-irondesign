---
/**
 * Demo source for docs/component-button.html.
 *
 * Every region is generated as of 2026-08-13 — states, anatomy and both
 * Do/Don't cards join preview, variants and sizes.
 *
 * States needed three docs-only illustrations and lost one. `disabled` is a real
 * prop and the component already ships `disabled:opacity-50
 * disabled:cursor-not-allowed disabled:pointer-events-none`, so
 * `.demo-disabled-btn` was decoration and is gone. Hover, the two focus rings
 * and the spinner cannot be rendered statically, so they travel as `class`,
 * which Button puts on the button element:
 *   .demo-hover-primary  the hover fill, lifted out of an inline style
 *   .demo-focus-magenta  the primary focus halo   (already on the page)
 *   .demo-focus-ghost    the ghost focus border   (already on the page)
 * The Loading cell is a real button with an extra `.spin` span as its child —
 * Button has no loading prop, and inventing one to serve the docs is the thing
 * this file is trying not to do.
 *
 * NUGET, added 2026-08-17 — Figma `277:372`, the `button-Nuget` frame. The page
 * had drawn it by hand since before the component existed and had drifted off
 * the node on seven counts (structure, a 26px hand-drawn mark that was not the
 * NuGet logo, no caret, line-height, letter-spacing, opacity, and no `md` at
 * all). It is `NugetButton`, its own component, because Figma keeps the frame
 * outside the button set. Its state cells reuse the same two docs-only classes
 * the Button states already use — `.demo-hover-primary` and
 * `.demo-focus-magenta` — since the fill and the ring are the same tokens.
 *
 * THE TWO ARROWS ARE ICONS, NOT CHARACTERS, since 2026-08-17. They were `→`
 * and `↓` in a `.ico` span, and Ball caught the Anatomy one by looking at it.
 *
 * `→` U+2192 is the real case: it is not in the vendored subset and falls out
 * of the stack, measured at 14.19px in .SF NS against 16.00px in Lucida Grande
 * — the trap FormCard, Select, FileUpload, Tooltip and TextLink were each fixed
 * for. `↓` U+2193 is NOT that case, and the first version of this note said it
 * was: one CDP reading on one element returned `.SF NS` and I generalised it to
 * the font. Re-tested with the stack and weight as the only variables, `↓`
 * resolves to Montserrat every way it can be asked. It is an icon here only so
 * the pair matches.
 *
 * The two icons are sized with an INLINE STYLE, not `size-[1em]`. Tailwind
 * scans components/, internal/ and the shared .ts files — not this folder — so
 * a utility class written here reaches the markup with no rule behind it. The
 * first attempt did exactly that and the arrow rendered at its intrinsic
 * 179.77 x 239.69px inside a 56px button. CLAUDE.md names this one; it still
 * took a measurement to see it.
 *
 * The Variants grid's on-dark cell keeps its dark background inline — that is
 * docs chrome around the button, not an override on it, so it lives inside the
 * region like any other cell wrapper.
 */
import { Button, NugetButton, icons } from '@iron-software/astro-components';

const variants = [
  ['primary', 'Primary', 'button/primary'],
  ['secondary', 'Secondary', 'button/secondary'],
  ['tertiary', 'Tertiary', 'button/tertiary → pink'],
  ['outline', 'Outline', 'border/default'],
] as const;
---

<html lang="en">
  <body>
    <div data-demo="preview">
      <Button size="lg">Download Free Trial</Button>
      <Button size="lg" variant="outline">Learn more</Button>
      <Button size="lg" variant="ghost">Docs<svg style="width:1em;height:1em;flex-shrink:0" viewBox={icons.arrowRight.viewBox} fill="currentColor" aria-hidden="true"><path d={icons.arrowRight.path} /></svg></Button>
    </div>

    <div data-demo="variants">
      {variants.map(([v, name, note]) => (
        <div class="cell">
          <Button variant={v}>{name}</Button>
          <div class="lbl">{name}<small>{note}</small></div>
        </div>
      ))}
      <div class="cell" style="background:var(--slate-800);border-color:var(--slate-700);">
        <Button variant="ondark">On-dark</Button>
        <div class="lbl" style="color:#CAD5E2;">Outline · on-dark<small style="color:#90A1B9;">transparent + blur</small></div>
      </div>
      <div class="cell">
        <Button variant="ghost">Ghost</Button>
        <div class="lbl">Ghost<small>text only</small></div>
      </div>
    </div>

    <div data-demo="sizes">
      <Button size="lg">Large</Button>
      <Button size="md">Default</Button>
      <Button size="sm">Small</Button>
    </div>

    <div data-demo="states">
      <div class="cell"><Button>Default</Button><div class="lbl">Default</div></div>
      <div class="cell"><Button class="demo-hover-primary">Hover</Button><div class="lbl">Hover<small>primary-hover</small></div></div>
      <div class="cell"><Button class="demo-focus-magenta">Focus</Button><div class="lbl">Focus<small>pink halo</small></div></div>
      <div class="cell"><Button disabled>Disabled</Button><div class="lbl">Disabled<small>opacity .5</small></div></div>
      <div class="cell"><Button variant="ghost" class="demo-focus-ghost">Focus</Button><div class="lbl">Ghost focus<small>border/focused</small></div></div>
      <div class="cell"><Button><span class="spin"></span>Loading</Button><div class="lbl">Loading<small>spinner (extra)</small></div></div>
    </div>

    <div data-demo="nuget">
      <NugetButton subtext="Total download 19,002,577" />
    </div>

    <div data-demo="nuget-sizes">
      <NugetButton size="lg" subtext="Total download 19,002,577" />
      <NugetButton size="md" subtext="Total download 19,002,577" />
    </div>

    <div data-demo="nuget-states">
      <div class="cell"><NugetButton subtext="19,002,577" /><div class="lbl">Default<small>button/primary</small></div></div>
      <div class="cell"><NugetButton subtext="19,002,577" class="demo-hover-primary" /><div class="lbl">Hover<small>primary-hover</small></div></div>
      <div class="cell"><NugetButton subtext="19,002,577" class="demo-focus-magenta" /><div class="lbl">Focus<small>pink halo</small></div></div>
      <div class="cell"><NugetButton subtext="19,002,577" disabled /><div class="lbl">Disabled<small>opacity .5</small></div></div>
    </div>

    <div data-demo="anatomy">
      <Button size="lg"><svg style="width:1em;height:1em;flex-shrink:0" viewBox={icons.arrowDown.viewBox} fill="currentColor" aria-hidden="true"><path d={icons.arrowDown.path} /></svg> Download Free Trial</Button>
    </div>

    <div data-demo="do">
      <Button>Get started</Button>
    </div>

    <div data-demo="dont">
      <Button>Save</Button>
      <Button>Cancel</Button>
    </div>

  </body>
</html>
