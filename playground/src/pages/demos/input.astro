---
/**
 * Demo source for docs/component-input.html.
 *
 * Preview only, and the two sections below it explain why.
 *
 * States forces `is-focus` and `is-disabled`, classes the component never emits
 * — the same kind of isolated illustration as Select's states grid.
 *
 * Compositions sizes its canvas with an inline max-width, so it stays
 * hand-written too. It used to carry a third field with a leading icon
 * (`has-icon` plus an `.input-icon` span) that Input had no prop and no CSS
 * for — documented but impossible to produce. Dropped 2026-07-31 rather than
 * grown into a feature.
 */
import { Input } from '@iron-software/astro-components';
---

<html lang="en">
  <body>
    <div data-demo="preview">
      <Input
        label="Email address"
        name="email-address"
        type="email"
        placeholder="you@example.com"
        hint="We'll never share your email."
      />
    </div>
  </body>
</html>
