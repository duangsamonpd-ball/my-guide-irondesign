---
/**
 * Demo source for docs/component-input.html.
 *
 * Every region is generated as of 2026-08-13. What stays hand-written on the
 * page is prose and page chrome: the `.atag` callouts, the card labels and
 * advice lists, and the inline `max-width` on the Compositions canvas.
 *
 * FOUR OF THE FIVE STATE CELLS ARE REAL STATES, not illustrations. `disabled`
 * and `error` are props, and the docs had been faking `disabled` with a
 * `.demo-disabled` rule on a control that already carried the `disabled`
 * attribute — the component's own `disabled:` utilities were doing the work and
 * the rule was decoration. It is gone.
 *
 * Only FOCUS cannot be rendered statically, so it stays faked — but the fake
 * now travels as a prop. `class` lands on the field shell, and the page styles
 * `.demo-focus input`, so no wrapper element is added and the cell's DOM shape
 * is unchanged. Putting the class on the control itself was impossible: `class`
 * does not reach it.
 *
 * The Compositions canvas keeps its inline max-width because that is the
 * CANVAS, not the field. It used to carry a third field with a leading icon
 * (`has-icon` plus an `.input-icon` span) that Input had no prop and no CSS
 * for — documented but impossible to produce. Dropped 2026-07-31 rather than
 * grown into a feature.
 */
import { Input, PasswordChecklist, checkPassword } from '@iron-software/astro-components';

const states = [
  { props: { name: 'st-default', placeholder: 'Placeholder' }, lbl: 'Default' },
  { props: { name: 'st-focus', value: 'Focused', class: 'demo-focus' }, lbl: 'Focus', note: 'secondary ring' },
  { props: { name: 'st-filled', value: 'Jane Cooper' }, lbl: 'Filled' },
  { props: { name: 'st-error', value: 'not-an-email', error: true, errorMessage: 'Enter a valid email.' }, lbl: 'Error', note: 'danger border' },
  { props: { name: 'st-disabled', value: 'Disabled', disabled: true }, lbl: 'Disabled' },
];

/* The four states of the password checklist. Rendered as visible text, not
   `type="password"`, because the value IS the thing each cell explains. They are
   live too: type in one and it re-checks. */
const pwStates = [
  { id: 'pw-empty', value: '', touched: false, lbl: 'Empty', note: 'the rule, before typing' },
  { id: 'pw-typing', value: 'ironpdf', touched: false, lbl: 'Typing', note: 'nothing red yet' },
  { id: 'pw-short', value: 'IronPdf2026', touched: true, lbl: 'Left the field', note: '11 characters: only length fails' },
  { id: 'pw-met', value: 'IronPdfs2026', touched: true, lbl: 'All met', note: 'no special character, and none needed' },
];
---

<html lang="en">
  <body>
    <div data-demo="preview">
      <Input class="demo-field"
        label="Email address"
        name="email-address"
        type="email"
        autocomplete="email"
        placeholder="you@example.com"
        hint="We'll never share your email."
      />
    </div>

    <div data-demo="states">
      {states.map((s) => (
        <div class="cell">
          <Input {...s.props} class={['demo-field', s.props.class].filter(Boolean).join(' ')} />
          <div class="lbl">{s.lbl}{s.note && <small>{s.note}</small>}</div>
        </div>
      ))}
    </div>

    <div data-demo="compositions">
      <Input class="demo-field" label="Full name" name="full-name" autocomplete="name" required placeholder="Jane Cooper" />
      <Input class="demo-field"
        label="Password"
        name="password"
        type="password"
        autocomplete="current-password"
        value="123"
        error
        errorMessage="Must be at least 12 characters."
      />
    </div>

    <div data-demo="password">
      <div class="demo-field flex flex-col gap-xs">
        <Input label="Password" id="pw-live" name="password" type="password" autocomplete="new-password" required placeholder="Create a password" describedby="pw-live-rules" />
        <PasswordChecklist for="pw-live" />
      </div>
    </div>

    <div data-demo="password-states">
      {pwStates.map((s) => (
        <div class="cell">
          <div class="demo-field flex flex-col gap-xs">
            <Input label="Password" id={s.id} name={s.id} placeholder="Create a password" value={s.value} error={s.touched && !checkPassword(s.value).ok} describedby={`${s.id}-rules`} />
            <PasswordChecklist for={s.id} value={s.value} touched={s.touched} />
          </div>
          <div class="lbl">{s.lbl}<small>{s.note}</small></div>
        </div>
      ))}
    </div>

    <div data-demo="anatomy">
      <Input class="demo-field" label="Email address" name="anatomy-email" placeholder="you@example.com" hint="Helper text." />
    </div>

    <div data-demo="do">
      <Input class="demo-field" label="Email" name="do-email" placeholder="you@example.com" />
    </div>

    <div data-demo="dont">
      <Input class="demo-field" name="dont-email" placeholder="Email" />
    </div>
  </body>
</html>
