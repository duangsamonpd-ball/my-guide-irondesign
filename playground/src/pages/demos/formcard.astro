---
/**
 * Demo source for docs/component-formcard.html.
 *
 * Preview only. Anatomy overrides max-width inline, which is not a prop.
 *
 * The card takes its fields through a slot, so the demo composes real Input
 * components rather than imitating their markup — which is what the docs page
 * had been doing, and it had drifted: its labels carried no `for` and its inputs
 * no `id`, so nothing tied the two together for a screen reader. Each Input is
 * given a `name` so the id it derives is stable across builds.
 */
import { FormCard, Input, Checkbox } from '@iron-software/astro-components';
---

<html lang="en">
  <body>
    <div data-demo="preview">
      <FormCard
        icon="quote"
        title="Request Your Discounted Quote"
        subtitle="Tell us what you're migrating from and we'll do the rest."
        submitLabel="Get Your Migration Quote"
        noteLeft="No obligation to proceed"
        noteRight="Response within 1 business day"
      >
        <Input label="Full name" name="full-name" placeholder="Jane Cooper" required />
        <Input label="Work email" name="work-email" type="email" placeholder="you@example.com" required />
      </FormCard>
    </div>
    {/* `elevated`, no icon — Figma 2787:10701, the card this component now
        follows. The light square behind it is the docs page's, so the shadow
        has something to fall on. */}
    <div data-demo="elevated">
      <FormCard
        variant="elevated"
        headingLevel={2}
        title="Activate your Iron Suite Upgrade"
        subtitle="Enter the email you bought your license with."
        submitLabel="Confirm"
      >
        <Input label="Email" name="elevated-email" type="email" autocomplete="email" placeholder="you@example.com" />
        <Checkbox name="elevated-consent" size="sm" label="I agree to the Iron Suite Upgrade terms and conditions." />
      </FormCard>
    </div>
    {/* The card at full width for the diagram; `.anatomy .demo-wide` on the page
        replaces an inline max-width:none the component cannot emit. The slot
        held a hand-written `.field` stub in pre-Tailwind classes — a real Input
        is what a consumer would actually put there. */}
    <div data-demo="anatomy">
      <FormCard
        icon="key"
        title="Card title"
        subtitle="Optional subtitle."
        submitLabel="Submit label"
        noteLeft="Note left"
        noteRight="Note right"
        class="demo-wide"
      >
        <Input label="Slotted field" name="anatomy-slot" placeholder="Your fields go here" />
      </FormCard>
    </div>

  </body>
</html>
