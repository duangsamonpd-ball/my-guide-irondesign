---
/**
 * Demo source for docs/component-footerbar.html.
 *
 * Two of Figma's three `footer-lg` variants: Default, and Free tools version —
 * which in Figma is the same layout with one hidden menu item switched on, so
 * it is a prop here rather than a second component. `Free tool open` is still
 * unbuilt; it needs an expanding three-column panel.
 *
 * Both regions are complete real components, so nothing here has to stay
 * hand-written the way Select's partial state grids do.
 */
import { FooterBar } from '@iron-software/astro-components';
---

<html lang="en">
  <body>
    <div data-demo="default">
      <FooterBar />
    </div>
    <div data-demo="freetools">
      <FooterBar freeTools />
    </div>
  </body>
</html>
