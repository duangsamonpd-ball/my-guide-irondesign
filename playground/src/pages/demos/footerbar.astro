---
/**
 * Demo source for docs/component-footerbar.html.
 *
 * FooterBar is a single composed bar with no variants in code yet — Figma's
 * `footer-lg` set carries three (Default / Free tools version / Free tool open)
 * and this is the Default one. The other two land when the Free-tools menu does.
 *
 * The whole component is one region: every part of it is real, so there is
 * nothing here that has to stay hand-written the way Select's partial state
 * grids do.
 */
import { FooterBar } from '@iron-software/astro-components';
---

<html lang="en">
  <body>
    <div data-demo="default">
      <FooterBar />
    </div>
  </body>
</html>
