---
/**
 * Demo source for docs/component-tooltip.html.
 *
 * Only Preview is generated. The Variants, Placement and Sizes grids show a
 * bare `.tt-bubble force-show` with no trigger, no `tabindex` and no aria —
 * deliberately partial illustrations of the bubble alone, the same category as
 * the Select states grid. Rendering the real component there would need props
 * that exist only to serve the docs.
 *
 * `.tt-trigger` is docs-only styling for the demo button, so the button is
 * slotted here as part of the region rather than living in the component.
 * The rule itself is repeated in the <head> below, mirroring
 * docs/component-tooltip.html, because the built demo is what check-overflow.mjs
 * measures: without it a <button> does not inherit the body font and Chrome's UA
 * stylesheet renders the trigger in 13.33px Arial while the docs page shows
 * 0.85rem/600 Montserrat. The sweep was measuring a button that exists nowhere.
 * It sits in the head, outside the [data-demo] region, so build-demos.mjs does
 * not carry it into the docs page that already has it.
 */
import { Tooltip } from '@iron-software/astro-components';

const seats =
  'The number of individuals or development machines working on all projects using an Iron Product.';
---

<html lang="en">
  <head>
    <style is:global>
      /* Kept identical to docs/component-tooltip.html's own `.tt-trigger` rule. */
      .tt-trigger {
        font-family: 'Montserrat', sans-serif; font-size: 0.85rem; font-weight: 600;
        color: #45556C; background: #F1F5F9; border: 1px solid #E2E8F0;
        border-radius: 8px; padding: 9px 16px; cursor: pointer;
      }
    </style>
  </head>
  <body>
    <div data-demo="preview">
      <Tooltip title="Title" body={seats}>
        <button class="tt-trigger">Hover me</button>
      </Tooltip>
      <Tooltip
        title="Per-seat licensing"
        body="Counts unique developers, not machines."
        linkHref="#"
        linkText="Learn more"
      >
        <button class="tt-trigger">With a link</button>
      </Tooltip>
      <Tooltip body={seats}>
        <button class="tt-trigger">No title</button>
      </Tooltip>
      <Tooltip
        variant="action"
        icon="buildings"
        title="Organisation seats"
        body="Counts unique developers, not machines."
        linkHref="#"
        linkText="Learn more"
      >
        <button class="tt-trigger">Action variant</button>
      </Tooltip>
    </div>

    {/* The Variants grid. `.demo-open` lands on the .tt wrapper and the page
        opens the bubble through it — a tooltip cannot be hovered in a static
        render, and `js-open` sits on the BUBBLE, which `class` cannot reach.
        The `action` variant had no card at all until 2026-08-14, though the
        preview above has shown it all along. */}
    <div data-demo="variants">
      <div class="cell">
        <Tooltip title="Title" body={seats} class="demo-open" />
        <div class="lbl">Default<small>Property 1=Default</small></div>
      </div>
      <div class="cell">
        <Tooltip
          title="Per-seat licensing"
          body="Counts unique developers, not machines."
          linkHref="#"
          linkText="Learn more"
          class="demo-open"
        />
        <div class="lbl">With link<small>Property 1=With link</small></div>
      </div>
      <div class="cell">
        <Tooltip body={seats} class="demo-open" />
        <div class="lbl">Default · no title<small>Show Title = false</small></div>
      </div>
      <div class="cell">
        <Tooltip
          variant="action"
          icon="buildings"
          title="Organisation seats"
          body="Counts unique developers, not machines."
          linkHref="#"
          linkText="Learn more"
          class="demo-open"
        />
        <div class="lbl">Action<small>variant="action" · adds an icon</small></div>
      </div>
    </div>

  </body>
</html>
